# Database backups (contain real user PII — never commit)
Database_backup/

# Environment variables
.env
.env.local
.env.*.local

# Dependencies
node_modules/
yarn.lock

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Archived template and backup files
_REDUNDANT_BACKUP/

node.module/
# Build outputs
dist/
build/

# Playwright (npm run test:e2e) — screenshots/traces/HTML reports from a run, never source
test-results/
playwright-report/
blob-report/

# OCR temp uploads (deleted automatically after processing; never committed)
uploads/tmp/*
!uploads/tmp/.gitkeep

# Archived Document Library uploads (runtime user data, not source)
uploads/documents/*
!uploads/documents/.gitkeep

# Profile picture uploads (runtime user data, not source)
uploads/avatars/*
!uploads/avatars/.gitkeep

# Achievement certificate/image uploads (runtime user data, not source — see services/documentStorageService.js;
# uploaded to Google Drive in the background, local disk is only a transient fallback)
uploads/achievements/*
!uploads/achievements/.gitkeep
