<!-- ========== LAU Sidebar (2026-10, read-only Partnership Request monitoring role) ==========
     Deliberately a NEW, minimal partial rather than reusing sidebar_staff.ejs/sidebar.ejs — those link to
     User Management, Reports & Audit Trail, Document Library, Calendar management, and Admin Settings,
     none of which LAU has (or should appear to have) access to. Only Partnership Monitoring + Logout. -->
<div class="app-menu navbar-menu">
    <div class="navbar-brand-box">
        <a href="/lau/monitoring" class="logo logo-dark">
            <span class="logo-sm">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28" style="border-radius:50%;object-fit:cover;">
            </span>
            <span class="logo-lg">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28"
                    style="border-radius:50%;object-fit:cover;margin-right:8px;">
                <span style="font-size:18px;font-weight:700;letter-spacing:-.3px;color:#405189;">CIPRMS</span>
            </span>
        </a>
        <a href="/lau/monitoring" class="logo logo-light">
            <span class="logo-sm">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28" style="border-radius:50%;object-fit:cover;">
            </span>
            <span class="logo-lg">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28"
                    style="border-radius:50%;object-fit:cover;margin-right:8px;">
                <span style="font-size:18px;font-weight:700;letter-spacing:-.3px;color:#fff;">CIPRMS</span>
            </span>
        </a>
        <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover"
            id="vertical-hover">
            <i class="ri-record-circle-line"></i>
        </button>
    </div>

    <!-- Sidebar User Box (Velzon style) -->
    <div class="dropdown sidebar-user m-1 rounded">
        <button type="button" class="btn material-shadow-none" id="sidebar-user-dropdown" data-bs-toggle="dropdown"
            aria-haspopup="true" aria-expanded="false">
            <span class="d-flex align-items-center gap-2">
                <img class="rounded header-profile-user js-user-avatar" src="<%= typeof userAvatarUrl !== 'undefined' ? userAvatarUrl : '/images/default-avatar.jpg' %>" alt="Profile picture" style="object-fit:cover;" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/default-avatar.jpg'">
                <span class="text-start">
                    <span class="d-block fw-medium sidebar-user-name-text">
                        <%= typeof user !=='undefined' && user ? user.name || 'Guest' : 'Guest' %>
                    </span>
                    <span class="d-block fs-14 sidebar-user-name-sub-text"><i
                            class="ri ri-circle-fill fs-10 text-info align-baseline"></i> <span
                            class="align-middle">LAU</span></span>
                </span>
            </span>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
            <h6 class="dropdown-header">Welcome!</h6>
            <a class="dropdown-item" href="#" onclick="event.preventDefault(); fetch('/logout', {method:'POST'}).then(function(){ location.href='/'; });"><i class="mdi mdi-logout text-muted fs-16 align-middle me-1"></i>
                <span class="align-middle">Logout</span></a>
        </div>
    </div>

    <div id="scrollbar">
        <div class="container-fluid">
            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">

                <li class="menu-title"><span>Main Menu</span></li>

                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'access-requests') ? 'active' : '' %>"
                        href="/lau/monitoring">
                        <i class="ri-shield-user-line"></i>
                        <span>Partnership Monitoring</span>
                    </a>
                </li>

                <li class="menu-title"><span>Account</span></li>

                <li class="nav-item">
                    <a class="nav-link menu-link" href="#" onclick="event.preventDefault(); fetch('/logout', {method:'POST'}).then(function(){ location.href='/'; });">
                        <i class="ri-logout-box-r-line"></i>
                        <span>Logout</span>
                    </a>
                </li>

            </ul>
        </div>
    </div>
    <div class="sidebar-background"></div>
</div>
<div class="vertical-overlay"></div>
