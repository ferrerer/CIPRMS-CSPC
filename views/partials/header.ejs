<script>
// Notification badge. paintNotifBadge() draws a count; refreshNotifBadge() asks the server for the real one (the server is
// the source of truth) — used on load, after a live update, and after a reconnect.
function paintNotifBadge(count) {
    const badge = document.getElementById('notif-badge');
    const countBadge = document.getElementById('notif-count-badge');
    if (badge) {
        badge.textContent = count;
        badge.style.display = count > 0 ? '' : 'none';
    }
    if (countBadge) countBadge.textContent = count + ' New';
}
function refreshNotifBadge() {
    return fetch('/api/notifications/unread-count', { headers: { 'X-Requested-With': 'ciprms' } })
        .then(r => r.json())
        .then(d => paintNotifBadge(d.count || 0))
        .catch(() => {});
}
refreshNotifBadge();

// ── Notification bell dropdown — real data, click-to-navigate ───────────────
// Reuses the same /api/notifications/mine feed and PATCH-mark-read pattern as
// the full Notifications page (views/administrator/notifications.ejs) —
// clicking an item here marks it read then jumps straight to its `link`
// (which for Partnership/Document Requests deep-links into that request's
// detail modal, same as the full page already does).
(function () {
    let notifCache = [];

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function renderNotifItem(n) {
        const color = n.color || 'primary';
        const icon = n.icon || 'ri-notification-3-line';
        return `<div class="text-reset notification-item d-block dropdown-item position-relative${n.unread ? ' bg-light-subtle' : ''}" data-notif-id="${n.id}" style="cursor:pointer;">
            <div class="d-flex">
                <div class="avatar-xs me-3 flex-shrink-0">
                    <span class="avatar-title bg-${color}-subtle text-${color} rounded-circle fs-16"><i class="${icon}"></i></span>
                </div>
                <div class="flex-grow-1" style="min-width:0;">
                    <h6 class="mt-0 mb-1 lh-base fs-13 notif-title-line ${n.unread ? 'fw-semibold' : 'fw-normal text-muted'}" title="${escapeHtml(n.title)}">${n.priority ? '<i class="ri-flag-fill text-danger me-1 notif-flag" title="Priority" aria-label="Priority"></i>' : ''}${escapeHtml(n.title)}</h6>
                    <p class="mb-1 fs-12 text-muted notif-desc-line" title="${escapeHtml(n.desc || '')}">${escapeHtml(n.desc || '')}</p>
                    <p class="mb-0 fs-11 fw-medium text-uppercase text-muted"><i class="mdi mdi-clock-outline"></i> ${escapeHtml(n.time || '')}</p>
                </div>
            </div>
        </div>`;
    }

    function handleNotifClick(id) {
        const n = notifCache.find(x => x.id === id);
        if (n && n.unread) {
            n.unread = false;
            // keepalive: the page navigates away in this same click; without it the browser can cancel the request
            // before the server records the notification as read
            const req = { method: 'PATCH', json: { unread: false }, keepalive: true, quiet: true };
            if (window.CIPRMS) window.CIPRMS.api('/api/notifications/' + id, req);
            else fetch('/api/notifications/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ unread: false }), keepalive: true }).catch(() => {});
            paintNotifBadge(notifCache.filter(x => x.unread).length);
        }
        // n.href is the destination the server resolved for THIS user's role (n.link is only what was stored
        // when the notification was created, and can be a route the reader's role no longer has).
        const dest = n && (n.href || n.link);
        if (dest) window.location.href = dest;
    }

    // Velzon's own app.js (H(), wired up on page load regardless of whether
    // this dropdown is even open yet) checks each tab-pane for existing
    // `.notification-item` elements and, finding none against the initial
    // static "Loading…" placeholder, permanently (a) hides that tab's
    // ".view-all" footer and (b) injects its own hardcoded
    // ".empty-notification-elem" ("Hey! You have no any notifications")
    // block as an extra sibling of #notif-list. Because
    // that happens before this file's own fetch ever resolves, the stray
    // block and the hidden footer both survive untouched once real data
    // renders — this restores the footer and clears Velzon's own stale
    // block every time this function runs, so it can never linger regardless
    // of how that race played out on a given load.
    function resyncTabFooter(el) {
        const pane = el.closest('.tab-pane');
        if (!pane) return;
        const stale = pane.querySelector('.empty-notification-elem');
        if (stale) stale.remove();
        const viewAll = pane.querySelector('.view-all');
        if (viewAll) viewAll.style.display = '';
    }

    function renderList(elId, items, emptyMsg) {
        const el = document.getElementById(elId);
        if (!el) return;
        if (!items.length) {
            el.innerHTML = `<div class="text-center text-muted py-4 fs-13">${emptyMsg}</div>`;
        } else {
            el.innerHTML = items.map(renderNotifItem).join('');
            el.querySelectorAll('[data-notif-id]').forEach(item => {
                item.addEventListener('click', () => handleNotifClick(parseInt(item.dataset.notifId)));
            });
        }
        resyncTabFooter(el);
    }

    function loadDropdownNotifications() {
        fetch('/api/notifications/mine')
            .then(r => r.json())
            .then(data => {
                notifCache = Array.isArray(data) ? data : [];
                renderList('notif-list', notifCache, 'No notifications yet.');
            })
            .catch(() => {
                renderList('notif-list', [], 'Could not load notifications.');
            });
    }

    function rerenderFromCache() {
        renderList('notif-list', notifCache, 'No notifications yet.');
        paintNotifBadge(notifCache.filter(n => n.unread).length);
    }

    document.addEventListener('DOMContentLoaded', loadDropdownNotifications);

    // Live updates (Server-Sent Events, see public/js/ciprms-rt.js). The pushed notification is for THIS user only; the
    // server's own count and list are re-read shortly afterwards so what is shown never drifts from the database.
    let reconcileTimer = null;
    function reconcileSoon() {
        clearTimeout(reconcileTimer);
        reconcileTimer = setTimeout(() => { loadDropdownNotifications(); refreshNotifBadge(); }, 600);
    }
    if (window.CIPRMS && window.CIPRMS.on) {
        window.CIPRMS.on('notification.created', d => {
            const n = d && d.notification;
            if (n && !notifCache.some(x => x.id === n.id)) {
                notifCache.unshift(n);
                notifCache.sort((a, b) => b.id - a.id);
                rerenderFromCache();
                window.CIPRMS.toast(n.title || 'New notification', 'info');
            }
            reconcileSoon();
        });
        window.CIPRMS.on('notification.read', d => {
            notifCache.forEach(n => { if (d && (d.all || n.id === d.id)) n.unread = false; });
            rerenderFromCache();
            reconcileSoon();
        });
        window.CIPRMS.on('notification.deleted', d => {
            notifCache = notifCache.filter(n => !(d && n.id === d.id));
            rerenderFromCache();
            reconcileSoon();
        });
        window.CIPRMS.on('rt.resync', () => { loadDropdownNotifications(); refreshNotifBadge(); });
    }
})();
</script>

<% if (typeof isDeptUser !== 'undefined' && isDeptUser) { %>
<script>
// College Dean (2026-11 update): the ☰ button toggles the sidebar between Expanded (full labeled sidebar)
// and Compact (icon-only) — replacing the earlier "hide the whole sidebar completely" behavior. Compact
// mode reuses Velzon's own native data-sidebar-size="sm" feature directly (app.min.css already implements
// the narrow width, logo-sm/logo-lg swap, hidden text labels/group headings, and main-content/topbar/
// footer repositioning for it — no custom CSS needed here, unlike the old hide-the-whole-sidebar approach).
// The choice is remembered per user under its own key (sidebarCompact), separate from the generic
// sidebarSize field ui-state-init.ejs manages for every role — that field can't distinguish a genuine
// Velzon desktop toggle (which this button fully replaces for a Dean, see below) from this button's own
// choice, so mixing them would let the two systems overwrite each other. Phones and small tablets keep
// Velzon's own slide-in menu, which the button still opens, always at full size.
(function () {
    var btn = document.getElementById('topnav-hamburger-icon');
    if (!btn || !window.CIPRMS_USER) return;
    var root = document.documentElement;
    var KEY = 'ciprmsUiState_' + String(window.CIPRMS_USER.id);
    var DESKTOP_MIN = 768;

    function isDesktop() { return window.innerWidth >= DESKTOP_MIN; }
    function savedCompact() {
        try { return !!JSON.parse(localStorage.getItem(KEY) || '{}').sidebarCompact; } catch (e) { return false; }
    }
    function save(compact) {
        try {
            var s = JSON.parse(localStorage.getItem(KEY) || '{}');
            s.sidebarCompact = compact;
            localStorage.setItem(KEY, JSON.stringify(s));
        } catch (e) { /* storage unavailable: the choice just lasts for this page */ }
    }
    var compactNow = savedCompact();
    function apply() {
        // The saved choice only applies where there IS a permanent sidebar to collapse.
        if (isDesktop() && compactNow) {
            root.setAttribute('data-sidebar-size', 'sm');
        } else {
            // Mobile always needs Velzon's own full-size off-canvas drawer, never the icon-only desktop
            // layout — and a Dean who has NOT chosen compact needs the full sidebar too, on any width.
            // Clearing "sm"/"sm-hover" here is always safe and never loses a real choice: this button is
            // the only thing that ever sets it for a Dean (stopImmediatePropagation() below fully
            // suppresses Velzon's own O(), the only other code that does), so finding it set here while
            // the desktop+compact combination says otherwise can only mean a stale value got in some other
            // way — e.g. ui-state-init.ejs's own generic, role-agnostic restore (shared with every other
            // role) applying a leftover pre-2026-11 preference, or Velzon's resize-debounced P() restoring
            // a stale sessionStorage snapshot (see the MutationObserver below). The Dean's actual choice
            // always lives in compactNow/localStorage, never in this raw attribute value.
            var size = root.getAttribute('data-sidebar-size');
            if (size === 'sm' || size === 'sm-hover') root.removeAttribute('data-sidebar-size');
        }
        btn.setAttribute('aria-pressed', isDesktop() && compactNow ? 'true' : 'false');
        btn.setAttribute('title', isDesktop() ? (compactNow ? 'Expand sidebar' : 'Collapse sidebar') : 'Toggle sidebar menu');
    }

    // Registered here, before Velzon's app.js (bottom of the page) adds its own click handler to this button, so on a
    // desktop-width window this runs first and stops that one; on a small screen it steps aside and Velzon's runs.
    btn.addEventListener('click', function (e) {
        if (!isDesktop()) return;
        e.stopImmediatePropagation();
        compactNow = !compactNow;
        save(compactNow);
        apply();
    });
    window.addEventListener('resize', apply);
    apply();

    // app.js's own window "resize" handler debounces a call (2s) to its P() function, which rebuilds its
    // layout-restore object from sessionStorage — including data-sidebar-size, refreshed by ui-state-init.
    // ejs's own snapshot taken BEFORE this script ever runs, so it reflects whatever the generic
    // (role-agnostic) restore set, not this button's own compact choice. Left alone, that 2-second restore
    // would silently undo a Dean's compact selection after any resize, with no further event to
    // self-correct. Watch the attribute itself and re-assert our own state the moment anything else
    // changes it away from it — no flag/guard needed: once apply() has made the attribute match our
    // desired state, the mutation that fires from apply()'s own write is a no-op here.
    new MutationObserver(function () {
        var wantCompact = isDesktop() && compactNow;
        var isCompact = root.getAttribute('data-sidebar-size') === 'sm';
        if (wantCompact !== isCompact) apply();
    }).observe(root, { attributes: true, attributeFilter: ['data-sidebar-size'] });
})();
</script>
<% } %>
