<!-- Overlay -->
<div class="vertical-overlay"></div>

<script>
    // Load notification badge in sidebar
    fetch('/api/notifications/unread-count')
        .then(r => r.json())
        .then(d => {
            const count = d.count || 0;
            const badge = document.getElementById('sidebar-notif-badge');
            if (badge && count > 0) {
                badge.textContent = count;
                badge.style.display = '';
            }
        }).catch(() => { });
</script>