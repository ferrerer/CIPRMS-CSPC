<!-- ========== Personnel Sidebar ========== -->
<div class="app-menu navbar-menu">
    <div class="navbar-brand-box">
        <a href="/personnel/monitoring" class="logo logo-dark">
            <span class="logo-sm">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28" style="border-radius:50%;object-fit:cover;">
            </span>
            <span class="logo-lg">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28"
                    style="border-radius:50%;object-fit:cover;margin-right:8px;">
                <span style="font-size:18px;font-weight:700;letter-spacing:-.3px;color:#405189;">CIPRMS</span>
            </span>
        </a>
        <a href="/personnel/monitoring" class="logo logo-light">
            <span class="logo-sm">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28" style="border-radius:50%;object-fit:cover;">
            </span>
            <span class="logo-lg">
                <img src="/images/cirl-logo.jpg" alt="CIRL" height="28"
                    style="border-radius:50%;object-fit:cover;margin-right:8px;">
                <span style="font-size:18px;font-weight:700;letter-spacing:-.3px;color:#fff;">CIPRMS</span>
            </span>
        </a>
        <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover"
            id="vertical-hover">
            <i class="ri-record-circle-line"></i>
        </button>
    </div>

    <!-- Sidebar user box — identity + role label only. Profile lives in the
         header user menu; Settings and Logout are nav items below. There is no
         Notifications page for this role (the header bell remains). -->
    <div class="sidebar-user m-1 rounded">
        <div class="d-flex align-items-center gap-2 px-3 py-2">
            <img class="rounded header-profile-user js-user-avatar" src="<%= typeof userAvatarUrl !== 'undefined' ? userAvatarUrl : '/images/default-avatar.jpg' %>" alt="Profile picture" style="object-fit:cover;" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/default-avatar.jpg'">
            <span class="text-start">
                <span class="d-block fw-medium sidebar-user-name-text">
                    <%= typeof user !=='undefined' && user ? user.name || 'College Dean' : 'College Dean' %>
                </span>
                <span class="d-block fs-14 sidebar-user-name-sub-text" id="sidebar-role-label"><i
                        class="ri ri-circle-fill fs-10 text-success align-baseline"></i> <span class="align-middle">College Dean</span></span>
            </span>
        </div>
    </div>

    <div id="scrollbar">
        <div class="container-fluid">
            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">

                <li class="menu-title"><span>Main Menu</span></li>

                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'monitoring') ? 'active' : '' %>"
                        href="/personnel/monitoring" data-bs-toggle="tooltip" data-bs-placement="right" title="Monitoring">
                        <i class="ri-refresh-line"></i>
                        <span>Monitoring</span>
                    </a>
                </li>

                <!-- Requests — College Requests (MOA/MOU/Accreditation assigned by Administrator/Staff) lives
                     inside this same page as its own tab (2026-11 follow-up); no separate sidebar item or
                     primary navigation destination for it anymore — see cirl.js's /personnel/requests and
                     /personnel/college-requests (now a redirect into that tab). -->
                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'requests') ? 'active' : '' %>"
                        href="/personnel/requests" data-bs-toggle="tooltip" data-bs-placement="right" title="Requests">
                        <i class="ri-briefcase-4-line"></i>
                        <span>Requests</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'calendar') ? 'active' : '' %>"
                        href="/personnel/calendar" data-bs-toggle="tooltip" data-bs-placement="right" title="Calendar">
                        <i class="ri-calendar-2-line"></i>
                        <span>Calendar</span>
                    </a>
                </li>

                <!-- Notifications — the page already exists and is already authorized for this role
                     (/personnel/notifications, requirePersonnel; reopened 2026-09-26, reached only via the
                     header bell's "View All Notifications" until now). Adding the direct sidebar shortcut
                     grants nothing new — same route, same RBAC. Kept in Main Menu rather than its own
                     "Management" group: a divider around a single item looked sparse/disjointed next to
                     Administrator's fuller groups, not like an intentional section. -->
                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'notifications') ? 'active' : '' %>"
                        href="/personnel/notifications" data-bs-toggle="tooltip" data-bs-placement="right" title="Notifications">
                        <i class="ri-notification-3-line"></i>
                        <span>Notifications</span>
                        <span class="badge bg-danger rounded-pill" id="sidebar-notif-badge"
                            style="display:none;margin-left:auto;"></span>
                    </a>
                </li>

                <li class="menu-title"><span>Account</span></li>

                <li class="nav-item">
                    <a class="nav-link menu-link <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>"
                        href="/personnel/settings" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings">
                        <i class="ri-settings-3-line"></i>
                        <span>Settings</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link menu-link" href="#" data-bs-toggle="tooltip" data-bs-placement="right" title="Logout" onclick="event.preventDefault(); fetch('/logout', {method:'POST'}).then(function(){ location.href='/'; });">
                        <i class="ri-logout-box-r-line"></i>
                        <span>Logout</span>
                    </a>
                </li>

            </ul>
        </div>
    </div>
    <div class="sidebar-background"></div>
</div>
<div class="vertical-overlay"></div>

<script>
    // Load notification badge in sidebar (same pattern as the Administrator sidebar's own copy of this script)
    fetch('/api/notifications/unread-count')
        .then(r => r.json())
        .then(d => {
            const count = d.count || 0;
            const badge = document.getElementById('sidebar-notif-badge');
            if (badge && count > 0) {
                badge.textContent = count;
                badge.style.display = '';
            }
        }).catch(() => { });
</script>
