<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Monitoring | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <style>
        /* Bordered grid with fixed column widths — same look as the Administrator Requests tables
           (administrator/partnership_requests.ejs .req-fixed-cols): columns don't shift between pages and
           long text wraps inside its cell. */
        .req-fixed-cols { table-layout: fixed; width: 100%; min-width: 860px; }
        .req-fixed-cols td, .req-fixed-cols th { white-space: normal; overflow-wrap: break-word; word-break: normal; }
        .req-fixed-cols td .badge { white-space: normal; text-align: left; line-height: 1.35; max-width: 100%; }
    </style>
</head>
<body>

<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar_partner') %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <div class="row">
                  <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                      <h4 class="mb-sm-0"><i class="ri-refresh-line me-2 text-primary"></i>Monitoring</h4>
                      <div class="page-title-right">
                        <ol class="breadcrumb m-0" id="page-breadcrumb">
                          <li class="breadcrumb-item"><a href="/partner/monitoring">CIPRMS</a></li>
                          <li class="breadcrumb-item active">Monitoring</li>
                        </ol>
                      </div>
                    </div>
                  </div>
                </div>
                <p class="text-muted mb-3"><i class="ri-shield-check-line me-1"></i>This page tracks only your own submitted requests, documents, and partnership record.</p>

                <!-- Stat Cards -->
                <div class="row">
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Total Requests</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-total">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-primary-subtle text-primary mb-0"><i class="ri-file-list-3-line align-middle"></i> Submitted</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-primary-subtle rounded-circle fs-2"><i class="ri-file-list-3-line text-primary"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">In Progress</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-progress">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-warning-subtle text-warning mb-0"><i class="ri-time-line align-middle"></i> Awaiting review</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-warning-subtle rounded-circle fs-2"><i class="ri-time-line text-warning"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Approved</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-approved">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-success-subtle text-success mb-0"><i class="ri-checkbox-circle-line align-middle"></i> Confirmed</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-success-subtle rounded-circle fs-2"><i class="ri-checkbox-circle-line text-success"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Documents on File</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-docs">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-info-subtle text-info mb-0"><i class="ri-file-shield-2-line align-middle"></i> Uploaded</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-info-subtle rounded-circle fs-2"><i class="ri-file-shield-2-line text-info"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end stat cards -->

                <!-- My Partnership Requests -->
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <h4 class="card-title mb-0 flex-grow-1"><i class="ri-file-list-3-line me-2"></i>My Partnership Requests</h4>
                                <a href="/partner/requests" class="btn btn-soft-primary btn-sm"><i class="ri-add-line me-1"></i>New Request</a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover req-fixed-cols table-bordered align-middle mb-0">
                                        <colgroup><col style="width:20%"><col style="width:10%"><col style="width:11%"><col style="width:11%"><col style="width:12%"><col style="width:12%"><col style="width:11%"><col style="width:13%"></colgroup>
                                        <thead class="table-light">
                                            <tr>
                                                <th>Institution</th><th>Request Type</th><th>Status</th>
                                                <th>Date Submitted</th><th>Last Updated</th><th>Current Stage</th>
                                                <th>Administrator</th><th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="pr-monitor-body">
                                            <tr><td colspan="8" class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="pr-pagination" class="p-3"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- My MOA/MOU Submissions — the record of everything sent through "Submission Of MOA/MOU" -->
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <h4 class="card-title mb-0 flex-grow-1"><i class="ri-file-upload-line me-2"></i>My MOA/MOU Submissions</h4>
                                <a href="/partner/requests?tab=dr" class="btn btn-soft-success btn-sm"><i class="ri-add-line me-1"></i>New Submission</a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover req-fixed-cols table-bordered align-middle mb-0">
                                        <colgroup><col style="width:18%"><col style="width:22%"><col style="width:6%"><col style="width:11%"><col style="width:11%"><col style="width:11%"><col style="width:11%"><col style="width:10%"></colgroup>
                                        <thead class="table-light">
                                            <tr>
                                                <th>Institution</th><th>Notes</th><th>Files</th><th>Status</th>
                                                <th>Date Submitted</th><th>Last Updated</th><th>Administrator</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="moa-monitor-body">
                                            <tr><td colspan="8" class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="moa-pagination" class="p-3"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Renewal Status -->
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header"><h4 class="card-title mb-0"><i class="ri-refresh-line me-2"></i>Renewal Status</h4></div>
                            <div class="card-body" id="renewal-status-body">
                                <div class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Draft Collaboration Modal -->
        <!-- Request Details (2026-11, split from pr-draft-modal) — read-only summary; its own "View Draft"
             button drills into pr-draft-modal (a separate modal, swapped in — see the hidden.bs.modal
             wiring below), never stacked on top of this one. -->
        <div class="modal fade" id="pr-details-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pr-details-modal-title"><i class="ri-file-list-3-line me-2 text-primary"></i>Request Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="pr-details-summary" class="row g-2 fs-13 mb-0">
                            <div class="col-6"><span class="text-muted">Institution</span><div class="fw-semibold" id="pr-det-inst"></div></div>
                            <div class="col-6"><span class="text-muted">Country</span><div class="fw-semibold" id="pr-det-country"></div></div>
                            <div class="col-4"><span class="text-muted">Agreement Type</span><div id="pr-det-type"></div></div>
                            <div class="col-4"><span class="text-muted">Nature</span><div id="pr-det-nature"></div></div>
                            <div class="col-4"><span class="text-muted">Category</span><div id="pr-det-category"></div></div>
                            <div class="col-4"><span class="text-muted">Status</span><div id="pr-det-status"></div></div>
                            <div class="col-4"><span class="text-muted">Proposed Start</span><div id="pr-det-start"></div></div>
                            <div class="col-4"><span class="text-muted">Proposed End</span><div id="pr-det-end"></div></div>
                            <div class="col-12"><span class="text-muted">Notes</span><div id="pr-det-notes"></div></div>
                            <div class="col-12"><span class="text-muted">Started by</span><div id="pr-det-initiator"></div></div>
                        </div>
                        <div id="pr-details-no-draft-note" class="form-text mt-2" style="display:none;">No draft or document has been attached to this request yet.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-soft-info" id="pr-details-view-draft-btn" onclick="openDraftModal(currentDraftPRId)">
                            <i class="ri-file-list-3-line me-1"></i>View Draft
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft modal (2026-11, narrowed to just the draft/document timeline + upload — the read-only
             summary that used to live here moved to pr-details-modal above). -->
        <div class="modal fade" id="pr-draft-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pr-draft-modal-title"><i class="ri-file-list-3-line me-2 text-primary"></i>Draft & Documents</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="pr-gdocs-partner" class="mb-3" style="display:none;"></div>
                        <div id="pr-draft-timeline" class="mb-3"></div>
                        <div id="pr-draft-upload-wrap" class="border-top pt-3">
                            <label class="input-label text-muted fs-10 fw-bold text-uppercase d-block mb-2">Upload a New Version</label>
                            <div class="mb-2">
                                <input type="file" class="form-control form-control-sm" id="pr-draft-file" accept=".pdf,.jpg,.jpeg,.png,.docx">
                            </div>
                            <div class="mb-2">
                                <textarea class="form-control form-control-sm" id="pr-draft-note" rows="2"></textarea>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" id="pr-draft-upload-btn" onclick="uploadDraftDocument()">
                                <i class="ri-upload-2-line me-1"></i>Upload
                            </button>
                            <small class="text-muted d-block mt-2">PDF, JPG, PNG, or DOCX — max 10MB. CIRL is notified of your revision.</small>
                        </div>
                        <div id="pr-draft-closed-note" class="alert alert-secondary fs-13 mb-0" style="display:none;">
                            <i class="ri-lock-line me-1"></i>This request has already been decided — no further documents can be added.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" onclick="backToDetailsModal()"><i class="ri-arrow-left-line me-1"></i>Back to Details</button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft Preview Modal — opens on top of the Partnership Request
             draft-collaboration modal that triggered it. -->
        <div class="modal fade" id="draft-preview-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="ri-eye-line me-2 text-primary"></i>Draft Preview</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="draft-preview-body" class="mb-3"></div>
                        <div class="border-top pt-3">
                            <p class="fs-13 fw-medium mb-1" id="draft-preview-filename">—</p>
                            <p class="fs-13 text-muted mb-1">Uploaded by: <span id="draft-preview-uploader">—</span></p>
                            <p class="fs-13 text-muted mb-1">Date: <span id="draft-preview-when">—</span></p>
                            <p class="fs-13 text-muted mb-0">Note: <span id="draft-preview-note">—</span></p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="#" id="draft-preview-download-btn" class="btn btn-success btn-sm"><i class="ri-download-2-line me-1"></i>Download</a>
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Request Renewal Modal -->
        <div class="modal fade" id="renewal-request-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="ri-refresh-line me-2 text-success"></i>Request Renewal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Requesting renewal for <strong id="rr-institution">—</strong>. Current expiry: <span id="rr-current-end">—</span>.</p>
                        <div class="mb-3">
                            <label class="form-label">Proposed New End Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="rr-end-date">
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" id="rr-notes" rows="3"></textarea>
                        </div>
                        <div class="alert alert-danger d-none mt-3 mb-0 py-2 fs-13" id="rr-error"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-success" id="rr-submit-btn" onclick="submitRenewalRequest()">
                            <i class="ri-send-plane-line me-1"></i>Submit Request
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<div id="mon-toast" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;font-size:.8125rem;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.18);opacity:0;pointer-events:none;transition:opacity .3s;"></div>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script>
    function showToast(msg, bg) {
        var t = document.getElementById('mon-toast');
        t.style.background = bg || '#405189'; t.textContent = msg; t.style.opacity = '1';
        clearTimeout(t._to); t._to = setTimeout(function () { t.style.opacity = '0'; }, 3000);
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // ── Breadcrumb — reflects whichever record's Draft/Renewal modal is currently open,
    // e.g. CIPRMS > Monitoring > Partnership Request > <institution — #id>. ──
    function setBreadcrumb(labels) {
        var ol = document.getElementById('page-breadcrumb');
        if (!ol) return;
        var html = '<li class="breadcrumb-item"><a href="/partner/monitoring">CIPRMS</a></li>';
        labels.forEach(function (label, i) {
            var isLast = i === labels.length - 1;
            html += isLast
                ? '<li class="breadcrumb-item active">' + escapeHtml(label) + '</li>'
                : '<li class="breadcrumb-item"><a href="/partner/monitoring">' + escapeHtml(label) + '</a></li>';
        });
        ol.innerHTML = html;
    }
    function resetBreadcrumb() { setBreadcrumb(['Monitoring']); }
    function prRequestLabel(r) { return (r.institution || ('Request #' + r.id)) + ' — #' + r.id; }

    // 2026-09-06 security hardening: escapeHtml() alone does NOT neutralize a
    // dangerous URL scheme (javascript:/data:/vbscript:) in an href/src —
    // item.link can be a submitter's free-text attachmentLink. Only allow
    // absolute http(s) URLs or the app's own relative paths.
    function sanitizeUrl(url) {
        var s = String(url == null ? '' : url).trim();
        if (!s) return '';
        if (/^https?:\/\//i.test(s)) return s;
        if (s.charAt(0) === '/' && s.charAt(1) !== '/') return s;
        return '';
    }

    function statusBadgeClass(status) {
        if (status === 'Approved' || status === 'Fulfilled' || status === 'Completed') return 'bg-success-subtle text-success';
        if (status === 'Rejected') return 'bg-danger-subtle text-danger';
        if (status === 'Withdrawn') return 'bg-secondary-subtle text-secondary';
        if (status === 'Draft') return 'bg-light text-dark';
        if (status === 'Preparing') return 'bg-info-subtle text-info';
        if (status === 'Awaiting for Approval') return 'bg-primary-subtle text-primary';
        if (status === 'Release') return 'bg-dark-subtle text-dark';
        return 'bg-warning-subtle text-warning'; // Pending / Received and any other undecided state
    }

    // "Current Stage" is a human-readable phase name derived from the same
    // `status` field the Status column already shows — not a separate piece
    // of backend state — so the two columns never disagree.
    var PR_STAGE_LABEL = {
        'Draft': 'Draft — Not Submitted', 'Pending': 'Awaiting Review',
        'Under Review': 'Under Review by CIRL', 'Approved': 'Approved',
        'Rejected': 'Rejected', 'Withdrawn': 'Withdrawn'
    };
    function fmtWhen(iso, fallback) {
        if (!iso) return fallback || '—';
        var d = new Date(iso);
        return isNaN(d) ? (fallback || '—') : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function setCount(id, n) {
        var el = document.getElementById(id);
        if (el) el.textContent = n;
    }

    /* ─── DRAFT / DOCUMENT COLLABORATION (own requests only — the request's
       own submittedByEmail is the ownership boundary, enforced server-side
       on POST /api/requests/:id/documents; myRequests itself is already
       scoped to "mine" by GET /api/requests/mine, so there is no way to
       reach another user's request id from this page). ─── */
    var ROLE_LABEL = {
        'Administrator': 'Administrator', 'Staff': 'CIRL Staff',
        'Auth. Personnel': 'College Dean', 'potential_partner': 'Partner',
        'Requester': 'You'
    };

    function fileKind(filename, mime) {
        var ext = String(filename || '').split('.').pop().toLowerCase();
        if ((mime && mime.indexOf('pdf') !== -1) || ext === 'pdf') return 'pdf';
        if ((mime && mime.indexOf('image/') === 0) || ['jpg', 'jpeg', 'png'].indexOf(ext) !== -1) return 'image';
        return 'other';
    }

    function fmtFileSize(bytes) {
        if (!bytes) return '';
        return bytes > 1e6 ? (bytes / 1e6).toFixed(1) + ' MB' : Math.round(bytes / 1024) + ' KB';
    }

    // Every draft/version gets its own dedicated "Draft Preview" modal
    // (opened on top of the pr-draft-modal that's already
    // showing) rather than an inline expand — same-screen, never navigates
    // away, and carries uploader/date/note context alongside the file.
    var DRAFT_TIMELINE_ITEMS = {};

    // Bootstrap 5 doesn't reliably support two modals open at once (the
    // second one's backdrop can render behind the first, eating clicks), so
    // instead of stacking, this SWAPS: hide whichever draft-collaboration
    // modal triggered it, show the preview modal, then restore the
    // original one when the preview is closed.
    var draftPreviewReturnTo = null;
    document.getElementById('draft-preview-modal').addEventListener('hidden.bs.modal', function () {
        if (draftPreviewReturnTo) {
            var returnEl = document.getElementById(draftPreviewReturnTo);
            draftPreviewReturnTo = null;
            if (returnEl) bootstrap.Modal.getOrCreateInstance(returnEl).show();
        }
    });
    // pr-draft-modal's own hidden.bs.modal listener (real close vs. Back-to-Details vs. swap-to-preview)
    // is registered further down, right next to openDraftModal()/backToDetailsModal(), which it depends on.
    document.getElementById('renewal-request-modal').addEventListener('hidden.bs.modal', resetBreadcrumb);
    // Set (and self-cleared) only by openDraftModal(), right before it hides pr-details-modal to swap into
    // pr-draft-modal — distinct from draftModalReturnTo below, which is pr-draft-modal's OWN "go back"
    // signal. Keeping these separate avoids a stale flag from one swap direction leaking into the other
    // (e.g. closing the Draft modal with its real Close button must never silently reopen Details).
    var detailsToDraftSwap = false;
    document.getElementById('pr-details-modal').addEventListener('hidden.bs.modal', function () {
        if (detailsToDraftSwap) { detailsToDraftSwap = false; return; }
        resetBreadcrumb();
    });

    function openDraftPreviewModal(prefix, idx) {
        var item = (DRAFT_TIMELINE_ITEMS[prefix] || [])[idx];
        if (!item || !item.link) return;
        var kind = fileKind(item.filename, item.fileType);
        var body = document.getElementById('draft-preview-body');
        var safeLink = sanitizeUrl(item.link);
        if (!safeLink) {
            body.innerHTML = '<div class="text-center text-muted py-5"><i class="ri-error-warning-line fs-1 d-block mb-2"></i>This link cannot be previewed (unrecognized or unsafe URL).</div>';
        } else if (kind === 'pdf') {
            body.innerHTML = '<iframe src="' + safeLink + '" style="width:100%;height:60vh;border:1px solid #e9ebec;border-radius:.25rem;"></iframe>';
        } else if (kind === 'image') {
            body.innerHTML = '<div class="text-center"><img src="' + safeLink + '" style="max-width:100%;max-height:60vh;border:1px solid #e9ebec;border-radius:.25rem;"></div>';
        } else {
            body.innerHTML = '<div class="text-center text-muted py-5"><i class="ri-file-3-line fs-1 d-block mb-2"></i>Preview not available for this file type.</div>';
        }
        document.getElementById('draft-preview-filename').textContent = item.filename;
        document.getElementById('draft-preview-uploader').textContent = item.uploadedBy + ' (' + (ROLE_LABEL[item.role] || item.role) + ')';
        document.getElementById('draft-preview-when').textContent = item.when;
        document.getElementById('draft-preview-note').textContent = item.note || '—';
        var downloadBtn = document.getElementById('draft-preview-download-btn');
        downloadBtn.href = safeLink || '#';
        downloadBtn.setAttribute('download', item.filename);

        var sourceEl = document.getElementById((prefix || 'pr') + '-draft-modal');
        var sourceInstance = sourceEl && bootstrap.Modal.getInstance(sourceEl);
        draftPreviewReturnTo = sourceInstance ? sourceEl.id : null;
        if (sourceInstance) sourceInstance.hide();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('draft-preview-modal')).show();
    }

    function draftItemHtml(item, idx, prefix) {
        var roleLabel = ROLE_LABEL[item.role] || item.role || 'Reviewer';
        var isReviewerRole = item.role === 'Administrator' || item.role === 'Staff';
        var avatar = '<div class="flex-shrink-0"><span class="avatar-title ' + (isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success') + ' rounded-circle" style="width:36px;height:36px;"><i class="ri-' + (isReviewerRole ? 'shield-star-line' : 'user-line') + '"></i></span></div>';
        var header = '<div class="d-flex justify-content-between flex-wrap gap-1">' +
            '<div><span class="fw-semibold fs-13">' + escapeHtml(item.uploadedBy) + '</span> <span class="badge ' + (isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success') + ' fs-10 ms-1">' + escapeHtml(roleLabel) + '</span></div>' +
            '<span class="text-muted fs-12">' + escapeHtml(item.when) + '</span>' +
            '</div>';
        if (!item.link) {
            return '<div class="d-flex gap-3 mb-3">' + avatar +
                '<div class="flex-grow-1 border rounded p-3">' + header +
                (item.note ? '<div class="fs-13 text-muted mt-1">' + escapeHtml(item.note) + '</div>' : '') +
                '</div></div>';
        }
        var kind = fileKind(item.filename, item.fileType);
        var sizeStr = fmtFileSize(item.fileSize);
        var previewBtn = (kind === 'pdf' || kind === 'image')
            ? '<button type="button" class="btn btn-sm btn-soft-primary" onclick="openDraftPreviewModal(\'' + (prefix || 'pr') + '\', ' + idx + ')"><i class="ri-eye-line me-1"></i>Preview</button>'
            : '<span class="text-muted fs-12 align-self-center">Preview not available for this file type</span>';
        var safeItemLink = sanitizeUrl(item.link);
        var downloadBtnHtml = safeItemLink
            ? ('<a href="' + safeItemLink + '" download="' + escapeHtml(item.filename) + '" class="btn btn-sm btn-soft-success"><i class="ri-download-2-line me-1"></i>Download</a>')
            : '<span class="text-muted fs-12 align-self-center">Link unavailable</span>';
        return '<div class="d-flex gap-3 mb-3">' + avatar +
            '<div class="flex-grow-1 border rounded p-3">' + header +
            '<div class="fs-13 fw-medium mt-1">' + escapeHtml(item.filename) + (sizeStr ? ' <span class="text-muted fs-12">(' + sizeStr + ')</span>' : '') + '</div>' +
            (item.note ? '<div class="fs-13 text-muted mt-1 fst-italic">"' + escapeHtml(item.note) + '"</div>' : '') +
            '<div class="d-flex align-items-center gap-2 mt-2">' + previewBtn + ' ' + downloadBtnHtml + '</div>' +
            '</div></div>';
    }

    function buildDraftTimelineItems(r) {
        var items = [];
        if (r.attachmentLink) {
            items.push({
                uploadedBy: r.requestedBy || 'You', role: 'Requester', when: r.date || '—',
                filename: String(r.attachmentLink).split('/').pop(), link: r.attachmentLink,
                note: 'Initial submission', fileType: '', fileSize: 0
            });
        }
        (r.supportingDocuments || []).forEach(function (d) {
            items.push({
                uploadedBy: d.uploadedBy || 'Unknown', role: d.uploaderRole || 'Reviewer',
                when: d.uploadedAt ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—',
                filename: d.originalFilename || 'Document', link: d.fileLink,
                note: d.note || '', fileType: d.fileType, fileSize: d.fileSize
            });
        });
        return items;
    }

    function renderDraftTimeline(r) {
        var items = buildDraftTimelineItems(r);
        DRAFT_TIMELINE_ITEMS.pr = items;
        var wrap = document.getElementById('pr-draft-timeline');
        wrap.innerHTML = items.length
            ? items.map(function (it, idx) { return draftItemHtml(it, idx, 'pr'); }).join('')
            : '<p class="text-muted fs-13 mb-0">No draft documents yet.</p>';
    }

    var currentDraftPRId = null;

    // Does this request have anything for "View Draft" to show? Same test buildDraftTimelineItems() itself
    // would otherwise report as empty — kept separate so the Details modal can decide this without first
    // rendering the timeline into a (currently hidden) pr-draft-modal.
    function requestHasDraftContent(r) {
        return !!(r.attachmentLink || (Array.isArray(r.supportingDocuments) && r.supportingDocuments.length));
    }

    function populateDetailsSummary(r) {
        document.getElementById('pr-details-modal-title').innerHTML = '<i class="ri-file-list-3-line me-2 text-primary"></i>Request Details — #' + r.id;
        document.getElementById('pr-det-inst').textContent = r.institution || '—';
        document.getElementById('pr-det-country').textContent = r.country || '—';
        document.getElementById('pr-det-type').textContent = r.type || '—';
        document.getElementById('pr-det-nature').textContent = r.nature || '—';
        document.getElementById('pr-det-category').textContent = r.category || '—';
        document.getElementById('pr-det-status').innerHTML = '<span class="badge ' + statusBadgeClass(r.status) + '">' + escapeHtml(r.status || '—') + '</span>';
        document.getElementById('pr-det-start').textContent = r.startDate || '—';
        document.getElementById('pr-det-end').textContent = r.endDate || '—';
        document.getElementById('pr-det-notes').textContent = r.notes || '—';
        // initiatedBy:'institution' (2026-11) — Admin/Staff started this request on the partner's behalf;
        // every other request was submitted by the partner themselves.
        document.getElementById('pr-det-initiator').textContent = r.initiatedBy === 'institution'
            ? 'CSPC-CIRL (started on your behalf)' : 'You';
        var hasDraft = requestHasDraftContent(r) || !!gdocsDraftIds[r.id];
        var viewDraftBtn = document.getElementById('pr-details-view-draft-btn');
        var noDraftNote = document.getElementById('pr-details-no-draft-note');
        viewDraftBtn.disabled = !hasDraft;
        noDraftNote.style.display = hasDraft ? 'none' : '';
        // A draft CIRL created in Google Docs isn't an uploaded file, so also ask the server for those —
        // without this the partner's View Draft stayed disabled and the Google Docs draft was unreachable.
        if (!hasDraft) {
            CIPRMS.api('/api/requests/' + r.id + '/google-docs', { quiet: true }).then(function (res) {
                if (!res.ok || !res.data || !res.data.docs || !res.data.docs.length) return;
                gdocsDraftIds[r.id] = true;
                if (currentDraftPRId !== r.id) return;
                viewDraftBtn.disabled = false;
                noDraftNote.style.display = 'none';
            });
        }
    }
    var gdocsDraftIds = {};   // request id → true once a Google Docs draft is known to exist

    function openDetailsModal(id) {
        var r = myRequests.find(function (x) { return x.id === id; });
        if (!r) return;
        currentDraftPRId = id;
        populateDetailsSummary(r);
        setBreadcrumb(['Monitoring', r.isSubmission ? 'MOA/MOU Submission' : 'Partnership Request', prRequestLabel(r), 'Details']);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('pr-details-modal')).show();
    }

    // Bootstrap 5 doesn't reliably support two modals open at once (the second one's backdrop can render
    // behind the first, eating clicks, and can leave the page scroll-locked after close), so Details and
    // Draft are SWAPPED rather than stacked — same pattern already used for pr-draft-modal <-> the Draft
    // Preview modal below. Only the explicit "Back to Details" button sets draftModalReturnTo before
    // hiding pr-draft-modal; closing it any other way (X, footer Close, Esc) ends the flow entirely.
    var draftModalReturnTo = null;
    document.getElementById('pr-draft-modal').addEventListener('hidden.bs.modal', function () {
        if (draftPreviewReturnTo === 'pr-draft-modal') return; // swapping to the preview, not a real close
        if (draftModalReturnTo) {
            draftModalReturnTo = null;
            openDetailsModal(currentDraftPRId);
            return;
        }
        resetBreadcrumb();
    });

    function openDraftModal(id) {
        var r = myRequests.find(function (x) { return x.id === id; });
        if (!r || !(requestHasDraftContent(r) || gdocsDraftIds[r.id])) return;
        currentDraftPRId = id;
        document.getElementById('pr-draft-modal-title').innerHTML = '<i class="ri-file-list-3-line me-2 text-primary"></i>Draft & Documents — #' + r.id;
        renderDraftTimeline(r);
        var closed = ['Approved', 'Rejected', 'Withdrawn'].indexOf(r.status) !== -1;
        document.getElementById('pr-draft-upload-wrap').style.display = closed ? 'none' : '';
        document.getElementById('pr-draft-closed-note').style.display = closed ? '' : 'none';
        document.getElementById('pr-draft-file').value = '';
        document.getElementById('pr-draft-note').value = '';
        setBreadcrumb(['Monitoring', r.isSubmission ? 'MOA/MOU Submission' : 'Partnership Request', prRequestLabel(r), 'Draft']);

        var detailsEl = document.getElementById('pr-details-modal');
        var detailsInstance = detailsEl && bootstrap.Modal.getInstance(detailsEl);
        if (detailsInstance) { detailsToDraftSwap = true; detailsInstance.hide(); }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('pr-draft-modal')).show();
        loadPartnerGoogleDocs(id);
    }

    function backToDetailsModal() {
        draftModalReturnTo = 'pr-details-modal';
        bootstrap.Modal.getInstance(document.getElementById('pr-draft-modal')).hide();
    }

    // MOA/MOU drafts CIRL started in Google Docs for this request (2026-09-26). The partner was already given
    // comment access by e-mail when the draft was created; this just puts the link where they work on the request.
    function loadPartnerGoogleDocs(id) {
        var box = document.getElementById('pr-gdocs-partner');
        box.style.display = 'none';
        box.innerHTML = '';
        CIPRMS.api('/api/requests/' + id + '/google-docs', { quiet: true }).then(function (res) {
            if (currentDraftPRId !== id || !res.ok || !res.data.docs.length) return;
            box.innerHTML =
                '<label class="input-label text-muted fs-10 fw-bold text-uppercase d-block mb-2">Agreement Draft in Google Docs</label>' +
                res.data.docs.map(function (d) {
                    var url = escapeHtml(sanitizeUrl(d.url));
                    return '<div class="d-flex align-items-center justify-content-between gap-2 border rounded p-2 mb-2">' +
                        '<div><div class="fw-semibold fs-13"><i class="ri-file-word-2-line text-primary me-1"></i>' + escapeHtml(d.title) + '</div>' +
                        '<div class="text-muted fs-12">You can read it and add comments. Open it while signed in to Google with the same e-mail address you use for CIPRMS.</div></div>' +
                        (url ? '<a href="' + url + '" target="_blank" rel="noopener" class="btn btn-sm btn-primary flex-shrink-0"><i class="ri-external-link-line me-1"></i>Open in Google Docs</a>' : '') +
                        '</div>';
                }).join('');
            box.style.display = '';
        });
    }

    function uploadDraftDocument() {
        var fileInput = document.getElementById('pr-draft-file');
        var noteInput = document.getElementById('pr-draft-note');
        var file = fileInput.files[0];
        if (!file || !currentDraftPRId) { showToast('Choose a file first.', '#f06548'); return; }
        var btn = document.getElementById('pr-draft-upload-btn');
        var originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
        var formData = new FormData();
        formData.append('document', file);
        formData.append('note', noteInput.value.trim());
        CIPRMS.api('/api/requests/' + currentDraftPRId + '/documents', { method: 'POST', body: formData, quiet: true })
            .then(function (result) {
                if (!result.ok) throw new Error(result.error || 'Upload failed.');
                var idx = myRequests.findIndex(function (x) { return x.id === currentDraftPRId; });
                if (idx !== -1 && result.data.request) myRequests[idx] = result.data.request;
                renderDraftTimeline(myRequests.find(function (x) { return x.id === currentDraftPRId; }));
                renderPRTable();
                renderMoaTable();
                fileInput.value = '';
                noteInput.value = '';
                showToast('New draft version uploaded.', '#0ab39c');
            })
            .catch(function (e) { showToast(e.message, '#f06548'); })
            .finally(function () { btn.disabled = false; btn.innerHTML = originalHtml; });
    }

    var myRequests = [];
    var flashPRIds = new Set();   // rows a live update just changed

    // MOA/MOU submissions are Partnership Requests underneath (isSubmission) but have their own record below, so the
    // Partnership Requests table, its counters and Approval Progress only cover real partnership / renewal requests.
    function partnershipOnly(list) { return list.filter(function (r) { return !r.isSubmission; }); }
    function submissionsOnly(list) { return list.filter(function (r) { return r.isSubmission; }); }

    
    /* ─── PAGINATION HELPERS (Request pattern) ─── */
    var prCurrentPage = 1, prItemsPerPage = 10;
    var moaCurrentPage = 1, moaItemsPerPage = 10;

    function buildPageList(current, total) {
        var maxVisible = 5;
        if (total <= maxVisible + 2) return Array.from({length: total}, function(_, i){ return i + 1; });
        var start = Math.max(1, current - Math.floor(maxVisible / 2));
        var end = start + maxVisible - 1;
        if (end > total) { end = total; start = Math.max(1, end - maxVisible + 1); }
        var pages = [];
        for (var i = start; i <= end; i++) pages.push(i);
        if (start > 1) { pages.unshift('...'); pages.unshift(1); }
        if (end < total) { pages.push('...'); pages.push(total); }
        return pages;
    }

    function buildPaginationHtml(current, total, onClickFn) {
        if (total <= 1) return '';
        var pageItem = function(label, page, opts) {
            opts = opts || {};
            var disabled = opts.disabled ? ' disabled' : '';
            var active = opts.active ? ' active' : '';
            var isEllipsis = opts.ellipsis ? ' ellipsis-item' : '';
            var isPrevNext = opts.isPrev ? ' page-link-prev' : (opts.isNext ? ' page-link-next' : '');
            var click = opts.disabled || opts.ellipsis ? '' : 'onclick="' + onClickFn + '(' + page + ')"';
            return '<li class="page-item' + disabled + active + isEllipsis + '"><a class="page-link' + isPrevNext + '" href="javascript:void(0)" ' + click + '>' + label + '</a></li>';
        };
        var html = pageItem('&lsaquo; Previous', current - 1, { disabled: current === 1, isPrev: true });
        buildPageList(current, total).forEach(function(p) {
            html += (p === '...')
                ? pageItem('&hellip;', null, { ellipsis: true, disabled: true })
                : pageItem(p, p, { active: p === current });
        });
        html += pageItem('Next &rsaquo;', current + 1, { disabled: current === total, isNext: true });
        return '<div class="d-flex justify-content-end mb-3"><ul class="pagination pagination-custom align-items-center m-0">' + html + '</ul></div>';
    }

    function goToPRPage(p) { prCurrentPage = p; renderPRTable(); }
    function goToMoaPage(p) { moaCurrentPage = p; renderMoaTable(); }

    function renderPRTable() {
        var body = document.getElementById('pr-monitor-body');
        var pagEl = document.getElementById('pr-pagination');
        var prs = partnershipOnly(myRequests);
        if (!prs.length) {
            body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No partnership requests yet.</td></tr>';
            if (pagEl) pagEl.innerHTML = '';
            return;
        }
        var totalPages = Math.ceil(prs.length / prItemsPerPage);
        if (prCurrentPage > totalPages) prCurrentPage = totalPages || 1;
        var startIdx = (prCurrentPage - 1) * prItemsPerPage;
        var pageItems = prs.slice(startIdx, startIdx + prItemsPerPage);
        if (pagEl) pagEl.innerHTML = buildPaginationHtml(prCurrentPage, totalPages, 'goToPRPage');
        body.innerHTML = pageItems.map(function (r) {
            // Withdraw was removed from Monitoring: a submitted request can only be viewed here. Every row
            // gets a read-only "View" action (2026-11); Drafts additionally keep "Continue" to go on editing.
            var actions = (r.status === 'Draft'
                ? '<a href="/partner/requests" class="btn btn-sm btn-soft-primary" title="Continue this draft"><i class="ri-edit-line me-1"></i>Continue</a> '
                : '') +
                '<button class="btn btn-sm btn-soft-info" onclick="openDetailsModal(' + r.id + ')" title="View details"><i class="ri-eye-line me-1"></i>View</button>';
            return '<tr data-pr-id="' + r.id + '"' + (flashPRIds.has(r.id) ? ' class="rt-flash"' : '') + '>' +
                '<td>' + (escapeHtml(r.institution) || '<span class="text-muted">(untitled draft)</span>') + '</td>' +
                '<td>' + (r.isRenewal ? 'Renewal' : 'Partnership') + '</td>' +
                '<td><span class="badge table-pill ' + statusBadgeClass(r.status) + '">' + r.status + '</span></td>' +
                '<td>' + (r.date || '—') + '</td>' +
                '<td>' + fmtWhen(r.updatedAt, r.date) + '</td>' +
                '<td>' + (PR_STAGE_LABEL[r.status] || r.status) + '</td>' +
                '<td>' + (r.decidedBy || '—') + '</td>' +
                '<td class="text-center">' + actions + '</td></tr>';
        }).join('');
    }

    // ── My MOA/MOU Submissions ─────────────────────────────────────────────────────────────────────────────────────
    // New submissions are Partnership Requests flagged isSubmission (already in myRequests). Submissions sent before that
    // change were saved as Document Requests of type "MOA/MOU Submission"; they are read-only history here.
    var MOA_MOU_LABEL = 'MOA/MOU Submission';
    var legacySubmissions = [];

    function loadLegacySubmissions() {
        return CIPRMS.api('/api/document-requests/mine', { quiet: true }).then(function (res) {
            if (!res.ok || !Array.isArray(res.data)) return false;
            legacySubmissions = res.data.filter(function (d) {
                return String(d.documentType || '').indexOf(MOA_MOU_LABEL) !== -1
                    || (Array.isArray(d.documentTypes) && d.documentTypes.indexOf(MOA_MOU_LABEL) !== -1);
            });
            renderMoaTable();
        });
    }

    function moaNotesCell(notes) {
        var t = String(notes || '').trim();
        if (!t) return '<span class="text-muted">—</span>';
        var short = t.length > 80 ? t.slice(0, 80) + '…' : t;
        return '<span title="' + escapeHtml(t) + '">' + escapeHtml(short) + '</span>';
    }

    function renderMoaTable() {
        var body = document.getElementById('moa-monitor-body');
        var pagEl = document.getElementById('moa-pagination');
        var current = submissionsOnly(myRequests).filter(function (r) { return r.status !== 'Draft'; });
        if (!current.length && !legacySubmissions.length) {
            body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No MOA/MOU submissions yet. Use <strong>New Submission</strong> to send CIRL your MOA/MOU files or notes.</td></tr>';
            if (pagEl) pagEl.innerHTML = '';
            return;
        }
        var allRows = [];
        current.forEach(function (r) {
            var files = (r.attachmentLink ? 1 : 0) + (r.supportingDocuments || []).length;
            var actions = '<button class="btn btn-sm btn-soft-info" onclick="openDetailsModal(' + r.id + ')" title="View files"><i class="ri-file-list-3-line me-1"></i>View</button>';
            allRows.push('<tr data-pr-id="' + r.id + '"' + (flashPRIds.has(r.id) ? ' class="rt-flash"' : '') + '>' +
                '<td>' + escapeHtml(r.institution || '—') + '</td>' +
                '<td>' + moaNotesCell(r.notes) + '</td>' +
                '<td>' + files + '</td>' +
                '<td><span class="badge table-pill ' + statusBadgeClass(r.status) + '">' + escapeHtml(r.status) + '</span></td>' +
                '<td>' + (r.date || '—') + '</td>' +
                '<td>' + fmtWhen(r.updatedAt, r.date) + '</td>' +
                '<td>' + escapeHtml(r.decidedBy || '—') + '</td>' +
                '<td class="text-center">' + actions + '</td></tr>');
        });
        legacySubmissions.forEach(function (d) {
            var cs = d.canonicalStatus || d.status;
            allRows.push('<tr>' +
                '<td>' + escapeHtml(d.institution || '—') + '</td>' +
                '<td>' + moaNotesCell(d.notes) + '</td>' +
                '<td>' + (d.supportingDocuments || []).length + '</td>' +
                '<td><span class="badge table-pill ' + statusBadgeClass(cs) + '">' + escapeHtml(cs) + '</span></td>' +
                '<td>' + (d.date || '—') + '</td>' +
                '<td>' + fmtWhen(d.updatedAt, d.date) + '</td>' +
                '<td>' + escapeHtml(d.decidedBy || '—') + '</td>' +
                '<td class="text-center"><span class="text-muted fs-12">Earlier submission</span></td></tr>');
        });
        var totalPages = Math.ceil(allRows.length / moaItemsPerPage);
        if (moaCurrentPage > totalPages) moaCurrentPage = totalPages || 1;
        var startIdx = (moaCurrentPage - 1) * moaItemsPerPage;
        var pageItems = allRows.slice(startIdx, startIdx + moaItemsPerPage);
        if (pagEl) pagEl.innerHTML = buildPaginationHtml(moaCurrentPage, totalPages, 'goToMoaPage');
        body.innerHTML = pageItems.join('');
    }

    // Pending -> "Pending", Under Review -> "In Progress", Approved -> "Approved"; Rejected and Withdrawn are both
    // "Closed" (decided without approval). The backend status names are unchanged - only this display grouping.
    function requestBuckets(list) {
        var b = { pending: 0, review: 0, approved: 0, closed: 0 };
        list.forEach(function (r) {
            if (r.status === 'Pending') b.pending++;
            else if (r.status === 'Under Review') b.review++;
            else if (r.status === 'Approved') b.approved++;
            else b.closed++;
        });
        return b;
    }

    function loadPRRequests(opts) {
        var live = !!(opts && opts.live);
        return CIPRMS.api('/api/requests/mine', { quiet: true }).then(function (res) {
            if (!res.ok || !Array.isArray(res.data)) {
                if (live) return false;   // a background refresh never wipes what is on screen (false = try again later)
                document.getElementById('pr-monitor-body').innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Failed to load requests.</td></tr>';
                document.getElementById('moa-monitor-body').innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Failed to load submissions.</td></tr>';
                return;
            }
            var requests = res.data;
            var previous = {};
            myRequests.forEach(function (r) { previous[r.id] = JSON.stringify(r); });
            flashPRIds = new Set(live ? requests.filter(function (r) { return previous[r.id] !== JSON.stringify(r); }).map(function (r) { return r.id; }) : []);
            myRequests = requests;
            var real = partnershipOnly(myRequests).filter(function (r) { return r.status !== 'Draft'; });

            // Every non-draft request falls in exactly ONE bucket, so Pending + In Progress + Approved + Closed
            // always equals Total. (In Progress used to lump Pending in with Under Review, the tiles showed
            // "Rejected" but never Pending or Withdrawn, so the tiles could not add up to the total.)
            var b = requestBuckets(real);
            setCount('cnt-total', real.length);
            setCount('cnt-progress', b.review);
            setCount('cnt-approved', b.approved);

            renderPRTable();
            renderMoaTable();
            flashPRIds = new Set();
            refreshOpenDraft();
            refreshOpenDetails();

            // (The Approval Progress panel was removed — it repeated the stat cards and the requests table.)

            return live ? undefined : openFromQuery();
        });
    }

    // A Details or Draft modal that is open on a request whose data just changed shows the new state.
    function refreshOpenDraft() {
        var el = document.getElementById('pr-draft-modal');
        if (!el || !el.classList.contains('show') || !currentDraftPRId) return;
        var r = myRequests.find(function (x) { return x.id === currentDraftPRId; });
        if (!r) return;
        renderDraftTimeline(r);
        var closed = ['Approved', 'Rejected', 'Withdrawn'].indexOf(r.status) !== -1;
        document.getElementById('pr-draft-upload-wrap').style.display = closed ? 'none' : '';
        document.getElementById('pr-draft-closed-note').style.display = closed ? '' : 'none';
    }

    function refreshOpenDetails() {
        var el = document.getElementById('pr-details-modal');
        if (!el || !el.classList.contains('show') || !currentDraftPRId) return;
        var r = myRequests.find(function (x) { return x.id === currentDraftPRId; });
        if (!r) return;
        populateDetailsSummary(r);
    }

    // Deep-link support so a notification ("Partnership Request Approved", etc.) can jump
    // straight to and highlight the matching row. Notification links for Document Requests
    // (type=dr) have no table on this page anymore and are simply ignored.
    function openFromQuery() {
        var params = new URLSearchParams(window.location.search);
        var id = params.get('id');
        if (!id || params.get('type') !== 'pr') return;
        var row = document.querySelector('#pr-monitor-body tr[data-pr-id="' + id + '"], #moa-monitor-body tr[data-pr-id="' + id + '"]');
        if (!row) return;
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.classList.add('table-warning');
        setTimeout(function () { row.classList.remove('table-warning'); }, 3000);
    }

    // "Documents on File" stat card only — the Document Verification table was removed from this page.
    function refreshDocCount() {
        return CIPRMS.api('/api/documents/mine', { quiet: true }).then(function (res) {
            if (!res.ok) return false;
            setCount('cnt-docs', Array.isArray(res.data) ? res.data.length : 0);
        });
    }
    refreshDocCount();

    var myPartnerships = [];

    function loadRenewalStatus(opts) {
        var live = !!(opts && opts.live);
        return Promise.all([
            CIPRMS.api('/api/partnerships/mine', { quiet: true }),
            CIPRMS.api('/api/requests/mine', { quiet: true })
        ]).then(function (results) {
            var box = document.getElementById('renewal-status-body');
            if (!results[0].ok || !results[1].ok) {
                if (!live) box.innerHTML = '<p class="text-danger text-center py-3 mb-0">Failed to load renewal status.</p>';
                return live ? false : undefined;
            }
            var partnerships = Array.isArray(results[0].data) ? results[0].data : [];
            var reqs = Array.isArray(results[1].data) ? results[1].data : [];
            myPartnerships = partnerships;

            // Partnerships that already have a renewal request awaiting a decision.
            var pendingRenewalIds = new Set(
                reqs
                    .filter(function (r) { return r.isRenewal && (r.status === 'Pending' || r.status === 'Under Review'); })
                    .map(function (r) { return r.renewalPartnershipId; })
            );

            if (partnerships.length === 0) {
                box.innerHTML = '<p class="text-muted text-center py-3 mb-0">No active partnership record is linked to your account yet. Once an approved request becomes an official partnership, its renewal status will appear here.</p>';
                return;
            }
            // Full-width table with the same columns as the Monitoring Partnership Registry
            // (Institution, Country/Region, Nature, Start, End, Days Left, Status) plus the renewal action.
            var rows = partnerships.map(function (p) {
                var status = p.status || 'Unknown';
                var badge = status === 'Expired' ? 'bg-danger-subtle text-danger' : status === 'Expiring Soon' ? 'bg-expiring-subtle text-expiring' : status === 'Active' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary';
                var inst = p.inst || p.institution || '';
                var nature = Array.isArray(p.nature) ? p.nature.join(', ') : (p.nature || '');
                var endDate = new Date(p.end);
                var days = isNaN(endDate) ? null : Math.ceil((endDate - new Date()) / 86400000);
                var daysHtml = status === 'Expired' ? '<span class="badge table-pill bg-danger-subtle text-danger">Expired</span>'
                    : days === null ? '—'
                    : days <= 14 ? '<span class="badge table-pill bg-danger">Critical (' + days + 'd)</span>'
                    : days <= 90 ? '<span class="badge table-pill bg-expiring-subtle text-expiring">' + days + ' days</span>'
                    : '<span class="badge table-pill bg-success-subtle text-success">' + days + ' days</span>';
                var endColor = status === 'Expired' ? '#dc2626' : status === 'Expiring Soon' ? '#ea580c' : '#15803d';
                var actionHtml = pendingRenewalIds.has(p.id)
                    ? '<span class="badge bg-info-subtle text-info fs-13 px-3 py-2">Renewal Requested</span>'
                    : '<button class="btn btn-primary text-nowrap px-4" onclick="openRenewalModal(' + p.id + ')"><i class="ri-refresh-line me-1"></i>Request Renewal</button>';
                return '<tr>' +
                    '<td class="fw-medium">' + escapeHtml(inst) + '</td>' +
                    '<td>' + escapeHtml(p.country || '—') + (p.region ? '<div class="text-muted fs-11"><i class="ri-map-pin-line me-1"></i>' + escapeHtml(p.region) + '</div>' : '') + '</td>' +
                    '<td>' + escapeHtml(nature || '—') + '</td>' +
                    '<td class="text-nowrap">' + escapeHtml(p.start || '—') + '</td>' +
                    '<td class="text-nowrap"><span style="color:' + endColor + ';font-weight:600">' + escapeHtml(p.end || '—') + '</span></td>' +
                    '<td>' + daysHtml + '</td>' +
                    '<td><span class="badge table-pill ' + badge + '">' + escapeHtml(status) + '</span></td>' +
                    '<td class="text-center">' + actionHtml + '</td>' +
                    '</tr>';
            }).join('');
            box.innerHTML = '<div class="table-responsive"><table class="table table-bordered align-middle mb-0 w-100">' +
                '<thead class="table-light"><tr>' +
                '<th style="width:14%">Institution</th><th style="width:13%">Country/Region</th><th style="width:12%">Nature</th>' +
                '<th style="width:10%">Start</th><th style="width:10%">End</th><th style="width:10%">Days Left</th>' +
                '<th style="width:10%">Status</th><th class="text-center" style="width:21%">Renewal</th>' +
                '</tr></thead><tbody>' + rows + '</tbody></table></div>';
        });
    }
    loadRenewalStatus();

    var renewalModal = null;
    var renewingPartnershipId = null;

    function openRenewalModal(id) {
        var p = myPartnerships.find(function (x) { return x.id === id; });
        if (!p) return;
        renewingPartnershipId = id;
        document.getElementById('rr-institution').textContent = p.inst || p.institution || '';
        document.getElementById('rr-current-end').textContent = p.end || '—';
        document.getElementById('rr-end-date').value = '';
        document.getElementById('rr-notes').value = '';
        document.getElementById('rr-error').classList.add('d-none');
        setBreadcrumb(['Monitoring', p.inst || p.institution || ('Partnership #' + id), 'Request Renewal']);
        if (!renewalModal) renewalModal = new bootstrap.Modal(document.getElementById('renewal-request-modal'));
        renewalModal.show();
    }

    function submitRenewalRequest() {
        if (!renewingPartnershipId) return;
        var endDate = document.getElementById('rr-end-date').value;
        var notes = document.getElementById('rr-notes').value.trim();
        var errBox = document.getElementById('rr-error');
        errBox.classList.add('d-none');

        if (!endDate) {
            errBox.textContent = 'Please choose a proposed new end date.';
            errBox.classList.remove('d-none');
            return;
        }

        var btn = document.getElementById('rr-submit-btn');
        return CIPRMS.busy(btn, function () {
            return CIPRMS.api('/api/partnerships/' + renewingPartnershipId + '/renew-request', {
                method: 'POST', json: { proposedEndDate: endDate, notes: notes }, quiet: true
            }).then(function (res) {
                if (res.ok) {
                    renewalModal.hide();
                    showToast('Renewal request submitted.', '#15803d');
                    return Promise.all([loadPRRequests({ live: true }), loadRenewalStatus({ live: true })]);
                }
                errBox.textContent = res.error || 'Failed to submit renewal request.';
                errBox.classList.remove('d-none');
                if (res.status === 409 || res.status === 404) return loadRenewalStatus({ live: true });   // the card was stale
            });
        }, 'Submitting…');
    }

    loadPRRequests();
    loadLegacySubmissions();
    // Live updates: CIRL reviewed / approved / rejected one of my requests or submissions, or the registry record behind
    // one changed. The server is asked again for the real data (counters, Approval Progress, table rows and the renewal
    // card are all recomputed from it) — nothing here is calculated from the event itself.
    if (window.CIPRMS && CIPRMS.live) {
        CIPRMS.live(['request.updated', 'request.statusChanged', 'documentRequest.updated', 'documentRequest.statusChanged', 'partnership.updated', 'partnership.statusChanged'], function () {
            return Promise.all([loadPRRequests({ live: true }), loadLegacySubmissions(), loadRenewalStatus({ live: true }), refreshDocCount()]).then(function (r) { return r.indexOf(false) === -1; });
        }, { debounce: 250 });
    }
</script>
</body>
</html>
