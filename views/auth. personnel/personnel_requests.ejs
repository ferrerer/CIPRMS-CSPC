                    </div>
                </div><!-- end panel-cdr -->

            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6">
                        <script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL
                    </div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>


<div id="req-toast"></div>

<!-- ═══════ COLLEGE REQUESTS: DETAIL / SUBMIT MODAL (2026-11 follow-up) ═══════ -->
<div class="modal fade" id="cdr-detail-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="cdr-d-title"><i class="ri-award-line me-2 text-primary"></i>Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="cdr-d-body">
        <!-- populated by cdrOpenDetail() -->
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<!-- JAVASCRIPT -->
<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>

<script>
    function showToast(msg, color) {
        const t = document.getElementById('req-toast');
        t.style.background = color || '#405189'; t.style.opacity = '1'; t.innerHTML = msg;
        setTimeout(() => t.style.opacity = '0', 3000);
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    /* ═══════════════════════════════════════════════════
       DOCUMENT REQUEST — same /api/document-requests
       endpoint; tracking/detail-view live on
       /personnel/monitoring, not this page.
       ═══════════════════════════════════════════════════ */
    var DOC_TYPE_SUGGESTIONS = [
        'Compliance requirements for international linkages and consortia (MAN)',
        'MOA',
        'MOU',
        'Photos/Docs - IMC Japan',
        'Terminal Reports (International Activity); Year end report of activities',
        'QS Star Rating result',
        'Handbook or manual regarding student participation on internationalization',
        'International Linkages; International students/faculty'
    ];

    /* Searchable multi-select combobox: predefined suggestions + free-text
       custom entries, rendered as removable chips. Mounted on
       #<prefix>-combo / #<prefix>-chips / #<prefix>-input / #<prefix>-dropdown. */
    function createDocCombo(prefix, onChange) {
        var selected = [];
        var chips = document.getElementById(prefix + '-chips');
        var input = document.getElementById(prefix + '-input');
        var dropdown = document.getElementById(prefix + '-dropdown');

        function renderChips() {
            chips.innerHTML = selected.map(function (val, i) {
                return '<span class="doc-chip"><span class="doc-chip-label">' + escapeHtml(val) + '</span>' +
                    '<button type="button" data-i="' + i + '" aria-label="Remove">&times;</button></span>';
            }).join('');
            chips.querySelectorAll('button').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    selected.splice(parseInt(btn.getAttribute('data-i'), 10), 1);
                    renderChips();
                    input.classList.remove('is-invalid');
                });
            });
            if (onChange) onChange();
        }

        function addValue(raw) {
            var val = (raw || '').trim();
            if (!val) return;
            var existingIdx = selected.findIndex(function (v) { return v.toLowerCase() === val.toLowerCase(); });
            if (existingIdx !== -1) { input.value = ''; closeDropdown(); return; }
            var canonical = DOC_TYPE_SUGGESTIONS.find(function (s) { return s.toLowerCase() === val.toLowerCase(); });
            selected.push(canonical || val);
            renderChips();
            input.value = '';
            input.classList.remove('is-invalid');
            closeDropdown();
            input.focus();
            if (onChange) onChange();   // renderChips() above ran while the typed text was still in the field
        }

        function closeDropdown() {
            dropdown.style.display = 'none';
            dropdown.innerHTML = '';
            input.setAttribute('aria-expanded', 'false');
        }

        function openDropdown() {
            var q = input.value.trim().toLowerCase();
            var available = DOC_TYPE_SUGGESTIONS.filter(function (s) {
                return !selected.some(function (v) { return v.toLowerCase() === s.toLowerCase(); });
            });
            var matches = q ? available.filter(function (s) { return s.toLowerCase().indexOf(q) !== -1; }) : available;
            var exact = q && available.some(function (s) { return s.toLowerCase() === q; });

            var html = matches.map(function (s) {
                return '<div class="doc-combo-option" data-val="' + escapeHtml(s) + '">' + escapeHtml(s) + '</div>';
            }).join('');
            if (q && !exact) {
                html += '<div class="doc-combo-option custom" data-val="' + escapeHtml(input.value.trim()) + '">' +
                    '<i class="ri-add-line"></i> Add "' + escapeHtml(input.value.trim()) + '"' +
                    '<span class="doc-combo-option-hint">Custom</span></div>';
            }
            if (!html) html = '<div class="doc-combo-empty">No matching suggestions — keep typing to add a custom document.</div>';
            dropdown.innerHTML = html;
            dropdown.style.display = 'block';
            input.setAttribute('aria-expanded', 'true');
            dropdown.querySelectorAll('.doc-combo-option').forEach(function (opt) {
                opt.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    addValue(opt.getAttribute('data-val'));
                });
            });
        }

        input.addEventListener('focus', openDropdown);
        input.addEventListener('input', openDropdown);
        // "focus" only fires when the field GAINS focus. After a document is picked (or Escape is pressed) the field
        // keeps focus, so clicking it again fired nothing and the list only came back after clicking somewhere else
        // and then into the field. A click, or the Down arrow, opens it whenever it is closed.
        input.addEventListener('click', openDropdown);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (input.value.trim()) addValue(input.value);
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                openDropdown();
            } else if (e.key === 'Backspace' && !input.value && selected.length) {
                selected.pop();
                renderChips();
            } else if (e.key === 'Escape') {
                closeDropdown();
            }
        });
        input.addEventListener('blur', function () { setTimeout(closeDropdown, 120); });

        return {
            getValues: function () { return selected.slice(); },
            hasText: function () { return !!input.value.trim(); },
            clear: function () { selected = []; input.value = ''; renderChips(); closeDropdown(); },
            markInvalid: function () { input.classList.add('is-invalid'); },
            clearInvalid: function () { input.classList.remove('is-invalid'); }
        };
    }

    // Clear only exists while someone is filling the form in: it appears as soon as anything is entered (a picked or
    // typed document, purpose, contact number, document form, or an office the person typed themselves) and goes away
    // again when the form is empty — after Clear, after a successful submit, or when they delete what they typed. The
    // office pre-filled from the profile and the contact number pre-filled from Settings are not something they entered
    // here, so they never count (a contact number only counts once it differs from the pre-filled one).
    function formHasInput() {
        var inst = document.getElementById('f-inst');
        var contact = document.getElementById('f-contact');
        return fTypeCombo.getValues().length > 0
            || fTypeCombo.hasText()
            || !!(inst && inst.type !== 'hidden' && inst.value.trim())
            || contact.value.trim() !== (contact.defaultValue || '').trim()
            || !!document.getElementById('f-notes').value.trim()
            || !!document.querySelector('input[name="f-form"]:checked');
    }
    function syncClearButton() {
        var btn = document.getElementById('clear-req-btn');
        if (btn) btn.style.display = formHasInput() ? '' : 'none';
        // Once the requestor starts a new request, the previous "submitted successfully" banner no longer applies.
        hideSuccessBanner();
    }

    function showSuccessBanner() {
        var el = document.getElementById('dr-success-banner');
        if (el) el.classList.remove('d-none');
    }
    function hideSuccessBanner() {
        var el = document.getElementById('dr-success-banner');
        if (el && !el.classList.contains('d-none')) el.classList.add('d-none');
    }

    var fTypeCombo = createDocCombo('f-type', syncClearButton);
    var docForm = document.getElementById('docRequestForm');
    docForm.addEventListener('input', syncClearButton);
    docForm.addEventListener('change', syncClearButton);

    function resetForm() {
        document.getElementById('docRequestForm').reset();
        fTypeCombo.clear();
        syncClearButton();
    }

    function setDrDateTimeDisplay() {
        var el = document.getElementById('f-datetime-display');
        if (el) el.textContent = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    }
    setDrDateTimeDisplay();

    // Contact No. — digits and basic phone punctuation only, no letters.
    // Warn (rather than silently strip) so the user sees why what they
    // typed didn't show up.
    var fContactEl = document.getElementById('f-contact');
    var fContactWarnEl = document.getElementById('f-contact-warn');
    if (fContactEl) {
        fContactEl.addEventListener('input', function () {
            var cleaned = this.value.replace(/[^0-9+()\-\s]/g, '');
            if (fContactWarnEl) fContactWarnEl.style.display = cleaned !== this.value ? '' : 'none';
            this.value = cleaned;
        });
    }

    function submitRequest() {
        const inst = document.getElementById('f-inst').value.trim();
        const documentTypes = fTypeCombo.getValues();
        const notes = document.getElementById('f-notes').value.trim();
        const contactNumber = document.getElementById('f-contact').value.trim();
        const documentFormEl = document.querySelector('input[name="f-form"]:checked');
        const documentForm = documentFormEl ? documentFormEl.value : '';

        if (!inst || documentTypes.length === 0) {
            showToast('<i class="ri-error-warning-line me-2"></i> Please fill in all required fields.', '#e0a800');
            if (!inst) document.getElementById('f-inst').classList.add('is-invalid');
            if (documentTypes.length === 0) fTypeCombo.markInvalid();
            return;
        }

        document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

        const btn = document.getElementById('submit-req-btn');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="ri-loader-4-line ai-spin me-2"></i> Submitting...';

        // Through the shared helper: a timeout, a dropped connection or an expired session gets a plain message.
        // (The button above is already disabled, so a double click cannot submit twice.)
        CIPRMS.api('/api/document-requests', {
            method: 'POST', json: { institution: inst, documentTypes, notes, contactNumber, documentForm }, quiet: true
        }).then(res => ({ ok: res.ok, data: res.ok ? res.data : { error: res.error } }))
        .then(({ ok, data }) => {
            btn.disabled = false;
            btn.innerHTML = orig;
            if (ok && data.success) {
                showToast('<i class="ri-checkbox-circle-line me-2"></i> Document request submitted!', '#15803d');
                document.getElementById('docRequestForm').reset();
                fTypeCombo.clear();
                syncClearButton();
                showSuccessBanner();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                showToast('<i class="ri-error-warning-line me-2"></i> ' + (data.error || 'Error submitting request.'), '#f06548');
            }
        }).catch(e => {
            console.error(e);
            btn.disabled = false;
            btn.innerHTML = orig;
            showToast('<i class="ri-error-warning-line me-2"></i> Error submitting request.', '#f06548');
        });
    }

    // ── Section switcher: Document Request | Submission of Approved MOA/MOU | College Requests ──
    function switchSection(sec) {
        document.getElementById('panel-dr').style.display = sec === 'dr' ? '' : 'none';
        document.getElementById('panel-moa').style.display = sec === 'moa' ? '' : 'none';
        document.getElementById('panel-cdr').style.display = sec === 'cdr' ? '' : 'none';
        document.getElementById('tab-dr').classList.toggle('active', sec === 'dr');
        document.getElementById('tab-moa').classList.toggle('active', sec === 'moa');
        document.getElementById('tab-cdr').classList.toggle('active', sec === 'cdr');
    }
    // /personnel/requests?tab=moa opens the MOA/MOU tab directly (the Monitoring page links here).
    // /personnel/requests?open=cdr&id=... is the notification deep-link convention shared with the
    // Administrator/Staff Requests pages (cdrLinkForRole in cirl.js) and with the old
    // /personnel/college-requests?id=... bookmarks, which now redirect here.
    (function () {
        var params = new URLSearchParams(window.location.search);
        // Always load the College Requests tab's data up front (same convention as the Administrator/Staff
        // Requests pages' own init()), so it's ready whether the Dean lands here directly or clicks the tab
        // later — not only when arriving via the ?open=cdr deep link below.
        var cdrReady = cdrLoadList();
        if (params.get('open') === 'cdr') {
            switchSection('cdr');
            cdrReady.then(function () {
                var id = params.get('id');
                if (id) cdrOpenDetail(parseInt(id));
            });
        } else if (params.get('tab') === 'moa') {
            switchSection('moa');
        }
    })();

    /* ═══ COLLEGE REQUESTS (2026-11 follow-up) — ported from the former standalone
       views/auth. personnel/college_requests.ejs page. Reuses this page's own escapeHtml()/showToast()
       (targets #req-toast) rather than redeclaring them. Only view/submit/resubmit actions are ever
       rendered here — accept/return are Administrator/Staff-only and enforced server-side regardless. ═══ */
    var CDR_BADGE = {
        'Pending': 'bg-secondary-subtle text-secondary',
        'Submitted': 'bg-info-subtle text-info',
        'Returned for Revision': 'bg-warning-subtle text-warning',
        'Completed': 'bg-success-subtle text-success'
    };
    function cdrBadge(status) {
        return '<span class="badge ' + (CDR_BADGE[status] || 'bg-secondary-subtle text-secondary') + '">' + escapeHtml(status) + '</span>';
    }
    function cdrFmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        return isNaN(d) ? escapeHtml(iso) : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    var CDR_ALL = [];
    var CDR_ACTIVE_FILTER = 'all';

    function cdrRenderTable() {
        var rows = CDR_ACTIVE_FILTER === 'all' ? CDR_ALL : CDR_ALL.filter(function (r) { return r.status === CDR_ACTIVE_FILTER; });
        var body = document.getElementById('cdr-table-body');
        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No college requests assigned to you yet.</td></tr>';
            return;
        }
        body.innerHTML = rows.map(function (r) {
            return '<tr>' +
                '<td><strong>' + escapeHtml(r.title) + '</strong></td>' +
                '<td>' + escapeHtml(r.requestType) + '</td>' +
                '<td>' + (r.deadline ? cdrFmtDate(r.deadline) : '<span class="text-muted">—</span>') + '</td>' +
                '<td>' + cdrBadge(r.status) + '</td>' +
                '<td class="text-end"><button class="btn btn-sm btn-soft-primary" onclick="cdrOpenDetail(' + r.id + ')"><i class="ri-eye-line"></i> View</button></td>' +
                '</tr>';
        }).join('');
    }

    function cdrFilterBy(status, el) {
        CDR_ACTIVE_FILTER = status;
        document.querySelectorAll('.cdr-filter-tab').forEach(function (t) { t.classList.remove('active'); });
        el.classList.add('active');
        cdrRenderTable();
    }

    function cdrLoadList() {
        return fetch('/api/college-requests', { headers: { 'X-Requested-With': 'ciprms' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                CDR_ALL = Array.isArray(data) ? data : [];
                cdrRenderTable();
            })
            .catch(function () {
                document.getElementById('cdr-table-body').innerHTML =
                    '<tr><td colspan="5" class="text-center text-danger py-4">Unable to load your college requests.</td></tr>';
            });
    }

    function cdrHistoryHtml(history) {
        if (!history || !history.length) return '<p class="text-muted mb-0">No history yet.</p>';
        return history.slice().reverse().map(function (h) {
            return '<div class="cdr-history-item"><strong>' + escapeHtml(h.to) + '</strong> — ' + cdrFmtDate(h.at) +
                '<br><span class="text-muted">by ' + escapeHtml(h.by || 'System') + (h.remark ? ': ' + escapeHtml(h.remark) : '') + '</span></div>';
        }).join('');
    }

    function cdrDocListHtml(docs, emptyLabel) {
        if (!docs || !docs.length) return '<p class="text-muted mb-0">' + emptyLabel + '</p>';
        return docs.map(function (d) {
            var label = d.originalFilename || (d.note ? 'Note only' : 'Attachment');
            return '<div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2">' +
                '<div><i class="ri-file-line me-1"></i>' + escapeHtml(label) +
                (d.note ? '<div class="text-muted small">' + escapeHtml(d.note) + '</div>' : '') + '</div>' +
                (d.fileLink ? '<a class="btn btn-sm btn-soft-secondary" href="' + d.fileLink + '" target="_blank"><i class="ri-download-2-line"></i></a>' : '') +
                '</div>';
        }).join('');
    }

    function cdrOpenDetail(id) {
        fetch('/api/college-requests/' + id, { headers: { 'X-Requested-With': 'ciprms' } })
            .then(function (r) { return r.json(); })
            .then(function (r) {
                var canSubmit = r.status === 'Pending' || r.status === 'Returned for Revision';
                var required = (r.requiredDocuments || []).map(function (d) { return '<span class="cdr-doc-chip">' + escapeHtml(d) + '</span>'; }).join('') || '<span class="text-muted">None specified</span>';
                document.getElementById('cdr-d-title').innerHTML = '<i class="ri-award-line me-2 text-primary"></i>' + escapeHtml(r.title);
                document.getElementById('cdr-d-body').innerHTML =
                    '<div class="mb-3 d-flex gap-2 flex-wrap">' + cdrBadge(r.status) +
                        '<span class="badge bg-light text-dark border">' + escapeHtml(r.requestType) + '</span>' +
                        (r.deadline ? '<span class="badge bg-light text-dark border"><i class="ri-calendar-line"></i> Due ' + cdrFmtDate(r.deadline) + '</span>' : '') +
                    '</div>' +
                    '<p class="mb-1"><strong>From:</strong> ' + escapeHtml(r.createdBy) + '</p>' +
                    (r.instructions ? '<p class="mb-1"><strong>Instructions:</strong><br>' + escapeHtml(r.instructions).replace(/\n/g, '<br>') + '</p>' : '') +
                    (r.description ? '<p class="mb-3"><strong>Description:</strong><br>' + escapeHtml(r.description).replace(/\n/g, '<br>') + '</p>' : '') +
                    '<p class="mb-1"><strong>Required Documents</strong></p><div class="mb-3">' + required + '</div>' +
                    (r.status === 'Returned for Revision' && r.reviewRemark ? '<div class="alert alert-warning"><strong>Returned for revision:</strong> ' + escapeHtml(r.reviewRemark) + '</div>' : '') +
                    (r.status === 'Completed' ? '<div class="alert alert-success"><i class="ri-checkbox-circle-line me-1"></i> This request has been accepted.</div>' : '') +
                    '<p class="mb-1 mt-3"><strong>Reference Documents</strong> <span class="text-muted">(provided by ' + escapeHtml(r.createdBy) + ')</span></p>' + cdrDocListHtml(r.referenceDocuments, 'No reference documents were attached.') +
                    '<p class="mb-1 mt-3"><strong>Your Submissions</strong></p>' + cdrDocListHtml(r.submittedDocuments, 'You have not submitted anything yet.') +
                    (canSubmit ? (
                        '<div class="border rounded p-3 mt-3 bg-light-subtle">' +
                        '<p class="mb-2"><strong>' + (r.status === 'Returned for Revision' ? 'Resubmit' : 'Submit') + ' Documents</strong></p>' +
                        '<input type="file" class="form-control mb-2" id="cdr-sub-file">' +
                        '<textarea class="form-control mb-2" id="cdr-sub-note" rows="2" placeholder="Note (optional if attaching a file)"></textarea>' +
                        '<button class="btn btn-primary w-100" onclick="cdrSubmitDocuments(' + r.id + ')"><i class="ri-upload-cloud-2-line me-1"></i> ' + (r.status === 'Returned for Revision' ? 'Resubmit' : 'Submit') + '</button>' +
                        '</div>'
                    ) : '') +
                    '<p class="mb-1 mt-3"><strong>History</strong></p>' + cdrHistoryHtml(r.statusHistory);

                bootstrap.Modal.getOrCreateInstance(document.getElementById('cdr-detail-modal')).show();
            })
            .catch(function () { showToast('<i class="ri-error-warning-line me-2"></i> Unable to load this request.', '#f06548'); });
    }

    function cdrSubmitDocuments(id) {
        var fileInput = document.getElementById('cdr-sub-file');
        var note = document.getElementById('cdr-sub-note').value.trim();
        if (!fileInput.files.length && !note) { showToast('<i class="ri-error-warning-line me-2"></i> Attach a file, add a note, or both.', '#f7b84b'); return; }
        var fd = new FormData();
        if (fileInput.files.length) fd.append('document', fileInput.files[0]);
        fd.append('note', note);
        fetch('/api/college-requests/' + id + '/documents', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'ciprms' } })
            .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
            .then(function (res) {
                if (!res.ok) { showToast('<i class="ri-error-warning-line me-2"></i> ' + (res.body.error || 'Submission failed.'), '#f06548'); return; }
                showToast('<i class="ri-checkbox-circle-line me-2"></i> Submitted successfully.', '#15803d');
                bootstrap.Modal.getInstance(document.getElementById('cdr-detail-modal')).hide();
                cdrLoadList();
            })
            .catch(function () { showToast('<i class="ri-error-warning-line me-2"></i> Network error during submission.', '#f06548'); });
    }

    /* ═══ SUBMISSION OF APPROVED MOA/MOU — College Partnership Report (2026-09-26) ═══
       Filed as a Partnership Request with isCollegeReport (POST /api/requests), then the approved copy is attached
       (POST /api/requests/:id/documents, initial=1). CIRL records it in the Registry; the Dean tracks it on Monitoring. */
    var CR_MAX_BYTES = 10 * 1024 * 1024;
    var crPendingUploadId = null;   // a report that was created but whose file upload failed — Send retries only the upload

    function matchCountryOption(raw) {
        var q = String(raw || '').trim().toLowerCase();
        if (!q || typeof COUNTRY_OPTIONS === 'undefined') return null;
        return COUNTRY_OPTIONS.find(function (c) { return c.toLowerCase() === q; }) || null;
    }
    (function initCountrySearch() {
        var input = document.getElementById('cr-country');
        var dropdown = document.getElementById('cr-country-dropdown');
        if (!input || !dropdown || typeof COUNTRY_OPTIONS === 'undefined') return;
        var blurTimer = null;
        function close() { dropdown.style.display = 'none'; dropdown.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); }
        function pick(v) { input.value = v; input.classList.remove('is-invalid'); close(); }
        function open() {
            if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
            var q = input.value.trim().toLowerCase();
            var list = (q && !matchCountryOption(q)) ? COUNTRY_OPTIONS.filter(function (c) { return c.toLowerCase().indexOf(q) !== -1; }) : COUNTRY_OPTIONS;
            dropdown.innerHTML = list.length
                ? list.map(function (c) { return '<div class="cr-country-option" data-val="' + escapeHtml(c) + '">' + escapeHtml(c) + '</div>'; }).join('')
                : '<div class="cr-country-empty">No matching country.</div>';
            dropdown.style.display = 'block';
            input.setAttribute('aria-expanded', 'true');
            dropdown.querySelectorAll('.cr-country-option').forEach(function (o) {
                o.addEventListener('mousedown', function (e) { e.preventDefault(); pick(o.getAttribute('data-val')); });
            });
        }
        input.addEventListener('focus', open);
        input.addEventListener('click', open);
        input.addEventListener('input', open);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var q = input.value.trim().toUpperCase();
                var m = COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase() === q; }) || COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase().indexOf(q) === 0; });
                if (m) pick(m);
            } else if (e.key === 'Escape' && dropdown.style.display === 'block') {
                e.stopPropagation();
                close();
            }
        });
        input.addEventListener('blur', function () {
            blurTimer = setTimeout(function () {
                close();
                var m = matchCountryOption(input.value);
                if (m) input.value = m;
                input.classList.toggle('is-invalid', !!input.value.trim() && !m);
            }, 120);
        });
        document.addEventListener('click', function (e) { if (e.target !== input && !dropdown.contains(e.target)) close(); });
    })();

    function resetCollegeReportForm() {
        ['cr-inst', 'cr-country', 'cr-type', 'cr-nature', 'cr-start', 'cr-end', 'cr-notes', 'cr-file'].forEach(function (id) { document.getElementById(id).value = ''; });
        document.querySelectorAll('#panel-moa .is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
    }

    function submitCollegeReport() {
        var v = function (id) { return document.getElementById(id).value.trim(); };
        var fileEl = document.getElementById('cr-file');
        var file = fileEl.files[0] || null;
        var bad = function (id, msg) { document.getElementById(id).classList.add('is-invalid'); showToast('<i class="ri-error-warning-line me-2"></i> ' + msg, '#f06548'); };
        document.querySelectorAll('#panel-moa .is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
        document.getElementById('cr-success-banner').classList.add('d-none');

        var missing = ['cr-inst', 'cr-country', 'cr-type', 'cr-nature', 'cr-start', 'cr-end'].filter(function (id) { return !v(id); });
        if (!file) missing.push('cr-file');
        if (missing.length) {
            missing.forEach(function (id) { document.getElementById(id).classList.add('is-invalid'); });
            showToast('<i class="ri-error-warning-line me-2"></i> Please fill in every required field and attach the approved copy.', '#f06548');
            return;
        }
        var country = matchCountryOption(v('cr-country'));
        if (!country) return bad('cr-country', 'Please select a country from the list.');
        if (new Date(v('cr-end')) <= new Date(v('cr-start'))) return bad('cr-end', 'The expiry date must be after the effective date.');
        if (file.size > CR_MAX_BYTES) return bad('cr-file', 'That file is too large. The maximum size is 10MB.');
        if (!/\.(pdf|jpe?g|png)$/i.test(file.name)) return bad('cr-file', 'Only PDF, JPG or PNG files are accepted.');

        var btn = document.getElementById('cr-submit-btn');
        var orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending…';

        var create = crPendingUploadId
            ? Promise.resolve(crPendingUploadId)
            : CIPRMS.api('/api/requests', {
                method: 'POST', quiet: true,
                json: {
                    isCollegeReport: true, institution: v('cr-inst'), country: country, type: v('cr-type'), nature: v('cr-nature'),
                    startDate: v('cr-start'), endDate: v('cr-end'), notes: v('cr-notes')
                }
            }).then(function (res) {
                if (!res.ok) throw new Error(res.error || 'Could not send the report.');
                return res.data.request.id;
            });

        create.then(function (id) {
            var fd = new FormData();
            fd.append('document', file);
            fd.append('initial', '1');
            fd.append('note', 'Approved copy');
            return CIPRMS.api('/api/requests/' + id + '/documents', { method: 'POST', body: fd, quiet: true }).then(function (res) {
                if (!res.ok) { var err = new Error(res.error || 'Upload failed.'); err.uploadStep = true; err.requestId = id; throw err; }
                return id;
            });
        }).then(function (id) {
            crPendingUploadId = null;
            resetCollegeReportForm();
            document.getElementById('cr-success-text').textContent = 'Reference #REQ-' + String(id).padStart(3, '0') + '. You will be notified once CIRL records it in the Partnership Registry.';
            document.getElementById('cr-success-banner').classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }).catch(function (e) {
            if (e && e.uploadStep) {
                crPendingUploadId = e.requestId;
                showToast('<i class="ri-error-warning-line me-2"></i> The report was sent, but the file could not be uploaded: ' + escapeHtml(e.message) + ' Choose the file again and click Send.', '#f7b84b');
            } else {
                showToast('<i class="ri-error-warning-line me-2"></i> ' + escapeHtml((e && e.message) || 'Could not send the report.'), '#f06548');
            }
        }).then(function () { btn.disabled = false; btn.innerHTML = orig; });
    }

</script>
