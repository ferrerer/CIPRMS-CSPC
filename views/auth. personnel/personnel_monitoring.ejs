                        </div>
                        <h5 class="mb-2" id="dr-cancel-title">Cancel this request?</h5>
                        <p class="text-muted mb-0">This document request will be withdrawn and CIRL will no longer process it. This cannot be undone.</p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep Request</button>
                        <button type="button" class="btn btn-danger" id="dr-cancel-confirm-btn"><i class="ri-close-circle-line me-1"></i>Yes, Cancel It</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document Request Details Modal -->
        <div class="modal fade" id="dr-detail-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
