<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Document Library | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <!-- Bootstrap Css -->
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css -->
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- Custom Css -->
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- CIPRMS bridge Css (global header search sizing, dropdown overflow and dark-mode rules) -->
    <link href="/velzon/assets/css/ciprms-bridge.css?v=20260925d" rel="stylesheet" />
    <style>
        .doc-card { transition: all 0.2s; border: 1px solid #e9ebec !important; }
        .doc-card:hover { transform: translateY(-3px); border-color: #405189 !important; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .ocr-spinner { display: none; margin: 20px auto; }
        .extracted-data { display: none; }
        .folder-list .list-group-item { border: none; padding: 0.6rem 1.25rem; transition: all 0.2s; display: flex; align-items: center; }
        .folder-list .list-group-item:hover { background-color: #f3f6f9; }
        .folder-list .list-group-item.active { background-color: #e2e5ed; color: #405189; font-weight: 600; }
        .folder-list .list-group-item i.folder-icon { font-size: 16px; width: 24px; }
        .folder-actions { display: none; white-space: nowrap; }
        .folder-list .list-group-item:hover .folder-actions { display: inline-block; }
        .folder-actions i { cursor: pointer; padding: 2px 4px; }
        .folder-actions i:hover { color: #405189; }
        .stat-box { padding: 12px; border: 1px solid #e9ebec; border-radius: 8px; text-center: center; }
        .tag-pills-container { overflow-x: auto; white-space: nowrap; padding-bottom: 5px; }
        .tag-pill { margin-right: 8px; cursor: pointer; }

        /* ── Document Library — Upload & OCR Extraction Modal Sizing ──
           Substantially enlarged modal matching CIPRMS Monitoring (Add New Partnership modal-xl)
           and Requests (Partnership & Document Requests Review / Draft View modals).
           Spacious, centered, responsive width/height, body scrolling, never full-screen. */
        @media (min-width: 992px) {
            #uploadModal .modal-dialog {
                --vz-modal-width: 960px;
                max-width: 960px;
            }
        }
        @media (min-width: 1200px) {
            #uploadModal .modal-dialog {
                --vz-modal-width: 1080px;
                max-width: 1080px;
            }
        }
        @media (min-width: 1400px) {
            #uploadModal .modal-dialog {
                --vz-modal-width: 1140px;
                max-width: 1140px;
            }
        }
        #uploadModal .modal-content {
            max-height: calc(100vh - 3.5rem);
            display: flex;
            flex-direction: column;
            border-radius: 0.5rem;
            overflow: hidden;
        }
        #uploadModal .modal-header {
            padding: 1.1rem 1.75rem;
            flex-shrink: 0;
            border-bottom: 1px solid var(--vz-border-color, #e9ebec);
        }
        #uploadModal .modal-title {
            min-width: 0;
            overflow-wrap: anywhere;
        }
        #uploadModal .modal-header .btn-close {
            flex-shrink: 0;
        }
        #uploadModal .modal-body {
            padding: 1.5rem 1.75rem;
            overflow-y: auto;
            overflow-wrap: anywhere;
            min-width: 0;
            flex: 1 1 auto;
        }
        #uploadModal .modal-footer {
            padding: 1rem 1.75rem;
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.5rem;
            border-top: 1px solid var(--vz-border-color, #e9ebec);
        }
        #uploadModal .upload-modal-body {
            min-height: 420px;
        }
        #uploadModal #doc-library-dropzone-wrap .ciprms-dropzone {
            padding: 2.25rem 1.5rem;
            min-height: 200px;
        }
        #uploadModal .duplicate-matches-list {
            max-height: 240px;
            overflow-y: auto;
        }
        #uploadModal .ocr-raw-pre {
            min-height: 120px;
            max-height: 220px;
        }

        /* Responsive Mobile / Small screen adjustments */
        @media (max-width: 575.98px) {
            #uploadModal .modal-dialog {
                margin: 0.75rem auto;
                max-width: calc(100vw - 1.5rem);
            }
            #uploadModal .modal-content {
                max-height: calc(100vh - 1.5rem);
            }
            #uploadModal .modal-header {
                padding: 0.85rem 1rem;
            }
            #uploadModal .modal-body {
                padding: 1rem;
            }
            #uploadModal .modal-footer {
                padding: 0.75rem 1rem;
            }
            #uploadModal #doc-library-dropzone-wrap .ciprms-dropzone {
                padding: 1.5rem 1rem;
                min-height: 160px;
            }
            #uploadModal .upload-modal-body {
                min-height: 340px;
            }
        }

        /* ── Dark mode ──────────────────────────────────────────────────────
           The rules above hardcode light surfaces (folder hover/active fills,
           card and stat borders) and leave text on Bootstrap's defaults, which
           left folder names, document titles, table cells and the muted labels
           dim or unreadable on dark cards. Text is lifted to light greys here. */
        [data-bs-theme="dark"] .doc-card { border-color: rgba(255,255,255,.14) !important; }
        [data-bs-theme="dark"] .doc-card:hover { border-color: #7094f5 !important; box-shadow: 0 5px 15px rgba(0,0,0,.4); }
        [data-bs-theme="dark"] .stat-box { border-color: rgba(255,255,255,.14); }
        [data-bs-theme="dark"] .stat-box h5,
        [data-bs-theme="dark"] .doc-card h5,
        [data-bs-theme="dark"] .card-title { color: #f1f3f5; }
        [data-bs-theme="dark"] .folder-list .list-group-item { background-color: transparent; color: #dee2e6; }
        [data-bs-theme="dark"] .folder-list .list-group-item:hover { background-color: rgba(255,255,255,.07); color: #ffffff; }
        [data-bs-theme="dark"] .folder-list .list-group-item.active { background-color: rgba(112,148,245,.2); color: #a9c0ff; }
        [data-bs-theme="dark"] .folder-actions i:hover { color: #a9c0ff; }
        [data-bs-theme="dark"] .text-muted { color: #b4bccb !important; }
        [data-bs-theme="dark"] .text-dark { color: #e9ecef !important; }
        [data-bs-theme="dark"] .badge.bg-light { background-color: rgba(255,255,255,.12) !important; color: #e9ecef !important; }
        [data-bs-theme="dark"] .avatar-title.bg-light { background-color: rgba(255,255,255,.1) !important; }
        [data-bs-theme="dark"] .table > :not(caption) > * > * { color: #dee2e6; }
        [data-bs-theme="dark"] .table-hover > tbody > tr:hover > * { color: #ffffff; }
        [data-bs-theme="dark"] .table-light,
        [data-bs-theme="dark"] .table-light th { color: #f1f3f5; }
        [data-bs-theme="dark"] .form-control,
        [data-bs-theme="dark"] .form-select { color: #e9ecef; }
        [data-bs-theme="dark"] .form-control::placeholder { color: #9aa3b5; }
        [data-bs-theme="dark"] .modal-title { color: #f1f3f5; }
        [data-bs-theme="dark"] .form-control.bg-light { background-color: rgba(255,255,255,.06) !important; color: #e9ecef; }

        /* Dark-mode contrast pass (same palette as above: #a9c0ff / #7094f5 accents on translucent white surfaces).
           - the nature filter pills carry a count in `badge bg-white text-dark`; the `.text-dark` rule above turns that
             text light, so the count became light-on-white (a blank white box) — now a translucent chip with light text;
           - the Type filter buttons, Preview and soft-blue/-info buttons used the light-theme blues, which sit
             dim against dark cards; lifted to the accent colours so labels are readable and states are distinct. */
        [data-bs-theme="dark"] .badge.bg-white { background-color: rgba(255,255,255,.18) !important; color: #f1f3f5 !important; }
        [data-bs-theme="dark"] .btn-outline-primary { color: #a9c0ff; border-color: rgba(112,148,245,.55); }
        [data-bs-theme="dark"] .btn-outline-primary:hover,
        [data-bs-theme="dark"] .btn-outline-primary:focus-visible { background-color: rgba(112,148,245,.22); color: #ffffff; border-color: #7094f5; }
        [data-bs-theme="dark"] .btn-outline-primary.active,
        [data-bs-theme="dark"] .btn-check:checked + .btn-outline-primary { background-color: #405189; color: #ffffff; border-color: #7094f5; }
        [data-bs-theme="dark"] .btn-soft-primary { background-color: rgba(112,148,245,.18); color: #b9ccff; }
        [data-bs-theme="dark"] .btn-soft-primary:hover,
        [data-bs-theme="dark"] .btn-soft-primary:focus-visible,
        [data-bs-theme="dark"] .btn-soft-primary.active { background-color: #5b7bd9; color: #ffffff; }
        [data-bs-theme="dark"] .btn-soft-info { background-color: rgba(41,156,219,.2); color: #8fd8f5; }
        [data-bs-theme="dark"] .btn-soft-info:hover,
        [data-bs-theme="dark"] .btn-soft-info:focus-visible { background-color: #299cdb; color: #ffffff; }
        [data-bs-theme="dark"] .btn-soft-secondary { background-color: rgba(255,255,255,.1); color: #dee2e6; }
        [data-bs-theme="dark"] .btn-soft-secondary:hover { background-color: rgba(255,255,255,.2); color: #ffffff; }
        [data-bs-theme="dark"] #uploadModal .modal-content { background-color: var(--vz-card-bg, #212529); border-color: var(--vz-border-color, #32383e); }
        [data-bs-theme="dark"] #uploadModal .modal-header,
        [data-bs-theme="dark"] #uploadModal .modal-footer { background-color: #1a1d21 !important; border-color: #32383e !important; }
        [data-bs-theme="dark"] #uploadModal .modal-title { color: #f1f3f5 !important; }
        [data-bs-theme="dark"] #uploadModal .card.border-primary-subtle { background-color: #1e2533 !important; border-color: rgba(112, 148, 245, 0.25) !important; }
        [data-bs-theme="dark"] #uploadModal #res-file-name { color: #f1f3f5 !important; }
        [data-bs-theme="dark"] #uploadModal .duplicate-match-card { background-color: #1a1d21 !important; border-color: #3b3323 !important; }
    </style>
</head>

<body>

<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <!-- page title -->
                <div class="row">
                  <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                      <h4 class="mb-sm-0">Document Library (OCR)</h4>
                      <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                          <li class="breadcrumb-item"><a href="<%= typeof homeHref !== 'undefined' ? homeHref : '/dashboard' %>">CIPRMS</a></li>
                          <li class="breadcrumb-item active">Document Library</li>
                        </ol>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="row">
                    <!-- Left Sidebar Panel -->
                    <div class="col-xl-3">
                        <!-- Summary Card -->
                        <div class="card">
                            <div class="card-header align-items-center d-flex">
                                <h4 class="card-title mb-0 flex-grow-1"><i class="ri-dashboard-line me-2 align-bottom"></i>Summary</h4>
                            </div>
                            <div class="card-body">
                                <div class="row g-2 text-center">
                                    <div class="col-4">
                                        <div class="stat-box">
                                            <h5 class="mb-1" id="stat-total">0</h5>
                                            <p class="text-muted fs-11 mb-0">Total</p>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-box">
                                            <h5 class="mb-1" id="stat-moa">0</h5>
                                            <p class="text-muted fs-11 mb-0">MOA</p>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-box">
                                            <h5 class="mb-1" id="stat-mou">0</h5>
                                            <p class="text-muted fs-11 mb-0">MOU</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Type Filter -->
                        <div class="card">
                            <div class="card-body">
                                <p class="text-muted text-uppercase fw-semibold fs-11 mb-3">Type Filter</p>
                                <div class="btn-group w-100 flex-wrap" role="group" id="type-filter-group">
                                    <button type="button" class="btn btn-outline-primary btn-sm active" onclick="filterType('All', this)">All</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="filterType('MOA', this)">MOA</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="filterType('MOU', this)">MOU</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="filterType('Other', this)">Other</button>
                                </div>
                            </div>
                        </div>

                        <!-- Folders -->
                        <div class="card">
                            <div class="card-header align-items-center d-flex">
                                <h4 class="card-title mb-0 flex-grow-1">Folders</h4>
                                <button class="btn btn-soft-primary btn-sm" onclick="createFolderPrompt()"><i class="ri-add-line me-1"></i>New</button>
                            </div>
                            <div class="card-body p-0">
                                <div class="folder-list">
                                    <div class="list-group list-group-flush" id="folder-list-group"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Grid Area -->
                    <div class="col-xl-9">
                        <div class="card">
                            <div class="card-header border-0 pb-0">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-3">
                                        <h4 class="card-title mb-0"><i class="ri-file-list-3-line me-2"></i>Documents</h4>
                                    </div>
                                    <div class="col-md">
                                        <div class="search-box">
                                            <input type="text" class="form-control" id="searchLibrary">
                                            <i class="ri-search-line search-icon"></i>
                                        </div>
                                    </div>
                                    <div class="col-md-auto">
                                        <div class="btn-group" role="group" aria-label="Grid or List view">
                                            <button type="button" class="btn btn-outline-secondary" id="view-grid-btn" title="Grid View" onclick="setView('grid')">
                                                <i class="ri-layout-grid-fill"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary" id="view-list-btn" title="List View" onclick="setView('list')">
                                                <i class="ri-list-check-2"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <% if (typeof user !== 'undefined' && user && (user.role === 'Administrator' || user.role === 'Staff')) { %>
                                    <div class="col-md-auto">
                                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#uploadModal">
                                            <i class="ri-upload-cloud-2-line align-bottom me-1"></i> Upload & Extract
                                        </button>
                                    </div>
                                    <% } %>
                                </div>

                                <!-- Nature of Partnership filters — rebuilt from the actual MOA/MOU records on every
                                     load/refresh by renderNaturePills() below; see that function for why. -->
                                <div class="tag-pills-container mt-4 mb-2" id="nature-pills-container"></div>
                            </div>
                            <div class="card-body">
                                <div class="row" id="document-grid">
                                    <!-- Documents loaded here (Grid View) -->
                                    <div class="col-12 text-center py-5" id="loading-docs">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <p class="mt-2 text-muted">Loading documents...</p>
                                    </div>
                                </div>

                                <!-- List View (hidden unless selected) -->
                                <div class="table-responsive" id="document-list" style="display:none">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:48px"></th>
                                                <th>Document Name</th>
                                                <th>Institution</th>
                                                <th>Document Type</th>
                                                <th>Nature</th>
                                                <th>Upload Date</th>
                                                <th>Status</th>
                                                <th>Folder</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="document-list-body">
                                            <tr>
                                                <td colspan="9" class="text-center py-5">
                                                    <div class="spinner-border text-primary" role="status"></div>
                                                    <p class="mt-2 text-muted mb-0">Loading documents...</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<!-- Upload & OCR Modal — Administrator and Staff only (removed for Auth. Personnel
     2026-07-23; Staff added 2026-09-14 — the backend (requireUploader,
     OWN_SCOPE_ROLES) already supported Staff uploads, this template was the
     only thing blocking it). potential_partner has its own separate
     Document Library page/template, not this shared one. -->
<% var canUploadDocuments = typeof user !== 'undefined' && user && (user.role === 'Administrator' || user.role === 'Staff'); %>
<% if (canUploadDocuments) { %>
<div class="modal fade zoomIn" id="uploadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl" id="upload-modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light-subtle border-bottom">
        <h5 class="modal-title fs-16 fw-bold"><i class="ri-scan-2-line text-primary me-2"></i>Upload Document &amp; OCR Extraction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="close-upload"></button>
      </div>
      <div class="modal-body upload-modal-body">
        <!-- Stage 1: Upload Dropzone Area -->
        <div id="upload-stage" class="upload-modal-stage">
            <div class="mb-3 text-center">
                <p class="ocr-helper-text mb-0 fs-13 text-muted">Upload an agreement, proposal, contract, or accreditation document. The system extracts text, suggests metadata, detects duplicates, and archives the file to the Document Library.</p>
            </div>
            <div id="doc-library-dropzone-wrap">
                <input type="file" id="fileInput" accept=".pdf,.jpg,.jpeg,.png">
            </div>
            <div class="d-flex align-items-center justify-content-center gap-3 mt-3 flex-wrap fs-12 text-muted">
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i>Automatic OCR Extraction</span>
                <span><i class="ri-shield-check-fill text-primary me-1"></i>Duplicate Detection</span>
                <span><i class="ri-archive-fill text-info me-1"></i>Auto Archival</span>
            </div>

            <!-- Multiple photos of one document (2026-11) — a separate picker from the single-file dropzone
                 above, so a single PDF/image upload keeps behaving exactly as before. Photos are combined
                 into one document server-side; OCR/duplicate detection/auto-fill run once on the combined
                 result via the exact same result stage below. -->
            <div class="text-center my-3 fs-12 text-muted">— or —</div>
            <div id="multi-photo-picker" class="text-center">
                <p class="ocr-helper-text mb-2 fs-13 text-muted">Have several photos of the same document (one per page)? Select them all at once — they'll be combined and extracted as a single document.</p>
                <input type="file" id="multiPhotoInput" accept=".jpg,.jpeg,.png" multiple class="d-none">
                <button type="button" class="btn btn-sm btn-soft-primary" id="btn-pick-multi-photos">
                    <i class="ri-image-add-line me-1"></i>Select Photos
                </button>
                <div id="multi-photo-list" class="d-flex flex-wrap gap-2 justify-content-center mt-3"></div>
                <div class="fs-12 text-muted mt-2 d-none" id="multi-photo-count"></div>
                <div class="alert alert-danger py-2 px-3 fs-13 mt-2 d-none" id="multi-photo-error"></div>
                <button type="button" class="btn btn-primary btn-sm mt-2 d-none" id="btn-extract-multi">
                    <i class="ri-scan-2-line me-1"></i>Combine &amp; Extract
                </button>
            </div>
        </div>

        <!-- Stage 2: OCR Processing Spinner & Progress -->
        <div id="ocr-stage" class="upload-modal-stage text-center py-4 ocr-spinner">
            <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
            <h5 class="ocr-section-title fs-16 fw-bold mb-1" id="ocr-stage-heading">Analyzing Document with OCR...</h5>
            <p class="ocr-helper-text fs-13 mb-3" id="ocr-stage-detail">Extracting metadata and analyzing content. Please wait.</p>
            <div class="progress mx-auto mb-3" style="height:8px;max-width:420px;border-radius:4px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="ocr-modal-progress-bar" style="width:0%"></div>
            </div>
            <div class="fs-12 text-muted" id="ocr-stage-subtext">Step 1 of 2: Uploading &amp; processing text</div>
        </div>

        <!-- Stage 3: Extracted Results, Metadata & Duplicate Alerts -->
        <div id="result-stage" class="extracted-data">
            <!-- Document Meta Header Pill -->
            <div class="card border border-primary-subtle bg-light-subtle mb-3 p-3 shadow-none">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2 text-truncate me-2">
                        <div class="avatar-xs flex-shrink-0">
                            <span class="avatar-title rounded bg-primary-subtle text-primary fs-4">
                                <i class="ri-file-text-line"></i>
                            </span>
                        </div>
                        <div class="text-truncate">
                            <div class="fw-semibold text-dark fs-14 text-truncate" id="res-file-name">Uploaded Document</div>
                            <div class="fs-12 text-muted" id="res-file-meta">Saved to Document Library</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <span class="badge bg-success-subtle text-success fs-12 py-1 px-2" id="res-confidence-badge"><i class="ri-sparkling-fill me-1"></i>Confidence: —</span>
                        <span class="badge bg-warning-subtle text-warning fs-12 py-1 px-2" id="res-warning-badge" style="display:none;"><i class="ri-alert-line me-1"></i>Low Confidence</span>
                    </div>
                </div>
            </div>

            <!-- Duplicate Warning Alert Box -->
            <div id="duplicate-warning-box" class="alert alert-warning border border-warning-subtle shadow-sm mb-3" style="display:none;">
                <div class="d-flex align-items-start gap-2">
                    <i class="ri-alert-fill fs-3 text-warning flex-shrink-0 mt-1"></i>
                    <div class="flex-grow-1">
                        <h6 class="alert-heading text-warning-emphasis fw-bold fs-15 mb-1">Possible Duplicate Detected</h6>
                        <p class="fs-13 text-muted mb-2">The system detected that this document may already exist in the Document Library. Review the matching record(s) below:</p>
                        
                        <div class="duplicate-matches-list mb-3" id="duplicate-matches-container" style="max-height: 240px; overflow-y: auto;"></div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <button type="button" class="btn btn-warning btn-sm fs-13" id="btn-continue-duplicate" onclick="acknowledgeDuplicateAndContinue()">
                                <i class="ri-check-line me-1"></i>Continue Anyway &amp; Save
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm fs-13" id="btn-discard-duplicate" onclick="discardDuplicateUpload()">
                                <i class="ri-delete-bin-line me-1"></i>Discard Upload
                            </button>
                            <button type="button" class="btn btn-light btn-sm ms-auto fs-13" id="btn-toggle-matches" onclick="toggleDuplicateDetails()">
                                <i class="ri-arrow-up-s-line me-1" id="toggle-matches-icon"></i><span id="toggle-matches-text">Hide Matches</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-success border-success-subtle py-2 px-3 fs-13 mb-3" id="result-success-alert">
                <i class="ri-checkbox-circle-fill me-2"></i><span id="result-alert-text">Extraction complete. Document has been archived to the library — verify or edit any field below.</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label ocr-field-label" for="res-title">Document Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control ocr-field-input" id="res-title" placeholder="Document Title">
                </div>
                <div class="col-md-6">
                    <label class="form-label ocr-field-label" for="res-type">Document Type</label>
                    <input type="text" class="form-control ocr-field-input" id="res-type" placeholder="e.g. MOA, MOU, Contract">
                </div>
                <div class="col-md-6">
                    <label class="form-label ocr-field-label" for="res-inst">Institution / Partner</label>
                    <input type="text" class="form-control ocr-field-input" id="res-inst" placeholder="Institution Name">
                </div>
                <div class="col-md-6">
                    <label class="form-label ocr-field-label" for="res-validity">Validity Period</label>
                    <input type="text" class="form-control ocr-field-input" id="res-validity" placeholder="Start Date – End Date">
                </div>
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <label class="form-label ocr-field-label mb-0" for="res-rawtext">Extracted OCR Text Preview</label>
                        <button type="button" class="btn btn-sm btn-ghost-secondary text-primary fs-12 p-0" data-bs-toggle="collapse" data-bs-target="#ocr-text-collapse">
                            <i class="ri-eye-line me-1"></i>Toggle Text Preview
                        </button>
                    </div>
                    <div class="collapse show" id="ocr-text-collapse">
                        <textarea class="form-control ocr-raw-pre bg-light" rows="5" readonly id="res-rawtext" placeholder="Extracted text preview..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div id="ocr-error-stage" class="alert alert-danger py-2 px-3 fs-13 mb-0" style="display:none"></div>
      </div>
      <div class="modal-footer border-top bg-light-subtle">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary px-3" id="saveDocBtn" style="display:none;" onclick="saveDocument()">
            <i class="ri-save-line me-1"></i>Save Edits
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script src="/js/ciprms-uploader.js"></script>
<script>
    let allDocs = [];
    let allFolders = [];
    let currentType = 'All';
    let currentTag = 'All';
    let currentSearch = '';
    let currentFolder = 'all'; // 'all' | 'unfiled' | 'archived' | <folder id>
    let currentView = localStorage.getItem('docLibraryView') === 'list' ? 'list' : 'grid';

    function escHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    document.addEventListener('DOMContentLoaded', () => {
        applyViewState(); // reflect the persisted view immediately, before data loads
        loadFolders();
        loadDocuments();

        // A document this account uploaded was just archived (a fresh OCR upload) or updated/archived elsewhere —
        // re-read the library so the grid/list and the Nature-of-Partnership pills reflect it without a full page
        // reload. Own-uploads-only, matching this page's existing GET /api/documents scoping.
        if (window.CIPRMS && CIPRMS.live) {
            CIPRMS.live(['document.updated'], loadDocuments, { debounce: 250 });
        }

        document.getElementById('searchLibrary').addEventListener('input', function(e) {
            currentSearch = e.target.value.toLowerCase();
            renderFiltered();
        });



        var uploadModalEl = document.getElementById('uploadModal');
        if (uploadModalEl) {
            uploadModalEl.addEventListener('hidden.bs.modal', function () {
                // If the user closes the modal without saving, discard the temp file.
                if (currentJobId) {
                    fetch('/api/ocr/discard', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ jobId: currentJobId })
                    }).catch(function () {}); // best-effort, fire-and-forget
                    currentJobId = null;
                }
                document.getElementById('fileInput').value = '';
                document.getElementById('upload-stage').style.display = 'block';
                document.getElementById('ocr-stage').style.display = 'none';
                document.getElementById('result-stage').style.display = 'none';
                document.getElementById('ocr-error-stage').style.display = 'none';
                document.getElementById('saveDocBtn').style.display = 'none';
                var dupBox = document.getElementById('duplicate-warning-box');
                if (dupBox) dupBox.style.display = 'none';
                var dzPreview = document.querySelector('#doc-library-dropzone-wrap .ciprms-dropzone-preview');
                var dzPrompt = document.querySelector('#doc-library-dropzone-wrap .ciprms-dropzone-prompt');
                if (dzPreview) dzPreview.style.display = 'none';
                if (dzPrompt) dzPrompt.style.display = 'flex';
                resetMultiPhotoPicker();
            });
        }

        if (window.CIPRMS && CIPRMS.initDropzone) {
            CIPRMS.initDropzone({
                container: '#doc-library-dropzone-wrap',
                input: '#fileInput',
                title: 'Upload Document',
                desc: 'PDF, JPG, JPEG, or PNG · Maximum 10MB',
                onFileSelected: function (file) {
                    startOcr();
                }
            });
        }
    });

    function loadDocuments() {
        return fetch('/api/documents')
            .then(r => r.json())
            .then(data => {
                allDocs = Array.isArray(data) ? data : [];
                renderNaturePills();
                renderFiltered();
                updateStats();
            });
    }

    function updateStats() {
        const total = allDocs.length;
        const moa = allDocs.filter(d => d.type === 'MOA').length;
        const mou = allDocs.filter(d => d.type === 'MOU').length;
        
        document.getElementById('stat-total').textContent = total;
        document.getElementById('stat-moa').textContent = moa;
        document.getElementById('stat-mou').textContent = mou;
    }

    // ── Grid/List view toggle ─────────────────────────────────────────────────
    // Purely client-side: no fetch, no page reload. Both views are kept
    // rendered in the DOM from the same `filtered` array (see renderFiltered),
    // so switching is just an instant show/hide — search and filters already
    // apply to both since they share one data source.
    function setView(view) {
        currentView = view;
        localStorage.setItem('docLibraryView', view);
        applyViewState();
    }

    function applyViewState() {
        document.getElementById('view-grid-btn').classList.toggle('active', currentView === 'grid');
        document.getElementById('view-list-btn').classList.toggle('active', currentView === 'list');
        document.getElementById('document-grid').style.display = currentView === 'grid' ? '' : 'none';
        document.getElementById('document-list').style.display = currentView === 'list' ? '' : 'none';
    }

    function filterType(type, el) {
        currentType = type;
        document.querySelectorAll('#type-filter-group .btn').forEach(btn => btn.classList.remove('active'));
        el.classList.add('active');
        renderFiltered();
    }

    function filterTag(tag, el) {
        currentTag = tag;
        document.querySelectorAll('#nature-pills-container .btn').forEach(btn => btn.classList.remove('active'));
        if (el) el.classList.add('active');
        renderFiltered();
    }

    // Nature of Partnership filter pills — built from the ACTUAL nature values present on real MOA/MOU records
    // (doc.nature, set by OCR extraction — see services/extractionService.js's inferNature()), not a fixed list.
    // A pill only exists when at least one MOA/MOU document currently has that nature; "All" is always shown, and
    // "Other" covers an MOA/MOU whose nature could not be confidently determined (never a reason to hide the
    // document itself elsewhere in the library — only this refinement filter).
    const NATURE_PILL_COLORS = ['btn-soft-info', 'btn-soft-success', 'btn-soft-warning', 'btn-soft-danger', 'btn-soft-primary', 'btn-soft-dark'];
    function renderNaturePills() {
        const container = document.getElementById('nature-pills-container');
        if (!container) return;
        const counts = new Map();
        allDocs.forEach(doc => {
            if (doc.archived) return;
            if (doc.type !== 'MOA' && doc.type !== 'MOU') return;
            const nature = doc.nature || 'Other';
            counts.set(nature, (counts.get(nature) || 0) + 1);
        });
        const natures = [...counts.keys()].sort((a, b) => a === 'Other' ? 1 : b === 'Other' ? -1 : a.localeCompare(b));
        // If the currently-selected nature pill no longer has any matching document (e.g. the last one was removed,
        // reclassified, or archived), fall back to "All" rather than silently showing an empty grid with no visible
        // active filter to explain why.
        if (currentTag !== 'All' && !natures.includes(currentTag)) currentTag = 'All';
        let html = `<button class="btn btn-sm btn-soft-primary rounded-pill px-3${currentTag === 'All' ? ' active' : ''}" onclick="filterTag('All', this)">All</button>`;
        natures.forEach((nature, i) => {
            const color = NATURE_PILL_COLORS[i % NATURE_PILL_COLORS.length];
            html += `<button class="btn btn-sm ${color} rounded-pill px-3${currentTag === nature ? ' active' : ''}" onclick="filterTag('${nature.replace(/'/g, "\\'")}', this)">${escHtml(nature)} <span class="badge bg-white text-dark ms-1">${counts.get(nature)}</span></button>`;
        });
        container.innerHTML = html;
    }

    // ── Folders — real, per-owner, backed by /api/document-folders* ─────────────
    function loadFolders() {
        return fetch('/api/document-folders/mine').then(r => r.json()).then(data => {
            allFolders = Array.isArray(data) ? data : [];
            renderFolderList();
        });
    }

    function filterFolder(folder) {
        currentFolder = folder;
        renderFolderList();
        renderFiltered();
    }

    function renderFolderList() {
        const container = document.getElementById('folder-list-group');
        const activeFolders = allFolders.filter(f => !f.archived);
        const archivedCount = allFolders.filter(f => f.archived).length + allDocs.filter(d => d.archived).length;

        let html = `
          <a href="#" class="list-group-item list-group-item-action ${currentFolder === 'all' ? 'active' : ''}" onclick="filterFolder('all');return false;">
            <i class="ri-folder-open-fill text-warning folder-icon"></i> All Documents
          </a>
          <a href="#" class="list-group-item list-group-item-action ${currentFolder === 'unfiled' ? 'active' : ''}" onclick="filterFolder('unfiled');return false;">
            <i class="ri-file-3-line text-muted folder-icon"></i> Unfiled
          </a>`;
        activeFolders.forEach(f => {
            html += `
          <a href="#" class="list-group-item list-group-item-action ${currentFolder === f.id ? 'active' : ''}" onclick="filterFolder(${f.id});return false;">
            <i class="ri-folder-2-fill text-info folder-icon"></i>
            <span class="flex-grow-1 text-truncate">${escHtml(f.name)}</span>
            <span class="folder-actions">
              <i class="ri-pencil-line" title="Rename" onclick="event.stopPropagation();event.preventDefault();renameFolderPrompt(${f.id})"></i>
              <i class="ri-archive-line" title="Archive folder" onclick="event.stopPropagation();event.preventDefault();toggleFolderArchive(${f.id}, true)"></i>
            </span>
          </a>`;
        });
        html += `
          <div class="dropdown-divider"></div>
          <a href="#" class="list-group-item list-group-item-action ${currentFolder === 'archived' ? 'active' : ''}" onclick="filterFolder('archived');return false;">
            <i class="ri-archive-fill text-muted folder-icon"></i> Archived <span class="badge bg-light text-dark ms-auto">${archivedCount}</span>
          </a>`;
        container.innerHTML = html;
    }

    function createFolderPrompt() {
        const name = prompt('New folder name:');
        if (!name || !name.trim()) return;
        fetch('/api/document-folders', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name.trim() })
        }).then(r => r.json()).then(data => {
            if (data.success) { loadFolders(); showToast('<i class="ri-checkbox-circle-line me-1"></i>Folder created.'); }
            else showToast(data.error || 'Failed to create folder.', '#f06548');
        });
    }

    function renameFolderPrompt(id) {
        const folder = allFolders.find(f => f.id === id);
        const name = prompt('Rename folder:', folder ? folder.name : '');
        if (!name || !name.trim()) return;
        fetch('/api/document-folders/' + id, {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name.trim() })
        }).then(r => r.json()).then(data => {
            if (data.success) { loadFolders(); showToast('<i class="ri-checkbox-circle-line me-1"></i>Folder renamed.'); }
            else showToast(data.error || 'Failed to rename folder.', '#f06548');
        });
    }

    function toggleFolderArchive(id, archived) {
        fetch('/api/document-folders/' + id, {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ archived })
        }).then(r => r.json()).then(data => {
            if (data.success) { loadFolders(); if (currentFolder === id) filterFolder('all'); showToast('<i class="ri-checkbox-circle-line me-1"></i>Folder updated.'); }
            else showToast(data.error || 'Failed to update folder.', '#f06548');
        });
    }

    function moveDocument(docId, folderValue) {
        const folderId = folderValue === '' ? null : parseInt(folderValue);
        fetch('/api/documents/' + docId + '/organize', {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ folderId })
        }).then(r => r.json()).then(data => {
            if (data.success) {
                const doc = allDocs.find(d => d.id === docId);
                if (doc) doc.folderId = folderId;
                renderFiltered();
                showToast('<i class="ri-checkbox-circle-line me-1"></i>Document moved.');
            } else showToast(data.error || 'Failed to move document.', '#f06548');
        });
    }

    function toggleDocArchive(docId, archived) {
        fetch('/api/documents/' + docId + '/organize', {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ archived })
        }).then(r => r.json()).then(data => {
            if (data.success) {
                const doc = allDocs.find(d => d.id === docId);
                if (doc) doc.archived = archived;
                renderFolderList();
                renderFiltered();
                showToast('<i class="ri-checkbox-circle-line me-1"></i>' + (archived ? 'Document archived.' : 'Document unarchived.'));
            } else showToast(data.error || 'Failed to update document.', '#f06548');
        });
    }

    // Looks the document up by id (same safe pattern as renameDocumentPrompt/toggleDocArchive below — only a
    // numeric id is ever interpolated into the onclick attribute, never the raw title/fileLink strings) so
    // the shared viewer (views/partials/document_viewer.ejs) never needs those values embedded in markup.
    function openDocPreview(docId) {
        const doc = allDocs.find(d => d.id === docId);
        if (!doc) return;
        DocViewer.open(doc.fileLink || '', doc.title || 'Document');
    }

    function renameDocumentPrompt(docId) {
        const doc = allDocs.find(d => d.id === docId);
        const title = prompt('Rename document:', doc ? doc.title : '');
        if (!title || !title.trim()) return;
        fetch('/api/documents/' + docId, {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: title.trim() })
        }).then(r => r.json()).then(data => {
            if (data.success) { doc.title = title.trim(); renderFiltered(); showToast('<i class="ri-checkbox-circle-line me-1"></i>Document renamed.'); }
            else showToast(data.error || 'Failed to rename document.', '#f06548');
        });
    }

    function folderOptionsHtml(doc) {
        let opts = `<option value="" ${doc.folderId == null ? 'selected' : ''}>Unfiled</option>`;
        allFolders.filter(f => !f.archived).forEach(f => {
            opts += `<option value="${f.id}" ${doc.folderId === f.id ? 'selected' : ''}>${escHtml(f.name)}</option>`;
        });
        return opts;
    }

    function renderFiltered() {
        const filtered = allDocs.filter(doc => {
            if (currentFolder === 'archived') {
                if (!doc.archived) return false;
            } else {
                if (doc.archived) return false;
                if (currentFolder === 'unfiled' && doc.folderId != null) return false;
                else if (currentFolder !== 'all' && currentFolder !== 'unfiled' && doc.folderId !== currentFolder) return false;
            }
            const matchesType = currentType === 'All' || doc.type === currentType;
            // Nature of Partnership — the real field (doc.nature), scoped to MOA/MOU records; "Other" covers an
            // MOA/MOU with no confidently-extracted nature. Every non-MOA/MOU document (Accreditation, Contract,
            // etc.) is left alone by this filter entirely, same as before.
            const matchesTag = currentTag === 'All'
                || ((doc.type === 'MOA' || doc.type === 'MOU') && (doc.nature || 'Other') === currentTag);
            const instText = (doc.institution || doc.partner || '').toLowerCase();
            // IDP upgrade (2026-07-28): also search the OCR-extracted text and
            // keywords, so scanned documents are searchable by words that only
            // ever appear inside the file itself (e.g. "Kyushu", "CHED").
            const ocrText = (doc.ocrText || '').toLowerCase();
            const kwText = (doc.searchKeywords || []).join(' ').toLowerCase();
            const matchesSearch = !currentSearch || doc.title.toLowerCase().includes(currentSearch)
                || instText.includes(currentSearch) || ocrText.includes(currentSearch) || kwText.includes(currentSearch);
            return matchesType && matchesTag && matchesSearch;
        });

        // Both views are kept in sync on every filter/search change so toggling
        // between them (setView) never needs to re-fetch or re-filter.
        renderGrid(filtered);
        renderList(filtered);
    }

    // Existing card layout — untouched.
    function renderGrid(filtered) {
        const grid = document.getElementById('document-grid');
        if (filtered.length === 0) {
            grid.innerHTML = '<div class="col-12 text-center py-5"><i class="ri-file-search-line fs-1 text-muted"></i><p class="mt-2 text-muted">No documents found matching your filters.</p></div>';
            return;
        }

        grid.innerHTML = filtered.map(doc => {
            const isAccred = doc.type === 'Accreditation';
            const icon = doc.type === 'MOA' ? 'ri-file-text-line text-primary' :
                         doc.type === 'MOU' ? 'ri-file-list-3-line text-info' :
                         isAccred ? 'ri-award-line text-warning' : 'ri-file-paper-2-line text-secondary';
            const nature = doc.tags && doc.tags.length > 0 ? doc.tags[0] : 'Research';
            const natureBadge = nature === 'Research' ? 'bg-info-subtle text-info' :
                               nature === 'Student Exchange' ? 'bg-success-subtle text-success' :
                               nature === 'Foreign Exchange' ? 'bg-primary-subtle text-primary' : 'bg-light text-muted';

            const rightLabel = isAccred ? 'Issuing Body:' : 'Nature:';
            const rightValue = isAccred
                ? `<span class="fw-bold fs-12 d-block text-truncate" title="${escHtml(doc.issuingBody || '—')}">${escHtml(doc.issuingBody || '—')}</span>`
                : `<span class="badge ${natureBadge} fs-10">${escHtml(nature)}</span>`;
            const accredExtra = isAccred && (doc.accreditationLevel || doc.certificateNumber)
                ? `<div class="mb-2 fs-11 text-muted">${doc.accreditationLevel ? 'Level: ' + escHtml(doc.accreditationLevel) : ''}${doc.accreditationLevel && doc.certificateNumber ? ' &middot; ' : ''}${doc.certificateNumber ? 'Cert No: ' + escHtml(doc.certificateNumber) : ''}</div>`
                : '';

            return `
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="card doc-card h-100 shadow-none mb-0">
                        <div class="card-body pb-1">
                            <div class="d-flex align-items-start mb-3">
                                <div class="avatar-sm flex-shrink-0 me-3">
                                    <span class="avatar-title bg-light rounded fs-3"><i class="${icon}"></i></span>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <h5 class="fs-14 mb-1 text-truncate" title="${escHtml(doc.title)}">${escHtml(doc.title)}</h5>
                                    <p class="text-muted fs-12 mb-0 text-truncate">${escHtml(doc.institution || doc.partner || '')}</p>
                                </div>
                            </div>
                            <div class="row g-2 mb-2 align-items-center">
                                <div class="col-4" style="min-width:0;">
                                    <small class="text-muted d-block fs-11">Type:</small>
                                    <span class="fw-bold fs-12 d-block text-truncate" title="${escHtml(doc.type || '')}">${escHtml(doc.type)}</span>
                                </div>
                                <div class="col-8 text-end" style="min-width:0;">
                                    <small class="text-muted d-block fs-11">${rightLabel}</small>
                                    ${rightValue}
                                </div>
                            </div>
                            ${accredExtra}
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-soft-primary flex-grow-1" onclick="openDocPreview(${doc.id})"><i class="ri-eye-line me-1"></i>Preview</button>
                                <a class="btn btn-sm btn-soft-success" href="${doc.fileLink || '#'}" download title="Download"><i class="ri-download-2-line"></i></a>
                                <button class="btn btn-sm btn-soft-warning" title="Rename" onclick="renameDocumentPrompt(${doc.id})"><i class="ri-pencil-line"></i></button>
                            </div>
                            <select class="form-select form-select-sm mb-2" title="Move to folder" onchange="moveDocument(${doc.id}, this.value)">
                                ${folderOptionsHtml(doc)}
                            </select>
                        </div>
                        <div class="card-footer p-0 border-0">
                            <button class="btn ${doc.archived ? 'btn-soft-secondary' : 'btn-soft-info'} w-100 rounded-0 rounded-bottom py-2" onclick="toggleDocArchive(${doc.id}, ${!doc.archived})">
                                <i class="ri-archive-line me-1"></i>${doc.archived ? 'Unarchive' : 'Archive'}
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // List View — same document data and same action buttons as the grid,
    // laid out as a responsive Bootstrap table instead of cards.
    function renderList(filtered) {
        const tbody = document.getElementById('document-list-body');
        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center py-5 text-muted"><i class="ri-file-search-line fs-1 d-block mb-2"></i>No documents found matching your filters.</td></tr>';
            return;
        }

        tbody.innerHTML = filtered.map(doc => {
            const isAccred = doc.type === 'Accreditation';
            const icon = doc.type === 'MOA' ? 'ri-file-text-line text-primary' :
                         doc.type === 'MOU' ? 'ri-file-list-3-line text-info' :
                         isAccred ? 'ri-award-line text-warning' : 'ri-file-paper-2-line text-secondary';
            const nature = doc.tags && doc.tags.length > 0 ? doc.tags[0] : 'Research';
            const natureBadge = nature === 'Research' ? 'bg-info-subtle text-info' :
                               nature === 'Student Exchange' ? 'bg-success-subtle text-success' :
                               nature === 'Foreign Exchange' ? 'bg-primary-subtle text-primary' : 'bg-light text-muted';
            const statusBadge = doc.status === 'Needs Review' ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success';

            return `
                <tr>
                    <td><span class="avatar-title bg-light rounded fs-4" style="width:36px;height:36px;display:inline-flex"><i class="${icon}"></i></span></td>
                    <td class="text-truncate" style="max-width:240px" title="${escHtml(doc.title)}">${escHtml(doc.title)}</td>
                    <td class="text-truncate" style="max-width:180px">${escHtml(doc.institution || doc.partner || '—')}</td>
                    <td class="text-truncate" style="max-width:180px" title="${escHtml(doc.type || '')}">${escHtml(doc.type)}</td>
                    <td><span class="badge ${natureBadge} fs-10">${escHtml(nature)}</span></td>
                    <td>${escHtml(doc.date || '—')}</td>
                    <td><span class="badge ${statusBadge} fs-10">${escHtml(doc.status || '—')}</span></td>
                    <td style="min-width:140px">
                        <select class="form-select form-select-sm" title="Move to folder" onchange="moveDocument(${doc.id}, this.value)">
                            ${folderOptionsHtml(doc)}
                        </select>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-soft-primary" title="Preview" onclick="openDocPreview(${doc.id})"><i class="ri-eye-line"></i></button>
                            <a class="btn btn-soft-success" href="${doc.fileLink || '#'}" download title="Download"><i class="ri-download-2-line"></i></a>
                            <button class="btn btn-soft-warning" title="Rename" onclick="renameDocumentPrompt(${doc.id})"><i class="ri-pencil-line"></i></button>
                            <button class="btn ${doc.archived ? 'btn-soft-secondary' : 'btn-soft-info'}" title="${doc.archived ? 'Unarchive' : 'Archive'}" onclick="toggleDocArchive(${doc.id}, ${!doc.archived})"><i class="ri-archive-line"></i></button>
                        </div>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // currentJobId tracks the in-flight OCR job. Nothing is persisted to the DB
    // until the user clicks "Save to Document Library" — the variable is set in
    // the modal-shown handler above and mirrored here for use by the functions below.
    var currentJobId = null;

    function startOcr() {
        var input = document.getElementById('fileInput');
        var file = input.files[0];
        if (!file) return;
        var formData = new FormData();
        formData.append('document', file);
        startOcrWithFormData(formData, 'Sending the file to the server.');
    }

    // Shared by both the single-file dropzone (startOcr, field 'document') and the multi-photo picker
    // (startOcrMulti below, field 'documents') — everything from here on (progress, polling, result
    // rendering, duplicate detection, save) is identical regardless of how many files started the job.
    function startOcrWithFormData(formData, uploadingDetailText) {
        currentJobId = null;

        document.getElementById('upload-stage').style.display = 'none';
        document.getElementById('result-stage').style.display = 'none';
        document.getElementById('ocr-error-stage').style.display = 'none';
        document.getElementById('ocr-stage').style.display = 'block';
        document.getElementById('ocr-modal-progress-bar').style.width = '0%';
        document.getElementById('ocr-stage-heading').textContent = 'Uploading…';
        document.getElementById('ocr-stage-detail').textContent = uploadingDetailText || 'Sending the file to the server.';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/ocr/extract');
        xhr.upload.addEventListener('progress', function (e) {
            if (!e.lengthComputable) return;
            var pct = Math.round((e.loaded / e.total) * 100);
            document.getElementById('ocr-modal-progress-bar').style.width = pct + '%';
        });
        xhr.onload = function () {
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
            if (xhr.status !== 202 || !data || !data.success) {
                docOcrFail((data && data.error) || 'Failed to start OCR processing.');
                return;
            }
            // Store the jobId — used by saveDocument() and the modal-close handler.
            currentJobId = data.jobId;
            document.getElementById('ocr-stage-heading').textContent = 'OCR Processing…';
            document.getElementById('ocr-stage-detail').textContent = 'Extracting text and metadata. Please wait.';
            pollDocOcrStatus(data.jobId);
        };
        xhr.onerror = function () { docOcrFail('Network error while uploading the document.'); };
        xhr.send(formData);
    }

    // ── Multiple photos of one document (2026-11) ───────────────────────────────
    // Selected cumulatively across repeated "Select Photos" clicks (never replaced), with an individual
    // remove button per thumbnail, and an explicit "Combine & Extract" step — unlike the single-file
    // dropzone, which starts OCR the instant a file is chosen, extraction here only begins once the user
    // has finished picking every photo for this one document and confirms.
    var multiPhotoFiles = [];
    var MAX_MULTI_PHOTOS = 10;
    var MAX_PHOTO_SIZE = 10 * 1024 * 1024; // 10MB — same per-file limit the single-file dropzone enforces

    function resetMultiPhotoPicker() {
        multiPhotoFiles = [];
        var input = document.getElementById('multiPhotoInput');
        if (input) input.value = '';
        renderMultiPhotoList();
        showMultiPhotoError('');
    }

    function showMultiPhotoError(msg) {
        var box = document.getElementById('multi-photo-error');
        if (!box) return;
        if (msg) { box.textContent = msg; box.classList.remove('d-none'); }
        else { box.textContent = ''; box.classList.add('d-none'); }
    }

    function renderMultiPhotoList() {
        var list = document.getElementById('multi-photo-list');
        if (list) {
            list.innerHTML = multiPhotoFiles.map(function (f, i) {
                return '<span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 p-2 fs-12">' +
                    '<i class="ri-image-line text-success"></i>' + escHtml(f.name) +
                    '<button type="button" class="btn-close" style="font-size:.55rem" data-i="' + i + '" aria-label="Remove ' + escHtml(f.name) + '"></button></span>';
            }).join('');
            list.querySelectorAll('.btn-close').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    multiPhotoFiles.splice(parseInt(btn.getAttribute('data-i'), 10), 1);
                    renderMultiPhotoList();
                });
            });
        }
        var countEl = document.getElementById('multi-photo-count');
        var extractBtn = document.getElementById('btn-extract-multi');
        if (multiPhotoFiles.length) {
            if (countEl) { countEl.classList.remove('d-none'); countEl.textContent = multiPhotoFiles.length + ' photo' + (multiPhotoFiles.length === 1 ? '' : 's') + ' selected (max ' + MAX_MULTI_PHOTOS + ').'; }
            if (extractBtn) extractBtn.classList.remove('d-none');
        } else {
            if (countEl) countEl.classList.add('d-none');
            if (extractBtn) extractBtn.classList.add('d-none');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var pickBtn = document.getElementById('btn-pick-multi-photos');
        var multiInput = document.getElementById('multiPhotoInput');
        var extractBtn = document.getElementById('btn-extract-multi');
        if (pickBtn && multiInput) pickBtn.addEventListener('click', function () { multiInput.click(); });
        if (multiInput) multiInput.addEventListener('change', function (e) {
            var picked = Array.from(e.target.files || []);
            var errors = [];
            picked.forEach(function (f) {
                var ext = '.' + (f.name.split('.').pop() || '').toLowerCase();
                if (!['.jpg', '.jpeg', '.png'].includes(ext)) { errors.push('"' + f.name + '": unsupported file type.'); return; }
                if (f.size > MAX_PHOTO_SIZE) { errors.push('"' + f.name + '": too large (max 10MB).'); return; }
                if (multiPhotoFiles.length >= MAX_MULTI_PHOTOS) { errors.push('"' + f.name + '": skipped — maximum ' + MAX_MULTI_PHOTOS + ' photos per extraction.'); return; }
                // Same name+size already selected — don't add it twice.
                if (multiPhotoFiles.some(function (x) { return x.name === f.name && x.size === f.size; })) return;
                multiPhotoFiles.push(f);
            });
            renderMultiPhotoList();
            showMultiPhotoError(errors.join(' '));
            e.target.value = ''; // lets the same filename be re-picked later if removed first
        });
        if (extractBtn) extractBtn.addEventListener('click', function () {
            if (!multiPhotoFiles.length) return;
            var formData = new FormData();
            multiPhotoFiles.forEach(function (f) { formData.append('documents', f); });
            startOcrWithFormData(formData, 'Combining ' + multiPhotoFiles.length + ' photos and sending them to the server.');
        });
    });

    function pollDocOcrStatus(jobId) {
        fetch('/api/ocr/status/' + jobId)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.success) { docOcrFail(data.error || 'Job not found.'); return; }
                document.getElementById('ocr-modal-progress-bar').style.width = (data.progress || 0) + '%';

                if (data.status === 'error') {
                    // OCR failed — the temp file has been deleted server-side; nothing was saved.
                    docOcrFail(data.error || 'OCR processing failed.');
                    return;
                }
                if (data.status === 'done') { docOcrSucceed(data.result, jobId); return; }
                setTimeout(function () { pollDocOcrStatus(jobId); }, 700);
            })
            .catch(function () { docOcrFail('Lost connection while checking OCR progress.'); });
    }

    function docOcrFail(message) {
        document.getElementById('ocr-stage').style.display = 'none';
        var box = document.getElementById('ocr-error-stage');
        box.textContent = message;
        box.style.display = 'block';
        // Nothing was saved — no need to reload the document list.
    }

    function docOcrSucceed(result, jobId) {
        // Store the jobId (NOT a documentId — nothing has been saved yet).
        currentJobId = jobId;
        document.getElementById('ocr-stage').style.display = 'none';
        document.getElementById('result-stage').style.display = 'block';
        // Always show the Save button — the user must explicitly confirm to save.
        document.getElementById('saveDocBtn').style.display = 'inline-block';

        document.getElementById('res-title').value = result.title || '';
        document.getElementById('res-type').value = result.documentType || '';
        document.getElementById('res-inst').value = result.institution || result.partner || result.issuingBody || '';
        document.getElementById('res-validity').value = [result.startDate, result.endDate].filter(Boolean).join(' – ');
        document.getElementById('res-rawtext').value = result.rawText || '';
        document.getElementById('res-confidence-badge').innerHTML = '<i class="ri-sparkling-fill me-1"></i>Confidence: ' + Math.round(result.confidence) + '%';
        document.getElementById('res-warning-badge').style.display = result.warning ? '' : 'none';

        var fileNameEl = document.getElementById('res-file-name');
        if (fileNameEl) fileNameEl.textContent = result.originalFilename || result.title || 'Uploaded Document';
        var fileMetaEl = document.getElementById('res-file-meta');
        // Document is NOT yet saved — make this clear to the user.
        if (fileMetaEl) fileMetaEl.textContent = 'Ready to save' + (result.documentType ? ' · ' + result.documentType : '');

        var dup = result.duplicateWarning;
        var dupBox = document.getElementById('duplicate-warning-box');
        var dupContainer = document.getElementById('duplicate-matches-container');
        var successAlert = document.getElementById('result-success-alert');

        if (dup && dup.found && dup.matches && dup.matches.length > 0) {
            dupBox.style.display = 'block';
            if (successAlert) successAlert.style.display = 'none';
            dupContainer.innerHTML = dup.matches.map(function (m) {
                return `
                    <div class="card mb-2 border border-warning-subtle duplicate-match-card">
                        <div class="card-body p-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="text-truncate" style="max-width: 72%;">
                                <div class="fw-semibold text-truncate">
                                    <span class="badge bg-primary-subtle text-primary me-1">${escHtml(m.type || 'Document')}</span>
                                    ${escHtml(m.title || 'Untitled Document')}
                                </div>
                                <div class="fs-12 text-muted text-truncate mt-1">
                                    <span><i class="ri-building-line me-1"></i>${escHtml(m.institution || '—')}</span> ·
                                    <span><i class="ri-calendar-line me-1"></i>${escHtml(m.validity || '—')}</span> ·
                                    <span class="text-warning fw-medium"><i class="ri-information-line me-1"></i>${escHtml(m.reason || 'Match')}</span>
                                </div>
                            </div>
                            <div>
                                <a href="${escHtml(m.fileLink || '#')}" target="_blank" rel="noopener" class="btn btn-sm btn-soft-primary" title="Preview Existing Document">
                                    <i class="ri-eye-line me-1"></i>Compare / Preview
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } else {
            dupBox.style.display = 'none';
            if (successAlert) successAlert.style.display = 'block';
        }
        // Do NOT call loadDocuments() here — nothing has been saved yet.
    }

    function discardDuplicateUpload() {
        if (!currentJobId) {
            bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();
            return;
        }
        // Discard the temp file server-side without creating any DB record.
        fetch('/api/ocr/discard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ jobId: currentJobId })
        })
            .then(function (r) { return r.json(); })
            .then(function () {
                currentJobId = null;
                bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();
                showToast('<i class="ri-information-line me-1"></i>Upload discarded.');
            })
            .catch(function () {
                currentJobId = null;
                bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();
            });
    }

    function acknowledgeDuplicateAndContinue() {
        document.getElementById('duplicate-warning-box').style.display = 'none';
        var successAlert = document.getElementById('result-success-alert');
        if (successAlert) successAlert.style.display = 'block';
        saveDocument();
    }

    function toggleDuplicateDetails() {
        var container = document.getElementById('duplicate-matches-container');
        var text = document.getElementById('toggle-matches-text');
        var icon = document.getElementById('toggle-matches-icon');
        if (container.style.display === 'none') {
            container.style.display = 'block';
            text.textContent = 'Hide Matches';
            icon.className = 'ri-arrow-up-s-line me-1';
        } else {
            container.style.display = 'none';
            text.textContent = 'Show Matches (' + container.children.length + ')';
            icon.className = 'ri-arrow-down-s-line me-1';
        }
    }

    function saveDocument() {
        if (!currentJobId) {
            bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();
            return;
        }
        var saveBtn = document.getElementById('saveDocBtn');
        if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving…'; }

        // POST /api/ocr/confirm — permanently archives the temp file and creates
        // the Document Library record, with any user-edited field values merged in.
        fetch('/api/ocr/confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                jobId: currentJobId,
                title: document.getElementById('res-title').value.trim(),
                institution: document.getElementById('res-inst').value.trim()
            })
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save to Document Library'; }
                if (!data.success) {
                    showToast('<i class="ri-error-warning-line me-1"></i>' + (data.error || 'Failed to save. Please try again.'), '#f06548');
                    return;
                }
                currentJobId = null;
                bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();
                loadDocuments();
                showToast('<i class="ri-checkbox-circle-line me-1"></i>Document saved to the library successfully.');
            })
            .catch(function () {
                if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save to Document Library'; }
                showToast('<i class="ri-error-warning-line me-1"></i>Failed to save — please try again.', '#f06548');
            });
    }

    // ── Toast (shared pattern used across CIPRMS pages) ──────────────────
    function showToast(msg, bg) {
        const t = document.getElementById('doc-toast');
        if (!t) return;
        t.innerHTML = msg; t.style.background = bg || '#405189';
        t.style.opacity = '1'; t.style.pointerEvents = 'auto';
        setTimeout(() => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; }, 3500);
    }
</script>

<!-- Toast -->
<div id="doc-toast" style="
    position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;
    color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;
    font-size:.8125rem;font-weight:600;
    box-shadow:0 4px 16px rgba(0,0,0,.18);
    opacity:0;pointer-events:none;transition:opacity .3s;
    display:flex;align-items:center;gap:.4rem;
"></div>

<%- include('../partials/document_viewer') %>

</body>
</html>
