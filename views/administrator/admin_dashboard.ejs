    <!-- JAVASCRIPT -->
    <script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
    <script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/velzon/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="/velzon/assets/js/plugins.js"></script>
    <script src="/velzon/assets/js/app.js"></script>
    <script src="/velzon/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>

    <script>
        // ── Leaflet Map (initialized empty; markers added once real data loads) ──
        const map = L.map('partnership-map', { center: [20, 15], zoom: 2, zoomControl: true });
        // Base map: OpenFreeMap (free, no account, no API key) drawn with MapLibre inside this Leaflet map, with every
        // place label forced to its Latin/English form. History: this was Carto's free "Voyager" raster endpoint, which
        // now answers every tile with a watermark saying an API key is required; the OpenStreetMap raster tiles that
        // replaced it print each country's own script (Japanese, Chinese, Korean, Cyrillic...) on the map.
        //
        // The labels are NOT written in this file: they come from the provider's own tile data. The stock style prints
        // the Latin name and then the native-script name under it; here each label uses only, in order, the provider's
        // English name, its Latin name/transliteration, the plain name when that is already Latin, or its international
        // (transliterated) name. A place that only has a native-script name in the data gets no label rather than a
        // label in a script most users cannot read. Highway numbers come from a separate field and are already Latin.
        const BASEMAP_STYLE_URL = 'https://tiles.openfreemap.org/styles/liberty';
        const LATIN_LABEL = ['case',
            ['has', 'name:en'], ['get', 'name:en'],
            ['has', 'name:latin'], ['get', 'name:latin'],
            ['!', ['has', 'name:nonlatin']], ['coalesce', ['get', 'name_en'], ['get', 'name']],
            ['all', ['has', 'name_int'], ['!=', ['get', 'name_int'], ['get', 'name']]], ['get', 'name_int'],
            ''];
        const BASEMAP_ATTRIBUTION = '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openmaptiles.org/" target="_blank" rel="noopener">OpenMapTiles</a> Data from <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>';

        // Only used when the vector base map cannot start (no WebGL in the browser, or the style could not be
        // fetched): plain OpenStreetMap raster tiles, so the map is never blank. Its labels are in each country's own
        // script — that is the price of the fallback — and the markers do not depend on either base map.
        function addFallbackBasemap() {
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);
        }
        (function addBasemap() {
            if (!(window.maplibregl && L.maplibreGL)) { addFallbackBasemap(); return; }
            fetch(BASEMAP_STYLE_URL).then(function (r) { if (!r.ok) throw new Error('style ' + r.status); return r.json(); }).then(function (style) {
                style.layers.forEach(function (l) {
                    if (l.type === 'symbol' && l.layout && l.layout['text-field'] && JSON.stringify(l.layout['text-field']).indexOf('name:latin') !== -1) {
                        l.layout['text-field'] = LATIN_LABEL;
                    }
                });
                let gl;
                try { gl = L.maplibreGL({ style: style, attribution: BASEMAP_ATTRIBUTION }).addTo(map); }
                catch (e) { if (gl) map.removeLayer(gl); throw e; }
                window.partnershipBasemap = gl;
            }).catch(function (err) { console.warn('Vector base map unavailable, using the raster fallback:', err && err.message); addFallbackBasemap(); });
        })();

        // Markers live in their own layer so a live refresh can clear and redraw them.
        const markerLayer = L.layerGroup().addTo(map);
        const countryHighlightLayer = L.layerGroup().addTo(map);
        window.countryHighlightLayer = countryHighlightLayer;

        const STATUS_COLOR = { active: '#17c653', expiring: '#f7b84b', expired: '#f06548' };
        const STATUS_RING = { active: '#d1fae5', expiring: '#fef3c7', expired: '#fee2e2' };
        const STATUS_LABEL = { active: 'Active', expiring: 'Expiring Soon', expired: 'Expired' };

        // Real partnership status strings ('Active' / 'Expiring Soon' / 'Expired') → map/badge color key
        function statusKey(status) {
            if (status === 'Active') return 'active';
            if (status === 'Expired') return 'expired';
            return 'expiring'; // covers 'Expiring Soon' and anything unrecognized
        }

        function makeIcon(key) {
            const c = STATUS_COLOR[key], r = STATUS_RING[key];
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 26 32">
        <ellipse cx="13" cy="30" rx="5" ry="2.5" fill="rgba(0,0,0,.18)"/>
        <circle cx="13" cy="13" r="12" fill="${r}" stroke="${c}" stroke-width="2.5"/>
        <circle cx="13" cy="13" r="6" fill="${c}"/>
    </svg>`;
            return L.divIcon({ className: '', html: svg, iconSize: [26, 32], iconAnchor: [13, 30], popupAnchor: [0, -28] });
        }

        // Institution/country/type come from user input, OCR, or a third-party list —
        // always escaped before going into popup HTML.
        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // Approximate (country-level) locations get a dashed, semi-transparent ring so
        // they can never be mistaken for an exact institution location.
        function makeApproxIcon(key) {
            const c = STATUS_COLOR[key];
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 26 32">
        <ellipse cx="13" cy="30" rx="5" ry="2.5" fill="rgba(0,0,0,.12)"/>
        <circle cx="13" cy="13" r="12" fill="#ffffff" fill-opacity="0.65" stroke="${c}" stroke-width="2.5" stroke-dasharray="4 3"/>
        <circle cx="13" cy="13" r="4" fill="${c}" fill-opacity="0.55"/>
    </svg>`;
            return L.divIcon({ className: '', html: svg, iconSize: [26, 32], iconAnchor: [13, 30], popupAnchor: [0, -28] });
        }

        // One marker for several partnerships sharing the same coordinates: a numbered
        // circle, colored by the worst status among its members.
        function makeGroupIcon(count, key, approx) {
            const c = STATUS_COLOR[key], r = STATUS_RING[key];
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
        <circle cx="17" cy="17" r="15" fill="${approx ? '#ffffff' : r}" fill-opacity="${approx ? '0.75' : '1'}" stroke="${c}" stroke-width="3"${approx ? ' stroke-dasharray="5 3"' : ''}/>
        <text x="17" y="22" text-anchor="middle" font-family="Inter,sans-serif" font-size="14" font-weight="700" fill="#0d1b3e">${count}</text>
    </svg>`;
            return L.divIcon({ className: '', html: svg, iconSize: [34, 34], iconAnchor: [17, 17], popupAnchor: [0, -18] });
        }

        const STATUS_RANK = { active: 1, expiring: 2, expired: 3 };

        // A record is placed on the map only with valid numeric coordinates that are not
        // flagged unresolved — never an invented location.
        function hasMapLocation(p) {
            return typeof p.lat === 'number' && typeof p.lng === 'number'
                && isFinite(p.lat) && isFinite(p.lng)
                && Math.abs(p.lat) <= 90 && Math.abs(p.lng) <= 180
                && p.locationStatus !== 'unresolved';
        }
        // Country-level fallback points. Legacy records (no location metadata) are exact.
        function isApproximate(p) {
            return p.locationPrecision === 'country' || p.locationStatus === 'approximate';
        }

        function badgesHtml(p, key) {
            return `<span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f0fe;color:#405189;">${esc(p.type || '')}</span>
            <span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:${STATUS_RING[key]};color:${STATUS_COLOR[key]};">${STATUS_LABEL[key]}</span>`;
        }
        const APPROX_NOTE = `<div style="font-size:10.5px;color:#b45309;margin-bottom:6px;">Approximate location (country level)</div>`;

        function singlePopupHtml(p, approx) {
            const key = statusKey(p.status);
            return `<div style="font-family:Inter,sans-serif;min-width:180px;">
        <div style="font-weight:700;font-size:13px;color:#0d1b3e;margin-bottom:4px;">${esc(p.inst || p.institution || 'Partner Institution')}</div>
        <div style="font-size:11.5px;color:#64748b;margin-bottom:6px;">${esc(p.country || '')}</div>
        ${approx ? APPROX_NOTE : ''}
        <div style="display:flex;gap:6px;">${badgesHtml(p, key)}</div>
    </div>`;
        }

        function groupPopupHtml(items, approx) {
            const rows = items.map(function (p) {
                const key = statusKey(p.status);
                return `<div style="border-top:1px solid #e9ebec;padding:6px 0;">
            <div style="font-weight:700;font-size:12.5px;color:#0d1b3e;">${esc(p.inst || p.institution || 'Partner Institution')}</div>
            <div style="font-size:11px;color:#64748b;margin-bottom:4px;">${esc(p.country || '')}</div>
            <div style="display:flex;gap:6px;">${badgesHtml(p, key)}</div>
        </div>`;
            }).join('');
            return `<div style="font-family:Inter,sans-serif;min-width:220px;">
        <div style="font-weight:700;font-size:13px;color:#0d1b3e;margin-bottom:4px;">${items.length} partnerships at this location</div>
        ${approx ? APPROX_NOTE : ''}
        <div style="max-height:190px;overflow-y:auto;">${rows}</div>
    </div>`;
        }

        let currentMapMarkers = [];
        let allLoadedPartnerships = [];

        function renderMap(partnerships) {
            // Group by identical coordinates (exact and approximate kept apart) so several
            // partnerships in one place become ONE marker whose popup lists them all,
            // instead of markers stacked on top of each other.
            allLoadedPartnerships = Array.isArray(partnerships) ? partnerships : [];
            markerLayer.clearLayers();
            if (window.countryHighlightLayer) window.countryHighlightLayer.clearLayers();
            currentMapMarkers = [];
            const alertBox = document.getElementById('map-country-alert');
            if (alertBox) { alertBox.style.display = 'none'; alertBox.innerHTML = ''; }

            const groups = new Map();
            let unmapped = 0, approxCount = 0, onMap = 0;
            allLoadedPartnerships.forEach(function (p) {
                if (!hasMapLocation(p)) { unmapped++; return; }
                const approx = isApproximate(p);
                onMap++;
                if (approx) approxCount++;
                const gk = p.lat.toFixed(5) + ',' + p.lng.toFixed(5) + (approx ? '~' : '');
                if (!groups.has(gk)) groups.set(gk, { lat: p.lat, lng: p.lng, approx: approx, items: [] });
                groups.get(gk).items.push(p);
            });

            groups.forEach(function (g) {
                let marker;
                if (g.items.length === 1) {
                    const key = statusKey(g.items[0].status);
                    marker = L.marker([g.lat, g.lng], { icon: g.approx ? makeApproxIcon(key) : makeIcon(key) })
                        .bindPopup(singlePopupHtml(g.items[0], g.approx), { maxWidth: 240 });
                } else {
                    const worst = g.items.reduce(function (w, p) {
                        const k = statusKey(p.status);
                        return STATUS_RANK[k] > STATUS_RANK[w] ? k : w;
                    }, 'active');
                    marker = L.marker([g.lat, g.lng], { icon: makeGroupIcon(g.items.length, worst, g.approx) })
                        .bindPopup(groupPopupHtml(g.items, g.approx), { maxWidth: 280 });
                }
                marker._groupData = g;
                marker.addTo(markerLayer);
                currentMapMarkers.push(marker);
            });

            // Coverage note: what is on the map, what is approximate, and how many
            // partnerships have no resolved location (they get no marker at all).
            const note = document.getElementById('map-coverage-note');
            if (note && allLoadedPartnerships.length) {
                const parts = [`<span><i class="ri-map-pin-2-line me-1"></i>${onMap} of ${allLoadedPartnerships.length} partnerships on the map</span>`];
                if (approxCount) parts.push(`<span>${approxCount} approximate (dashed markers = country level)</span>`);
                if (unmapped) parts.push(`<span class="text-warning-emphasis"><i class="ri-error-warning-line me-1"></i>${unmapped} not on map (location unresolved)</span>`);
                note.innerHTML = parts.join('<span class="mx-2">&middot;</span>');
                note.style.display = '';
            }
            setTimeout(function () { map.invalidateSize(); }, 300);
        }

        function clearCountrySelectionVisuals() {
            if (window.countryHighlightLayer) window.countryHighlightLayer.clearLayers();
            document.querySelectorAll('.top-country-row').forEach(function (r) { r.classList.remove('active-country-row'); });
            const alertBox = document.getElementById('map-country-alert');
            if (alertBox) { alertBox.style.display = 'none'; alertBox.innerHTML = ''; }
        }

        function flyToContinent(btn, lat, lng, zoom) {
            document.querySelectorAll('.continent-tab').forEach(function (t) { t.classList.remove('active', 'btn-soft-primary'); t.classList.add('btn-soft-secondary'); });
            if (btn) { btn.classList.remove('btn-soft-secondary'); btn.classList.add('active', 'btn-soft-primary'); }
            clearCountrySelectionVisuals();
            map.flyTo([lat, lng], zoom, { duration: 1.2 });
        }

        // ── Country → ISO2 code, for the flag emoji in "Top Partner Countries" ──
        // Rendered as native Unicode flag emoji rather than an <img> pointed at
        // an external CDN (flagcdn.com) — that's what silently broke before:
        // no fallback when the CDN was unreachable, so every flag showed as a
        // broken-image icon. Emoji render natively, no network dependency.
        // Supports both full country names AND a raw 2-letter code typed
        // directly (e.g. "PH", "jp"). A country that matches neither simply
        // gets the 🌍 fallback — never a fabricated code.
        const COUNTRY_CODE = {
            'Philippines': 'ph', 'Japan': 'jp', 'South Korea': 'kr', 'Korea': 'kr', 'North Korea': 'kp',
            'China': 'cn', 'Singapore': 'sg', 'Australia': 'au', 'Thailand': 'th', 'New Zealand': 'nz',
            'Netherlands': 'nl', 'USA': 'us', 'US': 'us', 'United States': 'us', 'United States of America': 'us',
            'Germany': 'de', 'United Kingdom': 'gb', 'UK': 'gb', 'Canada': 'ca', 'France': 'fr',
            'Spain': 'es', 'Italy': 'it', 'India': 'in', 'Indonesia': 'id', 'Malaysia': 'my', 'Vietnam': 'vn',
            'Taiwan': 'tw', 'Hong Kong': 'hk', 'Brazil': 'br', 'Mexico': 'mx',
            'Russia': 'ru', 'Russian Federation': 'ru', 'Switzerland': 'ch', 'Sweden': 'se', 'Norway': 'no',
            'Denmark': 'dk', 'Finland': 'fi', 'Belgium': 'be', 'Austria': 'at', 'Ireland': 'ie',
            'Portugal': 'pt', 'Poland': 'pl', 'United Arab Emirates': 'ae', 'UAE': 'ae',
            'Saudi Arabia': 'sa', 'Turkey': 'tr', 'Egypt': 'eg', 'South Africa': 'za'
        };

        // Lookups derived from COUNTRY_CODE. The FIRST name listed for a code is the one shown for it ("United Kingdom",
        // not "UK"), and names are matched case-insensitively, so "philippines", " Philippines " and a bare "ph" all
        // resolve to the same country. Anything not in the table keeps its own (trimmed) spelling — never a guess.
        const CODE_DISPLAY = {}, NAME_TO_CODE = {};
        Object.keys(COUNTRY_CODE).forEach(name => {
            const code = COUNTRY_CODE[name];
            if (!CODE_DISPLAY[code]) CODE_DISPLAY[code] = name;
            NAME_TO_CODE[name.toLowerCase()] = code;
        });

        // The ISO2 code for a country as typed in a record, or null when it is not one we can identify.
        function countryCodeOf(raw) {
            const t = String(raw || '').replace(/\s+/g, ' ').trim().toLowerCase();
            if (!t) return null;
            if (/^[a-z]{2}$/.test(t)) return CODE_DISPLAY[t] ? t : null;
            return NAME_TO_CODE[t] || null;
        }

        function countryToFlagEmoji(country) {
            const code = countryCodeOf(country);
            if (!code) return null;
            return String.fromCodePoint(...[...code.toUpperCase()].map(c => 127397 + c.charCodeAt(0)));
        }

        // Ranks the countries named on the REAL partnership records (never a fixed list). Records whose country differs
        // only by case/spacing, or is a bare ISO code, count as one country; the records themselves are not changed.
        function aggregateCountries(partnerships) {
            const groups = new Map();
            partnerships.forEach(p => {
                const raw = String((p && p.country) || '').replace(/\s+/g, ' ').trim();
                if (!raw) return;                                   // a blank country is skipped, never a fake bucket
                const code = countryCodeOf(raw);
                const key = code ? 'code:' + code : 'name:' + raw.toLowerCase();
                let g = groups.get(key);
                if (!g) { g = { code, count: 0, spellings: new Map() }; groups.set(key, g); }
                g.count++;
                g.spellings.set(raw, (g.spellings.get(raw) || 0) + 1);
            });
            return [...groups.values()].map(g => {
                // shown name: the canonical one for a known code, else the spelling used most often on the records
                const common = [...g.spellings.entries()].sort((x, y) => y[1] - x[1] || (/^[A-Z]/.test(y[0]) - /^[A-Z]/.test(x[0])) || x[0].localeCompare(y[0]))[0][0];
                return { country: g.code ? CODE_DISPLAY[g.code] : common, code: g.code, count: g.count };
            }).sort((x, y) => y.count - x.count || x.country.localeCompare(y.country));
        }

        function isCountryMatch(recordCountry, selectedCountry, selectedCode) {
            if (!recordCountry) return false;
            const rec = String(recordCountry).replace(/\s+/g, ' ').trim().toLowerCase();
            const sel = String(selectedCountry || '').replace(/\s+/g, ' ').trim().toLowerCase();
            if (rec === sel) return true;
            const recCode = countryCodeOf(rec);
            if (selectedCode && recCode && recCode.toLowerCase() === String(selectedCode).toLowerCase()) return true;
            return false;
        }

        function selectCountryForMap(countryName, countryCode) {
            // 1. Highlight clicked row in the list
            document.querySelectorAll('.top-country-row').forEach(function (row) {
                if (row.getAttribute('data-country') === countryName) {
                    row.classList.add('active-country-row');
                } else {
                    row.classList.remove('active-country-row');
                }
            });

            // 2. Clear continent tab active states
            document.querySelectorAll('.continent-tab').forEach(function (t) {
                t.classList.remove('active', 'btn-soft-primary');
                t.classList.add('btn-soft-secondary');
            });

            // 3. Clear previous highlight layer & alert
            if (window.countryHighlightLayer) window.countryHighlightLayer.clearLayers();
            const alertBox = document.getElementById('map-country-alert');
            if (alertBox) { alertBox.style.display = 'none'; alertBox.innerHTML = ''; }

            // 4. Smooth scroll to the Map section
            const mapContainer = document.getElementById('partnership-map');
            if (mapContainer) {
                const mapCard = mapContainer.closest('.card') || mapContainer;
                mapCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            // 5. Find markers matching this country
            const matchingMarkers = currentMapMarkers.filter(function (m) {
                return m._groupData && m._groupData.items && m._groupData.items.some(function (p) {
                    return isCountryMatch(p.country, countryName, countryCode);
                });
            });

            // 6. Handle case with matching markers
            if (matchingMarkers.length > 0) {
                const latLngs = [];
                matchingMarkers.forEach(function (m) {
                    const lat = m._groupData.lat;
                    const lng = m._groupData.lng;
                    latLngs.push([lat, lng]);

                    // Add highlight pulse circle around the marker
                    L.circleMarker([lat, lng], {
                        radius: m._groupData.items.length > 1 ? 26 : 22,
                        color: '#405189',
                        weight: 3,
                        dashArray: '4, 4',
                        fillColor: '#405189',
                        fillOpacity: 0.18,
                        className: 'pulse-country-ring'
                    }).addTo(countryHighlightLayer);
                });

                if (matchingMarkers.length === 1) {
                    const single = matchingMarkers[0];
                    map.flyTo([single._groupData.lat, single._groupData.lng], 6, { duration: 1.2 });
                    setTimeout(function () {
                        if (single && single.openPopup) single.openPopup();
                    }, 1250);
                } else {
                    const bounds = L.latLngBounds(latLngs);
                    map.flyToBounds(bounds, { padding: [50, 50], maxZoom: 6, duration: 1.2 });
                }

                // Show status notification bar above the map with reset option
                if (alertBox) {
                    alertBox.innerHTML = '<div class="alert alert-primary alert-dismissible d-flex align-items-center justify-content-between p-2 mb-2 fs-12" role="alert">' +
                        '<span><i class="ri-map-pin-fill text-primary me-1"></i>Showing <strong>' + matchingMarkers.length + '</strong> partnership location' + (matchingMarkers.length > 1 ? 's' : '') + ' in <strong>' + esc(countryName) + '</strong></span>' +
                        '<button type="button" class="btn btn-sm btn-link text-primary p-0 text-decoration-underline ms-2" onclick="clearCountrySelection()">View All</button>' +
                        '</div>';
                    alertBox.style.display = '';
                }
            } else {
                // 7. No valid coordinates on file for this country: show graceful empty state
                const countryPartnerships = allLoadedPartnerships.filter(function (p) {
                    return isCountryMatch(p.country, countryName, countryCode);
                });
                const total = countryPartnerships.length || 0;
                if (alertBox) {
                    alertBox.innerHTML = '<div class="alert alert-warning alert-dismissible d-flex align-items-center justify-content-between p-2 mb-2 fs-12" role="alert">' +
                        '<span><i class="ri-information-line me-1"></i>No geographic coordinates on file for <strong>' + esc(countryName) + '</strong> (' + total + ' agreement' + (total === 1 ? '' : 's') + '). Locations will appear once coordinates are added.</span>' +
                        '<button type="button" class="btn btn-sm btn-link text-warning-emphasis p-0 text-decoration-underline ms-2" onclick="clearCountrySelection()">Dismiss</button>' +
                        '</div>';
                    alertBox.style.display = '';
                }
            }
        }

        function clearCountrySelection() {
            clearCountrySelectionVisuals();
            const worldBtn = document.querySelector('.continent-tab[onclick*="20,0,2"]');
            if (worldBtn) flyToContinent(worldBtn, 20, 0, 2);
        }

        function renderTopCountries(partnerships) {
            const el = document.getElementById('top-countries-list');
            const list = Array.isArray(partnerships) ? partnerships : [];
            const top = aggregateCountries(list).slice(0, 7);
            if (!top.length) {
                el.innerHTML = '<p class="text-muted fs-13 mb-0">' + (list.length ? 'No partnership has a country recorded yet.' : 'No partnership records yet.') + '</p>';
                return;
            }
            const max = top[0].count;
            el.innerHTML = top.map(({ country, code, count }) => {
                const safeCountry = esc(country);
                const flagHtml = code
                    ? `<img src="https://flagcdn.com/w40/${code.toLowerCase()}.png"
                            srcset="https://flagcdn.com/w80/${code.toLowerCase()}.png 2x"
                            alt="${safeCountry} flag"
                            class="rounded shadow-sm country-flag-img flex-shrink-0"
                            loading="lazy"
                            style="width:28px;height:19px;object-fit:cover;vertical-align:middle;border:1px solid rgba(0,0,0,0.12);"
                            onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\\'avatar-title bg-light text-muted rounded shadow-sm country-flag-fallback flex-shrink-0\\' style=\\'width:28px;height:19px;font-size:12px;display:inline-flex;align-items:center;justify-content:center;\\'><i class=\\'ri-earth-line\\'></i></span>';">`
                    : `<span class="avatar-title bg-light text-muted rounded shadow-sm country-flag-fallback flex-shrink-0" style="width:28px;height:19px;font-size:12px;display:inline-flex;align-items:center;justify-content:center;"><i class="ri-earth-line"></i></span>`;
                const pct = Math.round((count / max) * 100);
                return `<div class="top-country-row d-flex align-items-center p-2 rounded mb-2"
        role="button"
        tabindex="0"
        data-country="${safeCountry}"
        data-code="${code || ''}"
        onclick="selectCountryForMap('${safeCountry}', '${code || ''}')"
        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectCountryForMap('${safeCountry}', '${code || ''}');}"
        title="View ${safeCountry} on map">
        <div class="flex-shrink-0 me-3 country-flag-wrapper" style="width:28px;height:19px;display:flex;align-items:center;justify-content:center;">${flagHtml}</div>
        <div class="flex-grow-1" style="min-width:0;">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <span class="fs-13 fw-medium text-truncate" title="${esc(country)}" style="min-width:0;">${esc(country)}</span>
                <span class="fs-12 fw-semibold flex-shrink-0 text-muted">${count}</span>
            </div>
            <div class="progress" style="height:4px;">
                <div class="progress-bar bg-primary" style="width:${pct}%"></div>
            </div>
        </div>
        <div class="flex-shrink-0 ms-2 text-muted country-nav-arrow" style="font-size:15px;line-height:1;opacity:0.5;">
            <i class="ri-arrow-right-s-line"></i>
        </div>
    </div>`;
            }).join('');
        }

        function fmtDate(s) {
            const d = new Date(s);
            return isNaN(d) ? (s || '—') : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // The charts are rebuilt on every live refresh, so the previous ones are destroyed first.
        var dashCharts = [];
        function renderCharts(stats) {
            dashCharts.forEach(function (c) { try { c.destroy(); } catch (_) { /* already gone */ } });
            dashCharts = [];
            var typeChart = new ApexCharts(document.getElementById('type-status-chart'), {
                chart: { type: 'bar', height: 300, toolbar: { show: false } },
                plotOptions: { bar: { horizontal: false, columnWidth: '45%', borderRadius: 4 } },
                dataLabels: { enabled: false },
                series: [
                    { name: 'MOA', data: [stats.byType.MOA || 0] },
                    { name: 'MOU', data: [stats.byType.MOU || 0] },
                    { name: 'Active', data: [stats.active] },
                    { name: 'Expiring', data: [stats.expiring] },
                    { name: 'Expired', data: [stats.expired] }
                ],
                xaxis: { categories: ['Agreements'] },
                colors: ['#405189', '#0ab39c', '#17c653', '#f7b84b', '#f06548'],
                legend: { position: 'bottom' },
                grid: { borderColor: '#f1f1f1' }
            });
            typeChart.render();
            dashCharts.push(typeChart);

            // byCountry (unlike byInstitution) is never capped server-side —
            // see /api/partnerships/stats in cirl.js — so countryTotal here is
            // the exact sum of every bar shown, and each bar's own percentage
            // of that total always adds up to ~100% across the whole chart.
            // Records with a blank/missing country are already excluded
            // server-side, so they can't silently skew this percentage.
            const countryEntries = Object.entries(stats.byCountry || {}).sort((a, b) => b[1] - a[1]);
            // Percentage is always computed against the FULL country
            // population (countryEntries/countryTotal, every country on
            // record) — never recomputed against just the displayed subset
            // below — so limiting what's shown can never change what each
            // shown country's percentage actually means.
            const countryTotal = countryEntries.reduce((sum, e) => sum + e[1], 0);
            function countryPct(count) { return countryTotal ? (count / countryTotal * 100) : 0; }
            // 2026-09-19: capped to the Top 8 by count (already sorted
            // descending above) — an uncapped country list could run past 20
            // distinct values on a real deployment, overcrowding this card.
            // This slice happens AFTER sorting/aggregation and is display-only:
            // countryEntries/countryTotal above (and therefore every shown
            // country's percentage) still reflect every country on record,
            // exactly as before. Countries beyond the top 8 are simply never
            // rendered — no data is altered, no name is hardcoded.
            const COUNTRY_CHART_MAX_ENTRIES = 8;
            const displayedCountryEntries = countryEntries.slice(0, COUNTRY_CHART_MAX_ENTRIES);
            // Height now scales with what's actually SHOWN (≤8 rows), not the
            // full, potentially much longer country list — previously this
            // scaled with countryEntries.length, so the card kept growing
            // taller as more countries existed even though only 8 are ever
            // displayed.
            const countryChartHeight = Math.max(300, displayedCountryEntries.length * 26);

            // Country names have no fixed length, and this label is an SVG
            // <text> node (the axis-label column ApexCharts renders for a
            // horizontal bar chart) — CSS text-overflow/white-space/overflow
            // only apply to HTML block/inline-block boxes, not SVG text, so
            // they cannot truncate this the way they would a normal HTML
            // label. A long name (e.g. "United States of America") would
            // otherwise render past the label column, pushing/overlapping
            // the "(43.6%)" suffix and widening the card past its bounds.
            // This reimplements the same "truncate + ellipsis" behavior
            // text-overflow:ellipsis gives HTML elements, applied only to the
            // country-name portion — the "(pct%)" suffix is built afterward
            // and is therefore never itself cut off.
            var COUNTRY_LABEL_MAX_CHARS = 17;
            function truncateCountryName(name) {
                var s = String(name == null ? '' : name);
                return s.length > COUNTRY_LABEL_MAX_CHARS
                    ? s.slice(0, COUNTRY_LABEL_MAX_CHARS).replace(/\s+$/, '') + '...'
                    : s;
            }

            // Full (untruncated) label per entry, keyed by the truncated
            // label actually rendered — used below to restore the complete
            // country name as a native hover tooltip, without touching
            // stats.byCountry (the underlying count/percentage data) at all.
            var countryAxisLabels = [];
            var fullLabelByTruncated = {};
            displayedCountryEntries.forEach(function (entry) {
                var country = entry[0], count = entry[1];
                var pctStr = countryPct(count).toFixed(1) + '%';
                var truncated = truncateCountryName(country) + ' (' + pctStr + ')';
                var full = country + ' (' + pctStr + ')';
                countryAxisLabels.push(truncated);
                fullLabelByTruncated[truncated] = full;
            });

            // Restores the full country name as a native SVG <title> (a
            // real browser tooltip on hover) on each truncated axis label —
            // only added when that row was actually truncated. ApexCharts
            // doesn't expose a hook to attach per-label tooltips directly in
            // its options, so this reaches into the rendered chart's own DOM
            // via chart.events.mounted/updated, which fire once the axis
            // label <text> elements actually exist.
            function restoreFullCountryNameTooltips() {
                var textEls = document.querySelectorAll('#country-chart .apexcharts-yaxis-texts-g text');
                textEls.forEach(function (el, i) {
                    var truncatedLabel = countryAxisLabels[i];
                    var fullLabel = truncatedLabel && fullLabelByTruncated[truncatedLabel];
                    if (!fullLabel || fullLabel === truncatedLabel) return; // not truncated — nothing to add
                    var existingTitle = el.querySelector('title');
                    if (existingTitle) existingTitle.remove();
                    var titleEl = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                    titleEl.textContent = fullLabel;
                    el.appendChild(titleEl);
                });
            }

            // The percentage is folded into the axis label itself (e.g.
            // "Philippines (43.6%)") rather than appended to the bar's own
            // data label. A first attempt put "<count> (<pct>%)" on the data
            // label the same way the count-only label already works on the
            // sibling College/Unit chart below — but ApexCharts renders a bar
            // data label in white, assuming it always sits inside a filled
            // bar; once the label text is longer than a short/low-count bar
            // (true for nearly every country here once a percentage is
            // added), the label overflows onto the card's white background
            // and the white-on-white remainder is simply invisible. The axis
            // label has no such failure mode — it's always plain dark text
            // in its own fixed column, at any bar length — so it's the only
            // place a percentage is guaranteed legible for every country, not
            // just the largest one or two.
            var countryChart = new ApexCharts(document.getElementById('country-chart'), {
                chart: {
                    type: 'bar', height: countryChartHeight, toolbar: { show: false },
                    events: { mounted: restoreFullCountryNameTooltips, updated: restoreFullCountryNameTooltips }
                },
                plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
                dataLabels: { enabled: true },
                series: [{ name: 'Partnerships', data: displayedCountryEntries.map(e => e[1]) }],
                // ApexCharts applies its OWN default axis-label max-width/
                // ellipsis behavior on top of whatever string it's given —
                // confirmed live: even a label already pre-truncated to a
                // safe length by truncateCountryName() above was getting
                // RE-truncated by ApexCharts' own default width budget,
                // cutting straight into the "(43.6%)" suffix, since it has
                // no idea part of the string is a percentage that must
                // survive intact. `labels.trim: false` disables that second,
                // uncontrolled truncation pass — ours is the only one that
                // ever runs — and `maxWidth: 260` gives it enough room for
                // the longest label this chart can now produce
                // (17-char name + "..." + " (100.0%)") with margin to spare.
                xaxis: { categories: countryAxisLabels, labels: { maxWidth: 260, trim: false } },
                yaxis: { labels: { maxWidth: 260, trim: false } },
                colors: ['#0ab39c'],
                tooltip: {
                    y: {
                        // The tooltip that appears on hovering a BAR already
                        // exists — extended here to also carry the full,
                        // untruncated country name, so the complete name is
                        // reachable via hover regardless of whether the user
                        // is over the axis label text or the bar itself.
                        title: { formatter: function (seriesName, opts) { return fullLabelByTruncated[countryAxisLabels[opts.dataPointIndex]] || countryAxisLabels[opts.dataPointIndex]; } },
                        formatter: (val) => val + ' partnerships'
                    }
                },
                grid: { borderColor: '#f1f1f1' }
            });
            countryChart.render();
            dashCharts.push(countryChart);

            const unitEntries = Object.entries(stats.byUnit || {}).sort((a, b) => b[1] - a[1]);
            var collegeChart = new ApexCharts(document.getElementById('college-chart'), {
                chart: { type: 'bar', height: 300, toolbar: { show: false } },
                plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
                dataLabels: { enabled: true },
                series: [{ name: 'Partnerships', data: unitEntries.map(e => e[1]) }],
                xaxis: { categories: unitEntries.map(e => e[0]) },
                colors: ['#405189'],
                grid: { borderColor: '#f1f1f1' }
            });
            collegeChart.render();
            dashCharts.push(collegeChart);
        }

        // ── DSS & Expiring table are server-side rendered — no loading state. ──
        // Only the charts, map, and top-countries list require client-side JS.

        // Loads (and, on a live update, reloads) everything the page draws client-side: the charts, the map and the
        // Top Partner Countries list. `no-store` so a stale cached copy can never be shown. Resolves false when a
        // background refresh failed, so CIPRMS.live retries it later; a failed refresh never wipes what is on screen.
        function loadDashboardData(live) {
            // 1. Stats API → charts only (counters already rendered by EJS)
            const statsDone = fetch('/api/partnerships/stats', { cache: 'no-store' })
                .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(stats => { renderCharts(stats); return true; })
                .catch(err => {
                    console.error('Stats API failed:', err);
                    if (!live) renderCharts({ active: 0, expiring: 0, expired: 0, total: 0, byType: {}, byRegion: {}, byUnit: {}, byInstitution: {}, byCountry: {} });
                    return false;
                });

            // 2. Partnerships list → map + top countries only
            const listDone = fetch('/api/partnerships', { cache: 'no-store' })
                .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(partnerships => {
                    const list = Array.isArray(partnerships) ? partnerships : [];
                    renderMap(list);
                    renderTopCountries(list);
                    return true;
                })
                .catch(err => { console.error('Map data failed:', err); return false; });

            return Promise.all([statsDone, listDone]).then(r => r.indexOf(false) === -1);
        }
        loadDashboardData(false);

        // Live updates: a partnership was added, edited, renewed or deleted (Monitoring, Requests, another admin…).
        if (window.CIPRMS && CIPRMS.live) {
            CIPRMS.live(['partnership.updated', 'partnership.statusChanged'], function () { return loadDashboardData(true); }, { debounce: 250 });
        }

        /* ═══════════════════════════════════════════════════════════════
           ACHIEVEMENTS (2026-11) — reuses the page's own esc() for HTML
           escaping and the globally-loaded CIPRMS.api()/CIPRMS.toast()
           (public/js/ciprms-rt.js, loaded by every authenticated page via
           header.ejs) for all network calls and feedback — no duplicate
           helpers declared here.
           ═══════════════════════════════════════════════════════════════ */
        var ACH_ALL = [];
        var ACH_ACTIVE_FILTER = 'all';
        var ACH_EDIT_ID = null;      // non-null while the form modal is editing an existing achievement
        var ACH_DELETE_ID = null;    // pending id for the delete-confirmation modal
        var ACH_REMOVE_FILE = false; // set when the user clicks "Remove file" while editing
        var achievementsModalEl = document.getElementById('achievements-modal');
        var achievementFormModalEl = document.getElementById('achievement-form-modal');
        var achievementDeleteModalEl = document.getElementById('achievement-delete-modal');

        var ACH_CATEGORY_BADGE = {
            'QS Ranking': 'bg-primary-subtle text-primary',
            'TUV Certification': 'bg-info-subtle text-info',
            'PQA': 'bg-success-subtle text-success',
            'Accreditation': 'bg-warning-subtle text-warning',
            'Ranking': 'bg-primary-subtle text-primary',
            'Award': 'bg-danger-subtle text-danger',
            'Other': 'bg-secondary-subtle text-secondary'
        };
        function achCategoryBadge(cat) {
            return '<span class="badge ' + (ACH_CATEGORY_BADGE[cat] || 'bg-secondary-subtle text-secondary') + '">' + esc(cat || 'Other') + '</span>';
        }
        function achFmtDate(iso) {
            if (!iso) return '';
            var d = new Date(iso);
            return isNaN(d) ? esc(iso) : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }
        function achFileIcon(fileType) {
            if (fileType === 'application/pdf') return 'ri-file-pdf-2-line';
            if (fileType === 'image/jpeg' || fileType === 'image/png') return 'ri-image-2-line';
            return 'ri-file-line';
        }
        function achIsImage(fileType) { return fileType === 'image/jpeg' || fileType === 'image/png'; }
        // Swaps a broken/unavailable achievement image for the same placeholder used when no file was
        // uploaded at all (deleted-on-disk file, failed Drive fetch, etc. — never a blank/broken-image icon).
        function achImgError(img) {
            var ph = document.createElement('div');
            ph.className = 'ach-card-image-placeholder';
            ph.innerHTML = '<i class="ri-image-line"></i>';
            img.replaceWith(ph);
        }

        function achRenderList() {
            var el = document.getElementById('ach-list');
            var rows = ACH_ACTIVE_FILTER === 'all' ? ACH_ALL : ACH_ALL.filter(function (a) { return a.category === ACH_ACTIVE_FILTER; });
            if (!rows.length) {
                el.innerHTML = '<div class="col-12 text-center text-muted py-5">' +
                    '<i class="ri-trophy-line display-5 d-block mb-2"></i>' +
                    (ACH_ALL.length ? 'No achievements in this category yet.' : 'No achievements recorded yet. Click "Add Achievement" to get started.') +
                    '</div>';
                return;
            }
            el.innerHTML = rows.map(function (a) {
                var fileHtml = a.fileLink
                    ? '<a class="btn btn-sm btn-soft-secondary" href="' + a.fileLink + '" target="_blank" rel="noopener"><i class="' + achFileIcon(a.fileType) + ' me-1"></i>View File</a>'
                    : '';
                var imageHtml = a.fileLink && achIsImage(a.fileType)
                    ? '<img class="ach-card-image" src="' + a.fileLink + '" alt="" onerror="achImgError(this)">'
                    : '<div class="ach-card-image-placeholder"><i class="' + (a.fileLink ? achFileIcon(a.fileType) : 'ri-trophy-line') + '"></i></div>';
                return '<div class="col-md-6 col-lg-4">' +
                    '<div class="ach-card">' +
                        imageHtml +
                        '<div class="ach-card-body">' +
                            '<div class="mb-2">' + achCategoryBadge(a.category) + '</div>' +
                            '<div class="ach-card-title">' + esc(a.title) + '</div>' +
                            '<div class="ach-card-meta">' +
                                (a.organization ? esc(a.organization) : '<span class="text-muted">No organization specified</span>') +
                                (a.dateAchieved ? ' &middot; ' + achFmtDate(a.dateAchieved) : '') +
                            '</div>' +
                            '<div class="ach-card-desc">' + (a.description ? esc(a.description) : '<span class="text-muted">No description provided.</span>') + '</div>' +
                            '<div class="ach-card-actions">' +
                                fileHtml +
                                '<button type="button" class="btn btn-sm btn-soft-primary" onclick="achOpenForm(' + a.id + ')"><i class="ri-edit-line me-1"></i>Edit</button>' +
                                '<button type="button" class="btn btn-sm btn-soft-danger ms-auto" onclick="achOpenDelete(' + a.id + ')"><i class="ri-delete-bin-line"></i></button>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        function achFilterBy(cat, el) {
            ACH_ACTIVE_FILTER = cat;
            document.querySelectorAll('.ach-filter-tab').forEach(function (t) { t.classList.remove('active'); });
            if (el) el.classList.add('active');
            achRenderList();
        }

        function achLoadList() {
            return CIPRMS.api('/api/achievements', { quiet: true }).then(function (res) {
                if (!res.ok) {
                    document.getElementById('ach-list').innerHTML = '<div class="col-12 text-center text-danger py-4">Unable to load achievements.</div>';
                    return false;
                }
                ACH_ALL = Array.isArray(res.data) ? res.data : [];
                achRenderList();
                return true;
            });
        }

        function achResetForm() {
            ACH_EDIT_ID = null;
            ACH_REMOVE_FILE = false;
            document.getElementById('ach-f-title').value = '';
            document.getElementById('ach-f-category').value = '';
            document.getElementById('ach-f-org').value = '';
            document.getElementById('ach-f-date').value = '';
            document.getElementById('ach-f-desc').value = '';
            document.getElementById('ach-f-file').value = '';
            document.getElementById('ach-f-current-file').style.display = 'none';
            document.getElementById('ach-f-current-file').innerHTML = '';
            document.querySelectorAll('#achievement-form-modal .is-invalid').forEach(function (e) { e.classList.remove('is-invalid'); });
        }

        // id omitted -> Add mode; id given -> Edit mode, prefilled from the already-loaded list (no extra request).
        function achOpenForm(id) {
            achResetForm();
            var modalTitle = document.getElementById('ach-form-title');
            if (id) {
                var a = ACH_ALL.find(function (x) { return x.id === id; });
                if (!a) return;
                ACH_EDIT_ID = id;
                modalTitle.innerHTML = '<i class="ri-edit-line me-2 text-primary"></i>Edit Achievement';
                document.getElementById('ach-f-title').value = a.title || '';
                document.getElementById('ach-f-category').value = a.category || '';
                document.getElementById('ach-f-org').value = a.organization || '';
                document.getElementById('ach-f-date').value = a.dateAchieved || '';
                document.getElementById('ach-f-desc').value = a.description || '';
                if (a.fileLink) {
                    var cur = document.getElementById('ach-f-current-file');
                    cur.style.display = '';
                    cur.innerHTML = '<div class="d-flex align-items-center justify-content-between border rounded p-2">' +
                        '<span><i class="' + achFileIcon(a.fileType) + ' me-1"></i>' + esc(a.originalFilename || 'Current file') + '</span>' +
                        '<button type="button" class="btn btn-sm btn-soft-danger" onclick="achMarkRemoveFile()"><i class="ri-close-line me-1"></i>Remove</button>' +
                        '</div>';
                }
            } else {
                modalTitle.innerHTML = '<i class="ri-award-line me-2 text-primary"></i>Add Achievement';
            }
            // Bootstrap modals stacking reliably means showing one at a time: hide the list modal first (it
            // re-shows, refreshed, once the form closes — see achCloseForm()/achSave()), same pattern already
            // used for the College Requests create/detail modals on the Requests pages.
            var listInstance = bootstrap.Modal.getInstance(achievementsModalEl);
            if (listInstance) listInstance.hide();
            bootstrap.Modal.getOrCreateInstance(achievementFormModalEl).show();
        }

        function achMarkRemoveFile() {
            ACH_REMOVE_FILE = true;
            var cur = document.getElementById('ach-f-current-file');
            cur.innerHTML = '<div class="text-muted fs-13"><i class="ri-information-line me-1"></i>The current file will be removed when you save.</div>';
        }

        function achCloseForm() {
            bootstrap.Modal.getOrCreateInstance(achievementFormModalEl).hide();
            bootstrap.Modal.getOrCreateInstance(achievementsModalEl).show();
        }

        function achSave() {
            var title = document.getElementById('ach-f-title').value.trim();
            var category = document.getElementById('ach-f-category').value;
            var titleEl = document.getElementById('ach-f-title');
            var categoryEl = document.getElementById('ach-f-category');
            titleEl.classList.remove('is-invalid');
            categoryEl.classList.remove('is-invalid');
            var missing = false;
            if (!title) { titleEl.classList.add('is-invalid'); missing = true; }
            if (!category) { categoryEl.classList.add('is-invalid'); missing = true; }
            if (missing) { CIPRMS.toast('Please fill in the required fields.', 'error'); return; }

            var fd = new FormData();
            fd.append('title', title);
            fd.append('category', category);
            fd.append('organization', document.getElementById('ach-f-org').value.trim());
            fd.append('dateAchieved', document.getElementById('ach-f-date').value);
            fd.append('description', document.getElementById('ach-f-desc').value.trim());
            var fileInput = document.getElementById('ach-f-file');
            if (fileInput.files.length) fd.append('file', fileInput.files[0]);
            else if (ACH_REMOVE_FILE) fd.append('removeFile', '1');

            var btn = document.getElementById('ach-f-save-btn');
            var orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

            var url = ACH_EDIT_ID ? '/api/achievements/' + ACH_EDIT_ID : '/api/achievements';
            var method = ACH_EDIT_ID ? 'PATCH' : 'POST';
            CIPRMS.api(url, { method: method, body: fd, quiet: true }).then(function (res) {
                btn.disabled = false;
                btn.innerHTML = orig;
                if (!res.ok) { CIPRMS.toast(res.error || 'Could not save the achievement.', 'error'); return; }
                CIPRMS.toast(ACH_EDIT_ID ? 'Achievement updated.' : 'Achievement added.', 'success');
                achCloseForm();
                achLoadList();
            });
        }

        function achOpenDelete(id) {
            var a = ACH_ALL.find(function (x) { return x.id === id; });
            if (!a) return;
            ACH_DELETE_ID = id;
            document.getElementById('ach-del-title').textContent = a.title;
            var listInstance = bootstrap.Modal.getInstance(achievementsModalEl);
            if (listInstance) listInstance.hide();
            bootstrap.Modal.getOrCreateInstance(achievementDeleteModalEl).show();
        }

        function achConfirmDelete() {
            if (!ACH_DELETE_ID) return;
            var btn = document.getElementById('ach-del-confirm-btn');
            var orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting…';
            CIPRMS.api('/api/achievements/' + ACH_DELETE_ID, { method: 'DELETE', quiet: true }).then(function (res) {
                btn.disabled = false;
                btn.innerHTML = orig;
                bootstrap.Modal.getOrCreateInstance(achievementDeleteModalEl).hide();
                bootstrap.Modal.getOrCreateInstance(achievementsModalEl).show();
                if (!res.ok) { CIPRMS.toast(res.error || 'Could not delete the achievement.', 'error'); return; }
                CIPRMS.toast('Achievement deleted.', 'success');
                ACH_DELETE_ID = null;
                achLoadList();
            });
        }

        // Loaded once the list modal is opened (not eagerly on page load — it's behind a click, unlike the
        // always-visible dashboard widgets above) and every time it's reopened, so edits made elsewhere are
        // never stale.
        if (achievementsModalEl) {
            achievementsModalEl.addEventListener('show.bs.modal', function () { achLoadList(); });
        }
    </script>

</body>

</html>