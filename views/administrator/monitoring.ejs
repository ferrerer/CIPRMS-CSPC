          <div class="col-6 mb-3">
            <label class="form-label">Previous End Date</label>
            <input type="text" class="form-control bg-light" id="renew-prev-end" readonly>
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">New End Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="renew-new-end" onchange="computeRenewStatus()">
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">Validity Period</label>
            <input type="text" class="form-control bg-light fw-semibold" id="renew-validity" readonly>
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">New Status</label>
            <input type="text" class="form-control bg-light" id="renew-status" readonly>
          </div>
          <div class="col-12 mb-3">
            <label class="form-label">Renewal Remarks</label>
            <textarea class="form-control" id="renew-remarks" rows="2"></textarea>
          </div>
        </div>
        <div class="alert alert-warning py-2 mb-0">
          <i class="ri-alert-line me-1"></i>This will update the partnership status to <strong>Active</strong> and record the new end date.
        </div>
      </div>
      <div class="modal-footer">
        <div class="hstack gap-2 justify-content-end">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-success" onclick="saveRenew()"><i class="ri-refresh-line me-1"></i>Confirm Renewal</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal - exact deleteRecordModal pattern from tables-listjs.html -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
      </div>
      <div class="modal-body">
        <div class="mt-2 text-center">
          <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
          <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
            <h4>Are you Sure?</h4>
            <p class="text-muted mx-4 mb-0">Are you sure you want to remove this partnership record?</p>
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
          <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn w-sm btn-danger" id="delete-record" onclick="confirmDelete()">Yes, Delete It!</button>
        </div>
      </div>
    </div>
  </div>
</div>
<!--end delete modal -->

<!-- Generate Report preview (2026-11: replaces the old window.open(/reports?...) redirect — this reuses
     the exact same /api/reports/custom/preview backend the Custom Report Builder's own Preview button calls
     (views/administrator/reports.ejs, previewCustomReport()/renderReportPreview()), just rendered into a
     modal on THIS page instead of navigating to Reports & Analytics. No separate reporting engine. -->
<div class="modal fade zoomIn" id="monReportPreviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="flex-grow-1">
          <h5 class="modal-title mb-1" id="mon-prev-title">Report Preview</h5>
          <p class="text-muted fs-12 mb-0" id="mon-prev-meta"></p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <!-- Loading state -->
        <div id="mon-rpm-loading" class="text-center py-5">
          <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
          <p class="text-muted mt-3 mb-0">Generating report…</p>
        </div>

        <!-- Error state — see reports.ejs's #rpm-error for why the display-toggle target stays free of any
             `d-flex`/other !important display utility class. -->
        <div id="mon-rpm-error" class="alert alert-danger" style="display:none;">
          <div class="d-flex align-items-center gap-2">
            <i class="ri-error-warning-line fs-4"></i>
            <div class="flex-grow-1" id="mon-rpm-error-text">Something went wrong.</div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="monitoringGenerateReport()">Retry</button>
          </div>
        </div>

        <div id="mon-rpm-body" style="display:none;">
          <div class="mb-3 d-flex align-items-center flex-wrap gap-1" id="mon-prev-filters"></div>
          <div class="row g-3 mb-4" id="mon-prev-summary-cards"></div>

          <div class="table-responsive" id="mon-prev-grouped-wrap" style="display:none;">
            <div class="d-flex align-items-center mb-2">
              <h6 class="fw-semibold mb-0 text-dark flex-grow-1"><i class="ri-bar-chart-2-line me-1 text-primary"></i>Grouped Breakdown</h6>
            </div>
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="bg-light"><tr id="mon-prev-grouped-thead-row"></tr></thead>
              <tbody id="mon-prev-grouped-tbody"></tbody>
            </table>
          </div>

          <div class="table-responsive" id="mon-prev-flat-wrap">
            <div class="d-flex align-items-center mb-2">
              <h6 class="fw-semibold mb-0 text-dark flex-grow-1"><i class="ri-list-check-2 me-1 text-primary"></i>Included Records (<span id="mon-prev-records-count">0</span>)</h6>
            </div>
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th>#</th><th>Institution</th><th>Country</th><th>Region</th><th>Type</th>
                  <th>Nature</th><th>Unit</th><th>Start</th><th>End</th><th>Status</th>
                </tr>
              </thead>
              <tbody id="mon-prev-records-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
<!-- end Generate Report preview -->

