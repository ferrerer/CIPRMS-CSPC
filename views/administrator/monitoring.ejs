<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Monitoring | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <!-- gridjs css -->
    <link rel="stylesheet" href="/velzon/assets/libs/gridjs/theme/mermaid.min.css" />
    <!-- Layout config Js -->
    <script src="/velzon/assets/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css -->
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- Custom Css -->
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- Our Css -->
    <link rel="stylesheet" href="/velzon/assets/css/ciprms-bridge.css?v=20260925d">
    <!-- Font Awesome (for legacy icons in content) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
      .gridjs-sort {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        padding: 0 0 0 4px;
        cursor: pointer;
        opacity: 0.4;
        transition: opacity .15s;
        vertical-align: middle;
      }
      .gridjs-sort:hover { opacity: 0.8; }
      .gridjs-sort-neutral::after { content: "⇅"; font-size: 11px; color: #6c757d; }
      .gridjs-sort-asc::after     { content: "↑"; font-size: 12px; color: #405189; }
      .gridjs-sort-desc::after    { content: "↓"; font-size: 12px; color: #405189; }
      .gridjs-sort-asc, .gridjs-sort-desc { opacity: 1 !important; }
      th.gridjs-th-sort:hover .gridjs-sort { opacity: 1; }

      /* Partnership Registry table: keep columns to their configured widths
         and wrap long institution/country names instead of stretching the
         table or the page. */
      #reg-grid { overflow-x: auto; }
      #reg-grid .gridjs-table { width: 100% !important; table-layout: fixed; }
      #reg-grid .gridjs-td, #reg-grid .gridjs-th {
        white-space: normal;
        word-break: break-word;
        vertical-align: middle;
      }

      /* ── "Responsible Unit" combobox — searchable multi-select restricted to
         the predefined CSPC unit list, with removable chips (2026-09-03). ── */
      .unit-combo { width: 100%; }
      .unit-combo-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
      .unit-combo-chips:empty { display: none; }
      .unit-chip {
        display: inline-flex; align-items: center; gap: 6px;
        background: #e7ebfa; color: #405189; border: 1px solid #c9d2f5;
        border-radius: 20px; padding: 5px 8px 5px 14px; font-size: .8rem; font-weight: 600;
      }
      .unit-chip button {
        border: none; background: rgba(64,81,137,.14); color: #405189; border-radius: 50%;
        width: 18px; height: 18px; line-height: 1; font-size: .85rem; flex-shrink: 0;
        cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;
      }
      .unit-chip button:hover { background: rgba(64,81,137,.28); }
      .unit-combo-input-wrap { position: relative; }
      .unit-combo-dropdown {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
        background: #fff; border: 1px solid #dfe3ea; border-radius: 8px;
        box-shadow: 0 10px 28px rgba(20,25,45,.14); max-height: 220px; overflow-y: auto; padding: 6px;
      }
      .unit-combo-option {
        padding: 8px 10px; border-radius: 6px; font-size: .85rem; color: #313a46; cursor: pointer;
      }
      .unit-combo-option:hover, .unit-combo-option.active { background: #f0f2fb; color: #405189; }
      .unit-combo-empty { padding: 10px; font-size: .8rem; color: #878a99; text-align: center; }
      /* "+ Add Responsible Unit" (2026-11) — a thin top border separates it from the real, selectable
         options above it so it never reads as just one more unit in the list; colored like this app's other
         primary actions (btn-primary blue) rather than the plain neutral text every real option uses. */
      .unit-combo-add { color: #405189; font-weight: 600; border-top: 1px solid #eef0f4; margin-top: 4px; }
      .unit-combo-add:hover { background: #f0f2fb; color: #405189; }
      [data-bs-theme="dark"] .unit-combo-add { color: #a9bcf5; border-top-color: #3a4053; }
      [data-bs-theme="dark"] .unit-combo-add:hover { background: #363c4c; color: #a9bcf5; }

      /* Country — same searchable-combo pattern as Unit/Nature above, but single-select and made to look like
         an ordinary <select> (a dropdown caret) since it fronts one (see registry-gridjs.init.js's
         createCountryCombo / the hidden #f-country / #e-country <select> underneath). */
      .country-combo-input { padding-right: 2.1rem; }
      .country-combo-caret {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        color: #878a99; pointer-events: none; font-size: 1.1rem;
      }

      [data-bs-theme="dark"] .unit-chip { background: rgba(96,126,224,.18); color: #a9bcf5; border-color: rgba(96,126,224,.35); }
      [data-bs-theme="dark"] .unit-chip button { background: rgba(169,188,245,.18); color: #a9bcf5; }
      [data-bs-theme="dark"] .unit-combo-dropdown { background: #2a2f3c; border-color: #3a4053; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
      [data-bs-theme="dark"] .unit-combo-option { color: #d3d5db; }
      [data-bs-theme="dark"] .unit-combo-option:hover, [data-bs-theme="dark"] .unit-combo-option.active { background: #363c4c; color: #a9bcf5; }

      /* Institution Name's worldwide-search results (#ac-dropdown / #e-ac-dropdown, populated by
         renderInstDropdown() in registry-gridjs.init.js) previously had no height cap at all — up to 15
         two-line results could grow past 700px, overflowing the modal on small/mobile screens. Bounded and
         given the same rounded-corner/shadow treatment as the Country combobox's dropdown just above, for a
         visually consistent search experience, without touching the existing Bootstrap list-group item markup
         or any of its click/keyboard-nav behavior. */
      #ac-dropdown, #e-ac-dropdown { max-height: 260px; overflow-y: auto; border-radius: 8px; box-shadow: 0 10px 28px rgba(20,25,45,.14); }
      [data-bs-theme="dark"] #ac-dropdown, [data-bs-theme="dark"] #e-ac-dropdown { box-shadow: 0 10px 28px rgba(0,0,0,.4); }
    </style>

</head>

<body>

<!-- Begin page -->
<div id="layout-wrapper">

    <%- include('../partials/header') %>

    <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

    <!-- ============================================================== -->
    <!-- Start right Content here -->
    <!-- ============================================================== -->
    <div class="main-content">

        <div class="page-content">
            <div class="container-fluid">

<!-- page title -->
<div class="row">
  <div class="col-12">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
      <h4 class="mb-sm-0">Monitoring</h4>
      <div class="page-title-right">
        <ol class="breadcrumb m-0" id="page-breadcrumb">
          <li class="breadcrumb-item"><a href="<%= typeof homeHref !== 'undefined' ? homeHref : '/dashboard' %>">CIPRMS</a></li>
          <li class="breadcrumb-item active">Monitoring</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- ── SECTION 1: KPI stat cards — single source of truth (/api/partnerships) ── -->
<div class="row">
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Total Partnerships</p>
            <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-total">0</span></h2>
            <p class="mb-0 text-muted"><span class="badge bg-light text-dark mb-0">MOA &amp; MOU</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-primary-subtle rounded-circle fs-2"><i data-feather="file-text" class="text-primary"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Active</p>
            <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-active">0</span></h2>
            <p class="mb-0 text-muted"><span class="badge bg-success-subtle text-success mb-0">In effect</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-success-subtle rounded-circle fs-2"><i data-feather="check-circle" class="text-success"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Expiring Soon</p>
            <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-expiring">0</span></h2>
            <p class="mb-0 text-muted"><span class="badge bg-warning-subtle text-warning mb-0">Within 90 days</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-warning-subtle rounded-circle fs-2"><i data-feather="alert-triangle" class="text-warning"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Expired</p>
            <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-expired">0</span></h2>
            <p class="mb-0 text-muted"><span class="badge bg-danger-subtle text-danger mb-0">Needs renewal</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-danger-subtle rounded-circle fs-2"><i data-feather="x-circle" class="text-danger"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <!-- Filter Partnerships + Partnership Registry now use the full width (2026-11: the Overview/Urgent/DSS
       sidebar that used to sit beside these in a col-xl-3 was relocated below, into the collapsed-by-default
       "Monitoring Insights" card, so it no longer takes any of this initial horizontal/vertical space). -->
  <div class="col-12">

    <!-- Filters -->
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1"><i class="ri-filter-3-line me-1"></i>Filter Partnerships</h4>
        <button class="btn btn-soft-primary btn-sm" onclick="monitoringGenerateReport()" title="Preview a report with these same filters, right here"><i class="ri-file-chart-2-line me-1"></i>Generate Report</button>
        <button class="btn btn-soft-danger btn-sm" onclick="clearFilters()"><i class="ri-refresh-line me-1"></i>Clear</button>
      </div>
      <div class="card-body py-3">
        <div class="row g-2 align-items-end mb-2">
          <div class="col-md-5">
            <label class="form-label fs-12 mb-1">Search</label>
            <div class="search-box">
              <input type="text" class="form-control" id="reg-search" oninput="applyFilter()">
              <i class="ri-search-line search-icon"></i>
            </div>
          </div>
        </div>
        <div class="row g-2 align-items-end">
          <div class="col-md-2">
            <label class="form-label fs-12 mb-1">Type</label>
            <select class="form-select form-select-sm" id="reg-type" onchange="applyFilter()">
              <option value="">All Types</option><option>MOA</option><option>MOU</option><option>Other</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fs-12 mb-1">Category</label>
            <select class="form-select form-select-sm" id="reg-cat" onchange="applyFilter()">
              <option value="">All</option><option>International</option><option>Local</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fs-12 mb-1">Status</label>
            <select class="form-select form-select-sm" id="reg-status" onchange="applyFilter()">
              <option value="">All</option><option>Active</option><option>Expiring Soon</option><option>Expired</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fs-12 mb-1">Region</label>
            <select class="form-select form-select-sm" id="reg-region" onchange="applyFilter()">
              <option value="">All</option><option>Asia</option><option>Africa</option><option>North America</option><option>South America</option><option>Antarctica</option><option>Europe</option><option>Oceania</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fs-12 mb-1">Unit</label>
            <select class="form-select form-select-sm" id="reg-unit" onchange="applyFilter()">
              <option value="">All</option><option>CCS</option><option>CILS</option><option>CETE</option><option>CNAS</option><option>CAMS</option><option>CIRL</option>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label fs-12 mb-1">Yr Signed</label>
            <select class="form-select form-select-sm" id="reg-yr-signed" onchange="applyFilter()">
              <option value="">All</option><option>2019</option><option>2020</option><option>2021</option><option>2022</option><option>2023</option><option>2024</option><option>2025</option><option>2026</option>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label fs-12 mb-1">Yr Expiry</label>
            <select class="form-select form-select-sm" id="reg-yr-exp" onchange="applyFilter()">
              <option value="">All</option><option>2024</option><option>2025</option><option>2026</option><option>2027</option><option>2028</option><option>2029</option><option>2030</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Partnership Registry — the one consolidated table (replaces the old
         separate "Agreement Validity Tracker" and "All Partnerships" tables) -->
    <div class="card">
      <div class="card-header border-0">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div>
            <h4 class="card-title mb-0">Partnership Registry</h4>
            <p class="text-muted fs-12 mb-0 mt-1">Manage and monitor all registered partnerships.</p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted fs-12" id="reg-count"></span>
            <% if (typeof user !== 'undefined' && user && ['Administrator', 'Staff'].includes(user.role)) { %>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addPartnershipModal">
              <i class="ri-add-line align-bottom me-1"></i>Add New Partnership
            </button>
            <% } %>
          </div>
        </div>
      </div>
      <div class="card-body pt-0">
        <div id="reg-grid">
          <div class="table-loading"><span class="spinner-border spinner-border-sm text-primary"></span>Loading partnerships&hellip;</div>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-end gap-3 px-3">
          <div id="reg-page-size"></div>
          <div id="reg-pagination" class="py-3"></div>
        </div>
      </div>
      <!-- Legend -->
      <div class="card-footer border-top-0 bg-transparent">
        <div class="d-flex flex-wrap gap-3 align-items-center">
          <span class="text-muted fs-12 fw-semibold text-uppercase me-1">Legend:</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-success-subtle text-success">Active</span> Valid &amp; in effect</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-warning-subtle text-warning">Expiring</span> Within 90 days</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-danger">Critical</span> Expires within 14 days</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-danger-subtle text-danger">Expired</span> Needs renewal</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-primary-subtle text-primary">MOA</span> Memorandum of Agreement</span>
          <span class="d-flex align-items-center gap-1 fs-12"><span class="badge bg-info-subtle text-info">MOU</span> Memorandum of Understanding</span>
        </div>
      </div>
    </div>

    <!-- Monitoring Insights (2026-11) — Overview / Urgent / DSS Smart Alerts, relocated here from the
         col-xl-3 sidebar that used to sit beside Filter Partnerships/Partnership Registry above. Collapsed
         by default so it takes no vertical space until opened; same ids as before, so the one JS population
         path (buildGrid()/renderDssAlerts() in registry-gridjs.init.js) needs no changes at all. -->
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1"><i class="ri-dashboard-3-line me-1"></i>Monitoring Insights</h4>
        <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#monitoring-insights-body" aria-expanded="false" aria-controls="monitoring-insights-body">
          <i class="ri-arrow-down-s-line me-1"></i>Show / Hide
        </button>
      </div>
      <div class="collapse" id="monitoring-insights-body">
        <div class="card-body">
          <div class="row g-3">

            <!-- Overview -->
            <div class="col-lg-4">
              <h6 class="fw-semibold mb-2">Overview</h6>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted fs-13">Total Agreements</span>
                <span class="fw-bold text-dark" id="ov-total">—</span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted fs-13">Active</span>
                <span class="fw-bold text-success" id="ov-active">—</span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted fs-13">Expiring &le; 30d</span>
                <span class="fw-bold text-danger" id="ov-expiring30">—</span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted fs-13">Expiring &le; 90d</span>
                <span class="fw-bold text-warning" id="ov-expiring90">—</span>
              </div>
              <div class="d-flex justify-content-between mb-3">
                <span class="text-muted fs-13">Expired</span>
                <span class="fw-bold text-danger" id="ov-expired">—</span>
              </div>
              <div class="mb-2">
                <div class="d-flex justify-content-between fs-12 mb-1">
                  <span class="text-muted">Active rate</span><span class="fw-bold text-success" id="ov-active-rate">—</span>
                </div>
                <div class="progress" style="height:6px"><div class="progress-bar bg-success" id="ov-active-bar" style="width:0%"></div></div>
              </div>
              <div class="mb-2">
                <div class="d-flex justify-content-between fs-12 mb-1">
                  <span class="text-muted">MOA</span><span class="fw-bold text-primary" id="ov-moa">—</span>
                </div>
                <div class="progress" style="height:6px"><div class="progress-bar bg-primary" id="ov-moa-bar" style="width:0%"></div></div>
              </div>
              <div class="mb-3">
                <div class="d-flex justify-content-between fs-12 mb-1">
                  <span class="text-muted">MOU</span><span class="fw-bold text-info" id="ov-mou">—</span>
                </div>
                <div class="progress" style="height:6px"><div class="progress-bar bg-info" id="ov-mou-bar" style="width:0%"></div></div>
              </div>
              <div class="d-flex justify-content-between pt-2 border-top fs-13">
                <span class="text-muted">International <strong class="text-primary" id="ov-intl">—</strong></span>
                <span class="text-muted">Local <strong class="text-warning" id="ov-local">—</strong></span>
              </div>
            </div>

            <!-- Urgent (single list — sourced from the same partnership data as the table above) -->
            <div class="col-lg-4">
              <h6 class="fw-semibold mb-2"><i class="ri-error-warning-line text-warning me-1"></i>Urgent</h6>
              <ul class="list-group list-group-flush" id="urgent-list">
                <li class="list-group-item px-3 py-3 text-muted fs-12">Loading…</li>
              </ul>
            </div>

            <!-- DSS Smart Alerts — Administrator only, unchanged from the prior Monitoring page (removed
                 for Auth. Personnel 2026-07-23, alongside their loss of Reports access, which is what
                 this card's only action button links to). -->
            <% if (typeof user !== 'undefined' && user && user.role === 'Administrator') { %>
            <div class="col-lg-4">
              <div class="bg-primary-subtle border border-primary text-primary rounded p-3 h-100">
                <h6 class="fw-semibold mb-2 text-primary"><i class="ri-robot-2-line me-1"></i> DSS Smart Alerts</h6>
                <p class="mb-2 fs-13"><strong>Decision Support System is active.</strong></p>
                <div class="d-flex gap-2 mb-3 align-items-start fs-13" id="dss-action-row">
                  <i class="ri-lightbulb-flash-line fs-16 mt-1"></i>
                  <div id="dss-action-text">Loading…</div>
                </div>
                <div class="d-flex gap-2 align-items-start fs-13" id="dss-review-row">
                  <i class="ri-alert-line fs-16 mt-1"></i>
                  <div id="dss-review-text">Loading…</div>
                </div>
                <div class="mt-3 text-end">
                  <a href="/reports" class="btn btn-sm btn-primary">View Full DSS Report <i class="ri-arrow-right-line ms-1"></i></a>
                </div>
              </div>
            </div>
            <% } %>

          </div>
        </div>
      </div>
    </div>

  </div><!-- end col-12 -->
</div><!-- end row -->



<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- ADD PARTNERSHIP MODAL — forms-wizard.html Arrow Nav Steps        -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade zoomIn" id="addPartnershipModal" tabindex="-1" aria-labelledby="addPartnershipModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="addPartnershipModalLabel">Add New Partnership</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
      </div>
      <div class="modal-body">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- APPROVED-REQUEST CONVERSION BANNER — shown only when this   -->
        <!-- modal was opened via "Approve" on a pending Partnership     -->
        <!-- Request (see checkFromRequestParam() / applyRequestToForm()-->
        <!-- in registry-gridjs.init.js). Hidden by default; the fields  -->
        <!-- below stay fully editable — this is a pre-fill, not a lock. -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Starts hidden via d-none rather than an inline style=display:none —
             Bootstrap's d-flex utility (added when shown) is !important, and
             would otherwise permanently win over a plain inline style toggle. -->
        <div class="alert alert-info d-none align-items-center gap-2 mb-4" id="from-request-banner">
          <i class="ri-file-transfer-line fs-4"></i>
          <div>
            <div class="fw-semibold">Creating this partnership from an approved Partnership Request<span id="from-request-inst"></span></div>
            <div class="fs-12 text-muted">Review and edit every field before saving — the original request will be marked Approved once you click Save Partnership.</div>
          </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- OCR AUTO-FILL — upload a MOA/MOU/Contract/Proposal/LOI and   -->
        <!-- let the system suggest values for the form below.           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <div class="card border border-primary-subtle mb-4" id="ocr-panel">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
              <h6 class="mb-0 fs-15 fw-semibold"><i class="ri-scan-2-line text-primary me-2"></i>Auto-fill from Document (OCR)</h6>
              <span class="badge bg-primary-subtle text-primary fs-12 px-2 py-1">Optional</span>
            </div>
            <% var docLibraryHref = (typeof user !== 'undefined' && user && user.role === 'Auth. Personnel') ? '/personnel/documents' : '/documents'; %>
            <%# 2026-11 investigation: this used to say the file "is safely archived to the Document Library"
                 in the present tense — true now (see confirmOcrDocument(), registry-gridjs.init.js), but not
                 until "Save Partnership" below actually succeeds; worded that way, it previously described
                 something that was never actually implemented at all. %>
            <p class="text-muted fs-13 mb-3">Upload a MOA, MOU, Contract, Partnership Proposal, or Letter of Intent. The system extracts text and suggests values for the form below. Once you save the partnership, the file is archived to the <a href="<%= docLibraryHref %>" target="_blank" class="fw-medium text-decoration-underline">Document Library</a> too.</p>
            <div id="monitoring-ocr-dropzone-wrap" class="mb-3">
              <input type="file" class="form-control" id="ocr-file-input" accept=".pdf,.jpg,.jpeg,.png">
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <button type="button" class="btn btn-primary px-3 text-nowrap" id="ocr-extract-btn" onclick="startOcrExtraction()">
                <i class="ri-magic-line me-1"></i>Extract using OCR
              </button>
            </div>

            <div id="ocr-progress-wrap" class="mt-3" style="display:none">
              <div class="d-flex justify-content-between fs-12 text-muted mb-1">
                <span id="ocr-stage-text">Uploading…</span>
                <span id="ocr-percent-text">0%</span>
              </div>
              <div class="progress" style="height:6px">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="ocr-progress-bar" style="width:0%"></div>
              </div>
            </div>

            <div id="ocr-result-box" class="mt-3" style="display:none">
              <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="badge bg-success-subtle text-success" id="ocr-confidence-badge">Confidence: —</span>
                <span class="badge bg-info-subtle text-info" id="ocr-doctype-badge">Document type: —</span>
                <span class="badge bg-warning-subtle text-warning" id="ocr-warning-badge" style="display:none">Low confidence — verify carefully</span>
              </div>

              <div id="ocr-idp-panel" class="mb-2" style="display:none"></div>

              <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#ocr-text-preview">
                <i class="ri-file-text-line me-1"></i>View extracted text
              </button>
              <div class="collapse mt-2" id="ocr-text-preview">
                <pre class="bg-light p-2 rounded fs-12" style="max-height:200px;overflow:auto;white-space:pre-wrap" id="ocr-raw-text"></pre>
              </div>
              <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-success btn-sm" onclick="applyOcrToForm()">
                  <i class="ri-check-line me-1"></i>Apply to Form
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="dismissOcrResult()">Dismiss</button>
              </div>
            </div>

            <div id="ocr-error-box" class="alert alert-danger mt-3 mb-0 py-2 fs-13" style="display:none"></div>
          </div>
        </div>

        <form class="form-steps" autocomplete="off" id="addPartnershipForm">

          <!-- STEP NAV — Arrow Nav Steps (forms-wizard.html) -->
          <div class="step-arrow-nav mb-4">
            <ul class="nav nav-pills custom-nav nav-justified" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="add-step1-tab" data-bs-toggle="pill" data-bs-target="#add-step1" type="button" role="tab" aria-selected="true">
                  <i class="ri-user-line me-1"></i> Partner Info
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="add-step2-tab" data-bs-toggle="pill" data-bs-target="#add-step2" type="button" role="tab" aria-selected="false">
                  <i class="ri-file-list-3-line me-1"></i> Agreement Details
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="add-step3-tab" data-bs-toggle="pill" data-bs-target="#add-step3" type="button" role="tab" aria-selected="false">
                  <i class="ri-building-line me-1"></i> CSPC-CIRL Details
                </button>
              </li>
            </ul>
          </div>

          <div class="tab-content">
            <!-- STEP 1: Partner Info -->
            <div class="tab-pane fade show active" id="add-step1" role="tabpanel">
              <div class="mb-4">
                <h5 class="mb-1">Partner Information</h5>
                <p class="text-muted">Fill in the partner institution details.</p>
              </div>
              <div class="row">
                <div class="col-lg-12 mb-3">
                  <label class="form-label" for="f-inst">Institution Name <span class="text-danger">*</span>
                    <span class="badge bg-info-subtle text-info ms-2"><i class="ri-global-line me-1"></i>Worldwide DB</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="ri-building-line"></i></span>
                    <input type="text" class="form-control" id="f-inst" autocomplete="off" oninput="instSearch(this.value)" onkeydown="instKeyNav(event)">
                    <i class="fa-solid fa-circle-notch ac-spinner" id="ac-spinner" style="display:none;position:absolute;right:10px;top:50%;transform:translateY(-50%)"></i>
                  </div>
                  <div id="ac-dropdown" class="list-group mt-1" style="position:absolute;z-index:9999;width:calc(100% - 2rem)"></div>
                  <div class="form-text"><i class="ri-information-line me-1"></i>Country &amp; region auto-fill on select.</div>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-country-input">Country <span class="text-danger">*</span></label>
                  <div class="unit-combo" id="f-country-combo">
                    <div class="unit-combo-input-wrap">
                      <input type="text" class="form-control country-combo-input" id="f-country-input" autocomplete="off" role="combobox" aria-expanded="false" aria-haspopup="listbox">
                      <i class="ri-arrow-down-s-line country-combo-caret"></i>
                      <div class="unit-combo-dropdown" id="f-country-dropdown" role="listbox" style="display:none"></div>
                    </div>
                  </div>
                  <!-- The real value of record — every save/OCR/auto-fill path still reads/writes this exact
                       element untouched; the combobox above is only a searchable front-end over it. -->
                  <select class="d-none" id="f-country" aria-hidden="true">
                    <option value="">Select country…</option>
                  </select>
                  <div class="form-text text-warning d-none" id="f-country-hint"><i class="ri-error-warning-line me-1"></i></div>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-region">Region <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-region">
                    <option value="">Select region…</option>
                    <option>Asia</option><option>Africa</option><option>North America</option>
                    <option>South America</option><option>Antarctica</option><option>Europe</option><option>Oceania</option>
                  </select>
                </div>
                <div class="col-lg-12 mb-3">
                  <!-- Automatic map location — filled in by requestLocationPreview()
                       (registry-gridjs.init.js) once the institution/country is set. -->
                  <div class="fs-12 text-muted" id="f-location-status" aria-live="polite"></div>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-partner-email">Partner Contact Email</label>
                  <input type="email" class="form-control" id="f-partner-email">
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mt-4">
                <button type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="add-step2-tab">
                  <i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next: Agreement Details
                </button>
              </div>
            </div><!-- end step 1 -->

            <!-- STEP 2: Agreement Details -->
            <div class="tab-pane fade" id="add-step2" role="tabpanel">
              <div class="mb-4">
                <h5 class="mb-1">Agreement Details</h5>
                <p class="text-muted">Fill in the MOA/MOU agreement terms.</p>
              </div>
              <div class="row">
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-type">Type (MOA/MOU) <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-type">
                    <option value="">Select…</option><option>MOA</option><option>MOU</option>
                  </select>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-nature-input">Nature of Partnership <span class="text-danger">*</span></label>
                  <!-- Multi-select (2026-09-19) — reuses the exact same searchable
                       chip-combobox component/classes as Responsible Unit below,
                       just backed by NATURE_OPTIONS instead of UNIT_OPTIONS. -->
                  <div class="unit-combo" id="f-nature-combo">
                    <div class="unit-combo-chips" id="f-nature-chips"></div>
                    <div class="unit-combo-input-wrap">
                      <input type="text" class="form-control" id="f-nature-input" autocomplete="off" role="combobox" aria-expanded="false" aria-haspopup="listbox">
                      <div class="unit-combo-dropdown" id="f-nature-dropdown" role="listbox" style="display:none"></div>
                    </div>
                  </div>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-cat">Category</label>
                  <select class="form-select" id="f-cat">
                    <option value="International">International</option>
                    <option value="Local">Local</option>
                  </select>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-start">Start Date <span class="text-danger">*</span></label>
                  <input type="date" class="form-control" id="f-start">
