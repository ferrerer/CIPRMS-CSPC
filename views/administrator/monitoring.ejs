<!-- Breadcrumb — reflects whichever partnership record is currently open in a modal
     (View/Edit/Renew/Delete), e.g. CIPRMS > Monitoring > <institution>. The
     open/close hooks live in registry-gridjs.init.js (shared with the now-dead
     registry.ejs), which reads BREADCRUMB_BASE and calls these page-scoped globals. -->
<script>
  var HOME_HREF = '<%= typeof homeHref !== "undefined" ? homeHref : "/dashboard" %>';
  var BREADCRUMB_BASE = ['Monitoring'];
  function setBreadcrumb(labels) {
    var ol = document.getElementById('page-breadcrumb');
    if (!ol) return;
    var html = '<li class="breadcrumb-item"><a href="' + HOME_HREF + '">CIPRMS</a></li>';
    labels.forEach(function (label, i) {
      var isLast = i === labels.length - 1;
      html += isLast
        ? '<li class="breadcrumb-item active">' + escapeHtml(label) + '</li>'
        : '<li class="breadcrumb-item"><a href="' + window.location.pathname + '">' + escapeHtml(label) + '</a></li>';
    });
    ol.innerHTML = html;
  }
  function resetBreadcrumb() { setBreadcrumb(BREADCRUMB_BASE); }
</script>
