    <script>
        function switchTab(tab) {
            document.getElementById('tab-rep').classList.toggle('active', tab === 'rep');
            document.getElementById('tab-audit').classList.toggle('active', tab === 'audit');
            if (document.getElementById('tab-insights')) {
                document.getElementById('tab-insights').classList.toggle('active', tab === 'insights');
            }
            document.getElementById('content-rep').style.display = tab === 'rep' ? '' : 'none';
            document.getElementById('content-audit').style.display = tab === 'audit' ? '' : 'none';
            if (document.getElementById('content-insights')) {
                document.getElementById('content-insights').style.display = tab === 'insights' ? '' : 'none';
            }
            // Lazy-load data when tab becomes visible
            if (tab === 'audit') loadAuditGrid();
            if (tab === 'insights') loadDssInsights();
        }

        const actionBadge = {
            ADD: 'bg-success-subtle text-success', EDIT: 'bg-primary-subtle text-primary',
            RENEW: 'bg-warning-subtle text-warning', VIEW: 'bg-secondary-subtle text-secondary',
            DELETE: 'bg-danger-subtle text-danger', APPROVE: 'bg-info-subtle text-info',
            REJECT: 'bg-danger-subtle text-danger',
            // 2026-10-21 login-attempt audit logging investigation.
            LOGIN_SUCCESS: 'bg-success-subtle text-success', LOGIN_FAILED: 'bg-danger-subtle text-danger',
            LOGIN_BLOCKED: 'bg-danger-subtle text-danger', LOGOUT: 'bg-secondary-subtle text-secondary',
            FORBIDDEN: 'bg-danger-subtle text-danger',
            // 2026-11 Google OAuth audit trail — informational (not an outcome), so its own neutral/info
            // tint rather than reusing success/failure/blocked's colors.
            GOOGLE_AUTH_INITIATED: 'bg-info-subtle text-info', GOOGLE_AUTH_CALLBACK: 'bg-info-subtle text-info'
        };
        const statusBadge = { success: 'bg-success-subtle text-success', failure: 'bg-danger-subtle text-danger', blocked: 'bg-warning-subtle text-warning' };
        const roleBadge = {
            'Administrator': 'bg-primary-subtle text-primary',
            'Auth. Personnel': 'bg-warning-subtle text-warning',
            'potential_partner': 'bg-success-subtle text-success',
            'Staff': 'bg-secondary-subtle text-secondary'
        };
        // Labels only — the stored/RBAC value stays 'Auth. Personnel' (roleBadge keys, the role filter, API).
        function formatRole(role) {
            if (role === 'potential_partner') return 'Partner';
            if (role === 'Auth. Personnel') return 'College Dean';
            if (role === 'Staff') return 'CIRL Staff';
            return role || '';
        }
        // Audit entries embed a role name in their free-text details ("User created: X (Auth. Personnel)",
        // "User updated: X — role: Staff, …"), including entries written before either rename. Translate for
        // display only; stored text is unchanged. Keep in step with displayRoleText() in cirl.js.
        function displayRoleText(text) {
            if (typeof text !== 'string') return text;
            return text
                .split('Auth. Personnel').join('College Dean')
                .split('Department/Colleges').join('College Dean')
                .replace(/\(Staff\)/g, '(CIRL Staff)')
                .replace(/\brole: Staff\b/g, 'role: CIRL Staff');
        }
        const roleLabel = {
            'potential_partner': 'Partner'
        };

        var auditGrid = null;
        var allAuditLogs = [];

        // ── Load Audit Trail from MongoDB ────────────────────────────────────────────
        function loadAuditGrid() {
            // destroy old instance so we can re-render fresh data
            if (auditGrid) {
                auditGrid.destroy();
                auditGrid = null;
                document.getElementById('audit-grid').innerHTML = '';
            }
            document.getElementById('audit-empty').style.display = 'none';

            fetch('/api/activitylogs')
                .then(r => r.json())
                .then(function (logs) {
                    allAuditLogs = logs;
                    renderAuditGrid(logs);
                })
                .catch(function (err) { console.error('Failed to load audit log:', err); });
        }

        function renderAuditGrid(logs) {
            if (auditGrid) { auditGrid.destroy(); auditGrid = null; document.getElementById('audit-grid').innerHTML = ''; }
            if (!logs || logs.length === 0) {
                document.getElementById('audit-empty').style.display = '';
                return;
            }
            document.getElementById('audit-empty').style.display = 'none';
            auditGrid = new gridjs.Grid({
                columns: [
                    { name: '#', width: '50px', formatter: (_, row) => gridjs.html(`<span class="text-muted fw-semibold">${row.cells[0].data}</span>`) },
                    { name: 'Action', formatter: (cell) => gridjs.html(`<span class="badge ${actionBadge[cell] || 'bg-secondary-subtle text-secondary'}">${cell}</span>`) },
                    // Category/Status (2026-10-21): absent on every pre-existing record (ADD/EDIT/DELETE/… never
                    // carried either) — an em dash, not a blank cell, so "no category recorded" reads as a fact
                    // rather than looking like missing/broken data.
                    { name: 'Category', formatter: (cell) => cell || '—' },
                    { name: 'Status', formatter: (cell) => cell ? gridjs.html(`<span class="badge ${statusBadge[cell] || 'bg-secondary-subtle text-secondary'}">${cell}</span>`) : '—' },
                    { name: 'Record / Details', width: '30%' },
                    { name: 'Performed By', formatter: (cell) => cell || 'Unknown' },
                    { name: 'Role', formatter: (cell) => cell ? gridjs.html(`<span class="badge ${roleBadge[cell] || 'bg-secondary-subtle text-secondary'}">${formatRole(cell)}</span>`) : '—' },
                    { name: 'IP Address', formatter: (cell) => cell || '—' },
                    { name: 'Date & Time' }
                ],
                data: logs.map((a, i) => [i + 1, a.action, a.category, a.status, displayRoleText(a.record), a.by, a.role, a.ip, a.date]),
                search: true,
                pagination: { limit: 15 },
                sort: true,
                language: { search: { placeholder: 'Search action, category, record, performed by, IP or date…' } },
                style: {
                    table: { border: 'none' },
                    // 2026-09-18: background/color used to be set here as
                    // inline styles referencing --vz-table-bg/--vz-table-color
                    // — CSS variables Velzon only ever defines scoped to
                    // `.table-light` elements (a Bootstrap table variant this
                    // grid never has), so they always silently fell through to
                    // their light hardcoded fallback (#f3f6f9/#878a99) in BOTH
                    // themes. An inline style beats any stylesheet selector
                    // regardless of specificity, so that hardcoded fallback
                    // could never be themed dark by CSS. Removed so this
                    // header instead follows the real stylesheet rules
                    // (assets/libs/gridjs/theme/mermaid.min.css for light,
                    // assets/css/ciprms-bridge.css's dark-mode block for dark).
                    th: { fontSize: '11px', textTransform: 'uppercase', letterSpacing: '.5px', fontWeight: '700', border: 'none', padding: '10px 16px' },
                    td: { border: 'none', padding: '10px 16px', fontSize: '13px' }
                }
            }).render(document.getElementById('audit-grid'));
        }

        // "YYYY-MM-DD" -> local midnight / local end-of-day, built from its own parts — never
        // toISOString()/bare new Date("YYYY-MM-DD") (parsed as UTC midnight per spec), the exact UTC/local
        // mismatch already fixed for the Custom Report Builder's own Date From/To (2026-09-26 investigation).
        // A bare `new Date(from)` compared against a LOCAL-time log entry silently excluded anything dated
        // exactly on the `from` boundary day in a timezone ahead of UTC (Asia/Manila, UTC+8, is exactly such a
        // zone) — the same bug, in the same shape, in a different filter.
        function auditLocalDate(ymd, endOfDay) {
            var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
            if (!m) return null;
            return endOfDay ? new Date(+m[1], +m[2] - 1, +m[3], 23, 59, 59, 999) : new Date(+m[1], +m[2] - 1, +m[3], 0, 0, 0, 0);
        }
        function applyAuditFilters() {
            const action   = document.getElementById('audit-filter-action').value;
            const category = document.getElementById('audit-filter-category').value;
            const status   = document.getElementById('audit-filter-status').value;
            const role     = document.getElementById('audit-filter-role').value;
            const from     = auditLocalDate(document.getElementById('audit-filter-from').value, false);
            const to       = auditLocalDate(document.getElementById('audit-filter-to').value, true);
            let filtered = allAuditLogs.filter(function(log) {
                if (action   && log.action   !== action)   return false;
                if (category && log.category !== category) return false;
                if (status   && log.status   !== status)   return false;
                if (role     && log.role     !== role)      return false;
                if (from || to) {
                    // `timestamp` (2026-10-21) is a real Date, present on every record written since this
                    // change; an older record has none, so it falls back to parsing the display string exactly
                    // as before — still a best-effort parse, not a new limitation this change introduces.
                    var d = log.timestamp ? new Date(log.timestamp) : new Date(log.date);
                    if (isNaN(d)) return false;
                    if (from && d < from) return false;
                    if (to   && d > to)   return false;
                }
                return true;
            });
            renderAuditGrid(filtered);
        }

        function resetAuditFilters() {
            document.getElementById('audit-filter-action').value = '';
            document.getElementById('audit-filter-category').value = '';
            document.getElementById('audit-filter-status').value = '';
            document.getElementById('audit-filter-role').value = '';
            document.getElementById('audit-filter-from').value = '';
            document.getElementById('audit-filter-to').value = '';
            renderAuditGrid(allAuditLogs);
        }

        function exportAuditPDF() {
            window.open('/api/reports/activitylog/pdf', '_blank');
        }

        function exportAuditExcel() {
            window.open('/api/reports/activitylog/excel', '_blank');
        }

        // Report Type options that name a specific status ("Active Partnerships",
        // "Inactive Partnerships", etc.) make the Status field redundant and
        // potentially conflicting. When one of these types is selected:
        //   - The Status dropdown is disabled and visually dimmed.
        //   - Its value is cleared so it cannot accidentally reach the backend.
        //   - The hint below the field explains why it is disabled.
        // When "Summary" (or any non-status-typed type) is selected, the Status
        // field is re-enabled and reset to "All", matching the default state.
        // This mirrors REPORT_TYPE_IMPLIED_STATUS / STATUS_TYPED_REPORT_TYPES in
        // cirl.js — keep the two lists in sync if new report types are added.
        var REPORT_TYPE_IMPLIED_STATUS = {
            'Active Partnerships': 'Active',
            'Active List': 'Active',
            'Inactive Partnerships': 'Inactive',
            'Expired Partnerships': 'Expired',
            'Expired List': 'Expired',
            'Expiring Soon': 'Expiring Soon'
        };
        var STATUS_TYPED_REPORT_TYPES = Object.keys(REPORT_TYPE_IMPLIED_STATUS);

        // Apply the disable/enable rule to a report-type select + status select pair.
        // statusHintId is optional — if supplied the hint text is shown/hidden too.
        function applyStatusFieldState(reportTypeEl, statusEl, statusHintId, colId) {
            if (!reportTypeEl || !statusEl) return;
            var isStatusTyped = STATUS_TYPED_REPORT_TYPES.indexOf(reportTypeEl.value) !== -1;
            statusEl.disabled = isStatusTyped;
            if (isStatusTyped) statusEl.value = '';
            // Toggle disabled class on the parent column for visual dimming
            var col = colId ? document.getElementById(colId) : statusEl.closest('[class*="col-"]');
            if (col) col.classList.toggle('cr-status-disabled', isStatusTyped);
            if (statusHintId) {
                var hint = document.getElementById(statusHintId);
                if (hint) hint.style.display = isStatusTyped ? '' : 'none';
            }
        }

        function onReportTypeChange() {
            var typeEl   = document.getElementById('cr-type');
            var statusEl = document.getElementById('cr-status');
            applyStatusFieldState(typeEl, statusEl, 'cr-status-hint', 'cr-status-col');
        }

        // Apply the state once on DOMContentLoaded so the correct initial state
        // is set even if the page is loaded with a pre-selected report type.
        document.addEventListener('DOMContentLoaded', function () {
            onReportTypeChange();
        });

        // From later than To can never match anything, and used to come back as an unexplained empty report. Flagged on the
        // fields instead, and nothing is requested. Empty dates never filter, and one bound alone is fine.
        function validateCustomReportDates(quiet) {
            var from = document.getElementById('cr-date-from'), to = document.getElementById('cr-date-to');
            var bad = !!(from.value && to.value && from.value > to.value);   // "YYYY-MM-DD" strings compare correctly as text
            from.classList.toggle('is-invalid', bad); to.classList.toggle('is-invalid', bad);
            if (bad && !quiet) to.focus();
            return !bad;
        }
        // Once the message is showing, it follows the fields as they are corrected (no focus stealing while typing).
        document.addEventListener('DOMContentLoaded', function () {
            ['cr-date-from', 'cr-date-to'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.addEventListener('input', function () { if (el.classList.contains('is-invalid')) validateCustomReportDates(true); });
            });
        });

        function buildReportQueryParams() {
            var reportType = document.getElementById('cr-type').value;
            var customTitle = document.getElementById('cr-title').value.trim();
            var cat = document.getElementById('cr-cat').value;
            var dateFrom = document.getElementById('cr-date-from').value;
            var dateTo = document.getElementById('cr-date-to').value;
            var agtype = document.getElementById('cr-agtype').value;
            var status = document.getElementById('cr-status').value;
            var country = document.getElementById('cr-country').value.trim();
            var unit = document.getElementById('cr-unit').value;
            var groupBy = document.getElementById('cr-groupby').value;

            var params = new URLSearchParams();
            params.set('reportType', reportType);
            params.set('title', customTitle || (reportType + ' Report'));
            if (cat) params.set('cat', cat);
            if (dateFrom) params.set('dateFrom', dateFrom);
            if (dateTo) params.set('dateTo', dateTo);
            if (agtype) params.set('agtype', agtype);
            if (status) params.set('status', status);
            if (country) params.set('country', country);
            if (unit) params.set('unit', unit);
            if (groupBy) params.set('groupBy', groupBy);

            return params;
        }

        // Restores every Custom Report Builder field to its default/blank
        // state (Reset Filters button) — must clear all 10 remaining fields so
        // no stale value can silently affect the next generated report.
        function resetCustomReportFilters() {
            document.getElementById('cr-title').value = '';
            document.getElementById('cr-type').value = 'Summary';
            document.getElementById('cr-cat').value = '';
            document.getElementById('cr-agtype').value = '';
            document.getElementById('cr-status').value = '';
            document.getElementById('cr-country').value = '';
            document.getElementById('cr-unit').value = '';
            document.getElementById('cr-groupby').value = '';
            document.getElementById('cr-date-from').value = '';
            document.getElementById('cr-date-to').value = '';
            document.getElementById('cr-date-from').classList.remove('is-invalid');
            document.getElementById('cr-date-to').classList.remove('is-invalid');
            // Re-enable and reset the Status field whenever filters are reset,
            // since Summary (the default) never disables Status.
            onReportTypeChange();
        }

        // ── College / Unit — dynamic options + "Add New Unit" (2026-11 Dynamic College/Unit Dropdowns) ──────
        // Both the Custom Report Builder's #cr-unit and every Comparison config's #cmpcfg-<id>-unit read the
        // exact same live, shared UNIT_OPTIONS array (assets/js/shared/responsible-units.js) that Monitoring's
        // Add/Edit Partnership Unit combobox already uses — one Responsible Unit list and one creation path,
        // never a second unit-management system.
        function unitOptionsHtml(selectedValue) {
            return UNIT_OPTIONS.map(function (name) {
                return '<option value="' + escapeHtml(name) + '"' + (selectedValue === name ? ' selected' : '') + '>' + escapeHtml(name) + '</option>';
            }).join('');
        }

        // Rebuilds a real <select>'s options from the current UNIT_OPTIONS, keeping its present selection if
        // that value still exists (so refreshing after an unrelated unit was added elsewhere never resets
        // what the person already picked here) and optionally forcing a specific value (the unit just added
        // from THIS select's own "+" button).
        function renderUnitSelect(select, forceValue) {
            if (!select) return;
            var current = forceValue !== undefined ? forceValue : select.value;
            select.innerHTML = '<option value="">All Units</option>' + unitOptionsHtml(current);
            select.value = (current && UNIT_OPTIONS.indexOf(current) !== -1) ? current : '';
        }

        // Every unit <select> currently on the page — the primary Custom Report Builder's plus one per
        // existing Comparison config (_cmpConfigIds, defined further below) — refreshed together so a unit
        // added from any one of them is immediately selectable in all the others too, with no page reload.
        function refreshAllUnitSelects(forPrefix, forceValue) {
            renderUnitSelect(document.getElementById('cr-unit'), forPrefix === 'cr-unit' ? forceValue : undefined);
            (typeof _cmpConfigIds !== 'undefined' ? _cmpConfigIds : []).forEach(function (id) {
                var prefix = 'cmpcfg-' + id + '-unit';
                renderUnitSelect(document.getElementById(prefix), forPrefix === prefix ? forceValue : undefined);
            });
        }

        // Delegated (not per-button) because Comparison configs are added/removed dynamically — one listener
        // here covers #cr-unit-add-btn and every current/future [data-add-unit-for] button alike.
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('#cr-unit-add-btn, [data-add-unit-for]');
            if (!btn) return;
            var targetId = btn.id === 'cr-unit-add-btn' ? 'cr-unit' : btn.getAttribute('data-add-unit-for');
            openAddResponsibleUnitModal({
                addValue: function (name) { refreshAllUnitSelects(targetId, name); }
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            loadResponsibleUnits().then(function () { renderUnitSelect(document.getElementById('cr-unit')); });
        });

        function exportReport(format, params) {
            var q = new URLSearchParams(params).toString();
            window.open('/api/reports/partnerships/' + format + '?' + q, '_blank');
        }

        // Mid-Year/Yearly Output Report tile cards — no dateFrom/dateTo is
        // sent at all; the server derives the current-calendar-year window
        // itself from reportType alone (computeCustomReportData in cirl.js),
        // so a manipulated query string can never smuggle in a different
        // year. Computing the range from the browser's clock here used to
        // look correct but fed straight into the generic Date From/To
        // filter, which is an OVERLAP filter (any still-active partnership
        // signed years ago silently "overlaps" every year it stays active) —
        // that was the actual historical-year-leakage bug; fixed server-side.
        function exportMidYearReport(format) {
            exportReport(format, { title: 'Mid-Year Output Report', reportType: 'Mid-Year' });
        }
        function exportYearlyReport(format) {
            exportReport(format, { title: 'Yearly Output Report', reportType: 'Yearly' });
        }

        function generateCustomReport(format) {
            var type = document.getElementById('cr-type').value;
            if (type === 'Audit') {
                window.open('/api/reports/activitylog/' + format, '_blank');
                return;
            }
            if (!validateCustomReportDates()) return;
            var params = buildReportQueryParams();
            window.open('/api/reports/partnerships/' + format + '?' + params.toString(), '_blank');
        }

        // ── Report Preview Modal — shared loading/error/view-switching helpers ──
        var _reportModalInstance = null;
        function getReportModal() {
            if (!_reportModalInstance) {
                _reportModalInstance = new bootstrap.Modal(document.getElementById('report-preview-modal'));
            }
            return _reportModalInstance;
        }

        function showRpmLoading() {
            document.getElementById('rpm-loading').style.display = '';
            document.getElementById('rpm-error').style.display = 'none';
            document.getElementById('rpm-view-preview').style.display = 'none';
            document.getElementById('rpm-view-compare-select').style.display = 'none';
            document.getElementById('rpm-view-compare-result').style.display = 'none';
            document.getElementById('rpm-footer-preview').style.display = 'none';
            document.getElementById('rpm-footer-compare-select').style.display = 'none';
            document.getElementById('rpm-footer-compare-result').style.display = 'none';
        }

        function showRpmError(message, retryFn) {
            document.getElementById('rpm-loading').style.display = 'none';
            document.getElementById('rpm-error').style.display = '';
            document.getElementById('rpm-error-text').textContent = message;
            document.getElementById('rpm-retry-btn').onclick = retryFn || previewCustomReport;
            // Mirror showRpmLoading()'s completeness: an error must always
            // fully replace whatever content view was showing, never sit
            // alongside it. Without this, a slower/stale request's error
            // handler firing after a newer request had already rendered
            // successfully left BOTH the error banner and the real report
            // visible at once ("Something went wrong" above a fully-populated
            // report).
            document.getElementById('rpm-view-preview').style.display = 'none';
            document.getElementById('rpm-view-compare-select').style.display = 'none';
            document.getElementById('rpm-view-compare-result').style.display = 'none';
            document.getElementById('rpm-footer-preview').style.display = 'none';
            document.getElementById('rpm-footer-compare-select').style.display = 'none';
            document.getElementById('rpm-footer-compare-result').style.display = 'none';
        }

        // view: 'preview' | 'compare-select' | 'compare-result'
        function switchRpmView(view) {
            document.getElementById('rpm-loading').style.display = 'none';
            document.getElementById('rpm-error').style.display = 'none';
            document.getElementById('rpm-view-preview').style.display = (view === 'preview') ? '' : 'none';
            document.getElementById('rpm-view-compare-select').style.display = (view === 'compare-select') ? '' : 'none';
            document.getElementById('rpm-view-compare-result').style.display = (view === 'compare-result') ? '' : 'none';
            document.getElementById('rpm-footer-preview').style.display = (view === 'preview') ? '' : 'none';
            document.getElementById('rpm-footer-compare-select').style.display = (view === 'compare-select') ? '' : 'none';
            document.getElementById('rpm-footer-compare-result').style.display = (view === 'compare-result') ? '' : 'none';
        }

        function closeReportModal() {
            getReportModal().hide();
        }

        var _lastCustomReportData = null;

        // Incremented on every previewCustomReport() call so an older,
        // slower request's eventual success/error can never overwrite what a
        // newer request already rendered (e.g. the admin double-clicking
        // Preview, or clicking it again after changing a filter before the
        // first request finished).
        var _previewRequestSeq = 0;

        function previewCustomReport() {
            if (document.getElementById('cr-type').value !== 'Audit' && !validateCustomReportDates()) return;
            getReportModal().show();
            showRpmLoading();
            var mySeq = ++_previewRequestSeq;
            // Audit is not a partnership report — it has no Partnership Filters/Group By meaning at all, and
            // generateCustomReport() below already special-cases it to download the real activity-log
            // PDF/Excel directly (there is no Audit JSON preview endpoint). Without this guard, Preview asked
            // /api/reports/custom/preview anyway, which only knows how to filter `partnerships` — silently
            // showing a generic partnership table under the "Audit" title, unrelated to the actual audit trail
            // the two Generate buttons produce.
            if (document.getElementById('cr-type').value === 'Audit') {
                showRpmError('Audit reports don’t use the Partnership Filters above and have no preview — use "Generate PDF" or "Generate Excel" to download the audit trail directly.', function () { closeReportModal(); });
                return;
            }
            var params = buildReportQueryParams();
            fetch('/api/reports/custom/preview?' + params.toString())
                .then(function (r) {
                    if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Server error while generating the preview.'); });
                    return r.json();
                })
                .then(function(data) {
                    if (mySeq !== _previewRequestSeq) return; // superseded by a newer preview request
                    if (data.error) throw new Error(data.error);
                    _lastCustomReportData = data;
                    renderReportPreview(data);
                    switchRpmView('preview');
                })
                .catch(function(err) {
                    if (mySeq !== _previewRequestSeq) return; // superseded by a newer preview request
                    console.error('Preview error:', err);
                    showRpmError('Failed to generate report preview: ' + err.message);
                });
        }

        function renderReportPreview(data) {
            document.getElementById('prev-title').textContent = data.title;
            document.getElementById('prev-meta').textContent = 'Generated ' + data.generatedDate + ' by ' + data.generatedBy + ' • Total Records: ' + data.totalRecords;

            // Applied filters badges
            var filtersEl = document.getElementById('prev-filters');
            var badgesHtml = '';
            if (data.filters) {
                var LABELS = { reportType: 'Report Type', category: 'Category', dateFrom: 'Date From', dateTo: 'Date To', unit: 'College / Unit', agreementType: 'Agreement Type', country: 'Country', status: 'Status', compareBy: 'Compare By', groupBy: 'Group By' };
                // "YYYY-MM-DD" -> "Sep 24, 2026" built from its own parts, so no timezone can shift the day
                var niceDate = function (v) {
                    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(v));
                    if (!m) return v;
                    return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][+m[2] - 1] + ' ' + (+m[3]) + ', ' + m[1];
                };
                Object.entries(data.filters).forEach(function(pair) {
                    var label = LABELS[pair[0]] || pair[0];
                    var value = (pair[0] === 'dateFrom' || pair[0] === 'dateTo') ? niceDate(pair[1]) : pair[1];
                    badgesHtml += '<span class="badge bg-secondary-subtle text-secondary me-1 mb-1"><strong class="text-secondary-emphasis">' + escapeHtml(label) + ':</strong> ' + escapeHtml(value) + '</span>';
                });
            }
            filtersEl.innerHTML = badgesHtml;

            // Key metrics cards
            var cardsEl = document.getElementById('prev-summary-cards');
            var sum = data.summary || {};
            cardsEl.innerHTML = `
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-primary-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-primary fw-semibold mb-1">Total Partnerships</h6>
                            <h3 class="mb-0 text-primary fw-bold">${sum.totalCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-success-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-success fw-semibold mb-1">Active Agreements</h6>
                            <h3 class="mb-0 text-success fw-bold">${sum.activeCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-warning-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-warning fw-semibold mb-1">Expiring Soon</h6>
                            <h3 class="mb-0 text-warning fw-bold">${sum.expiringSoonCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-danger-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-danger fw-semibold mb-1">Expired / Inactive</h6>
                            <h3 class="mb-0 text-danger fw-bold">${sum.inactiveCount || 0}</h3>
                        </div>
                    </div>
                </div>
            `;

            // Grouped (Group By set) vs flat records table — mutually exclusive.
            // Uses the exact same `data` computeCustomReportData() already
            // returned for this same request, so Preview can never disagree
            // with what PDF/Excel render from that identical result.
            var groupedWrap = document.getElementById('prev-grouped-wrap');
            var flatWrap = document.getElementById('prev-flat-wrap');
            if (data.isComparison && Array.isArray(data.comparisonData)) {
                flatWrap.style.display = 'none';
                groupedWrap.style.display = '';
                renderGroupedPreviewTable(data);
                return;
            }
            groupedWrap.style.display = 'none';
            flatWrap.style.display = '';

            // Detailed Records Table
            var recCountEl = document.getElementById('prev-records-count');
            var recTbody = document.getElementById('prev-records-tbody');
            var records = data.records || [];
            recCountEl.textContent = records.length;

            var recHtml = '';
            if (records.length === 0) {
                recHtml = '<tr><td colspan="10" class="text-center text-muted py-3">No partnerships found matching the selected filters.</td></tr>';
            } else {
                records.forEach(function(p, i) {
                    // Was its own inline ternary that defaulted anything not Active/Expiring Soon — including
                    // "Inactive" and any unexpected value — to the danger/red color. Now the one shared mapping
                    // every other status color in this page (and the exported PDF) also reads from.
                    var stBadge = CIPRMS_STATUS_COLORS.badgeClass(p.status);
                    recHtml += '<tr>'
                        + '<td>' + (i + 1) + '</td>'
                        + '<td class="fw-semibold">' + escapeHtml(p.inst) + '</td>'
                        + '<td>' + escapeHtml(p.country || '—') + '</td>'
                        + '<td>' + escapeHtml(p.region || '—') + '</td>'
                        + '<td><span class="badge bg-primary-subtle text-primary">' + escapeHtml(p.type || '—') + '</span></td>'
                        + '<td>' + escapeHtml((Array.isArray(p.nature) ? p.nature.join(', ') : p.nature) || '—') + '</td>'
                        + '<td><span class="badge bg-secondary-subtle text-secondary">' + escapeHtml((Array.isArray(p.unit) ? p.unit.join(', ') : p.unit) || '—') + '</span></td>'
                        + '<td>' + escapeHtml(p.start || '—') + '</td>'
                        + '<td>' + escapeHtml(p.end || '—') + '</td>'
                        + '<td><span class="badge ' + stBadge + '">' + escapeHtml(p.status || '—') + '</span></td>'
                        + '</tr>';
                });
            }
            recTbody.innerHTML = recHtml;
        }

        // Generic metrics-driven grouped table — mirrors the exact same
        // `metrics` (column list) + `comparisonData` (rows) shape the Excel
        // exporter's own isGrouped branch already renders from, so a
        // Country-grouped report's Preview table and its Excel sheet are
        // always the same columns/values, never two separate calculations.
        function renderGroupedPreviewTable(data) {
            var theadRow = document.getElementById('prev-grouped-thead-row');
            var tbody = document.getElementById('prev-grouped-tbody');
            var metrics = data.metrics || [];
            // Mirrors drawGroupedHeader()'s swatch in the exported PDF (cirl.js, renderPartnershipReportPdf's
            // grouped path) — a metric column whose label IS a status name (e.g. "Active", "Expired") gets the
            // same color swatch here in the preview, so the two never show a status colored differently.
            theadRow.innerHTML = metrics.map(function (m) {
                var swatch = CIPRMS_STATUS_COLORS.isKnownStatus(m)
                    ? '<span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:' + CIPRMS_STATUS_COLORS.hex(m) + ';margin-right:5px;"></span>'
                    : '';
                return '<th>' + swatch + escapeHtml(m) + '</th>';
            }).join('');

            var rows = data.comparisonData || [];
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="' + Math.max(metrics.length, 1) + '" class="text-center text-muted py-3">No partnerships found matching the selected filters.</td></tr>';
                return;
            }
            tbody.innerHTML = rows.map(function (row) {
                return '<tr>' + metrics.map(function (m) {
                    var v = row[m];
                    if (Array.isArray(v)) v = v.join(', ');
                    return '<td>' + escapeHtml(v === undefined || v === null || v === '' ? '—' : v) + '</td>';
                }).join('') + '</tr>';
            }).join('');
        }

        // Partnership fields (inst/country/type) are attacker-influenceable via
        // POST /api/partnerships (any Administrator/Personnel-entered value) with
        // no server-side sanitization — escape before building innerHTML strings
        // below (S17, Roadmap v2 Phase G7, docs/SYSTEM_AUDIT_2026-07-16.md).
        function escapeHtml(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // ── Load DSS Insights from MongoDB ───────────────────────────────────────────
        function loadDssInsights() {
            fetch('/api/partnerships/stats')
                .then(r => r.json())
                .then(function (s) {
                    // Update DSS alert text
                    var dssAlert = document.getElementById('dss-alert');
                    if (dssAlert) dssAlert.innerHTML = '<strong><i class="ri-information-line me-1"></i> Decision Support System (DSS) Active:</strong> Analyzing <strong>' + s.active + '</strong> active and <strong>' + s.expired + '</strong> expired partnerships. <strong>' + s.expiring + '</strong> expiring soon.';

                    // Update health score based on real data
                    var score = Math.round(((s.active / (s.total || 1)) * 60) + ((1 - (s.expired / (s.total || 1))) * 40));
                    var scoreEl = document.getElementById('health-score');
                    if (scoreEl) { scoreEl.textContent = score; scoreEl.className = score >= 70 ? 'display-5 fw-bold text-success mb-2' : score >= 50 ? 'display-5 fw-bold text-warning mb-2' : 'display-5 fw-bold text-danger mb-2'; }

                    // Top region gap
                    var regionEl = document.getElementById('region-gap-text');
                    if (regionEl) {
                        var regions = Object.entries(s.byRegion || {}).sort((a, b) => a[1] - b[1]);
                        if (regions.length) { var weakest = regions[0]; regionEl.innerHTML = '<strong>' + weakest[0] + '</strong> has only ' + weakest[1] + ' partnership(s). <strong>Recommendation:</strong> Prioritize establishing MOAs in this region to improve global reach and QS Stars rating.'; }
                    }

                    // Report card counts
                    var activeEl = document.getElementById('stat-active-count');
                    var expiringEl = document.getElementById('stat-expiring-count');
                    var expiredEl = document.getElementById('stat-expired-count');
                    if (activeEl) activeEl.textContent = s.active + ' record' + (s.active === 1 ? '' : 's');
                    if (expiringEl) expiringEl.textContent = s.expiring + ' record' + (s.expiring === 1 ? '' : 's');
                    if (expiredEl) expiredEl.textContent = s.expired + ' record' + (s.expired === 1 ? '' : 's');
                })
                .catch(function (err) { console.error('Failed to load stats:', err); });

            // Nearest-expiring / longest-overdue blocks need the raw list, not just the aggregate stats
            fetch('/api/partnerships')
                .then(r => r.json())
                .then(function (all) {
                    var withDays = all.map(function (p) {
                        var d = Math.ceil((new Date(p.end) - new Date()) / 86400000);
                        return Object.assign({}, p, { days: d });
                    });

                    var expiringBlock = document.getElementById('dss-expiring-block');
                    if (expiringBlock) {
                        var soon = withDays.filter(function (p) { return p.status === 'Expiring Soon'; })
                            .sort(function (a, b) { return a.days - b.days; });
                        if (soon.length) {
                            var p = soon[0];
                            expiringBlock.innerHTML = '<h6 class="mb-1 text-dark">' + escapeHtml(p.inst) + (p.country ? ' (' + escapeHtml(p.country) + ')' : '') + '</h6>'
                                + '<p class="text-muted mb-2 fs-13">This ' + escapeHtml(p.type) + ' expires in <strong>' + p.days + ' day' + (p.days === 1 ? '' : 's') + '</strong>.'
                                + (soon.length > 1 ? ' ' + (soon.length - 1) + ' other agreement' + (soon.length > 2 ? 's are' : ' is') + ' also expiring within 90 days.' : '') + '</p>'
                                + '<a href="/lifecycle" class="btn btn-sm btn-warning">Review in Lifecycle Monitor</a>';
                        } else {
                            expiringBlock.innerHTML = '<p class="text-muted mb-0 fs-13">No partnerships are currently expiring within the next 90 days.</p>';
                        }
                    }

                    var expiredBlock = document.getElementById('dss-expired-block');
                    if (expiredBlock) {
                        var expired = withDays.filter(function (p) { return p.status === 'Expired'; })
                            .sort(function (a, b) { return a.days - b.days; });
                        if (expired.length) {
                            var e = expired[0];
                            var overdueDays = Math.abs(e.days);
                            expiredBlock.innerHTML = '<h6 class="mb-1 text-dark">' + escapeHtml(e.inst) + (e.country ? ' (' + escapeHtml(e.country) + ')' : '') + '</h6>'
                                + '<p class="text-muted mb-2 fs-13">This ' + escapeHtml(e.type) + ' expired <strong>' + overdueDays + ' day' + (overdueDays === 1 ? '' : 's') + '</strong> ago.'
                                + (expired.length > 1 ? ' ' + (expired.length - 1) + ' other expired agreement' + (expired.length > 2 ? 's remain' : ' remains') + ' unrenewed.' : '')
                                + ' <strong>Recommendation:</strong> Renew or archive this record.</p>';
                        } else {
                            expiredBlock.innerHTML = '<p class="text-muted mb-0 fs-13">No expired agreements currently require review.</p>';
                        }
                    }
                })
                .catch(function (err) { console.error('Failed to load partnerships for DSS blocks:', err); });
        }


        // ── COMPARE REPORTS (accessed from the Preview modal) ──────────────────
        // Multi-configuration comparison: 1 to MAX_CMP_CONFIGS independent report
        // configurations, each with its own filters/Group By, all routed through
        // /api/reports/comparison/multi/* → computeMultiComparisonReport(), which
        // itself just runs each configuration through the same
        // computeCustomReportData() a single report already uses. Configurations
        // are a plain array rendered by iterating _cmpConfigIds — there is no
        // "Report A"/"Report B"-style hardcoding anywhere in this section.
        var _cmpChartInstance = null;
        var _lastComparisonData = null;
        var _lastComparisonQs = null;
        var _cmpConfigIds = [];
        var _cmpConfigSeq = 0;
        var MAX_CMP_CONFIGS = 5;
        var MIN_CMP_CONFIGS = 1;

        // Delegates to the one shared mapping (assets/js/shared/status-colors.js) — this function's own body
        // used to duplicate the same four if-checks the flat-records-table badge above also had its own
        // (slightly different, less complete) copy of; kept as a thin wrapper, not removed outright, so its
        // one call site below doesn't need to change.
        function statusBadgeClass(status) {
            return CIPRMS_STATUS_COLORS.badgeClass(status);
        }

        // Builds one configuration card's HTML. Mirrors exactly the 8 fields the
        // Custom Report Builder itself exposes (reportType/cat/dateFrom/dateTo/
        // agtype/status/country/unit) plus Group By — every input id follows the
        // cmpcfg-{id}-{field} convention so each card's state lives independently
        // in the DOM and is never shared with any other card.
        //
        // Mid-Year and Yearly Output Report are intentionally omitted from the
        // Comparison Report Type dropdown: they are not present in the primary
        // Custom Report Builder's Report Type field (they are fixed tile exports,
        // not user-configurable report types) and having them only in the
        // Comparison section created an inconsistent and confusing UX.
        function renderConfigCardHtml(id, index, prefill) {
            prefill = prefill || {};
            var sel = function (field, val) {
                return prefill[field] === val ? ' selected' : '';
            };
            var isStatusTyped = STATUS_TYPED_REPORT_TYPES.indexOf(prefill.reportType || 'Summary') !== -1;
            var statusDisabledAttr = isStatusTyped ? ' disabled' : '';
            var statusHintStyle    = isStatusTyped ? '' : 'display:none;';
            return '' +
                '<div class="card border mb-3" data-cmp-id="' + id + '">' +
                '  <div class="card-body">' +
                '    <div class="d-flex align-items-center justify-content-between mb-3">' +
                '      <h6 class="fw-semibold mb-0" id="cmpcfg-' + id + '-title">Comparison ' + (index + 1) + '</h6>' +
                '      <button type="button" class="btn btn-sm btn-outline-danger cmp-remove-btn" onclick="removeComparisonConfig(' + id + ')"><i class="ri-close-line me-1"></i>Remove</button>' +
                '    </div>' +
                '    <div class="row g-3">' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Label</label>' +
                '        <input type="text" class="form-control" id="cmpcfg-' + id + '-label" value="' + escapeHtml(prefill.label || '') + '">' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Report Type</label>' +
                '        <select class="form-select" id="cmpcfg-' + id + '-reportType" onchange="onCmpReportTypeChange(' + id + ')">' +
                '          <option value="Summary"'      + sel('reportType', 'Summary')      + '>Summary</option>' +
                '          <option value="Active Partnerships"' + sel('reportType', 'Active Partnerships') + '>Active Partnerships</option>' +
                '          <option value="Inactive Partnerships"' + sel('reportType', 'Inactive Partnerships') + '>Inactive Partnerships</option>' +
                '          <option value="Expiring Soon"' + sel('reportType', 'Expiring Soon') + '>Expiring Soon</option>' +
                '          <option value="Expired Partnerships"' + sel('reportType', 'Expired Partnerships') + '>Expired Partnerships</option>' +
                '        </select>' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Category</label>' +
                '        <input type="text" class="form-control" id="cmpcfg-' + id + '-cat" value="' + escapeHtml(prefill.cat || '') + '">' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6' + (isStatusTyped ? ' cr-status-disabled' : '') + '">' +
                '        <label class="form-label fw-semibold">Status</label>' +
                '        <select class="form-select" id="cmpcfg-' + id + '-status"' + statusDisabledAttr + '>' +
                '          <option value="">All</option>' +
                '          <option value="Active"'        + (prefill.status === 'Active'        ? ' selected' : '') + '>Active</option>' +
                '          <option value="Expiring Soon"' + (prefill.status === 'Expiring Soon' ? ' selected' : '') + '>Expiring Soon</option>' +
                '          <option value="Expired"'       + (prefill.status === 'Expired'       ? ' selected' : '') + '>Expired</option>' +
                '          <option value="Inactive"'      + (prefill.status === 'Inactive'      ? ' selected' : '') + '>Inactive</option>' +
                '        </select>' +
                '        <div class="form-text" id="cmpcfg-' + id + '-status-hint" style="' + statusHintStyle + '">Controlled by the selected Report Type.</div>' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Date From</label>' +
                '        <input type="date" class="form-control" id="cmpcfg-' + id + '-dateFrom" value="' + escapeHtml(prefill.dateFrom || '') + '">' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Date To</label>' +
                '        <input type="date" class="form-control" id="cmpcfg-' + id + '-dateTo" value="' + escapeHtml(prefill.dateTo || '') + '">' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Agreement Type</label>' +
                '        <select class="form-select" id="cmpcfg-' + id + '-agtype">' +
                '          <option value="">All</option>' +
                '          <option value="MOA"' + (prefill.agtype === 'MOA' ? ' selected' : '') + '>MOA</option>' +
                '          <option value="MOU"' + (prefill.agtype === 'MOU' ? ' selected' : '') + '>MOU</option>' +
                '        </select>' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Country</label>' +
                '        <div class="cr-country-wrap">' +
                '          <input type="text" class="form-control" id="cmpcfg-' + id + '-country" value="' + escapeHtml(prefill.country || '') + '" autocomplete="off" role="combobox" aria-expanded="false" aria-haspopup="listbox">' +
                '          <div class="cr-country-dropdown" id="cmpcfg-' + id + '-country-dropdown" role="listbox"></div>' +
                '        </div>' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">College / Unit</label>' +
                '        <div class="d-flex gap-2">' +
                '        <select class="form-select" id="cmpcfg-' + id + '-unit">' +
                '          <option value="">All Units</option>' +
                unitOptionsHtml(prefill.unit) +
                '        </select>' +
                '        <button type="button" class="btn btn-outline-primary flex-shrink-0" data-add-unit-for="cmpcfg-' + id + '-unit" title="Add New Unit" aria-label="Add New Unit"><i class="ri-add-line"></i></button>' +
                '        </div>' +
                '      </div>' +
                '      <div class="col-xl-3 col-md-6">' +
                '        <label class="form-label fw-semibold">Group By</label>' +
                '        <select class="form-select" id="cmpcfg-' + id + '-groupBy">' +
                '          <option value="">None</option>' +
                '          <option value="country"' + (prefill.groupBy === 'country' ? ' selected' : '') + '>Country</option>' +
                '          <option value="inst"'    + (prefill.groupBy === 'inst'    ? ' selected' : '') + '>Institution</option>' +
                '          <option value="unit"'    + (prefill.groupBy === 'unit'    ? ' selected' : '') + '>College / Unit</option>' +
                '          <option value="region"'  + (prefill.groupBy === 'region'  ? ' selected' : '') + '>Region</option>' +
                '          <option value="type"'    + (prefill.groupBy === 'type'    ? ' selected' : '') + '>Agreement Type</option>' +
                '          <option value="nature"'  + (prefill.groupBy === 'nature'  ? ' selected' : '') + '>Nature of Partnership</option>' +
                '          <option value="cat"'     + (prefill.groupBy === 'cat'     ? ' selected' : '') + '>Category</option>' +
                '        </select>' +
                '      </div>' +
                '    </div>' +
                '  </div>' +
                '</div>';
        }

        // Called by each comparison card's Report Type <select onchange>.
        // Applies the same disable/enable/clear rule as the primary builder.
        function onCmpReportTypeChange(id) {
            var typeEl   = document.getElementById('cmpcfg-' + id + '-reportType');
            var statusEl = document.getElementById('cmpcfg-' + id + '-status');
            if (!typeEl || !statusEl) return;
            var isStatusTyped = STATUS_TYPED_REPORT_TYPES.indexOf(typeEl.value) !== -1;
            statusEl.disabled = isStatusTyped;
            if (isStatusTyped) statusEl.value = '';
            var hint = document.getElementById('cmpcfg-' + id + '-status-hint');
            if (hint) hint.style.display = isStatusTyped ? '' : 'none';
            var col = statusEl.closest('[class*="col-"]');
            if (col) col.classList.toggle('cr-status-disabled', isStatusTyped);
        }

        function renumberComparisonConfigTitles() {
            _cmpConfigIds.forEach(function (id, index) {
                var t = document.getElementById('cmpcfg-' + id + '-title');
                if (t) t.textContent = 'Comparison ' + (index + 1);
            });
        }

        function updateCmpButtonsState() {
            var addBtn = document.getElementById('cmp-add-btn');
            var note = document.getElementById('cmp-limit-note');
            var atMax = _cmpConfigIds.length >= MAX_CMP_CONFIGS;
            if (addBtn) addBtn.disabled = atMax;
            if (note) note.textContent = atMax ? ('Maximum of ' + MAX_CMP_CONFIGS + ' comparisons reached.') : (_cmpConfigIds.length + ' of ' + MAX_CMP_CONFIGS + ' comparisons.');

            var showRemove = _cmpConfigIds.length > MIN_CMP_CONFIGS;
            document.querySelectorAll('.cmp-remove-btn').forEach(function (btn) {
                btn.style.display = showRemove ? '' : 'none';
            });
        }

        function addComparisonConfig(prefill) {
            if (_cmpConfigIds.length >= MAX_CMP_CONFIGS) return;
            var id = ++_cmpConfigSeq;
            _cmpConfigIds.push(id);
            var list = document.getElementById('cmp-configs-list');
            list.insertAdjacentHTML('beforeend', renderConfigCardHtml(id, _cmpConfigIds.length - 1, prefill));
            attachCountrySearch('cmpcfg-' + id + '-country', 'cmpcfg-' + id + '-country-dropdown');
            updateCmpButtonsState();
        }

        function removeComparisonConfig(id) {
            if (_cmpConfigIds.length <= MIN_CMP_CONFIGS) return;
            _cmpConfigIds = _cmpConfigIds.filter(function (x) { return x !== id; });
            var card = document.querySelector('[data-cmp-id="' + id + '"]');
            if (card) card.remove();
            renumberComparisonConfigTitles();
            updateCmpButtonsState();
        }

        // Reads live DOM values (never a separately-synced JS object) so nothing
        // an Administrator/Staff member typed can be lost by a re-render.
        function collectComparisonConfigs() {
            return _cmpConfigIds.map(function (id, index) {
                function val(field) {
                    var el = document.getElementById('cmpcfg-' + id + '-' + field);
                    return el ? el.value.trim() : '';
                }
                var cfg = {};
                var label = val('label');
                cfg.label = label || ('Comparison ' + (index + 1));
                var reportType = val('reportType'); if (reportType) cfg.reportType = reportType;
                var cat = val('cat'); if (cat) cfg.cat = cat;
                var status = val('status'); if (status) cfg.status = status;
                var dateFrom = val('dateFrom'); if (dateFrom) cfg.dateFrom = dateFrom;
                var dateTo = val('dateTo'); if (dateTo) cfg.dateTo = dateTo;
                var agtype = val('agtype'); if (agtype) cfg.agtype = agtype;
                var country = val('country'); if (country) cfg.country = country;
                var unit = val('unit'); if (unit) cfg.unit = unit;
                var groupBy = val('groupBy'); if (groupBy) cfg.groupBy = groupBy;
                return cfg;
            });
        }

        // First entry into the Compare view: seed exactly one configuration,
        // pre-filled from the Custom Report Builder's current filters (matching
        // "the first configuration starts from the report you just previewed").
        // Returning to this view later (changeComparison()) does NOT reset
        // anything already built.
        function openCompareSelect() {
            if (_cmpConfigIds.length === 0) {
                addComparisonConfig({
                    label: (_lastCustomReportData && _lastCustomReportData.title) || '',
                    reportType: document.getElementById('cr-type').value,
                    cat: document.getElementById('cr-cat').value,
                    dateFrom: document.getElementById('cr-date-from').value,
                    dateTo: document.getElementById('cr-date-to').value,
                    agtype: document.getElementById('cr-agtype').value,
                    status: document.getElementById('cr-status').value,
                    country: document.getElementById('cr-country').value.trim(),
                    unit: document.getElementById('cr-unit').value,
                    groupBy: document.getElementById('cr-groupby').value
                });
            }
            switchRpmView('compare-select');
        }

        function backToPreview() {
            switchRpmView('preview');
        }

        // Same stale-response guard as _previewRequestSeq, for the exact same
        // race (e.g. clicking "Generate Comparison" again before a prior
        // request finished).
        var _comparisonRequestSeq = 0;

        function generateComparison() {
            var configs = collectComparisonConfigs();
            if (!configs.length) return;
            var qs = 'configs=' + encodeURIComponent(JSON.stringify(configs));
            _lastComparisonQs = qs;
            var mySeq = ++_comparisonRequestSeq;
            var btn = document.getElementById('btn-generate-comparison');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line me-1"></i>Generating…'; }

            fetch('/api/reports/comparison/multi/preview?' + qs)
                .then(function (r) {
                    if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Server error while generating the comparison.'); });
                    return r.json();
                })
                .then(function (data) {
                    if (mySeq !== _comparisonRequestSeq) return; // superseded by a newer comparison request
                    _lastComparisonData = data;
                    renderMultiComparisonResult(data);
                    switchRpmView('compare-result');
                })
                .catch(function (err) {
                    if (mySeq !== _comparisonRequestSeq) return; // superseded by a newer comparison request
                    console.error('Comparison error:', err);
                    showRpmError('Failed to generate comparison: ' + err.message, function () { switchRpmView('compare-select'); });
                })
                .finally(function () {
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ri-git-branch-line me-1"></i>Generate Comparison'; }
                });
        }

        function renderRecordsIntoTable(tbodyId, records) {
            var tbody = document.getElementById(tbodyId);
            if (!records || !records.length) {
                tbody.innerHTML = '<tr><td class="text-center text-muted py-3">No records in this group.</td></tr>';
                return;
            }
            tbody.innerHTML = records.map(function (p) {
                return '<tr>' +
                    '<td class="fw-semibold">' + escapeHtml(p.inst || '—') + '<div class="text-muted fs-11">' + escapeHtml(p.country || '—') + '</div></td>' +
                    '<td><span class="badge ' + statusBadgeClass(p.status) + '">' + escapeHtml(p.status || '—') + '</span></td>' +
                    '</tr>';
            }).join('');
        }

        /**
         * Dynamically generates one row per comparison result (Comparison |
         * Partnerships | Percentage), iterating data.results — no hardcoded
         * "Report A"/"Report B" columns and no per-letter duplicated logic.
         * Real data only, from /api/reports/comparison/multi/preview. There is
         * deliberately no "Total Compared" metric anywhere in this function.
         */
        function renderMultiComparisonResult(data) {
            var results = data.results || [];
            document.getElementById('cmp-result-title').textContent = data.title || 'Multi-Configuration Comparison';
            document.getElementById('cmp-result-meta').textContent = 'Generated ' + data.generatedDate + ' by ' + data.generatedBy + ' • ' + results.length + ' configuration' + (results.length === 1 ? '' : 's');

            var emptyEl = document.getElementById('cmp-empty');
            var bodyEl = document.getElementById('cmp-result-body');
            if (!results.length || (data.grandTotal || 0) === 0) {
                emptyEl.style.display = '';
                bodyEl.style.display = 'none';
                if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
                return;
            }
            emptyEl.style.display = 'none';
            bodyEl.style.display = '';

            // Summary table: one row per comparison, from an iterated array.
            var summaryTbody = document.getElementById('cmp-summary-tbody');
            summaryTbody.innerHTML = results.map(function (r) {
                return '<tr>' +
                    '<td class="fw-semibold">' + escapeHtml(r.label) + '</td>' +
                    '<td>' + r.count + '</td>' +
                    '<td>' + Number(r.percentage).toFixed(1) + '%</td>' +
                    '</tr>';
            }).join('');

            // One detail card per comparison — clearly labeled, built from the
            // same array, so which records belong to which configuration is
            // always unambiguous.
            var configResultsEl = document.getElementById('cmp-config-results');
            configResultsEl.innerHTML = results.map(function (r) {
                var tbodyId = 'cmp-records-' + r.id;
                return '' +
                    '<div class="card border mb-3">' +
                    '  <div class="card-header bg-light d-flex align-items-center justify-content-between">' +
                    '    <h6 class="fw-semibold mb-0">' + escapeHtml(r.label) + '</h6>' +
                    '    <span class="badge bg-primary-subtle text-primary">' + r.count + ' partnership' + (r.count === 1 ? '' : 's') + ' • ' + Number(r.percentage).toFixed(1) + '%</span>' +
                    '  </div>' +
                    '  <div class="table-responsive">' +
                    '    <table class="table table-sm align-middle mb-0">' +
                    '      <tbody id="' + tbodyId + '"></tbody>' +
                    '    </table>' +
                    '  </div>' +
                    '</div>';
            }).join('');
            results.forEach(function (r) { renderRecordsIntoTable('cmp-records-' + r.id, r.records); });

            // Multi-series bar chart — one bar per comparison, colors cycle for
            // any count from 1 to MAX_CMP_CONFIGS, nothing hardcoded to 2.
            if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
            var chartEl = document.getElementById('cmp-apex-chart');
            chartEl.innerHTML = '';
            if (typeof ApexCharts !== 'undefined') {
                var colors = ['#0a3d91', '#991B1B', '#0ab39c', '#b45309', '#6d28d9'];
                _cmpChartInstance = new ApexCharts(chartEl, {
                    series: [{ name: 'Partnerships', data: results.map(function (r) { return r.count; }) }],
                    chart: { type: 'bar', height: 180 + (results.length * 20), toolbar: { show: false }, fontFamily: 'inherit' },
                    colors: results.map(function (r, i) { return colors[i % colors.length]; }),
                    plotOptions: { bar: { horizontal: true, barHeight: '55%', borderRadius: 4, distributed: true } },
                    dataLabels: { enabled: true },
                    xaxis: { categories: results.map(function (r) { return r.label; }) },
                    legend: { show: false }
                });
                _cmpChartInstance.render();
            }
        }

        function changeComparison() {
            switchRpmView('compare-select');
        }

        function clearComparison() {
            document.getElementById('cmp-configs-list').innerHTML = '';
            _cmpConfigIds = [];
            _lastComparisonData = null;
            _lastComparisonQs = null;
            if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
            openCompareSelect();
        }

        function exportComparison(format) {
            var qs = _lastComparisonQs || ('configs=' + encodeURIComponent(JSON.stringify(collectComparisonConfigs())));
            window.open('/api/reports/comparison/multi/' + format + '?' + qs, '_blank');
        }
        // ── END COMPARE REPORTS ─────────────────────────────────────────────────

        document.addEventListener('DOMContentLoaded', function () {
            // Load DSS stats quietly in background (elements are in the hidden insights tab)
            loadDssInsights();
            attachCountrySearch('cr-country', 'cr-country-dropdown');
        });

        // ── Searchable Country dropdown (2026-09-23; shared with Compare Reports 2026-09-25) ──────────
        // Used by the Custom Report Builder's #cr-country and every Compare Reports card's
        // #cmpcfg-{id}-country. Each stays a plain <input> whose raw .value is read and sent to the server
        // unchanged (no hidden field, no new query param, no backend change) — this only adds a type-to-filter
        // dropdown on top of it, sourced from the same COUNTRY_OPTIONS list the Registry and the Partner
        // Request form use (assets/js/shared/country-options.js). Matching is substring-anywhere and
        // case-insensitive; on blur a case-only difference is snapped to the list's spelling. Unlike the Partner
        // Request form, an off-list value is NOT rejected here: these are filters, and historical records
        // (e.g. "Philipines") must stay searchable.
        function matchCountryOption(raw) {
            var q = String(raw || '').trim().toLowerCase();
            if (!q || typeof COUNTRY_OPTIONS === 'undefined') return null;
            return COUNTRY_OPTIONS.find(function (c) { return c.toLowerCase() === q; }) || null;
        }

        function attachCountrySearch(inputId, dropdownId) {
            var input = document.getElementById(inputId);
            var dropdown = document.getElementById(dropdownId);
            if (!input || !dropdown || typeof COUNTRY_OPTIONS === 'undefined') return;
            var blurTimer = null;

            function closeDropdown() {
                dropdown.style.display = 'none';
                dropdown.innerHTML = '';
                input.setAttribute('aria-expanded', 'false');
            }
            function selectValue(val) {
                input.value = val;
                closeDropdown();
            }
            function openDropdown() {
                if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
                var q = input.value.trim().toLowerCase();
                // An exact pick (just selected, or prefilled) shows the full list again on reopen.
                var matches = (q && !matchCountryOption(q)) ? COUNTRY_OPTIONS.filter(function (c) { return c.toLowerCase().indexOf(q) !== -1; }) : COUNTRY_OPTIONS;
                dropdown.innerHTML = matches.length
                    ? matches.map(function (c) { return '<div class="cr-country-option" data-val="' + escapeHtml(c) + '">' + escapeHtml(c) + '</div>'; }).join('')
                    : '<div class="cr-country-empty">No matching country.</div>';
                dropdown.style.display = 'block';
                input.setAttribute('aria-expanded', 'true');
                dropdown.querySelectorAll('.cr-country-option').forEach(function (opt) {
                    opt.addEventListener('mousedown', function (e) { e.preventDefault(); selectValue(opt.getAttribute('data-val')); });
                });
            }

            input.addEventListener('focus', openDropdown);
            input.addEventListener('click', openDropdown);
            input.addEventListener('input', openDropdown);
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var q = input.value.trim().toUpperCase();
                    var match = COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase() === q; }) || COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase().indexOf(q) === 0; });
                    if (match) selectValue(match);
                } else if (e.key === 'Escape' && dropdown.style.display === 'block') {
                    // Only swallow Escape while OUR dropdown is open — otherwise leave it alone, so Escape
                    // still closes the Compare Reports modal when no dropdown is showing.
                    e.stopPropagation();
                    closeDropdown();
                }
            });
            input.addEventListener('blur', function () {
                blurTimer = setTimeout(function () {
                    closeDropdown();
                    var match = matchCountryOption(input.value);
                    if (match) input.value = match;
                }, 120);
            });
            document.addEventListener('click', function (e) {
                if (e.target !== input && !dropdown.contains(e.target)) closeDropdown();
            });
        }
    </script>

