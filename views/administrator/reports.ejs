<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg"
    data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Reports & Analytics | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <!-- gridjs css -->
    <link rel="stylesheet" href="/velzon/assets/libs/gridjs/theme/mermaid.min.css" />
    <script src="/velzon/assets/js/layout.js"></script>
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/ciprms-bridge.css?v=20260925d" rel="stylesheet" />
    <!-- Shared Country option list (same one the Registry Add/Edit Partnership Country combobox uses) — backs
         the Custom Report Builder's Country filter below, so there is one country list in the app, not two. -->
    <script src="/velzon/assets/js/shared/country-options.js"></script>
    <!-- Shared Responsible Unit list + "Add Responsible Unit" modal (same one the Registry Add/Edit
         Partnership Unit combobox uses) — backs the Custom Report Builder's and Comparison's College/Unit
         fields below, so there is one Responsible Unit list and one creation path in the app, never a
         separate unit-management system (2026-11 Dynamic College/Unit Dropdowns). -->
    <script src="/velzon/assets/js/shared/responsible-units.js"></script>
    <!-- Canonical partnership-status → color mapping (2026-10 status-color standardization) — the SAME file
         cirl.js require()'s server-side for PDF generation, loaded here as a plain global (CIPRMS_STATUS_COLORS)
         so the Custom Report Builder preview's badges/swatches and the exported PDF can never disagree on
         what color a given status is. -->
    <script src="/velzon/assets/js/shared/status-colors.js"></script>
    <!-- Custom Report Builder — searchable Country filter (2026-09-23). Same visual language (rounded corners,
         shadow, bounded/scrollable results, hover highlight, dark-mode variant) as the Registry page's Country
         combobox, defined independently here since this is a separate template with its own CSS. -->
    <style>
      /* Audit Trail filters: same size as the audit table's search bar (normal-size controls + its 14px text). */
      #audit-filter-action, #audit-filter-role, #audit-filter-from, #audit-filter-to,
      button[onclick="resetAuditFilters()"] { font-size: .875rem; }
      .cr-country-wrap { position: relative; }
      .cr-country-dropdown {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
        background: #fff; border: 1px solid #dfe3ea; border-radius: 8px;
        box-shadow: 0 10px 28px rgba(20,25,45,.14); max-height: 220px; overflow-y: auto; padding: 6px;
        display: none;
      }
      .cr-country-option { padding: 8px 10px; border-radius: 6px; font-size: .85rem; color: #313a46; cursor: pointer; }
      .cr-country-option:hover { background: #f0f2fb; color: #405189; }
      .cr-country-empty { padding: 10px; font-size: .8rem; color: #878a99; text-align: center; }
      [data-bs-theme="dark"] .cr-country-dropdown { background: #2a2f3c; border-color: #3a4053; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
      [data-bs-theme="dark"] .cr-country-option { color: #d3d5db; }
      [data-bs-theme="dark"] .cr-country-option:hover { background: #363c4c; color: #a9bcf5; }

      /* ── Status field disabled state (Report Type encodes the status) ─────── */
      #cr-status:disabled,
      .cr-status-disabled select:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
      }
      .cr-status-disabled label {
        opacity: 0.55;
      }
      .cr-status-disabled .form-text {
        font-style: italic;
      }
      /* dark-mode parity */
      [data-bs-theme="dark"] #cr-status:disabled,
      [data-bs-theme="dark"] .cr-status-disabled select:disabled {
        background-color: #2a2f3c;
        border-color: #3a4053;
        color: #6c757d;
      }
    </style>
</head>

<body>
    <div id="layout-wrapper">
        <%- include('../partials/header') %>
            <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

                <div class="main-content">
                    <div class="page-content">
                        <div class="container-fluid">

                            <!-- page title -->
                            <div class="row">
                                <div class="col-12">
                                    <div
                                        class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                                        <h4 class="mb-sm-0">Reports & Analytics</h4>
                                        <div class="page-title-right">
                                            <ol class="breadcrumb m-0">
                                                <li class="breadcrumb-item"><a href="<%= typeof homeHref !== 'undefined' ? homeHref : '/dashboard' %>">CIPRMS</a></li>
                                                <li class="breadcrumb-item active">Reports</li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Nav Tabs -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header border-0">
                                            <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0"
                                                role="tablist">
                                                <li class="nav-item">
                                                    <a class="nav-link active" id="tab-rep" href="#"
                                                        onclick="switchTab('rep');return false;">
                                                        <i class="ri-bar-chart-2-line me-1"></i> Reports
                                                    </a>
                                                </li>
                                                <li class="nav-item">
                                                    <a class="nav-link" id="tab-audit" href="#"
                                                        onclick="switchTab('audit');return false;">
                                                        <i class="ri-history-line me-1"></i> Audit Trail
                                                    </a>
                                                </li>
                                                <li class="nav-item">
                                                    <a class="nav-link" id="tab-insights" href="#"
                                                        onclick="switchTab('insights');return false;">
                                                        <i class="ri-lightbulb-flash-line me-1"></i> Strategic Insights
                                                        (DSS)
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- â”€â”€ REPORTS TAB â”€â”€ -->
                            <div id="content-rep">

                                <!-- Report Cards -->
                                <div class="row">

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-primary-subtle rounded fs-2"><i
                                                                data-feather="file-text"
                                                                class="text-primary"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Partnership Summary Report</h6>
                                                <p class="text-muted fs-13 mb-3">Complete overview of all active and
                                                    inactive partnerships, categorized by type, region, and college
                                                    unit.</p>
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {title:'Partnership Summary Report'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {title:'Partnership Summary Report'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-warning-subtle rounded fs-2"><i
                                                                data-feather="clock" class="text-warning"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Expiring Agreements Report</h6>
                                                <p class="text-muted fs-13 mb-3">List of agreements expiring within a
                                                    selected timeframe with renewal status and responsible units.</p>
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {status:'Expiring Soon', title:'Expiring Agreements Report'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {status:'Expiring Soon', title:'Expiring Agreements Report'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-success-subtle rounded fs-2"><i
                                                                data-feather="check-circle" class="text-success"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Active Partnerships List</h6>
                                                <p class="text-muted fs-13 mb-3">Full list of currently active MOA/MOU
                                                    agreements including responsible unit, coordinator, and expiry date.
                                                </p>
                                        
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {status:'Active', title:'Active Partnerships List'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {status:'Active', title:'Active Partnerships List'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-danger-subtle rounded fs-2"><i
                                                                data-feather="x-circle" class="text-danger"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Expired Partnerships List</h6>
                                                <p class="text-muted fs-13 mb-3">All expired agreements with last known
                                                    details and recommended renewal actions.</p>
                                         
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {status:'Expired', title:'Expired Partnerships List'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {status:'Expired', title:'Expired Partnerships List'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-warning-subtle rounded fs-2"><i
                                                                data-feather="alert-triangle"
                                                                class="text-warning"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Expiring Soon List</h6>
                                                <p class="text-muted fs-13 mb-3">Partnerships expiring within 90 days,
                                                    prioritized for renewal. Ideal for CHED reporting and audit prep.
                                                </p>
        
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {status:'Expiring Soon', title:'Expiring Soon List'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {status:'Expiring Soon', title:'Expiring Soon List'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-info-subtle rounded fs-2"><i
                                                                data-feather="calendar" class="text-info"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Mid-Year Output Report</h6>
                                                <p class="text-muted fs-13 mb-3">Summary of first-half partnership activities, including new, renewed, and expired agreements.</p>
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportMidYearReport('pdf')"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportMidYearReport('excel')"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-primary-subtle rounded fs-2"><i
                                                                data-feather="bar-chart-2" class="text-primary"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Yearly Output Report</h6>
                                                <p class="text-muted fs-13 mb-3">Annual summary of partnership records for the academic/calendar year, suitable for CHED submission.</p>
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportYearlyReport('pdf')"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportYearlyReport('excel')"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6">
                                        <div class="card card-animate h-150">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex mb-3">
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-success-subtle rounded fs-2"><i
                                                                data-feather="globe" class="text-success"></i></span>
                                                    </div>
                                                </div>
                                                <h6 class="fs-15 fw-semibold">Partnership by Country</h6>
                                                <p class="text-muted fs-13 mb-3">Percentage distribution of every
                                                    partnership on record, grouped by country.</p>
                                                <div class="d-flex gap-2 mt-auto">
                                                    <button class="btn btn-sm btn-danger" onclick="exportReport('pdf', {title:'Partnership by Country Report', groupBy:'country'})"><i
                                                            class="ri-file-pdf-line me-1"></i>PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportReport('excel', {title:'Partnership by Country Report', groupBy:'country'})"><i
                                                            class="ri-table-line me-1"></i>Excel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div><!-- end report cards row -->

                                <!-- Custom Report Builder -->
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header border-0 d-flex align-items-center flex-wrap gap-2">
                                                <h5 class="card-title mb-0 flex-grow-1"><i
                                                        class="ri-equalizer-line me-2 text-primary"></i>Custom Report
                                                    Builder</h5>
                                                <span class="badge bg-primary-subtle text-primary fs-12"><i class="ri-shield-line me-1"></i>Advanced Analytics</span>
                                            </div>
                                            <div class="card-body pt-0">
                                                <h6 class="text-uppercase fs-11 fw-semibold text-muted mb-2 mt-1">Report Configuration</h6>
                                                <div class="row g-3 mb-3">
                                                    <div class="col-xl-6 col-md-6">
                                                        <label class="form-label fw-semibold">Report Title</label>
                                                        <input type="text" class="form-control" id="cr-title">
                                                    </div>
                                                    <div class="col-xl-6 col-md-6">
                                                        <label class="form-label fw-semibold">Report Type</label>
                                                        <select class="form-select" id="cr-type" onchange="onReportTypeChange()">
                                                            <option value="Summary">Summary</option>
                                                            <option value="Active Partnerships">Active Partnerships</option>
                                                            <option value="Inactive Partnerships">Inactive Partnerships</option>
                                                            <option value="Expired Partnerships">Expired Partnerships</option>
                                                            <option value="Expiring Soon">Expiring Soon</option>
                                                            <!-- Preserved legacy aliases -->
                                                            <option value="Expiration" style="display:none;">Expiration</option>
                                                            <option value="Active List" style="display:none;">Active List</option>
                                                            <option value="Expired List" style="display:none;">Expired List</option>
                                                            <option value="Mid-Year" style="display:none;">Mid-Year</option>
                                                            <option value="Yearly" style="display:none;">Yearly</option>
                                                            <option value="Audit" style="display:none;">Audit</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <h6 class="text-uppercase fs-11 fw-semibold text-muted mb-2">Partnership Filters</h6>
                                                <div class="row g-3 mb-3">
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Category</label>
                                                        <select class="form-select" id="cr-cat">
                                                            <option value="">All</option>
                                                            <option>International</option>
                                                            <option>Local</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Agreement Type</label>
                                                        <select class="form-select" id="cr-agtype">
                                                            <option value="">All</option>
                                                            <option>MOA</option>
                                                            <option>MOU</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-xl-3 col-md-6" id="cr-status-col">
                                                        <label class="form-label fw-semibold" for="cr-status">Status</label>
                                                        <select class="form-select" id="cr-status">
                                                            <option value="">All</option>
                                                            <option>Active</option>
                                                            <option>Expiring Soon</option>
                                                            <option>Expired</option>
                                                            <option>Inactive</option>
                                                        </select>
                                                        <div class="form-text" id="cr-status-hint" style="display:none;">Controlled by the selected Report Type.</div>
                                                    </div>
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Country</label>
                                                        <div class="cr-country-wrap">
                                                            <input type="text" class="form-control" id="cr-country" autocomplete="off" role="combobox" aria-expanded="false" aria-haspopup="listbox">
                                                            <div class="cr-country-dropdown" id="cr-country-dropdown" role="listbox"></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">College / Unit</label>
                                                        <!-- Options populated from the live, shared Responsible Unit list (assets/js/shared/
                                                             responsible-units.js's UNIT_OPTIONS, same source as Monitoring's Add/Edit Partnership
                                                             Unit combobox) by renderUnitSelect() below — the six hard-coded <option>s this used to
                                                             have were seeded here only as a no-JS/pre-load fallback, same seed UNIT_OPTIONS itself
                                                             starts with, never a second authoritative list (2026-11 Dynamic College/Unit Dropdowns). -->
                                                        <div class="d-flex gap-2">
                                                            <select class="form-select" id="cr-unit">
                                                                <option value="">All Units</option>
                                                                <option value="CCS">CCS</option>
                                                                <option value="CILS">CILS</option>
                                                                <option value="CETE">CETE</option>
                                                                <option value="CNAS">CNAS</option>
                                                                <option value="CAMS">CAMS</option>
                                                                <option value="CIRL">CIRL</option>
                                                            </select>
                                                            <button type="button" class="btn btn-outline-primary flex-shrink-0" id="cr-unit-add-btn" title="Add New Unit" aria-label="Add New Unit"><i class="ri-add-line"></i></button>
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Group By</label>
                                                        <select class="form-select" id="cr-groupby">
                                                            <option value="">None</option>
                                                            <option value="country">Country</option>
                                                            <option value="inst">Institution</option>
                                                            <option value="unit">College / Unit</option>
                                                            <option value="region">Region</option>
                                                            <option value="type">Agreement Type</option>
                                                            <option value="nature">Nature of Partnership</option>
                                                            <option value="cat">Category</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <h6 class="text-uppercase fs-11 fw-semibold text-muted mb-2">Date Filters</h6>
                                                <div class="row g-3">
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Date From</label>
                                                        <input type="date" class="form-control" id="cr-date-from">
                                                    </div>
                                                    <div class="col-xl-3 col-md-6">
                                                        <label class="form-label fw-semibold">Date To</label>
                                                        <input type="date" class="form-control" id="cr-date-to">
                                                        <div class="invalid-feedback" id="cr-date-error">Date To cannot be earlier than Date From.</div>
                                                    </div>
                                                </div>
                                                <%- /* 2026-10-08: this text used to describe period-OVERLAP semantics ("an agreement that began
                                                     earlier but is still running in that window is included"), which is not what
                                                     computeCustomReportData()/filterByDateRange() (cirl.js) actually do and never have for
                                                     this generic filter — they keep only partnerships whose own signing date (or, for an
                                                     Expired/Expiring Soon report, expiration date) falls on or between Date From and Date To,
                                                     inclusive of both boundaries. Corrected to describe the real, strict behavior instead of
                                                     silently diverging from it. */ %>
                                                <div class="form-text mt-2" id="cr-date-help">Keeps only partnerships dated on or between Date From and Date To (both boundary dates included) — the signing date for most reports, or the expiration date for an Expired/Expiring Soon report. Leave a date empty for no limit on that side; the same date in both fields shows only partnerships dated exactly that day.</div>

                                                <div class="mt-4 d-flex gap-2 flex-wrap">
                                                    <button class="btn btn-primary" id="btn-cr-preview" onclick="previewCustomReport()"><i
                                                            class="ri-eye-line me-1"></i>Preview</button>
                                                    <button class="btn btn-danger" onclick="generateCustomReport('pdf')"><i
                                                            class="ri-file-pdf-line me-1"></i>Generate PDF</button>
                                                    <button class="btn btn-success" onclick="generateCustomReport('excel')"><i
                                                            class="ri-table-line me-1"></i>Generate Excel</button>
                                                    <button class="btn btn-outline-secondary ms-auto" onclick="resetCustomReportFilters()"><i
                                                            class="ri-refresh-line me-1"></i>Reset Filters</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ══════════════════════════════════════════════════════════════════ -->
                                <!-- Report Preview + Compare — single connected modal workflow            -->
                                <!-- (Reports & Analytics → Custom Report Builder → Preview → Compare →     -->
                                <!-- pick a dimension/value → 3-column result: new selection (left) /       -->
                                <!-- result (center) / original, untouched report (right))                 -->
                                <!-- ══════════════════════════════════════════════════════════════════ -->
                                <div class="modal fade" id="report-preview-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <div class="flex-grow-1">
                                                    <h5 class="modal-title mb-1" id="prev-title">Report Preview</h5>
                                                    <p class="text-muted fs-12 mb-0" id="prev-meta">Generated date & user...</p>
                                                </div>
                                                <button type="button" class="btn-close" onclick="closeReportModal()" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">

                                                <!-- Loading state -->
                                                <div id="rpm-loading" class="text-center py-5" style="display:none;">
                                                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                                                    <p class="text-muted mt-3 mb-0">Generating report…</p>
                                                </div>

                                                <!-- Error state — `d-flex` is a Bootstrap "display" utility and is
                                                     therefore !important; putting it directly on this element made
                                                     `style.display = 'none'` unable to ever actually hide it (the
                                                     !important class always won), so the error banner rendered
                                                     permanently, regardless of success or failure. Keeping the outer
                                                     toggle target free of any display utility class, with the flex
                                                     layout on an inner wrapper instead, lets the JS show/hide actually
                                                     take effect. -->
                                                <div id="rpm-error" class="alert alert-danger" style="display:none;">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="ri-error-warning-line fs-4"></i>
                                                        <div class="flex-grow-1" id="rpm-error-text">Something went wrong.</div>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" id="rpm-retry-btn" onclick="previewCustomReport()">Retry</button>
                                                    </div>
                                                </div>

                                                <!-- VIEW 1: Single Report Preview -->
                                                <div id="rpm-view-preview">
                                                    <div class="mb-3 d-flex align-items-center flex-wrap gap-1" id="prev-filters"></div>
                                                    <div class="row g-3 mb-4" id="prev-summary-cards"></div>

                                                    <!-- Grouped view (Group By set, e.g. Country) — same computeCustomReportData()
                                                         result PDF/Excel already render as a grouped table; shown instead of the
                                                         flat records table below, never alongside it. -->
