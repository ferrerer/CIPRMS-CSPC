                                                                <span id="ai-error-message"></span>
                                                                <button type="button"
                                                                    class="btn btn-sm btn-outline-danger ms-2"
                                                                    id="ai-retry-btn">Retry</button>
                                                            </div>
                                                            <div id="ai-state-ready" class="d-none">
                                                                <div id="ai-interpretation-list"></div>
                                                                <p class="text-muted fs-12 mt-2 mb-0" id="ai-cache-note">
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
