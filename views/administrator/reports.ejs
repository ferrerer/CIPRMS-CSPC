                                                            <tbody id="prev-grouped-tbody"></tbody>
                                                        </table>
                                                    </div>

                                                    <div class="table-responsive" id="prev-flat-wrap">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <h6 class="fw-semibold mb-0 text-dark flex-grow-1"><i class="ri-list-check-2 me-1 text-primary"></i>Included Records (<span id="prev-records-count">0</span>)</h6>
                                                        </div>
                                                        <table class="table table-sm table-bordered align-middle mb-0">
