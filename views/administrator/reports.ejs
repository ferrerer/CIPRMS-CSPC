                                <!-- pick a dimension/value → 3-column result: new selection (left) /       -->
                                <!-- result (center) / original, untouched report (right))                 -->
                                <!-- ══════════════════════════════════════════════════════════════════ -->
                                <div class="modal fade" id="report-preview-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <div class="flex-grow-1">
                                                    <h5 class="modal-title mb-1" id="prev-title">Report Preview</h5>
                                                    <p class="text-muted fs-12 mb-0" id="prev-meta">Generated date & user...</p>
                                                </div>
                                                <button type="button" class="btn-close" onclick="closeReportModal()" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">

                                                <!-- Loading state -->
                                                <div id="rpm-loading" class="text-center py-5" style="display:none;">
                                                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                                                    <p class="text-muted mt-3 mb-0">Generating report…</p>
                                                </div>

                                                <!-- Error state — `d-flex` is a Bootstrap "display" utility and is
                                                     therefore !important; putting it directly on this element made
                                                     `style.display = 'none'` unable to ever actually hide it (the
                                                     !important class always won), so the error banner rendered
                                                     permanently, regardless of success or failure. Keeping the outer
                                                     toggle target free of any display utility class, with the flex
                                                     layout on an inner wrapper instead, lets the JS show/hide actually
                                                     take effect. -->
                                                <div id="rpm-error" class="alert alert-danger" style="display:none;">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="ri-error-warning-line fs-4"></i>
                                                        <div class="flex-grow-1" id="rpm-error-text">Something went wrong.</div>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" id="rpm-retry-btn" onclick="previewCustomReport()">Retry</button>
                                                    </div>
                                                </div>

                                                <!-- VIEW 1: Single Report Preview -->
                                                <div id="rpm-view-preview">
                                                    <div class="mb-3 d-flex align-items-center flex-wrap gap-1" id="prev-filters"></div>
                                                    <div class="row g-3 mb-4" id="prev-summary-cards"></div>

                                                    <!-- Grouped view (Group By set, e.g. Country) — same computeCustomReportData()
                                                         result PDF/Excel already render as a grouped table; shown instead of the
                                                         flat records table below, never alongside it. -->
                                                    <div class="table-responsive" id="prev-grouped-wrap" style="display:none;">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <h6 class="fw-semibold mb-0 text-dark flex-grow-1"><i class="ri-bar-chart-2-line me-1 text-primary"></i>Grouped Breakdown</h6>
                                                        </div>
                                                        <table class="table table-sm table-bordered align-middle mb-0">
                                                            <thead class="bg-light"><tr id="prev-grouped-thead-row"></tr></thead>
                                                            <tbody id="prev-grouped-tbody"></tbody>
                                                        </table>
                                                    </div>

                                                    <div class="table-responsive" id="prev-flat-wrap">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <h6 class="fw-semibold mb-0 text-dark flex-grow-1"><i class="ri-list-check-2 me-1 text-primary"></i>Included Records (<span id="prev-records-count">0</span>)</h6>
                                                        </div>
                                                        <table class="table table-sm table-bordered align-middle mb-0">
                                                            <thead class="bg-light">
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Institution</th>
                                                                    <th>Country</th>
                                                                    <th>Region</th>
                                                                    <th>Type</th>
                                                                    <th>Nature</th>
                                                                    <th>Unit</th>
                                                                    <th>Start</th>
                                                                    <th>End</th>
                                                                    <th>Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="prev-records-tbody"></tbody>
                                                        </table>
                                                    </div>
                                                </div><!-- end rpm-view-preview -->

                                                <!-- VIEW 2: Compare — configure 1 to 5 independent report configurations.
                                                     Each config card below owns its OWN filters (never shared with any
                                                     other config or with the main Builder) and is submitted through
                                                     /api/reports/comparison/multi/* — the existing N-way engine. -->
                                                <div id="rpm-view-compare-select" style="display:none;">
                                                    <div class="alert alert-info d-flex align-items-start gap-2 mb-3">
                                                        <i class="ri-information-line fs-4"></i>
                                                        <div class="fs-13">
                                                            <strong>Build 2 to 5 independent report configurations to compare.</strong> Each configuration has its own filters and Group By — nothing is shared between them. The first configuration starts pre-filled from the Custom Report Builder above; add more with "Add Comparison".
                                                        </div>
                                                    </div>
                                                    <div id="cmp-configs-list"></div>
                                                    <div class="d-flex align-items-center gap-2 mb-4">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" id="cmp-add-btn" onclick="addComparisonConfig()"><i class="ri-add-line me-1"></i>Add Comparison</button>
                                                        <span class="text-muted fs-12" id="cmp-limit-note"></span>
                                                    </div>
                                                    <div class="mt-4">
                                                        <button class="btn btn-info text-white" id="btn-generate-comparison" onclick="generateComparison()"><i class="ri-git-branch-line me-1"></i>Generate Comparison</button>
                                                    </div>
                                                </div><!-- end rpm-view-compare-select -->

                                                <!-- VIEW 3: Comparison Result — one row per configuration (dynamic,
                                                     2-5), no fixed "Group A"/"Group B" columns and no "Total Compared"
                                                     metric anywhere. -->
                                                <div id="rpm-view-compare-result" style="display:none;">
                                                    <div class="mb-3">
                                                        <h6 class="fw-semibold mb-1" id="cmp-result-title"></h6>
                                                        <p class="text-muted fs-12 mb-0" id="cmp-result-meta"></p>
                                                    </div>
                                                    <div id="cmp-empty" class="text-center text-muted py-4" style="display:none;">
                                                        <i class="ri-inbox-line fs-2 d-block mb-2"></i>No comparison data for the selected configurations.
                                                    </div>
                                                    <div id="cmp-result-body">
                                                        <div id="cmp-chart-card" class="mb-3">
                                                            <div class="row g-3">
                                                                <div class="col-lg-7">
                                                                    <div id="cmp-apex-chart" class="apex-charts" dir="ltr"></div>
                                                                </div>
                                                                <div class="col-lg-5">
                                                                    <div id="cmp-pie-chart" class="apex-charts" dir="ltr"></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="table-responsive mb-4">
                                                            <table class="table table-sm table-bordered align-middle mb-0">
                                                                <thead class="bg-light"><tr><th>Comparison</th><th>Partnerships</th><th>Percentage</th></tr></thead>
                                                                <tbody id="cmp-summary-tbody"></tbody>
                                                            </table>
                                                        </div>
                                                        <div id="cmp-config-results"></div>
                                                    </div>
                                                </div><!-- end rpm-view-compare-result -->

                                            </div><!-- end modal-body -->

                                            <div class="modal-footer flex-wrap gap-2" id="rpm-footer-preview">
                                                <button type="button" class="btn btn-danger" onclick="generateCustomReport('pdf')"><i class="ri-file-pdf-line me-1"></i>Export PDF</button>
                                                <button type="button" class="btn btn-success" onclick="generateCustomReport('excel')"><i class="ri-table-line me-1"></i>Export Excel</button>
                                                <button type="button" class="btn btn-info text-white" onclick="openCompareSelect()"><i class="ri-git-branch-line me-1"></i>Compare</button>
                                                <button type="button" class="btn btn-light" onclick="closeReportModal()">Close</button>
                                                <button type="button" class="btn btn-outline-secondary" onclick="closeReportModal()"><i class="ri-arrow-go-back-line me-1"></i>Back / Edit</button>
                                            </div>
                                            <div class="modal-footer flex-wrap gap-2" id="rpm-footer-compare-select" style="display:none;">
                                                <button type="button" class="btn btn-light" onclick="closeReportModal()">Close</button>
                                                <button type="button" class="btn btn-outline-secondary" onclick="backToPreview()"><i class="ri-arrow-go-back-line me-1"></i>Back to Report Preview</button>
                                            </div>
                                            <div class="modal-footer flex-wrap gap-2" id="rpm-footer-compare-result" style="display:none;">
                                                <button type="button" class="btn btn-light" onclick="closeReportModal()">Close</button>
                                                <button type="button" class="btn btn-outline-secondary" onclick="backToPreview()"><i class="ri-arrow-go-back-line me-1"></i>Back to Report Preview</button>
                                                <button type="button" class="btn btn-outline-warning" onclick="changeComparison()"><i class="ri-edit-2-line me-1"></i>Change Comparison</button>
                                                <button type="button" class="btn btn-outline-danger" onclick="clearComparison()"><i class="ri-close-circle-line me-1"></i>Clear Comparison</button>
                                                <button type="button" class="btn btn-danger" onclick="exportComparison('pdf')"><i class="ri-file-pdf-line me-1"></i>Export PDF</button>
                                                <button type="button" class="btn btn-success" onclick="exportComparison('excel')"><i class="ri-table-line me-1"></i>Export Excel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div><!-- end report-preview-modal -->

                            </div><!-- end content-rep -->

                            <!-- ── AUDIT TRAIL TAB ── -->
                            <div id="content-audit" style="display:none;">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header border-0">
                                                <% var isStaffOwnTrail = typeof user !== 'undefined' && user && user.role === 'Staff'; %>
                                                <div class="d-flex align-items-center flex-wrap gap-2">
                                                    <h5 class="card-title mb-0 flex-grow-1"><i
                                                            class="ri-history-line me-2 text-primary"></i><%= isStaffOwnTrail ? 'My Activity Trail' : 'Activity / Audit Trail' %></h5>
                                                    <button class="btn btn-sm btn-danger" onclick="exportAuditPDF()"><i
                                                            class="ri-file-pdf-line me-1"></i>Export Log PDF</button>
                                                    <button class="btn btn-sm btn-success" onclick="exportAuditExcel()"><i
                                                            class="ri-table-line me-1"></i>Export Log Excel</button>
                                                </div>
                                                <p class="text-muted mt-1 mb-0 fs-12"><%= isStaffOwnTrail ? 'Your own actions, logged for transparency and accountability.' : 'All system actions logged for transparency and accountability' %></p>
                                            </div>
                                            <div class="card-body pt-0">
                                                <!-- Filters. Category/Status (2026-10-21 audit-logging investigation) filter the new structured fields
                                                     every login/security event now carries — the fast way to find LOGIN_FAILED/LOGIN_BLOCKED activity an
                                                     Administrator is specifically investigating, without scrolling the whole trail. Pre-existing
                                                     ADD/EDIT/DELETE/etc. rows have no category/status and simply don't match either filter, exactly
                                                     like a Role filter already didn't match a legacy record with no stored email. -->
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-3">
                                                        <select id="audit-filter-action" class="form-select" onchange="applyAuditFilters()">
                                                            <option value="">All Actions</option>
                                                            <option value="LOGIN_SUCCESS">LOGIN_SUCCESS</option>
                                                            <option value="LOGIN_FAILED">LOGIN_FAILED</option>
                                                            <option value="LOGIN_BLOCKED">LOGIN_BLOCKED</option>
                                                            <option value="GOOGLE_AUTH_INITIATED">GOOGLE_AUTH_INITIATED</option>
                                                            <option value="GOOGLE_AUTH_CALLBACK">GOOGLE_AUTH_CALLBACK</option>
                                                            <option value="LOGOUT">LOGOUT</option>
                                                            <option value="FORBIDDEN">FORBIDDEN</option>
                                                            <option value="ADD">ADD</option>
                                                            <option value="EDIT">EDIT</option>
                                                            <option value="DELETE">DELETE</option>
                                                            <option value="APPROVE">APPROVE</option>
                                                            <option value="REJECT">REJECT</option>
                                                            <option value="RENEW">RENEW</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <select id="audit-filter-category" class="form-select" onchange="applyAuditFilters()">
                                                            <option value="">All Categories</option>
                                                            <option value="Authentication">Authentication</option>
                                                            <option value="Security">Security</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <select id="audit-filter-status" class="form-select" onchange="applyAuditFilters()">
                                                            <option value="">All Statuses</option>
                                                            <option value="success">Success</option>
                                                            <option value="failure">Failure</option>
                                                            <option value="blocked">Blocked</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <select id="audit-filter-role" class="form-select" onchange="applyAuditFilters()">
                                                            <option value="">All Roles</option>
                                                            <option value="Administrator">Administrator</option>
                                                            <option value="Auth. Personnel">College Dean</option>
                                                            <option value="potential_partner">Partner</option>
                                                            <option value="Staff">CIRL Staff</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-12 text-muted mb-1">Date From</label>
                                                        <input type="date" id="audit-filter-from" class="form-control" onchange="applyAuditFilters()">
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-12 text-muted mb-1">Date To</label>
                                                        <input type="date" id="audit-filter-to" class="form-control" onchange="applyAuditFilters()">
                                                    </div>
                                                    <div class="col-md-3 d-flex align-items-end">
                                                        <button class="btn btn-outline-secondary w-100" onclick="resetAuditFilters()"><i class="ri-refresh-line me-1"></i>Reset Filters</button>
                                                    </div>
                                                </div>
                                                <div id="audit-grid"></div>
                                                <div id="audit-empty" class="text-center text-muted py-5" style="display:none;">
                                                    <i class="ri-history-line fs-1 mb-2 d-block"></i>
                                                    <p class="mb-0">No audit logs found. Actions on partnerships, users, and access requests will appear here.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- end content-audit -->

                            <!-- â”€â”€ STRATEGIC INSIGHTS (DSS) TAB â”€â”€ -->
                            <!-- AI-insights panel / Ask-a-Question panel (2026-11 — moved here from the Admin/Staff
                                 dashboards; the old recommendations list and health-score widget, which used
                                 to occupy these two cards, were removed — see the move's own report for why). -->
                            <div id="content-insights" style="display:none;">
                                <div class="row g-3">
                                    <div class="col-xl-12">
                                        <div class="card" id="ai-insights-card">
                                            <div class="card-header border-0 align-items-center d-flex flex-wrap gap-2">
                                                <div class="flex-grow-1">
                                                    <h4 class="card-title mb-0"><i
                                                            class="ri-robot-2-line me-2 text-primary"></i>AI Strategic
                                                        Insights</h4>
                                                    <p class="fs-12 text-muted mb-0 mt-1">
                                                        <i class="ri-time-line align-middle me-1"></i><span
                                                            id="ai-insights-last-generated">Not yet generated</span>
                                                    </p>
                                                </div>
                                                <div class="flex-shrink-0 d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-soft-primary d-none"
                                                        id="ai-generate-btn">
                                                        <i class="ri-magic-line align-middle me-1"></i>Generate
                                                        Insights</button>
                                                    <button type="button" class="btn btn-sm btn-soft-secondary d-none"
                                                        id="ai-regenerate-btn">
                                                        <i class="ri-refresh-line align-middle me-1"></i>Regenerate</button>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <p class="text-muted fs-13 mb-3">
                                                    Gemini interprets the institutional indicators already computed
                                                    below — partnership coverage, international reach, expiring
                                                    concentrations and target gaps. It never calculates or replaces
                                                    these figures; it only explains and prioritizes what the system
                                                    has already verified.
                                                </p>

                                                <!-- Verified Figures are always shown once any response has landed —
                                                     deterministic figures must stay visible even when AI generation
                                                     is blocked/empty/erroring. -->
                                                <div class="row g-3">
                                                    <div class="col-lg-6">
                                                        <div class="border rounded p-3 h-100 ai-scroll-box">
                                                            <h6 class="text-uppercase fs-12 text-muted mb-2">
                                                                <i
                                                                    class="ri-shield-check-line align-middle me-1 text-success"></i>Verified
                                                                Institutional Figures</h6>
                                                            <div id="ai-verified-figures" class="text-muted fs-13">
                                                                <span
                                                                    class="spinner-border spinner-border-sm me-2"></span>Loading…
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6">
                                                        <div class="border rounded p-3 h-100 ai-scroll-box"
                                                            style="background: var(--vz-light, #f3f3f9);">
                                                            <h6 class="text-uppercase fs-12 text-muted mb-2">
                                                                <i
                                                                    class="ri-sparkling-2-line align-middle me-1 text-primary"></i>AI-Generated
                                                                Interpretation</h6>
                                                            <div id="ai-state-checking" class="d-none text-muted fs-14">
                                                                <span
                                                                    class="spinner-border spinner-border-sm me-2"></span>Checking
                                                                for available insights…</div>
                                                            <div id="ai-state-blocked"
                                                                class="d-none alert alert-secondary mb-0">
                                                                <i
                                                                    class="ri-shield-keyhole-line align-middle me-1"></i>
                                                                <span id="ai-blocked-message"></span>
                                                            </div>
                                                            <div id="ai-state-empty" class="d-none text-muted fs-14">
                                                                No AI insights have been generated yet. Click "Generate
                                                                Insights" to interpret the figures on the left.</div>
                                                            <div id="ai-state-generating"
                                                                class="d-none text-muted fs-14">
                                                                <span
                                                                    class="spinner-border spinner-border-sm me-2"></span>Generating
                                                                insights…</div>
                                                            <div id="ai-state-error"
