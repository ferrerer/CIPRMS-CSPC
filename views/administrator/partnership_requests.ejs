                        <div class="stat-icon bg-secondary-subtle">
                          <i class="ri-file-shield-2-line text-secondary fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <% } %>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Pending Review</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-warning" id="cnt-pending-all">—</h3>
                        </div>
                        <div class="stat-icon bg-warning-subtle">
                          <i class="ri-time-line text-warning fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Approved</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-success" id="cnt-approved-all">—</h3>
                        </div>
                        <div class="stat-icon bg-success-subtle">
                          <i class="ri-checkbox-circle-line text-success fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Rejected</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-danger" id="cnt-rejected-all">—</h3>
                        </div>
                        <div class="stat-icon bg-danger-subtle">
                          <i class="ri-close-circle-line text-danger fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Main Card -->
              <div class="row">
                <div class="col-12">
                  <div class="card border-0 shadow-sm">
                    <div class="card-header border-bottom bg-transparent pt-3 pb-0">
                      <!-- Section switcher cards -->
                      <div class="section-tabs">
                        <a class="section-tab active" id="tab-pr" href="#" onclick="switchSection('pr');return false;">
                          <div class="section-tab-icon"><i class="ri-building-4-line"></i></div>
                          <div class="section-tab-body">
                            <span class="section-tab-title">Partnership Requests/Submission</span>
                          </div>
                          <span class="tab-count" id="tab-cnt-pr">0</span>
                        </a>
                        <% if (typeof user === 'undefined' || !user || user.role !== 'LAU') { %>
                        <a class="section-tab" id="tab-dr" href="#" onclick="switchSection('dr');return false;">
                          <div class="section-tab-icon"><i class="ri-file-shield-2-line"></i></div>
                          <div class="section-tab-body">
                            <span class="section-tab-title">Document Requests</span>
                            <span class="section-tab-desc">Official document processing</span>
                          </div>
                          <span class="tab-count" id="tab-cnt-dr">0</span>
                        </a>
                        <!-- College Requests (2026-11) — MOA/MOU/Accreditation requests Administrator/Staff assign to a
                             specific College Dean. Same requireAdmin/requireStaffAccess-gated audience as Document
                             Requests above, so it shares that tab's LAU exclusion rather than needing its own. -->
                        <a class="section-tab" id="tab-cdr" href="#" onclick="switchSection('cdr');return false;">
                          <div class="section-tab-icon"><i class="ri-award-line"></i></div>
                          <div class="section-tab-body">
                            <span class="section-tab-title">College Requests</span>
                            <span class="section-tab-desc">MOA / MOU / Accreditation</span>
                          </div>
                          <span class="tab-count" id="tab-cnt-cdr">0</span>
                        </a>
                        <% } %>
                      </div>
                    </div>

                    <div class="card-body pt-3">

                      <!-- Partnership Requests Panel -->
                      <div id="panel-pr">
                        <div class="filter-row">
                          <div class="search-box" style="width:210px;">
                            <input class="form-control form-control-sm" id="pr-search" oninput="prCurrentPage=1; renderPR()">
                            <i class="ri-search-line search-icon"></i>
                          </div>
                          <select class="form-select form-select-sm" id="pr-status" style="width:145px;"
                            onchange="prCurrentPage=1; renderPR()">
                            <option value="">All Status</option>
                            <option>Pending</option>
                            <option>Under Review</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Withdrawn</option>
                          </select>
                          <span class="text-muted fs-12 ms-auto" id="pr-count"></span>
                        </div>

                        <!-- Status quick-filter pills -->
                        <div class="d-flex gap-2 flex-wrap mb-3" id="pr-filter-tabs">
                          <button class="btn btn-sm btn-soft-primary active"
                            onclick="setPRStatusFilter('',this)">All</button>
                          <button class="btn btn-sm btn-soft-warning"
                            onclick="setPRStatusFilter('Pending',this)">Pending</button>
                          <button class="btn btn-sm btn-soft-info"
                            onclick="setPRStatusFilter('Under Review',this)">Under Review</button>
                          <button class="btn btn-sm btn-soft-success"
                            onclick="setPRStatusFilter('Approved',this)">Approved</button>
                          <button class="btn btn-sm btn-soft-danger"
                            onclick="setPRStatusFilter('Rejected',this)">Rejected</button>
                          <button class="btn btn-sm btn-soft-secondary"
                            onclick="setPRStatusFilter('Withdrawn',this)">Withdrawn</button>
                        </div>

                        <div class="table-responsive">
                          <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                              <tr>
                                <th>#</th>
                                <th>Request ID</th>
                                <th>Submitted By</th>
                                <th>Institution</th>
                                <th>Country</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <tbody id="pr-tbody"></tbody>
                          </table>
                        </div>
                        <div id="pr-pagination" class="p-3"></div>
                      </div>

                      <!-- Document Requests Panel -->
                      <div id="panel-dr" style="display:none;">
                        <div class="filter-row">
                          <div class="search-box" style="width:210px;">
                            <input class="form-control form-control-sm" id="dr-search" oninput="drCurrentPage=1; renderDR()">
                            <i class="ri-search-line search-icon"></i>
                          </div>
                          <select class="form-select form-select-sm" id="dr-status" style="width:170px;"
                            onchange="drCurrentPage=1; renderDR()">
                            <option value="">All Status</option>
                            <option>Received</option>
                            <option>Preparing</option>
                            <option>Awaiting for Approval</option>
                            <option>Approved</option>
                            <option>Release</option>
                            <option>Completed</option>
                            <option>Rejected</option>
                          </select>
                          <span class="text-muted fs-12 ms-auto" id="dr-count"></span>
                        </div>

                        <div class="table-responsive">
                          <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                              <tr>
                                <th>#</th>
                                <th>Institution</th>
                                <th>Document Type</th>
                                <th>Requested By</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <tbody id="dr-tbody"></tbody>
                          </table>
                        </div>
                        <div id="dr-pagination" class="p-3"></div>
                      </div>

                      <!-- College Requests Panel (2026-11) -->
                      <% if (typeof user === 'undefined' || !user || user.role !== 'LAU') { %>
                      <div id="panel-cdr" style="display:none;">
                        <div class="filter-row">
                          <div class="d-flex gap-2 flex-wrap" id="cdr-filter-tabs">
                            <button class="btn btn-sm btn-soft-primary active" onclick="cdrFilterBy('', this)">All</button>
                            <button class="btn btn-sm btn-soft-secondary" onclick="cdrFilterBy('Pending', this)">Pending</button>
                            <button class="btn btn-sm btn-soft-info" onclick="cdrFilterBy('Submitted', this)">Submitted</button>
                            <button class="btn btn-sm btn-soft-warning" onclick="cdrFilterBy('Returned for Revision', this)">Returned for Revision</button>
                            <button class="btn btn-sm btn-soft-success" onclick="cdrFilterBy('Completed', this)">Completed</button>
                          </div>
                          <span class="text-muted fs-12 ms-auto me-2" id="cdr-count"></span>
                          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#cdr-create-modal">
                            <i class="ri-add-line align-bottom me-1"></i> New Request
                          </button>
                        </div>

                        <div class="table-responsive">
                          <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                              <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>College Dean</th>
                                <th>College</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <tbody id="cdr-tbody"></tbody>
                          </table>
                        </div>
                      </div>
                      <% } %>

                    </div><!-- /card-body -->
                  </div><!-- /card -->
                </div>
              </div>

            </div><!-- /container-fluid -->
          </div><!-- /page-content -->

          <footer class="footer">
            <div class="container-fluid">
              <div class="row">
                <div class="col-sm-6">
                  <script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL
                </div>
                <div class="col-sm-6">
                  <div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div>
                </div>
              </div>
            </div>
          </footer>
        </div><!-- /main-content -->
  </div><!-- /layout-wrapper -->

  <!-- Partnership Request Detail Modal -->
  <div class="modal fade zoomIn" id="pr-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title" id="pr-modal-title">
            <i class="ri-building-4-line me-2 text-primary"></i>Partnership Request Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="pr-modal-body"></div>
        <div class="modal-footer" id="pr-modal-footer"></div>
      </div>
    </div>
  </div>

  <!-- Partnership Request Draft Collaboration Modal -->
  <div class="modal fade zoomIn" id="pr-draft-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title" id="pr-draft-modal-title">
            <i class="ri-file-list-3-line me-2 text-primary"></i>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="pr-draft-timeline" class="mb-3"></div>
          <div id="pr-draft-upload-wrap" class="border-top pt-3">
            <h6 class="fs-14 fw-bold text-dark mb-2"><i class="ri-upload-cloud-line me-1 text-primary"></i>Upload a New Version</h6>
            <div class="mb-3">
              <label class="form-label ocr-field-label fs-13 mb-1" for="pr-draft-file">Attachment (Optional)</label>
              <div id="pr-draft-dropzone-wrap">
                <input type="file" class="form-control" id="pr-draft-file" accept=".pdf,.jpg,.jpeg,.png">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label ocr-field-label fs-13 mb-1" for="pr-draft-note">Version Note / Remarks</label>
              <textarea class="form-control" id="pr-draft-note" rows="2" placeholder="Add a note or summary of changes for this version..."></textarea>
            </div>
            <button type="button" class="btn btn-primary px-3 fs-13" id="pr-draft-upload-btn" onclick="uploadDraftDocument()">
              <i class="ri-upload-2-line me-1"></i>Upload Version
            </button>
            <p class="text-muted fs-12 mt-2 mb-0">A file, a note, or both — at least one is required. A file (PDF, JPG, or PNG, max 10MB) is archived to the Document Library; collaborators are notified automatically.</p>
          </div>
          <div id="pr-draft-closed-note" class="alert alert-secondary fs-13 mb-0" style="display:none;">
            <i class="ri-lock-line me-1"></i>This request has already been decided — no further documents can be added.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Document Request Detail Modal -->
  <div class="modal fade zoomIn" id="dr-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title">
            <i class="ri-file-shield-2-line me-2 text-secondary"></i>Document Request Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-6">
              <p class="detail-label">Institution</p>
              <p class="detail-value mb-0" id="dr-v-inst">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Document Type</p>
              <p class="detail-value mb-0" id="dr-v-type">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Requested By</p>
              <p class="detail-value mb-0" id="dr-v-by">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Date Requested</p>
              <p class="detail-value mb-0" id="dr-v-date">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Status</p>
              <div id="dr-v-status">—</div>
            </div>
            <div class="col-12">
              <p class="detail-label">Notes</p>
              <div class="detail-box">
                <p class="mb-0 fs-13" id="dr-v-notes">—</p>
              </div>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between border rounded p-3">
                <div>
                  <p class="detail-label mb-1">Draft & Supporting Documents</p>
                  <p class="text-muted fs-12 mb-0" id="dr-draft-count">0 version(s) on file</p>
                </div>
                <button type="button" class="btn btn-soft-primary btn-sm" onclick="openDRDraftModal()">
                  <i class="ri-file-list-3-line me-1"></i>View Draft
                </button>
              </div>
            </div>
            <div class="col-12" id="dr-remark-wrap">
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label detail-label">Released By</label>
                  <div class="form-control form-control-sm bg-light text-muted" id="dr-released-by-display">Recorded automatically as you when the status moves to Release</div>
                </div>
                <div class="col-6">
                  <label class="form-label detail-label">Received By</label>
                  <input type="text" class="form-control form-control-sm" id="dr-received-by">
                </div>
              </div>
            </div>
            <div class="col-12" id="dr-signoff-wrap" style="display:none">
              <p class="detail-label mb-1">Sign-off on Record</p>
              <p class="mb-0 fs-13" id="dr-signoff-summary">—</p>
            </div>
            <div class="col-12">
              <p class="detail-label mb-1">Status History</p>
              <div class="detail-box" id="dr-history-list">
                <p class="mb-0 fs-13 text-muted">No status changes recorded yet.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" id="dr-modal-footer"></div>
      </div>
    </div>
  </div>

  <!-- Document Request Draft Collaboration Modal -->
  <div class="modal fade zoomIn" id="dr-draft-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title" id="dr-draft-modal-title">
            <i class="ri-file-list-3-line me-2 text-primary"></i>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="dr-draft-timeline" class="mb-3"></div>
          <div id="dr-draft-upload-wrap" class="border-top pt-3">
            <h6 class="fs-14 fw-bold text-dark mb-2"><i class="ri-upload-cloud-line me-1 text-primary"></i>Upload a New Version</h6>
            <div class="mb-3">
              <label class="form-label ocr-field-label fs-13 mb-1" for="dr-draft-file">Attachment (Optional)</label>
              <div id="dr-draft-dropzone-wrap">
                <input type="file" class="form-control" id="dr-draft-file" accept=".pdf,.jpg,.jpeg,.png">
              </div>
            </div>
            <div class="text-center my-2 fs-12 text-muted">— or —</div>
            <div class="mb-3">
              <label class="form-label ocr-field-label fs-13 mb-1">Select Existing Document(s) <span class="text-muted fw-normal">(already in the Document Library — no re-upload needed)</span></label>
              <div>
                <button type="button" class="btn btn-sm btn-soft-primary" id="dr-draft-pick-existing-btn" onclick="openDrSelectExisting()">
                  <i class="ri-folder-open-line me-1"></i>Browse Document Library
                </button>
              </div>
              <div id="dr-draft-linked-list" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>
            <div class="mb-3">
              <label class="form-label ocr-field-label fs-13 mb-1" for="dr-draft-note">Version Note / Remarks</label>
              <textarea class="form-control" id="dr-draft-note" rows="2" placeholder="Add a note or summary of changes for this version..."></textarea>
            </div>
            <button type="button" class="btn btn-primary px-3 fs-13" id="dr-draft-upload-btn" onclick="uploadDRDraftDocument()">
              <i class="ri-upload-2-line me-1"></i>Upload Version
            </button>
            <p class="text-muted fs-12 mt-2 mb-0">A file, a linked existing document, a note, or any combination — at least one is required. A new file (PDF, JPG, or PNG, max 10MB) is archived to the Document Library; collaborators are notified automatically.</p>
          </div>
          <div id="dr-draft-closed-note" class="alert alert-secondary fs-13 mb-0" style="display:none;">
            <i class="ri-lock-line me-1"></i>This document request has already been decided — no further documents can be added.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Select Existing Documents (2026-11) — opens on top of dr-draft-modal (Bootstrap stacks modals
       correctly on its own). Lists every document already in the system (GET /api/documents?scope=all —
       Administrator/Staff already have unrestricted read access to any document once it's linked to a
       request they review, so this picker shows that same full set rather than only this reviewer's own
       uploads), with a search box and checkable rows. "Done" just closes this modal; the actual link
       happens when "Upload Version" is clicked back on dr-draft-modal. -->
  <div class="modal fade" id="dr-select-existing-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title"><i class="ri-folder-open-line me-2 text-primary"></i>Select Existing Document(s)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="search-box mb-2">
            <input type="text" class="form-control" id="dr-select-existing-search" placeholder="Search by title, type, institution, or uploader…" oninput="renderDrSelectExistingList()">
            <i class="ri-search-line search-icon"></i>
          </div>
          <div id="dr-select-existing-list" class="list-group" style="max-height:360px;overflow-y:auto;"></div>
          <div class="text-muted fs-12 mt-2 d-none" id="dr-select-existing-empty">No documents found in your Document Library.</div>
        </div>
        <div class="modal-footer">
          <span class="text-muted fs-12 me-auto" id="dr-select-existing-count"></span>
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Draft Preview Modal — shared by both the Partnership Request and
       Document Request draft timelines above; opens on top of whichever
       draft-collaboration modal triggered it. -->
  <div class="modal fade zoomIn" id="draft-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title"><i class="ri-eye-line me-2 text-primary"></i>Draft Preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="draft-preview-body" class="mb-3"></div>
          <div class="border-top pt-3">
            <p class="fs-13 fw-medium mb-1" id="draft-preview-filename">—</p>
            <p class="fs-13 text-muted mb-1">Uploaded by: <span id="draft-preview-uploader">—</span></p>
            <p class="fs-13 text-muted mb-1">Date: <span id="draft-preview-when">—</span></p>
            <p class="fs-13 text-muted mb-0">Note: <span id="draft-preview-note">—</span></p>
          </div>
        </div>
        <div class="modal-footer">
          <a href="#" id="draft-preview-download-btn" class="btn btn-success btn-sm"><i class="ri-download-2-line me-1"></i>Download</a>
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <%# 2026-11 Document Requests confirmation investigation: a Document Request's status previously changed the
       instant the Status dropdown's value changed, with no confirmation step at all —
       a single misclick could move a real request to Approved/Rejected/Completed. One shared modal for every
       status transition (not a separate one per status) — see confirmDrStatusChange()/cancelDrStatusChange()
       below for the wiring. Styled like this page's own dr-modal/draft-preview-modal (modal fade zoomIn,
       bg-light header) rather than the browser's plain confirm() the one pre-existing confirm() on this page
       (unlinking a Google Doc) still uses — out of scope to also change that one here. %>
  <div class="modal fade zoomIn" id="dr-status-confirm-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title"><i class="ri-shield-check-line me-2 text-warning"></i>Confirm Status Update</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-3">Are you sure you want to change the status of the document request for <strong id="dr-confirm-inst">—</strong> from <span id="dr-confirm-from"></span> to <span id="dr-confirm-to"></span>?</p>
          <p class="text-muted fs-12 mb-0"><i class="ri-information-line me-1"></i>This will be saved immediately and cannot be undone from here.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="dr-status-confirm-btn" onclick="confirmDrStatusChange()">
            <span id="dr-status-confirm-btn-label">Confirm</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- College Request Create/Assign Modal (2026-11) — same LAU exclusion as panel-cdr/tab-cdr above;
       nothing in a LAU session can trigger these (no "New Request"/"View" buttons are rendered for it),
       but there is no reason to ship the markup to a role that can never use it. -->
  <% if (typeof user === 'undefined' || !user || user.role !== 'LAU') { %>
  <div class="modal fade zoomIn" id="cdr-create-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title"><i class="ri-award-line me-2 text-primary"></i>New College Request</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="cdr-create-form">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Request Type</label>
                <select class="form-select" id="cdr-c-type" required>
                  <option value="" disabled selected>Select type…</option>
                  <option value="MOA">MOA Request</option>
                  <option value="MOU">MOU Request</option>
                  <option value="Accreditation">Accreditation Request</option>
                </select>
              </div>
              <div class="col-md-5">
                <label class="form-label">Target College Dean(s)</label>
                <div class="dean-combo" id="cdr-c-dean-combo">
                  <div class="dean-combo-chips" id="cdr-c-dean-chips"></div>
                  <div class="dean-combo-input-wrap">
                    <input type="text" class="form-control" id="cdr-c-dean-input" placeholder="Search College Dean by name or college…" autocomplete="off" aria-expanded="false">
                    <div class="dean-combo-dropdown" id="cdr-c-dean-dropdown" role="listbox" style="display:none"></div>
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <label class="form-label">Submission Deadline</label>
                <input type="date" class="form-control" id="cdr-c-deadline">
              </div>
              <div class="col-12">
                <label class="form-label">Title</label>
                <input type="text" class="form-control" id="cdr-c-title" maxlength="300" placeholder="e.g. 2027 AACCUP Accreditation Documents" required>
              </div>
              <div class="col-12">
                <label class="form-label">Instructions</label>
                <textarea class="form-control" id="cdr-c-instructions" rows="3" maxlength="4000" placeholder="What the Dean needs to do, and by when."></textarea>
              </div>
              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control" id="cdr-c-description" rows="2" maxlength="4000" placeholder="Additional context (optional)."></textarea>
              </div>
              <div class="col-12">
                <label class="form-label">Required Documents <span class="text-muted">(comma-separated)</span></label>
                <input type="text" class="form-control" id="cdr-c-required" placeholder="e.g. Accomplishment Report, Faculty Profile, Curriculum Checklist">
              </div>
            </div>
            <div class="invalid-feedback d-block d-none mt-2" id="cdr-c-error"></div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="cdr-c-submit" onclick="cdrSubmitCreate()">Create &amp; Assign</button>
        </div>
      </div>
    </div>
  </div>

  <!-- College Request Detail/Review Modal (2026-11) -->
  <div class="modal fade zoomIn" id="cdr-detail-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light p-3">
          <h5 class="modal-title" id="cdr-d-title"><i class="ri-award-line me-2 text-primary"></i>Request</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="cdr-d-body"><!-- populated by cdrOpenDetail() --></div>
        <div class="modal-footer" id="cdr-d-footer"></div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Toast -->
  <div id="pr-toast"></div>

  <script>
    // Review/Approve/Reject/Request-More-Info and the Administrator document
    // upload widget are Administrator-only — PATCH /api/requests/:id, POST
    // /api/requests/:id/documents, PATCH /api/document-requests/:id, and POST
    // /api/document-requests/:id/documents are all requireStaffAccess
    // server-side (2026-08-27 full-parity revision) — Administrator and
    // Staff share identical Approve/Reject/Fulfill authority over every
    // request, so this flag (kept as IS_ADMIN for minimal diff) is true for
    // both roles; every other role gets the read-only "View" mode.
    var IS_ADMIN = <%- JSON.stringify(typeof user !== 'undefined' && user && ['Administrator', 'Staff'].includes(user.role)) %>;

    // LAU (2026-10, read-only partnership-request monitoring role) is deliberately scoped to Partnership
    // Requests only, not Document Requests — a separate collection/workflow bundled into this same page.
    // The Document Requests tab/stat card is hidden server-side below (never rendered, not just
    // CSS-hidden), and loadDR()/refreshLive()/the live-event subscription all skip fetching
    // /api/document-requests for this role — that route stays requireStaffAccess-gated server-side
    // regardless of this flag; this is what keeps the client from ever calling it and hitting a 403.
    var IS_LAU = <%- JSON.stringify(typeof user !== 'undefined' && user && user.role === 'LAU') %>;

    // Document Request workflow (2026-09-04) — mirrors the server-side
    // DR_WORKFLOW_STATUSES/DR_TERMINAL_STATUSES/drNextStatus in cirl.js so the
    // dropdown/UI never disagrees with what the PATCH endpoint will actually
    // accept. Every request from the API already carries a normalized
    // `canonicalStatus` field, so this file never needs its own legacy-name
    // mapping.
    var DR_WORKFLOW_STATUSES = ['Received', 'Preparing', 'Awaiting for Approval', 'Approved', 'Release', 'Completed'];
    var DR_TERMINAL_STATUSES = ['Completed', 'Rejected'];
    function drNextStatus(canonicalStatus) {
      var idx = DR_WORKFLOW_STATUSES.indexOf(canonicalStatus);
      return (idx === -1 || idx === DR_WORKFLOW_STATUSES.length - 1) ? null : DR_WORKFLOW_STATUSES[idx + 1];
    }
    // Staff and Administrator render this same partnership_requests.ejs
    // template from two different routes (/partnership-requests vs.
    // /staff/requests) that carry two different sidebars — Monitoring (the
    // consolidated Registry + Overview + DSS page, 2026-09-05) mirrors that
    // split (/lifecycle vs. /staff/lifecycle, both role-gated). "Approve"
    // must redirect into whichever one the current reviewer can actually open.
    var REGISTRY_BASE_PATH = <%- JSON.stringify(typeof user !== 'undefined' && user && user.role === 'Staff' ? '/staff/lifecycle' : '/lifecycle') %>;

    function escapeHtml(str) {
      return String(str == null ? '' : str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // 2026-09-06 security hardening: escapeHtml() alone does NOT neutralize a
    // dangerous URL scheme (javascript:/data:/vbscript:) placed into an href
    // or src attribute — item.link can be a submitter's free-text
    // attachmentLink, not just a server-generated upload path. Only allow
    // absolute http(s) URLs or the app's own relative paths; refuse anything
    // else rather than guess (same pattern as registry-gridjs.init.js's
    // sanitizeUrl()).
    function sanitizeUrl(url) {
      const s = String(url == null ? '' : url).trim();
      if (!s) return '';
      if (/^https?:\/\//i.test(s)) return s;
      if (s.charAt(0) === '/' && s.charAt(1) !== '/') return s;
      return '';
    }

    /* ─── STATE ─── */
    var prData = [], drData = [];
    var prFiltered = [], drFiltered = [];
    var currentPRId = null;
    var currentDRId = null;
    var activeSection = 'pr';

    /* ─── HELPERS ─── */
    // Document Request workflow statuses (Received/Preparing/Awaiting for
    // Approval/Release/Completed, 2026-09-04) share this map with Partnership
    // Request statuses — safe since each table only ever renders its own
    // vocabulary, so there's no collision in practice.
    function statusClasses(s) {
      const m = {
        'Pending': 'bg-warning-subtle text-warning',
        'Under Review': 'bg-info-subtle text-info',
        'Approved': 'bg-success-subtle text-success',
        'Accepted': 'bg-success-subtle text-success',
        'Fulfilled': 'bg-success-subtle text-success',
        'Rejected': 'bg-danger-subtle text-danger',
        'Withdrawn': 'bg-secondary-subtle text-secondary',
        'Received': 'bg-warning-subtle text-warning',
        'Preparing': 'bg-info-subtle text-info',
        'Awaiting for Approval': 'bg-primary-subtle text-primary',
        'Release': 'bg-dark-subtle text-dark',
        'Completed': 'bg-success-subtle text-success'
      };
      return m[s] || 'bg-secondary-subtle text-secondary';
    }
    function statusBadge(s) {
      return `<span class="badge ${statusClasses(s)}">${s}</span>`;
    }

    // Document Request "Document(s) Requested" is a free-form multi-item
    // list (documentTypes array on new records; documentType joined string
    // as a fallback for records created before 2026-09-02's combobox).
    function drDocTypeItems(r) {
      if (Array.isArray(r.documentTypes) && r.documentTypes.length) return r.documentTypes;
      return r.documentType ? [r.documentType] : [];
    }
    function drDocTypeBadges(r) {
      const items = drDocTypeItems(r);
      if (!items.length) return '<span class="badge badge-type bg-secondary-subtle text-secondary border border-secondary-subtle">—</span>';
      const first = `<span class="badge badge-type bg-secondary-subtle text-secondary border border-secondary-subtle" title="${escapeHtml(items.join(', '))}">${escapeHtml(items[0])}</span>`;
      const more = items.length > 1 ? ` <span class="badge bg-light text-muted border">+${items.length - 1} more</span>` : '';
      return first + more;
    }
    function drDocTypeList(r) {
      const items = drDocTypeItems(r);
      if (!items.length) return '—';
      if (items.length === 1) return escapeHtml(items[0]);
      return '<ol class="ps-3 mb-0">' + items.map(i => `<li>${escapeHtml(i)}</li>`).join('') + '</ol>';
    }

    function showToast(msg, bg) {
      const t = document.getElementById('pr-toast');
      t.style.background = bg || '#405189';
      t.innerHTML = msg;
      t.style.opacity = '1';
      clearTimeout(t._to);
      t._to = setTimeout(() => t.style.opacity = '0', 3500);
    }

    /* ─── SECTION SWITCHER ─── */
    // Null-guarded on the DR elements (2026-10) — panel-dr/tab-dr are not rendered at all for LAU (see
    // IS_LAU above), and this function runs on every section switch for every role off the same code
    // path, including the plain switchSection('pr') calls on page load.
    function switchSection(sec) {
      if (IS_LAU) sec = 'pr';
      activeSection = sec;
      document.getElementById('panel-pr').style.display = sec === 'pr' ? '' : 'none';
      if (document.getElementById('panel-dr')) document.getElementById('panel-dr').style.display = sec === 'dr' ? '' : 'none';
      if (document.getElementById('panel-cdr')) document.getElementById('panel-cdr').style.display = sec === 'cdr' ? '' : 'none';
      document.getElementById('tab-pr').classList.toggle('active', sec === 'pr');
      if (document.getElementById('tab-dr')) document.getElementById('tab-dr').classList.toggle('active', sec === 'dr');
      if (document.getElementById('tab-cdr')) document.getElementById('tab-cdr').classList.toggle('active', sec === 'cdr');
    }

    
    /* ─── PAGINATION HELPERS ─── */
    var prCurrentPage = 1, prItemsPerPage = 10;
    var drCurrentPage = 1, drItemsPerPage = 10;

    function buildPageList(current, total) {
        var maxVisible = 5;
        if (total <= maxVisible + 2) return Array.from({length: total}, function(_, i){ return i + 1; });
        var start = Math.max(1, current - Math.floor(maxVisible / 2));
        var end = start + maxVisible - 1;
        if (end > total) { end = total; start = Math.max(1, end - maxVisible + 1); }
        var pages = [];
        for (var i = start; i <= end; i++) pages.push(i);
        if (start > 1) { pages.unshift('...'); pages.unshift(1); }
        if (end < total) { pages.push('...'); pages.push(total); }
        return pages;
    }

    function buildPaginationHtml(current, total, onClickFn) {
        if (total <= 1) return '';
        var pageItem = function(label, page, opts) {
            opts = opts || {};
            var disabled = opts.disabled ? ' disabled' : '';
            var active = opts.active ? ' active' : '';
            var isEllipsis = opts.ellipsis ? ' ellipsis-item' : '';
            var isPrevNext = opts.isPrev ? ' page-link-prev' : (opts.isNext ? ' page-link-next' : '');
            var click = opts.disabled || opts.ellipsis ? '' : 'onclick="' + onClickFn + '(' + page + ')"';
            return '<li class="page-item' + disabled + active + isEllipsis + '"><a class="page-link' + isPrevNext + '" href="javascript:void(0)" ' + click + '>' + label + '</a></li>';
        };
        var html = pageItem('&lsaquo; Previous', current - 1, { disabled: current === 1, isPrev: true });
        buildPageList(current, total).forEach(function(p) {
            html += (p === '...')
                ? pageItem('&hellip;', null, { ellipsis: true, disabled: true })
                : pageItem(p, p, { active: p === current });
        });
        html += pageItem('Next &rsaquo;', current + 1, { disabled: current === total, isNext: true });
        return '<div class="d-flex justify-content-end mb-3"><ul class="pagination pagination-custom align-items-center m-0">' + html + '</ul></div>';
    }

    function goToPRPage(p) { prCurrentPage = p; renderPR(); }
    function goToDRPage(p) { drCurrentPage = p; renderDR(); }

    /* ─── STATS ─── */

    function updateStats() {
      document.getElementById('cnt-pr-total').textContent = prData.length;
      document.getElementById('tab-cnt-pr').textContent = prData.length;
      // Document Requests stat/tab elements are not rendered at all for LAU (see IS_LAU above) — guarded
      // rather than assumed present, since this function runs for every role off the same shared code path.
      if (document.getElementById('cnt-dr-total')) document.getElementById('cnt-dr-total').textContent = drData.length;
      if (document.getElementById('tab-cnt-dr')) document.getElementById('tab-cnt-dr').textContent = drData.length;

      let pending = 0, approved = 0, rejected = 0;
      prData.forEach(r => {
        const s = (r.status || '').toLowerCase();
        if (s === 'pending' || s === 'under review') pending++;
        else if (s === 'approved' || s === 'accepted') approved++;
        else if (s === 'rejected') rejected++;
      });
      // Document Requests use the 6-stage workflow (canonicalStatus) —
      // 'Completed' is the only genuinely-resolved-positive terminal state;
      // every other non-Rejected stage (Received/Preparing/Awaiting for
      // Approval/Approved/Release) is still "in progress" for this combined
      // pending/approved/rejected KPI.
      drData.forEach(r => {
        const cs = r.canonicalStatus || r.status;
        if (cs === 'Rejected') rejected++;
        else if (cs === 'Completed') approved++;
        else pending++;
      });
      document.getElementById('cnt-pending-all').textContent = pending;
      document.getElementById('cnt-approved-all').textContent = approved;
      document.getElementById('cnt-rejected-all').textContent = rejected;
    }

    /* ═══════════════════════════════════════════════════════
       PARTNERSHIP REQUESTS
    ═══════════════════════════════════════════════════════ */
    var _prStatusFilter = '';
    var flashPR = new Set(), flashDR = new Set();   // rows a live update just changed

    function setPRStatusFilter(val, btn) {
      _prStatusFilter = val;
      document.querySelectorAll('#pr-filter-tabs .btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      document.getElementById('pr-status').value = val;
      prCurrentPage = 1;
      renderPR();
    }

    // Drafts are still being edited by the submitter and were never actually submitted — they don't belong in the admin
    // review queue.
    const notDraft = r => r.status !== 'Draft';
    async function loadPR() {
      const res = await CIPRMS.api('/api/requests', { quiet: true });
      prData = res.ok && Array.isArray(res.data) ? res.data.filter(notDraft) : [];
      renderPR();
    }

    function renderPR() {
      const s = (document.getElementById('pr-search').value || '').toLowerCase();
      const st = document.getElementById('pr-status').value;

      prFiltered = prData.filter(r => {
        const id = String(r.id || '');
        const by = String(r.requestedBy || r.by || r.requestor || '');
        const inst = String(r.institution || r.inst || '');
        const country = String(r.country || '');
        const hay = [id, by, inst, country].join(' ').toLowerCase();
        return (!s || hay.includes(s))
          && (!st || r.status === st);
      });

      const tbody = document.getElementById('pr-tbody');
      document.getElementById('pr-count').textContent =
        `${prFiltered.length} of ${prData.length} request${prData.length !== 1 ? 's' : ''}`;

      if (!prFiltered.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
          <i class="ri-inbox-line d-block fs-1 mb-2"></i>No partnership requests found.</td></tr>`;
        document.getElementById('pr-pagination').innerHTML = '';
        return;
      }

      const totalPages = Math.ceil(prFiltered.length / prItemsPerPage);
      if (prCurrentPage > totalPages) prCurrentPage = Math.max(1, totalPages);
      const startIdx = (prCurrentPage - 1) * prItemsPerPage;
      const paged = prFiltered.slice(startIdx, startIdx + prItemsPerPage);
      
      document.getElementById('pr-pagination').innerHTML = buildPaginationHtml(prCurrentPage, totalPages, 'goToPRPage');

      tbody.innerHTML = paged.map((r, mappedIndex) => {
        const i = startIdx + mappedIndex;
        const uid = String(r.id || i);
        // Institution/requester/country/notes are free-form fields any
        // potential_partner or Auth. Personnel can submit — escape before
        // interpolating into innerHTML (2026-09-06 security hardening).
        const by = escapeHtml(r.requestedBy || r.by || '—');
        const inst = escapeHtml(r.institution || r.inst || '—');
        const country = escapeHtml(r.country || '—');
        const type = r.isSubmission ? 'MOA/MOU Submission' : (r.type || '—');
        const date = r.date || '—';
        const status = r.status || 'Pending';
        const canAct = IS_ADMIN && (status === 'Pending' || status === 'Under Review');

        return `<tr data-rid="${uid}"${flashPR.has(uid) ? ' class="rt-flash"' : ''}>
          <td class="text-muted fw-semibold fs-13">${i + 1}</td>
          <td><span class="fw-semibold text-primary fs-13">#REQ-${String(r.id).padStart(3, '0')}</span></td>
          <td class="fw-medium fs-13">${by}</td>
          <td><span class="fw-semibold fs-13">${inst}</span></td>
          <td class="text-muted fs-13">${country}</td>
          <td><span class="badge badge-type bg-primary-subtle text-primary border border-primary-subtle">${type}</span>${r.isRenewal ? ' <span class="badge bg-info-subtle text-info">Renewal</span>' : ''}${r.isCollegeReport ? ' <span class="badge bg-success-subtle text-success" title="A college sent CIRL a copy of an MOA/MOU it already signed">College Report</span>' : ''}</td>
          <td class="text-muted fs-13">${date}</td>
          <td>${statusBadge(status)}</td>
          <td>
            <div class="hstack gap-1">
              <button class="btn btn-sm btn-soft-primary" onclick="openPRDetail('${uid}')">
                <i class="ri-${canAct ? 'search-eye' : 'eye'}-line me-1"></i>${canAct ? 'Review' : 'View'}
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    function openPRDetail(uid) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      currentPRId = uid;

      // Free-form fields — escape before interpolating into innerHTML
      // (2026-09-06 security hardening).
      const by = escapeHtml(r.requestedBy || r.by || '—');
      const inst = escapeHtml(r.institution || r.inst || '—');
      const country = escapeHtml(r.country || '—');
      const type = r.type || '—';
      const nature = r.nature || '—';
      const category = r.category || '—';
      const region = r.region || '—';
      const unit = r.unit || '—';
      const startDate = r.startDate || '—';
      const endDate = r.endDate || '—';
      const date = r.date || '—';
      const notes = escapeHtml(r.notes || '—');
      const isReview = IS_ADMIN && (r.status === 'Pending' || r.status === 'Under Review');

      const scMap = {
        'Pending': { cls: 'ribbon-pending', icon: 'ri-time-line' },
        'Under Review': { cls: 'ribbon-review', icon: 'ri-search-eye-line' },
        'Approved': { cls: 'ribbon-approved', icon: 'ri-checkbox-circle-line' },
        'Rejected': { cls: 'ribbon-rejected', icon: 'ri-close-circle-line' }
      };
      const sc = scMap[r.status] || scMap['Pending'];

      document.getElementById('pr-modal-title').innerHTML =
        `<i class="ri-building-4-line me-2 text-primary"></i>#REQ-${String(r.id).padStart(3, '0')} — ${inst}` +
        (r.isRenewal ? ' <span class="badge bg-info-subtle text-info fs-12 align-middle ms-1">Renewal Request</span>' : '');

      document.getElementById('pr-modal-body').innerHTML = `
        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <p class="detail-label">Request ID</p>
            <p class="detail-value mb-0">#REQ-${String(r.id).padStart(3, '0')}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Request Type</p>
            <p class="detail-value mb-0">${r.isSubmission ? 'MOA/MOU Submission' : r.isCollegeReport ? 'College Partnership Report (already signed by the college)' : r.isRenewal ? 'Renewal of Existing Partnership' : 'New Partnership'}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Requested By</p>
            <p class="detail-value mb-0">${by}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Institution</p>
            <p class="detail-value mb-0">${inst}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Country</p>
            <p class="detail-value mb-0">${country}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Agreement Type</p>
            <div><span class="badge badge-type bg-primary-subtle text-primary border border-primary-subtle">${type}</span></div>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Nature</p>
            <p class="detail-value mb-0">${nature}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Category</p>
            <p class="detail-value mb-0">${category}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Region</p>
            <p class="detail-value mb-0">${region}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Responsible CSPC Unit</p>
            <p class="detail-value mb-0">${unit}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Proposed Start Date</p>
            <p class="detail-value mb-0">${startDate}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Proposed End Date</p>
            <p class="detail-value mb-0">${endDate}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Date Submitted</p>
            <p class="detail-value mb-0">${date}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Status</p>
            <div>${statusBadge(r.status || 'Pending')}</div>
          </div>
        </div>
        ${notes !== '—' ? `
          <p class="detail-label">Notes</p>
          <div class="detail-box mb-3 fs-13 lh-lg">${notes}</div>
        ` : ''}
        <div class="d-flex align-items-center justify-content-between border rounded p-3 mb-3">
          <div>
            <p class="detail-label mb-1">Draft & Supporting Documents</p>
            <p class="text-muted fs-12 mb-0">${(r.attachmentLink ? 1 : 0) + (r.supportingDocuments || []).length} version(s) on file</p>
          </div>
          <button type="button" class="btn btn-soft-primary btn-sm" onclick="openDraftModal('${uid}')">
            <i class="ri-file-list-3-line me-1"></i>View Draft
          </button>
        </div>
        ${IS_ADMIN ? `<div id="pr-gdocs-box" class="border rounded p-3 mb-3"><p class="text-muted fs-12 mb-0">Loading Google Docs drafts…</p></div>` : ''}
        ${!isReview ? `
          <div class="status-ribbon ${sc.cls}">
            <i class="${sc.icon} fs-3"></i>
            <div>
              <div class="fw-semibold ribbon-title">Request ${r.status}</div>
              <div class="fs-12 text-muted">This request has been processed and is now read-only.</div>
            </div>
          </div>
        ` : ''}`;

      document.getElementById('pr-modal-footer').innerHTML = `
        <div id="pr-moreinfo-wrap" class="w-100 d-none mb-1">
          <label class="form-label fs-13 mb-1" for="pr-moreinfo-note">What information or documents are needed?</label>
          <textarea id="pr-moreinfo-note" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
        </div>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          <i class="ri-close-line me-1"></i>Close</button>
        ${isReview && r.status === 'Pending' ? `
          <button type="button" class="btn btn-soft-warning" id="pr-moreinfo-btn" onclick="requestMoreInfo('${uid}', this)">
            <i class="ri-question-answer-line me-1"></i>Request More Information</button>
        ` : ''}
        ${isReview ? `
          <button type="button" class="btn btn-success" onclick="resolvePR('${uid}','Approved', this)">
            <i class="ri-check-line me-1"></i>${r.isCollegeReport ? 'Record in Registry' : 'Approve'}</button>
        ` : ''}`;

      setBreadcrumb(['Requests', 'Partnership Request', prRequestLabel(r)]);
      modalInstance('pr-modal').show();
      if (IS_ADMIN) loadPRGoogleDocs(r.id);
    }

    /* ─── GOOGLE DOCS AGREEMENT DRAFTS (2026-09-26) ───
       MOA/MOU drafts written in Google Docs, linked to this request. Created in the org Google account connected
       under Settings → Integrations, and shared by e-mail: Administrators/CIRL Staff edit, the requesting partner
       comments, College Deans of the request's unit view (see /api/requests/:id/google-docs in cirl.js). */
    const GDOC_ROLE_LABEL = { writer: 'can edit', commenter: 'can comment', reader: 'can view' };

    function gdocItemHtml(d) {
      const url = escapeHtml(sanitizeUrl(d.url));
      const failed = (d.sharing || []).filter(s => !s.ok);
      const shared = (d.sharing || []).filter(s => s.ok);
      const sharedSummary = shared.length
        ? shared.map(s => `${escapeHtml(s.email)} <span class="text-muted">(${GDOC_ROLE_LABEL[s.role] || s.role})</span>`).join(', ')
        : '<span class="text-muted">nobody yet</span>';
      return `
        <div class="border rounded p-2 mb-2">
          <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
            <div class="flex-grow-1">
              <div class="fw-semibold fs-13"><i class="ri-file-word-2-line text-primary me-1"></i>${escapeHtml(d.title)}</div>
              <div class="text-muted fs-12">Created by ${escapeHtml(d.createdByName || '—')} · ${d.createdAt ? escapeHtml(new Date(d.createdAt).toLocaleString()) : '—'}</div>
            </div>
            <div class="d-flex gap-1 flex-shrink-0">
              ${url ? `<a href="${url}" target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="ri-external-link-line me-1"></i>Open in Google Docs</a>` : ''}
              <button type="button" class="btn btn-sm btn-soft-secondary" title="Share again with the current reviewers, partner and deans" onclick="reshareGoogleDoc(${d.id}, this)"><i class="ri-share-line"></i></button>
              <button type="button" class="btn btn-sm btn-soft-danger" title="Unlink from this request (the Google Doc itself is kept)" onclick="unlinkGoogleDoc(${d.id})"><i class="ri-link-unlink-m"></i></button>
            </div>
          </div>
          <div class="fs-12 mt-1"><span class="text-muted">Shared with:</span> ${sharedSummary}</div>
          ${failed.length ? `<div class="fs-12 text-danger mt-1"><i class="ri-error-warning-line me-1"></i>Could not share with ${failed.map(s => escapeHtml(s.email)).join(', ')}. ${escapeHtml(failed[0].error || '')}</div>` : ''}
        </div>`;
    }

    async function loadPRGoogleDocs(requestId) {
      const box = document.getElementById('pr-gdocs-box');
      if (!box) return;
      const res = await CIPRMS.api('/api/requests/' + requestId + '/google-docs', { quiet: true });
      if (String(currentPRId) !== String(requestId) || !document.getElementById('pr-gdocs-box')) return; // another request was opened meanwhile
      if (!res.ok) { box.innerHTML = `<p class="text-danger fs-12 mb-0">Could not load Google Docs drafts: ${escapeHtml(res.error || 'error')}</p>`; return; }
      const { connected, docs } = res.data;
      const createButtons = connected
        ? `<div class="d-flex gap-1">
             <button type="button" class="btn btn-sm btn-soft-primary" onclick="createGoogleDoc(${requestId}, 'MOA', this)"><i class="ri-add-line me-1"></i>MOA draft</button>
             <button type="button" class="btn btn-sm btn-soft-primary" onclick="createGoogleDoc(${requestId}, 'MOU', this)"><i class="ri-add-line me-1"></i>MOU draft</button>
           </div>`
        : '';
      box.innerHTML = `
        <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
          <div>
            <p class="detail-label mb-1">Agreement Draft (Google Docs)</p>
            <p class="text-muted fs-12 mb-0">${connected
              ? 'Write the MOA/MOU together in Google Docs. Staff edit, the partner comments, deans of the unit view.'
              : 'Google Docs is not connected. An Administrator can connect it in Settings → Integrations.'}</p>
          </div>
          ${createButtons}
        </div>
        ${docs.length ? docs.map(gdocItemHtml).join('') : '<p class="text-muted fs-12 mb-0">No Google Docs draft yet.</p>'}`;
    }

    async function createGoogleDoc(requestId, kind, btn) {
      btn.disabled = true;
      const original = btn.innerHTML;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating…';
      const res = await CIPRMS.api('/api/requests/' + requestId + '/google-docs', { method: 'POST', json: { kind }, quiet: true, timeout: 60000 });
      btn.disabled = false;
      btn.innerHTML = original;
      if (!res.ok) { showToast('<i class="ri-error-warning-line me-1"></i>' + escapeHtml(res.error || 'Could not create the draft.'), '#f06548'); return; }
      showToast('<i class="ri-checkbox-circle-line me-1"></i>' + kind + ' draft created and shared.', '#0ab39c');
      loadPRGoogleDocs(requestId);
    }

    async function reshareGoogleDoc(docId, btn) {
      btn.disabled = true;
      const res = await CIPRMS.api('/api/google-docs/' + docId + '/reshare', { method: 'POST', quiet: true, timeout: 60000 });
      btn.disabled = false;
      if (!res.ok) { showToast('<i class="ri-error-warning-line me-1"></i>' + escapeHtml(res.error || 'Could not share again.'), '#f06548'); return; }
      showToast('<i class="ri-checkbox-circle-line me-1"></i>Sharing updated.', '#0ab39c');
      loadPRGoogleDocs(currentPRId);
    }

    async function unlinkGoogleDoc(docId) {
      if (!confirm('Unlink this Google Doc from the request? The document itself stays in Google Drive with its current sharing.')) return;
      const res = await CIPRMS.api('/api/google-docs/' + docId, { method: 'DELETE', quiet: true });
      if (!res.ok) { showToast('<i class="ri-error-warning-line me-1"></i>' + escapeHtml(res.error || 'Could not unlink.'), '#f06548'); return; }
      showToast('<i class="ri-checkbox-circle-line me-1"></i>Draft unlinked.', '#0ab39c');
      loadPRGoogleDocs(currentPRId);
    }

    /* ─── DRAFT / DOCUMENT COLLABORATION TIMELINE ───
       Combines the requester's original attachmentLink (if any, always the
       earliest version) with every entry in supportingDocuments (pushed —
       never replaced — by cirl.js, so this is already a real version
       history) into one chronological timeline. Both Administrator and
       Staff can add a new version here; the request's own submitter can
       too from their Monitoring page's own "Draft" modal (same backend
       route, same timeline renderer). */
    var ROLE_LABEL = {
      'Administrator': 'Administrator', 'Staff': 'CIRL Staff',
      'Auth. Personnel': 'College Dean', 'potential_partner': 'Partner',
      'Requester': 'Requester'
    };

    function fileKind(filename, mime) {
      const ext = String(filename || '').split('.').pop().toLowerCase();
      if ((mime && mime.includes('pdf')) || ext === 'pdf') return 'pdf';
      if ((mime && mime.startsWith('image/')) || ['jpg', 'jpeg', 'png'].includes(ext)) return 'image';
      return 'other';
    }

    function fmtFileSize(bytes) {
      if (!bytes) return '';
      return bytes > 1e6 ? (bytes / 1e6).toFixed(1) + ' MB' : Math.round(bytes / 1024) + ' KB';
    }

    // ── Breadcrumb — reflects whichever request modal is currently open on top of
    // Requests, e.g. CIPRMS > Requests > Partnership Request > <institution — #id>
    // [> Draft Collaboration]. Reused via MODAL_REOPEN below: reopening pr-modal/
    // dr-modal through openPRDetail/openDRDetail already re-sets it correctly. ──
    var HOME_HREF = '<%= typeof homeHref !== "undefined" ? homeHref : "/dashboard" %>';
    function setBreadcrumb(labels) {
      var ol = document.getElementById('page-breadcrumb');
      if (!ol) return;
      var html = '<li class="breadcrumb-item"><a href="' + HOME_HREF + '">CIPRMS</a></li>';
      labels.forEach(function (label, i) {
        var isLast = i === labels.length - 1;
        html += isLast
          ? '<li class="breadcrumb-item active">' + escapeHtml(label) + '</li>'
          : '<li class="breadcrumb-item"><a href="' + window.location.pathname + '">' + escapeHtml(label) + '</a></li>';
      });
      ol.innerHTML = html;
    }
    function resetBreadcrumb() { setBreadcrumb(['Requests']); }
    function prRequestLabel(r) { return (r.institution || r.inst || ('Request #' + r.id)) + ' — #REQ-' + String(r.id).padStart(3, '0'); }
    function drRequestLabel(r) { return (r.institution || ('Document Request #' + r.id)) + ' — #' + r.id; }

    // ── Modal helpers ──────────────────────────────────────────────────────────────────────
    // Bootstrap 5 does not support two modals open at once: the page's scroll lock belongs to
    // whichever closes first (closing the top one unlocked the page while the other was still
    // open) and each keeps its own backdrop. So the Request/Document detail modal, its View
    // Draft modal and the Draft Preview modal SWAP — the one underneath is hidden, the next one
    // shown, and closing it brings the previous one back — instead of stacking.
    //
    // Every modal here is also driven through getOrCreateInstance. `new bootstrap.Modal(el)` on
    // an element that already has an instance made a second instance (with its own key/click
    // handlers) on every open; now there is exactly one per modal, however often it is opened.
    function modalInstance(id) { return bootstrap.Modal.getOrCreateInstance(document.getElementById(id)); }

    var MODAL_RETURN_TO = {};   // modal id -> id of the modal to bring back when it closes
    var MODAL_SWAPPING = {};    // modal id -> true while it is being hidden only to make way for the next one
    // Reopening a detail modal through its own opener re-renders it, so it shows the
    // version count / status as they are now (e.g. after a draft was uploaded meanwhile).
    var MODAL_REOPEN = {
      'pr-modal': function () { if (currentPRId) openPRDetail(currentPRId); else modalInstance('pr-modal').show(); },
      'dr-modal': function () { if (currentDRId) openDRDetail(currentDRId); else modalInstance('dr-modal').show(); }
    };

    var MODAL_PENDING = {};     // modal id -> true from the click until it is actually on screen
    function swapToModal(toId, fromId) {
      // A double-click on "View Draft" arrives while the details modal is still fading out (Bootstrap has
      // already dropped its .show class), so the second call used to take the "nothing to swap" branch and
      // open the drafts over the fading details modal — two modals and two backdrops at once, with the
      // return-to link lost. One swap in flight per target modal; repeat clicks are ignored.
      if (MODAL_PENDING[toId]) return;
      MODAL_PENDING[toId] = true;
      document.getElementById(toId).addEventListener('shown.bs.modal', function () { delete MODAL_PENDING[toId]; }, { once: true });
      setTimeout(function () { delete MODAL_PENDING[toId]; }, 2000);   // never stay stuck if the modal fails to show
      const fromEl = fromId && document.getElementById(fromId);
      if (fromEl && fromEl.classList.contains('show')) {
        MODAL_RETURN_TO[toId] = fromId;
        MODAL_SWAPPING[fromId] = true;
        fromEl.addEventListener('hidden.bs.modal', function () { modalInstance(toId).show(); }, { once: true });
        modalInstance(fromId).hide();
      } else {
        delete MODAL_RETURN_TO[toId];
        modalInstance(toId).show();
      }
    }

    ['pr-draft-modal', 'dr-draft-modal', 'draft-preview-modal'].forEach(function (id) {
      document.getElementById(id).addEventListener('hidden.bs.modal', function () {
        if (MODAL_SWAPPING[id]) { delete MODAL_SWAPPING[id]; return; }   // hidden to make way for the next modal, not closed by the user
        const back = MODAL_RETURN_TO[id];
        delete MODAL_RETURN_TO[id];
        if (back) (MODAL_REOPEN[back] || function () { modalInstance(back).show(); })();
        else resetBreadcrumb();   // nothing to swap back to — this was the top of the stack
      });
    });

    // pr-modal/dr-modal have no swap-in listener of their own (they're the bottom of the
    // stack), so their real close (not a swap-out for Draft/Preview) is exactly when
    // MODAL_SWAPPING wasn't set for them — same guard style as the block above.
    ['pr-modal', 'dr-modal'].forEach(function (id) {
      document.getElementById(id).addEventListener('hidden.bs.modal', function () {
        if (MODAL_SWAPPING[id]) { delete MODAL_SWAPPING[id]; return; }
        resetBreadcrumb();
      });
    });

    // Every draft/version gets its own dedicated "Draft Preview" modal —
    // same-screen, never navigates away, carries uploader/date/note context
    // alongside the file (see the swap behaviour above).
    // DRAFT_TIMELINE_ITEMS keeps the last-rendered item list per timeline
    // (prefix 'pr'/'dr') so the modal can look an item up by index without
    // re-parsing anything out of the DOM or fighting HTML-attribute escaping
    // for arbitrary filenames/notes.
    var DRAFT_TIMELINE_ITEMS = {};

    function openDraftPreviewModal(prefix, idx) {
      const item = (DRAFT_TIMELINE_ITEMS[prefix] || [])[idx];
      if (!item || !item.link) return;
      const kind = fileKind(item.filename, item.fileType);
      const body = document.getElementById('draft-preview-body');
      const safeLink = sanitizeUrl(item.link);
      if (!safeLink) {
        body.innerHTML = `<div class="text-center text-muted py-5"><i class="ri-error-warning-line fs-1 d-block mb-2"></i>This link cannot be previewed (unrecognized or unsafe URL).</div>`;
      } else if (kind === 'pdf') {
        body.innerHTML = `<iframe src="${safeLink}" style="width:100%;height:60vh;border:1px solid var(--vz-border-color, #e9ebec);border-radius:.25rem;"></iframe>`;
      } else if (kind === 'image') {
        body.innerHTML = `<div class="text-center"><img src="${safeLink}" style="max-width:100%;max-height:60vh;border:1px solid var(--vz-border-color, #e9ebec);border-radius:.25rem;"></div>`;
      } else {
        body.innerHTML = `<div class="text-center text-muted py-5"><i class="ri-file-3-line fs-1 d-block mb-2"></i>Preview not available for this file type.</div>`;
      }
      document.getElementById('draft-preview-filename').textContent = item.filename;
      document.getElementById('draft-preview-uploader').textContent = item.uploadedBy + ' (' + (ROLE_LABEL[item.role] || item.role) + ')';
      document.getElementById('draft-preview-when').textContent = item.when;
      document.getElementById('draft-preview-note').textContent = item.note || '—';
      const downloadBtn = document.getElementById('draft-preview-download-btn');
      downloadBtn.href = safeLink || '#';
      downloadBtn.setAttribute('download', item.filename);

      // Swap from whichever draft-collaboration modal called this; closing the preview brings it back.
      swapToModal('draft-preview-modal', (prefix || 'pr') + '-draft-modal');
    }

    // prefix namespaces DRAFT_TIMELINE_ITEMS/preview lookups so a Partnership
    // Request timeline and a Document Request timeline never collide if both
    // happen to render on the page (each tab keeps its own prefix: 'pr'/'dr').
    function draftItemHtml(item, idx, prefix) {
      const roleLabel = ROLE_LABEL[item.role] || item.role || 'Reviewer';
      const isReviewerRole = item.role === 'Administrator' || item.role === 'Staff';
      const avatar = `<div class="flex-shrink-0">
        <span class="avatar-title ${isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success'} rounded-circle" style="width:36px;height:36px;">
          <i class="ri-${isReviewerRole ? 'shield-star-line' : 'user-line'}"></i>
        </span>
      </div>`;
      const header = `<div class="d-flex justify-content-between flex-wrap gap-1">
        <div>
          <span class="fw-semibold fs-13">${escapeHtml(item.uploadedBy)}</span>
          <span class="badge ${isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success'} fs-10 ms-1">${escapeHtml(roleLabel)}</span>
        </div>
        <span class="text-muted fs-12">${escapeHtml(item.when)}</span>
      </div>`;

      // A link-less item is a system/status entry (e.g. "Request submitted")
      // rather than an uploaded file — no filename, preview, or download row.
      if (!item.link) {
        return `<div class="d-flex gap-3 mb-3 draft-item">
          ${avatar}
          <div class="flex-grow-1 border rounded p-3 draft-card">
            ${header}
            ${item.note ? `<div class="fs-13 text-muted mt-1">${escapeHtml(item.note)}</div>` : ''}
          </div>
        </div>`;
      }

      const kind = fileKind(item.filename, item.fileType);
      const sizeStr = fmtFileSize(item.fileSize);
      // Every item (not just the latest) gets both actions — Preview opens
      // the shared modal above; Download sets the browser's suggested save
      // name to the ORIGINAL filename (the file on disk is stored under a
      // generated name to avoid collisions, so without this attribute the
      // browser would save it as that generated name instead).
      const previewBtn = (kind === 'pdf' || kind === 'image')
        ? `<button type="button" class="btn btn-sm btn-soft-primary" onclick="openDraftPreviewModal('${prefix || 'pr'}', ${idx})"><i class="ri-eye-line me-1"></i>Preview</button>`
        : `<span class="text-muted fs-12 align-self-center">Preview not available for this file type</span>`;
      const safeItemLink = sanitizeUrl(item.link);
      const downloadBtnHtml = safeItemLink
        ? `<a href="${safeItemLink}" download="${escapeHtml(item.filename)}" class="btn btn-sm btn-soft-success"><i class="ri-download-2-line me-1"></i>Download</a>`
        : `<span class="text-muted fs-12 align-self-center">Link unavailable</span>`;
      return `<div class="d-flex gap-3 mb-3 draft-item">
        ${avatar}
        <div class="flex-grow-1 border rounded p-3 draft-card">
          ${header}
          <div class="fs-13 fw-medium mt-1">${escapeHtml(item.filename)}${sizeStr ? ` <span class="text-muted fs-12">(${sizeStr})</span>` : ''}${item.linked ? ' <span class="badge bg-info-subtle text-info fs-10"><i class="ri-link me-1"></i>Linked from Document Library</span>' : ''}</div>
          ${item.note ? `<div class="fs-13 text-muted mt-1 fst-italic">"${escapeHtml(item.note)}"</div>` : ''}
          <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
            ${previewBtn}
            ${downloadBtnHtml}
          </div>
        </div>
      </div>`;
    }

    function buildDraftTimelineItems(r) {
      const items = [];
      if (r.attachmentLink) {
        items.push({
          uploadedBy: r.requestedBy || 'Requester', role: 'Requester',
          when: r.date || '—', filename: String(r.attachmentLink).split('/').pop(),
          link: r.attachmentLink, note: 'Initial submission', fileType: '', fileSize: 0
        });
      }
      (r.supportingDocuments || []).forEach(d => {
        items.push({
          uploadedBy: d.uploadedBy || 'Unknown',
          role: d.uploaderRole || 'Reviewer',
          when: d.uploadedAt
            ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
            : '—',
          filename: d.originalFilename || 'Document', link: d.fileLink,
          note: d.note || '', fileType: d.fileType, fileSize: d.fileSize
        });
      });
      return items;
    }

    function renderDraftTimeline(r) {
      const items = buildDraftTimelineItems(r);
      DRAFT_TIMELINE_ITEMS.pr = items;
      const wrap = document.getElementById('pr-draft-timeline');
      wrap.innerHTML = items.length
        ? items.map((it, idx) => draftItemHtml(it, idx, 'pr')).join('')
        : '<p class="text-muted fs-13 mb-0">No draft documents yet.</p>';
    }

    /* ═══════════════════════════════════════════════════════
       DOCUMENT REQUEST DRAFT / DOCUMENT COLLABORATION TIMELINE
       Mirrors the Partnership Request timeline above, sharing every helper
       (fileKind, fmtFileSize, togglePreview, draftItemHtml, ROLE_LABEL) —
       only the data source (drData/currentDRId) and the synthetic first
       entry (a "Request submitted" system event, since Document Requests
       have no attachmentLink-style original file) differ.
    ═══════════════════════════════════════════════════════ */
    function buildDRDraftTimelineItems(r) {
      const items = [{
        uploadedBy: r.requestedBy || 'Requester', role: 'Requester',
        when: r.submittedAt
          ? new Date(r.submittedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
          : (r.date || '—'),
        note: 'Request submitted'
      }];
      (r.supportingDocuments || []).forEach(d => {
        items.push({
          uploadedBy: d.uploadedBy || 'Unknown',
          role: d.uploaderRole || 'Reviewer',
          when: d.uploadedAt
            ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
            : '—',
          filename: d.originalFilename || 'Document', link: d.fileLink,
          note: d.note || '', fileType: d.fileType, fileSize: d.fileSize, linked: !!d.linked
        });
      });
      return items;
    }

    function renderDRDraftTimeline(r) {
      const items = buildDRDraftTimelineItems(r);
      DRAFT_TIMELINE_ITEMS.dr = items;
      const wrap = document.getElementById('dr-draft-timeline');
      wrap.innerHTML = items.map((it, idx) => draftItemHtml(it, idx, 'dr')).join('');
    }

    function openDRDraftModal() {
      const r = drData.find(x => x.id === currentDRId);
      if (!r) return;
      document.getElementById('dr-draft-modal-title').innerHTML =
        `<i class="ri-file-list-3-line me-2 text-primary"></i>Request #${r.id}`;
      renderDRDraftTimeline(r);
      const closed = DR_TERMINAL_STATUSES.includes(r.canonicalStatus || r.status);
      document.getElementById('dr-draft-upload-wrap').style.display = closed ? 'none' : '';
      document.getElementById('dr-draft-closed-note').style.display = closed ? '' : 'none';
      document.getElementById('dr-draft-file').value = '';
      if (window.drDraftDropzone) window.drDraftDropzone.removeFile();
      document.getElementById('dr-draft-note').value = '';
      drLinkedDocumentIds = [];
      renderDrLinkedChips();
      setBreadcrumb(['Requests', 'Document Request', drRequestLabel(r), 'Draft Collaboration']);
      swapToModal('dr-draft-modal', 'dr-modal');
    }

    /* ── Select Existing Documents (2026-11) — link one or more documents already in the system to a
       Document Request's draft timeline instead of re-uploading. ── */
    var DR_EXISTING_DOCS = null; // lazy-loaded once per page session; every document in the system
    var drLinkedDocumentIds = []; // selected for the draft currently being composed in dr-draft-modal

    async function openDrSelectExisting() {
      if (!DR_EXISTING_DOCS) {
        // scope=all: Administrator/Staff already have unrestricted read access to any document once it's
        // linked to a request they review (cirl.js's GET /uploads/documents/:filename exemption) — this
        // shows every document already in the system, not just the ones this reviewer personally uploaded,
        // so a colleague's existing upload never has to be re-uploaded just to attach it here.
        const res = await CIPRMS.api('/api/documents?scope=all', { quiet: true });
        DR_EXISTING_DOCS = (res.ok && Array.isArray(res.data)) ? res.data : [];
      }
      document.getElementById('dr-select-existing-search').value = '';
      renderDrSelectExistingList();
      bootstrap.Modal.getOrCreateInstance(document.getElementById('dr-select-existing-modal')).show();
    }

    function renderDrSelectExistingList() {
      const q = (document.getElementById('dr-select-existing-search').value || '').toLowerCase().trim();
      const docs = (DR_EXISTING_DOCS || []).filter(d => !q
        || (d.title || '').toLowerCase().includes(q)
        || (d.type || '').toLowerCase().includes(q)
        || (d.institution || '').toLowerCase().includes(q)
        || (d.partner || '').toLowerCase().includes(q)
        || (d.uploadedBy || '').toLowerCase().includes(q));
      const list = document.getElementById('dr-select-existing-list');
      const emptyEl = document.getElementById('dr-select-existing-empty');
      emptyEl.classList.toggle('d-none', docs.length > 0);
      list.innerHTML = docs.map(d => {
        const checked = drLinkedDocumentIds.includes(d.id);
        return `<label class="list-group-item d-flex align-items-start gap-2" style="cursor:pointer;">
            <input type="checkbox" class="form-check-input flex-shrink-0 mt-1" ${checked ? 'checked' : ''} onchange="toggleDrLinkedDoc(${d.id}, this.checked)">
            <span class="flex-grow-1">
              <span class="fw-semibold fs-13">${escapeHtml(d.title || 'Untitled Document')}</span>
              <span class="badge bg-primary-subtle text-primary fs-10 ms-1">${escapeHtml(d.type || 'Document')}</span>
              <br><span class="text-muted fs-12">${escapeHtml(d.institution || d.partner || '—')} &middot; ${escapeHtml(d.date || '—')} &middot; uploaded by ${escapeHtml(d.uploadedBy || 'Unknown')}</span>
            </span>
          </label>`;
      }).join('');
      document.getElementById('dr-select-existing-count').textContent =
        drLinkedDocumentIds.length ? drLinkedDocumentIds.length + ' selected' : '';
    }

    function toggleDrLinkedDoc(id, checked) {
      drLinkedDocumentIds = drLinkedDocumentIds.filter(x => x !== id);
      if (checked) drLinkedDocumentIds.push(id);
      renderDrLinkedChips();
      document.getElementById('dr-select-existing-count').textContent =
        drLinkedDocumentIds.length ? drLinkedDocumentIds.length + ' selected' : '';
    }

    function renderDrLinkedChips() {
      const wrap = document.getElementById('dr-draft-linked-list');
      if (!wrap) return;
      wrap.innerHTML = drLinkedDocumentIds.map(id => {
        const doc = (DR_EXISTING_DOCS || []).find(d => d.id === id);
        const label = doc ? doc.title : ('Document #' + id);
        return `<span class="badge bg-info-subtle text-info d-inline-flex align-items-center gap-1 p-2 fs-12">
            <i class="ri-link"></i>${escapeHtml(label)}
            <button type="button" class="btn-close" style="font-size:.55rem" onclick="toggleDrLinkedDoc(${id}, false); renderDrSelectExistingList();" aria-label="Remove"></button>
          </span>`;
      }).join('');
    }

    async function uploadDRDraftDocument() {
      const fileInput = document.getElementById('dr-draft-file');
      const noteInput = document.getElementById('dr-draft-note');
      const file = fileInput.files[0];
      const note = noteInput.value.trim();
      // File is optional (2026-09-19), and linking an existing document is a third alternative (2026-11)
      // — only block submission when there's genuinely nothing to save.
      if (!currentDRId) return;
      if (!file && !note && !drLinkedDocumentIds.length) return showToast('<i class="ri-error-warning-line me-1"></i>Add a file, a note, or select at least one existing document.', '#f06548');
      const btn = document.getElementById('dr-draft-upload-btn');
      const originalBtnHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
      const formData = new FormData();
      if (file) formData.append('document', file);
      formData.append('note', note);
      if (drLinkedDocumentIds.length) formData.append('documentIds', JSON.stringify(drLinkedDocumentIds));
      try {
        const res = await CIPRMS.api('/api/document-requests/' + currentDRId + '/documents', { method: 'POST', body: formData, quiet: true });
        if (!res.ok) throw new Error(res.error || 'Upload failed.');
        const data = res.data;
        const idx = drData.findIndex(x => x.id === currentDRId);
        if (idx !== -1 && data.request) drData[idx] = data.request;
        renderDRDraftTimeline(drData.find(x => x.id === currentDRId));
        renderDR();
        updateStats();
        fileInput.value = '';
        if (window.drDraftDropzone) window.drDraftDropzone.removeFile();
        noteInput.value = '';
        drLinkedDocumentIds = [];
        renderDrLinkedChips();
        showToast('<i class="ri-checkbox-circle-line me-1"></i>New draft version uploaded.', '#0ab39c');
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>' + e.message, '#f06548');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }

    function openDraftModal(uid) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      currentPRId = uid;
      document.getElementById('pr-draft-modal-title').innerHTML =
        `<i class="ri-file-list-3-line me-2 text-primary"></i>#REQ-${String(r.id).padStart(3, '0')}`;
      renderDraftTimeline(r);
      const closed = ['Approved', 'Rejected', 'Withdrawn'].includes(r.status);
      // LAU is read-only monitoring — never gets the upload widget regardless of status (it can still view
      // every existing draft/version via renderDraftTimeline above). Server-side, POST
      // /api/requests/:id/documents already rejects LAU independently (not a reviewer, not the owner) —
      // this just keeps the UI from offering an action that would 403.
      document.getElementById('pr-draft-upload-wrap').style.display = (closed || IS_LAU) ? 'none' : '';
      document.getElementById('pr-draft-closed-note').style.display = (closed && !IS_LAU) ? '' : 'none';
      document.getElementById('pr-draft-file').value = '';
      if (window.prDraftDropzone) window.prDraftDropzone.removeFile();
      document.getElementById('pr-draft-note').value = '';
      setBreadcrumb(['Requests', 'Partnership Request', prRequestLabel(r), 'Draft Collaboration']);
      swapToModal('pr-draft-modal', 'pr-modal');
    }

    async function uploadDraftDocument() {
      const fileInput = document.getElementById('pr-draft-file');
      const noteInput = document.getElementById('pr-draft-note');
      const file = fileInput.files[0];
      const note = noteInput.value.trim();
      // File is optional (2026-09-19) — notes alone are a valid new version.
      // Only block submission when there's genuinely nothing to save.
      if (!currentPRId) return;
      if (!file && !note) return showToast('<i class="ri-error-warning-line me-1"></i>Add a file, a note, or both.', '#f06548');
      const btn = document.getElementById('pr-draft-upload-btn');
      const originalBtnHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
      const formData = new FormData();
      if (file) formData.append('document', file);
      formData.append('note', note);
      try {
        const res = await CIPRMS.api('/api/requests/' + currentPRId + '/documents', { method: 'POST', body: formData, quiet: true });
        if (!res.ok) throw new Error(res.error || 'Upload failed.');
        const data = res.data;
        const idx = prData.findIndex(x => String(x.id) === currentPRId);
        if (idx !== -1 && data.request) prData[idx] = data.request;
        renderDraftTimeline(prData.find(x => String(x.id) === currentPRId));
        renderPR();
        updateStats();
        fileInput.value = '';
        if (window.prDraftDropzone) window.prDraftDropzone.removeFile();
        noteInput.value = '';
        showToast('<i class="ri-checkbox-circle-line me-1"></i>New draft version uploaded.', '#0ab39c');
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>' + e.message, '#f06548');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }

    // A status change is only shown once the SERVER has saved it: the row is replaced with the record the server returns,
    // and if the server refuses (already decided, not allowed, gone, offline) nothing local changes — the list is re-read
    // and the reviewer is told why.
    async function applyPRStatus(r, payload, button, okMessage, okColor) {
      return CIPRMS.busy(button, async () => {
        const res = await CIPRMS.api('/api/requests/' + r.id, { method: 'PATCH', json: payload, quiet: true });
        if (!res.ok) {
          showToast('<i class="ri-error-warning-line me-1"></i>' + res.error, '#f06548');
          if (res.status === 400 || res.status === 404 || res.status === 409) { await refreshLive(); refreshOpenModals(); }
          return false;
        }
        const i = prData.findIndex(x => x.id === r.id);
        if (i !== -1 && res.data && res.data.request) prData[i] = res.data.request;
        renderPR();
        updateStats();
        showToast(okMessage, okColor);
        return true;
      }, 'Saving…');
    }

    async function resolvePR(uid, decision, button) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      // Approving a NEW partnership request (not a renewal) no longer flips
      // the status directly — it hands off to Registry → Add New Partnership,
      // pre-filled from this request, so the reviewer can review/edit before
      // anything is saved. The request is only marked Approved once that
      // partnership is actually saved (see POST /api/partnerships,
      // sourceRequestId). Renewal requests are unaffected — approving one
      // still directly extends the already-linked partnership as before.
      // (This one stays a normal page navigation: it opens a different page, the Registry form.)
      // A partner's MOA/MOU submission is not a request to create a partnership, so approving it just marks it approved.
      if (decision === 'Approved' && !r.isRenewal && !r.isSubmission) {
        bootstrap.Modal.getInstance(document.getElementById('pr-modal'))?.hide();
        window.location.href = REGISTRY_BASE_PATH + '?fromRequest=' + r.id;
        return;
      }
      const verbLabel = decision === 'Approved' ? 'approved' : 'rejected';
      const ok = await applyPRStatus(r, { status: decision }, button,
        `<i class="ri-${decision === 'Approved' ? 'checkbox-circle' : 'close-circle'}-line me-1"></i> Partnership request ${verbLabel}.`,
        decision === 'Approved' ? '#0ab39c' : '#f06548');
      if (ok) bootstrap.Modal.getInstance(document.getElementById('pr-modal'))?.hide();
    }

    // "Request More Information": moves a Pending request to Under Review with the reviewer's note, which the server turns
    // into the "Additional documents requested" notification for the requester. First click opens the note box, second sends.
    async function requestMoreInfo(uid, button) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      const wrap = document.getElementById('pr-moreinfo-wrap');
      const note = document.getElementById('pr-moreinfo-note');
      if (wrap.classList.contains('d-none')) {
        wrap.classList.remove('d-none');
        button.innerHTML = '<i class="ri-send-plane-line me-1"></i>Send request';
        note.focus();
        return;
      }
      const text = note.value.trim();
      if (!text) { showToast('<i class="ri-error-warning-line me-1"></i>Write what information or documents are needed.', '#f06548'); note.focus(); return; }
      const ok = await applyPRStatus(r, { status: 'Under Review', notes: text }, button,
        '<i class="ri-question-answer-line me-1"></i>Requested. The requester has been notified.', '#0ab39c');
      if (ok) bootstrap.Modal.getInstance(document.getElementById('pr-modal'))?.hide();
    }

    /* ═══════════════════════════════════════════════════════
       DOCUMENT REQUESTS
    ═══════════════════════════════════════════════════════ */
    async function loadDR() {
      // /api/document-requests is requireStaffAccess-gated server-side — LAU would get a 403. Skip the
      // call entirely rather than let it fail; LAU never sees the Document Requests tab anyway (IS_LAU).
      if (IS_LAU) { drData = []; renderDR(); return; }
      const res = await CIPRMS.api('/api/document-requests', { quiet: true });
      drData = res.ok && Array.isArray(res.data) ? res.data : [];
      renderDR();
    }

    function renderDR() {
      const s = (document.getElementById('dr-search').value || '').toLowerCase();
      const st = document.getElementById('dr-status').value;

      drFiltered = drData.filter(r =>
        (!s || [(r.institution || ''), (r.requestedBy || '')].join(' ').toLowerCase().includes(s))
        && (!st || (r.canonicalStatus || r.status) === st)
      );

      const tbody = document.getElementById('dr-tbody');
      document.getElementById('dr-count').textContent =
        `${drFiltered.length} of ${drData.length} request${drData.length !== 1 ? 's' : ''}`;

      if (!drFiltered.length) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">
          <i class="ri-inbox-line d-block fs-1 mb-2"></i>No document requests found.</td></tr>`;
        document.getElementById('dr-pagination').innerHTML = '';
        return;
      }
      
      const totalPages = Math.ceil(drFiltered.length / drItemsPerPage);
      if (drCurrentPage > totalPages) drCurrentPage = Math.max(1, totalPages);
      const startIdx = (drCurrentPage - 1) * drItemsPerPage;
      const paged = drFiltered.slice(startIdx, startIdx + drItemsPerPage);
      
      document.getElementById('dr-pagination').innerHTML = buildPaginationHtml(drCurrentPage, totalPages, 'goToDRPage');

      tbody.innerHTML = paged.map((r, mappedIndex) => {
        const i = startIdx + mappedIndex;
        const cs = r.canonicalStatus || r.status;
        const canAct = IS_ADMIN && !DR_TERMINAL_STATUSES.includes(cs);
        return `<tr data-rid="${r.id}"${flashDR.has(r.id) ? ' class="rt-flash"' : ''}>
          <td class="text-muted fw-semibold fs-13">${i + 1}</td>
          <td><span class="fw-semibold fs-13">${escapeHtml(r.institution || '—')}</span></td>
          <td>${drDocTypeBadges(r)}</td>
          <td class="fw-medium fs-13">${escapeHtml(r.requestedBy || '—')}</td>
          <td class="text-muted fs-13">${r.date || '—'}</td>
          <td class="dr-status-cell">${drStatusSelectHtml(r)}</td>
          <td>
            <div class="hstack gap-1">
              <button class="btn btn-sm btn-soft-secondary" onclick="openDRDetail(${r.id})">
                <i class="ri-eye-line me-1"></i>${canAct ? 'Review' : 'View'}
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    function fmtHistoryWhen(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      return isNaN(d) ? '—' : d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    // Renders every recorded transition (never overwritten server-side) —
    // previous status, new status, who changed it, and when — oldest first.
    function drHistoryListHtml(r) {
      const hist = Array.isArray(r.statusHistory) ? r.statusHistory : [];
      if (!hist.length) return '<p class="mb-0 fs-13 text-muted">No status changes recorded yet.</p>';
      return '<ol class="mb-0 ps-3">' + hist.map(h =>
        `<li class="fs-13 mb-1"><strong>${escapeHtml(h.from || '—')}</strong> &rarr; <strong>${escapeHtml(h.to || '—')}</strong>` +
        ` <span class="text-muted">by ${escapeHtml(h.by || '—')} on ${fmtHistoryWhen(h.at)}</span>` +
        (h.remark ? `<div class="text-muted fs-12">Remark: ${escapeHtml(h.remark)}</div>` : '') +
        '</li>'
      ).join('') + '</ol>';
    }

    // The status control lives in the Document Requests TABLE (Status column), not in the details modal. Only the
    // current stage and the one legitimate next stage are selectable — every other option is rendered (for context)
    // but disabled, which is what prevents an invalid skip/backward pick in the UI (the PATCH endpoint enforces the
    // same rule server-side regardless). A closed request (Completed / Rejected) shows its status, not editable.
    function drStatusSelectHtml(r) {
      const cs = r.canonicalStatus || r.status || 'Received';
      if (!IS_ADMIN) return statusBadge(cs);
      const next = drNextStatus(cs);
      const terminal = DR_TERMINAL_STATUSES.includes(cs);
      const busy = drStatusInFlight.has(r.id);
      const opts = (DR_WORKFLOW_STATUSES.includes(cs) ? DR_WORKFLOW_STATUSES : [cs]).map(s =>
        `<option value="${escapeHtml(s)}"${s === cs ? ' selected' : ''}${s !== cs && s !== next ? ' disabled' : ''}>${escapeHtml(s)}</option>`).join('');
      const hint = terminal ? 'This request is closed — its status can no longer be changed.' : 'Change status — only the next step in the workflow can be selected.';
      return `<select class="form-select form-select-sm dr-status-select ${statusClasses(cs)}${busy ? ' is-busy' : ''}" data-id="${r.id}" data-current="${escapeHtml(cs)}"` +
        ` aria-label="Status of ${escapeHtml(r.institution || 'request')}" title="${hint}"${terminal || !next || busy ? ' disabled' : ''}${busy ? ' aria-busy="true"' : ''}>${opts}</select>`;
    }

    function openDRDetail(id) {
      const r = drData.find(x => x.id === id);
      if (!r) return;
      currentDRId = id;
      const cs = r.canonicalStatus || r.status || 'Received';

      document.getElementById('dr-v-inst').textContent = r.institution || '—';
      document.getElementById('dr-v-type').innerHTML = drDocTypeList(r);
      document.getElementById('dr-v-by').textContent = r.requestedBy || '—';
      document.getElementById('dr-v-date').textContent = r.date || '—';
      document.getElementById('dr-v-status').innerHTML = statusBadge(cs);
      document.getElementById('dr-v-notes').textContent = r.notes || '—';
      document.getElementById('dr-received-by').value = r.receivedBy || r.requestedBy || '';
      document.getElementById('dr-draft-count').textContent = (r.supportingDocuments || []).length + ' version(s) on file';
      document.getElementById('dr-history-list').innerHTML = drHistoryListHtml(r);

      const canAct = IS_ADMIN && !DR_TERMINAL_STATUSES.includes(cs);
      document.getElementById('dr-remark-wrap').style.display = canAct ? '' : 'none';

      const signoffWrap = document.getElementById('dr-signoff-wrap');
      if (r.decidedBy) {
        signoffWrap.style.display = '';
        // Internal note only — the printed CSPC-F-CIRL-04 form's "Approved
        // By" line always shows the fixed CIRL Head signatory, never this
        // record's decidedBy (who merely clicked a status transition in-app).
        document.getElementById('dr-signoff-summary').innerHTML =
          `Last Updated By: <strong>${escapeHtml(r.decidedBy)}</strong>` +
          (r.releasedBy ? ` &nbsp;·&nbsp; Released By: <strong>${escapeHtml(r.releasedBy)}</strong>` : '') +
          (r.receivedBy ? ` &nbsp;·&nbsp; Received By: <strong>${escapeHtml(r.receivedBy)}</strong>` : '');
      } else {
        signoffWrap.style.display = 'none';
      }

      // One action only: download the request as the CSPC-F-CIRL-04 PDF. The modal still closes from its header ✕.
      document.getElementById('dr-modal-footer').innerHTML = `
        <a href="/api/document-requests/${id}/pdf" class="btn btn-primary">
          <i class="ri-download-2-line me-1"></i>Download Request</a>`;

      setBreadcrumb(['Requests', 'Document Request', drRequestLabel(r)]);
      modalInstance('dr-modal').show();
    }

    // Backs the Status dropdown in the Document Requests table (any workflow stage) — a single PATCH call, the same
    // server-side transition/RBAC validation for every stage. The row's dropdown is disabled while the request is in
    // flight (a double click / rapid re-pick sends nothing extra) and is rebuilt from the real data afterwards, so on a
    // failure it goes back to the previous status by itself.
    var drStatusInFlight = new Set();     // one status change per request at a time
    async function submitDrStatusChange(id, newStatus) {
      const r = drData.find(x => x.id === id);
      if (!r || drStatusInFlight.has(id)) return;
      const body = { status: newStatus };
      if (newStatus === 'Completed' && currentDRId === id && document.getElementById('dr-modal').classList.contains('show')) {
        // Only the details modal of THIS request may supply a Received By name; otherwise the server uses the requester.
        const receivedByEl = document.getElementById('dr-received-by');
        if (receivedByEl && receivedByEl.value.trim()) body.receivedBy = receivedByEl.value.trim();
      }
      drStatusInFlight.add(id);
      renderDR();                       // shows this row's dropdown disabled/busy
      try {
        const res = await CIPRMS.api('/api/document-requests/' + id, { method: 'PATCH', json: body, quiet: true });
        if (!res.ok) {
          showToast('<i class="ri-error-warning-line me-1"></i>' + res.error, '#f06548');
          // when the server says the request has moved on / is gone, re-read the list; the row is rebuilt below either way
          if (res.status === 400 || res.status === 404 || res.status === 409) { await refreshLive(); refreshOpenModals(); }
          return;
        }
        // Refresh the in-memory row from the server's own response — the PATCH handler computes canonicalStatus/
        // releasedBy/receivedBy/statusHistory server-side, so trust that over reconstructing it.
        Object.assign(r, res.data.request, { canonicalStatus: newStatus === 'Rejected' ? 'Rejected' : newStatus });
        updateStats();
        if (document.getElementById('dr-modal').classList.contains('show')) openDRDetail(id);
        const verbLabel = newStatus === 'Rejected' ? 'rejected' : `moved to "${newStatus}"`;
        showToast(
          `<i class="ri-${newStatus === 'Rejected' ? 'close-circle' : 'checkbox-circle'}-line me-1"></i>
           Document request ${verbLabel} for ${r.institution}.`,
          newStatus === 'Rejected' ? '#f06548' : '#0ab39c'
        );
      } finally {
        drStatusInFlight.delete(id);
        renderDR();                     // re-enables the control and shows the real (new, or restored previous) status
      }
    }
    // One delegated listener for every row's dropdown (the tbody is re-rendered, so per-row handlers would pile up).
    // Holds the one pending status change awaiting confirmation — by id/value, not a DOM element reference,
    // since dr-tbody can be re-rendered in the background (a realtime refresh from someone else's unrelated
    // change) while this page's own confirm modal is still open.
    var pendingDrStatusChange = null;

    function bindDrStatusSelects() {
      const tbody = document.getElementById('dr-tbody');
      if (tbody.dataset.statusBound) return;
      tbody.dataset.statusBound = '1';
      tbody.addEventListener('change', function (e) {
        const sel = e.target.closest && e.target.closest('.dr-status-select');
        if (!sel) return;
        const id = parseInt(sel.dataset.id, 10);
        const previous = sel.dataset.current;
        const next = sel.value;
        if (!next || next === previous) return;
        if (drStatusInFlight.has(id)) { sel.value = previous; return; }
        // The native <select> already shows `next` visually the instant the user picks it — revert that now;
        // it is re-applied for real only if the user actually clicks Confirm below. This is what makes Cancel
        // (or dismissing the modal any other way: backdrop click, Esc, the header ✕) leave the request
        // genuinely unchanged, both on screen and server-side (nothing is sent yet either way).
        sel.value = previous;
        openDrStatusConfirm(id, previous, next);
      });
    }

    function openDrStatusConfirm(id, previousStatus, newStatus) {
      const r = drData.find(x => x.id === id);
      if (!r) return;
      pendingDrStatusChange = { id: id, previousStatus: previousStatus, newStatus: newStatus };
      document.getElementById('dr-confirm-inst').textContent = r.institution || 'this request';
      document.getElementById('dr-confirm-from').innerHTML = statusBadge(previousStatus);
      document.getElementById('dr-confirm-to').innerHTML = statusBadge(newStatus);
      const btn = document.getElementById('dr-status-confirm-btn');
      btn.disabled = false;
      document.getElementById('dr-status-confirm-btn-label').textContent = 'Confirm';
      modalInstance('dr-status-confirm-modal').show();
    }

    // Covers every way of NOT confirming — Cancel, the header ✕, Esc, a backdrop click — so there is a
    // single place that always leaves the request alone, rather than one path for an explicit Cancel button
    // and a separate (and easy to forget) path for every other way to close a Bootstrap modal.
    document.addEventListener('DOMContentLoaded', function () {
      const confirmModalEl = document.getElementById('dr-status-confirm-modal');
      if (confirmModalEl) confirmModalEl.addEventListener('hidden.bs.modal', function () { pendingDrStatusChange = null; });

      // Clear any leftover dean chips from a previously opened-then-cancelled "New College Request" —
      // cdrSubmitCreate() already clears on a successful create, this covers every other way to close it.
      const cdrCreateModalEl = document.getElementById('cdr-create-modal');
      if (cdrCreateModalEl) cdrCreateModalEl.addEventListener('hidden.bs.modal', function () {
        if (CDR_DEAN_COMBO) CDR_DEAN_COMBO.clear();
        const errBox = document.getElementById('cdr-c-error');
        if (errBox) errBox.classList.add('d-none');
      });
    });

    async function confirmDrStatusChange() {
      if (!pendingDrStatusChange) return;
      const { id, newStatus } = pendingDrStatusChange;
      const btn = document.getElementById('dr-status-confirm-btn');
      // Prevents rapid/double-clicking Confirm from firing the PATCH twice — the same in-flight guard
      // submitDrStatusChange() already uses for the dropdown itself, applied here too since the button is a
      // second way to trigger the exact same call.
      if (btn.disabled) return;
      btn.disabled = true;
      document.getElementById('dr-status-confirm-btn-label').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
      pendingDrStatusChange = null; // claimed — hidden.bs.modal's own reset below is now a no-op for this change
      try {
        await submitDrStatusChange(id, newStatus); // unchanged: same PATCH, same audit/notification/history side effects as before
      } finally {
        modalInstance('dr-status-confirm-modal').hide();
      }
    }

    /* ═══════════════════════════════════════════════════════
       COLLEGE REQUESTS (2026-11) — integrated into this page as a third
       tab/panel rather than its own page (the standalone
       administrator/college_requests.ejs page + /college-requests and
       /staff/college-requests routes still exist and stay RBAC-protected
       for direct URL access, but are no longer linked from the sidebar).
       Reuses the exact same /api/college-requests* backend routes as that
       page — no new or duplicated business logic — and this page's own
       escapeHtml()/showToast() above rather than redeclaring them.
    ═══════════════════════════════════════════════════════ */
    var CDR_ALL = [];
    var CDR_ACTIVE_FILTER = '';
    var CDR_DEANS = [];
    var CDR_BADGE = {
      'Pending': 'bg-secondary-subtle text-secondary',
      'Submitted': 'bg-info-subtle text-info',
      'Returned for Revision': 'bg-warning-subtle text-warning',
      'Completed': 'bg-success-subtle text-success'
    };
    function cdrBadge(status) {
      return '<span class="badge ' + (CDR_BADGE[status] || 'bg-secondary-subtle text-secondary') + '">' + escapeHtml(status) + '</span>';
    }
    function fmtDate(iso) {
      if (!iso) return '';
      var d = new Date(iso);
      return isNaN(d) ? escapeHtml(iso) : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    var CDR_DEAN_COMBO = null;

    // Searchable multi-select with removable chips for Target College Dean(s) — same visual language
    // (chips/dropdown) as the Responsible Unit combo elsewhere in the app, but keyed on dean user id
    // (not a display string), since multiple deans can share the same college/display label.
    function createDeanCombo() {
      var selected = []; // [{id, name, email, unit}]
      var chips = document.getElementById('cdr-c-dean-chips');
      var input = document.getElementById('cdr-c-dean-input');
      var dropdown = document.getElementById('cdr-c-dean-dropdown');
      var blurTimer = null;

      function renderChips() {
        chips.innerHTML = selected.map(function (d, i) {
          return '<span class="dean-chip">' + escapeHtml(d.name) + (d.unit ? ' — ' + escapeHtml(d.unit) : '') +
            '<button type="button" data-i="' + i + '" aria-label="Remove ' + escapeHtml(d.name) + '">&times;</button></span>';
        }).join('');
        chips.querySelectorAll('button').forEach(function (btn) {
          btn.addEventListener('click', function () {
            selected.splice(parseInt(btn.getAttribute('data-i'), 10), 1);
            renderChips();
          });
        });
      }

      function closeDropdown() {
        dropdown.style.display = 'none';
        dropdown.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
      }

      function addDean(dean) {
        if (!dean || selected.some(function (d) { return d.id === dean.id; })) { input.value = ''; closeDropdown(); return; }
        selected.push(dean);
        renderChips();
        input.value = '';
        input.classList.remove('is-invalid');
        closeDropdown();
        input.focus();
      }

      function openDropdown() {
        if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
        var q = input.value.trim().toLowerCase();
        if (dropdown.style.display === 'block' && dropdown.dataset.q === q) return;
        dropdown.dataset.q = q;
        var available = CDR_DEANS.filter(function (d) { return !selected.some(function (s) { return s.id === d.id; }); });
        var matches = q ? available.filter(function (d) {
          return (d.name || '').toLowerCase().indexOf(q) !== -1 || (d.unit || '').toLowerCase().indexOf(q) !== -1;
        }) : available;
        dropdown.innerHTML = matches.length
          ? matches.map(function (d) {
              return '<div class="dean-combo-option" data-id="' + d.id + '">' + escapeHtml(d.name) +
                (d.unit ? '<small>' + escapeHtml(d.unit) + '</small>' : '') + '</div>';
            }).join('')
          : '<div class="dean-combo-empty">' + (available.length ? 'No matching College Dean.' : 'All College Deans selected.') + '</div>';
        dropdown.style.display = 'block';
        input.setAttribute('aria-expanded', 'true');
        dropdown.querySelectorAll('.dean-combo-option').forEach(function (opt) {
          opt.addEventListener('mousedown', function (e) {
            e.preventDefault();
            var id = parseInt(opt.getAttribute('data-id'), 10);
            addDean(CDR_DEANS.find(function (d) { return d.id === id; }));
          });
        });
      }

      input.addEventListener('focus', openDropdown);
      input.addEventListener('click', openDropdown);
      input.addEventListener('input', openDropdown);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDropdown();
        else if (e.key === 'Backspace' && !input.value && selected.length) { selected.pop(); renderChips(); }
      });
      input.addEventListener('blur', function () { blurTimer = setTimeout(closeDropdown, 120); });

      return {
        getValues: function () { return selected.slice(); },
        clear: function () { selected = []; renderChips(); input.value = ''; closeDropdown(); input.classList.remove('is-invalid'); },
        markInvalid: function () { input.classList.add('is-invalid'); }
      };
    }

    function cdrLoadDeans() {
      // /api/users is requireStaffAccess-gated server-side — LAU would get a 403, and LAU never sees this
      // tab anyway (IS_LAU, same reasoning as loadDR() above).
      if (IS_LAU) return Promise.resolve();
      return fetch('/api/users', { headers: { 'X-Requested-With': 'ciprms' } })
        .then(function (r) { return r.json(); })
        .then(function (users) {
          CDR_DEANS = (users || []).filter(function (u) { return u.role === 'Auth. Personnel'; })
            .map(function (u) { return { id: u.id, name: u.name, email: u.email, unit: u.unit || '' }; });
          if (!CDR_DEAN_COMBO && document.getElementById('cdr-c-dean-combo')) CDR_DEAN_COMBO = createDeanCombo();
        })
        .catch(function () { showToast('Could not load College Dean accounts.', '#f44336'); });
    }

    // Normalizes a request's dean assignment for display — works for both the new assignedDeans array
    // and documents created before the 2026-11 multi-dean change (singular assignedDeanName/College only).
    function cdrDeansOf(r) {
      if (Array.isArray(r.assignedDeans) && r.assignedDeans.length) return r.assignedDeans;
      if (r.assignedDeanName) return [{ name: r.assignedDeanName, college: r.assignedCollege || '' }];
      return [];
    }

    function cdrRenderTable() {
      var rows = !CDR_ACTIVE_FILTER ? CDR_ALL : CDR_ALL.filter(function (r) { return r.status === CDR_ACTIVE_FILTER; });
      var body = document.getElementById('cdr-tbody');
      if (!body) return;
      document.getElementById('cdr-count').textContent =
          rows.length + ' of ' + CDR_ALL.length + ' request' + (CDR_ALL.length !== 1 ? 's' : '');
      if (!rows.length) {
          body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No college requests found.</td></tr>';
          return;
      }
      body.innerHTML = rows.map(function (r) {
          var deans = cdrDeansOf(r);
          var deanNames = deans.map(function (d) { return d.name; }).join(', ');
          var deanColleges = deans.map(function (d) { return d.college; }).filter(Boolean).join(', ');
          return '<tr>' +
              '<td><strong>' + escapeHtml(r.title) + '</strong></td>' +
              '<td>' + escapeHtml(r.requestType) + '</td>' +
              '<td>' + escapeHtml(deanNames) + '</td>' +
              '<td>' + escapeHtml(deanColleges || '—') + '</td>' +
              '<td>' + (r.deadline ? fmtDate(r.deadline) : '<span class="text-muted">—</span>') + '</td>' +
              '<td>' + cdrBadge(r.status) + '</td>' +
              '<td class="text-end"><button class="btn btn-sm btn-soft-primary" onclick="cdrOpenDetail(' + r.id + ')"><i class="ri-eye-line"></i> View</button></td>' +
              '</tr>';
      }).join('');
    }

    function cdrFilterBy(status, btn) {
      CDR_ACTIVE_FILTER = status;
      document.querySelectorAll('#cdr-filter-tabs .btn').forEach(function (b) { b.classList.remove('active'); });
      if (btn) btn.classList.add('active');
      cdrRenderTable();
    }

    function cdrLoadList() {
      // /api/college-requests already scopes correctly server-side for every role it admits, but LAU isn't
      // one of them (403) and never sees this tab anyway — same IS_LAU short-circuit as loadDR() above.
      if (IS_LAU) { CDR_ALL = []; cdrRenderTable(); return Promise.resolve(); }
      return fetch('/api/college-requests', { headers: { 'X-Requested-With': 'ciprms' } })
          .then(function (r) { return r.json(); })
          .then(function (data) {
              CDR_ALL = Array.isArray(data) ? data : [];
              cdrRenderTable();
              if (document.getElementById('tab-cnt-cdr')) document.getElementById('tab-cnt-cdr').textContent = CDR_ALL.length;
          })
          .catch(function () {
              var body = document.getElementById('cdr-tbody');
              if (body) body.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Unable to load college requests.</td></tr>';
          });
    }

    function cdrHistoryHtml(history) {
      if (!history || !history.length) return '<p class="text-muted mb-0">No history yet.</p>';
      return history.slice().reverse().map(function (h) {
          return '<div class="cdr-history-item"><strong>' + escapeHtml(h.to) + '</strong> — ' + fmtDate(h.at) +
              '<br><span class="text-muted">by ' + escapeHtml(h.by || 'System') + (h.remark ? ': ' + escapeHtml(h.remark) : '') + '</span></div>';
      }).join('');
    }

    function cdrDocListHtml(docs, emptyLabel) {
      if (!docs || !docs.length) return '<p class="text-muted mb-0">' + emptyLabel + '</p>';
      return docs.map(function (d) {
          var label = d.originalFilename || (d.note ? 'Note only' : 'Attachment');
          return '<div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2">' +
              '<div><i class="ri-file-line me-1"></i>' + escapeHtml(label) +
              (d.note ? '<div class="text-muted small">' + escapeHtml(d.note) + '</div>' : '') + '</div>' +
              (d.fileLink ? '<a class="btn btn-sm btn-soft-secondary" href="' + d.fileLink + '" target="_blank"><i class="ri-download-2-line"></i></a>' : '') +
              '</div>';
      }).join('');
    }

    function cdrSubmitCreate() {
      var errBox = document.getElementById('cdr-c-error');
      errBox.classList.add('d-none');
      var deans = CDR_DEAN_COMBO ? CDR_DEAN_COMBO.getValues() : [];
      if (!deans.length) {
          errBox.textContent = 'Select at least one target College Dean.';
          errBox.classList.remove('d-none');
          if (CDR_DEAN_COMBO) CDR_DEAN_COMBO.markInvalid();
          return;
      }
      var payload = {
          requestType: document.getElementById('cdr-c-type').value,
          assignedDeanIds: deans.map(function (d) { return d.id; }),
          deadline: document.getElementById('cdr-c-deadline').value,
          title: document.getElementById('cdr-c-title').value,
          instructions: document.getElementById('cdr-c-instructions').value,
          description: document.getElementById('cdr-c-description').value,
          requiredDocuments: document.getElementById('cdr-c-required').value
      };
      var btn = document.getElementById('cdr-c-submit');
      btn.disabled = true;
      fetch('/api/college-requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'ciprms' },
          body: JSON.stringify(payload)
      })
      .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
      .then(function (res) {
          btn.disabled = false;
          if (!res.ok) {
              errBox.textContent = res.body.error || 'Unable to create the request.';
              errBox.classList.remove('d-none');
              return;
          }
          showToast('College request created and assigned.', '#4caf50');
          bootstrap.Modal.getInstance(document.getElementById('cdr-create-modal')).hide();
          document.getElementById('cdr-create-form').reset();
          if (CDR_DEAN_COMBO) CDR_DEAN_COMBO.clear();
          cdrLoadList();
      })
      .catch(function () {
          btn.disabled = false;
          errBox.textContent = 'Network error. Please try again.';
          errBox.classList.remove('d-none');
      });
    }

    function cdrOpenDetail(id) {
      fetch('/api/college-requests/' + id, { headers: { 'X-Requested-With': 'ciprms' } })
          .then(function (r) { return r.json(); })
          .then(function (r) {
              document.getElementById('cdr-d-title').innerHTML = '<i class="ri-award-line me-2 text-primary"></i>' + escapeHtml(r.title);
              var required = (r.requiredDocuments || []).map(function (d) { return '<span class="cdr-doc-chip">' + escapeHtml(d) + '</span>'; }).join('') || '<span class="text-muted">None specified</span>';
              document.getElementById('cdr-d-body').innerHTML =
                  '<div class="mb-3 d-flex gap-2 flex-wrap">' + cdrBadge(r.status) +
                      '<span class="badge bg-light text-dark border">' + escapeHtml(r.requestType) + '</span>' +
                      (r.deadline ? '<span class="badge bg-light text-dark border"><i class="ri-calendar-line"></i> Due ' + fmtDate(r.deadline) + '</span>' : '') +
                  '</div>' +
                  '<p class="mb-1"><strong>Assigned to:</strong> ' + escapeHtml(cdrDeansOf(r).map(function (d) {
                      return d.name + (d.college ? ' (' + d.college + ')' : '');
                  }).join(', ')) + '</p>' +
                  (r.instructions ? '<p class="mb-1"><strong>Instructions:</strong><br>' + escapeHtml(r.instructions).replace(/\n/g, '<br>') + '</p>' : '') +
                  (r.description ? '<p class="mb-3"><strong>Description:</strong><br>' + escapeHtml(r.description).replace(/\n/g, '<br>') + '</p>' : '') +
                  '<p class="mb-1"><strong>Required Documents</strong></p><div class="mb-3">' + required + '</div>' +
                  (r.reviewRemark && r.status === 'Returned for Revision' ? '<div class="alert alert-warning"><strong>Returned for revision:</strong> ' + escapeHtml(r.reviewRemark) + '</div>' : '') +
                  '<p class="mb-1 mt-3"><strong>Reference Documents</strong> <span class="text-muted">(from you)</span></p>' + cdrDocListHtml(r.referenceDocuments, 'No reference documents attached.') +
                  '<div class="input-group input-group-sm mb-3">' +
                      '<input type="file" class="form-control" id="cdr-ref-file">' +
                      '<button class="btn btn-outline-secondary" type="button" onclick="cdrAddReference(' + r.id + ')">Attach</button>' +
                  '</div>' +
                  '<p class="mb-1"><strong>Submitted Documents</strong> <span class="text-muted">(from the Dean)</span></p>' + cdrDocListHtml(r.submittedDocuments, 'Nothing submitted yet.') +
                  '<p class="mb-1 mt-3"><strong>History</strong></p>' + cdrHistoryHtml(r.statusHistory);

              var footer = document.getElementById('cdr-d-footer');
              if (r.status === 'Submitted') {
                  footer.innerHTML =
                      '<div class="w-100">' +
                      '<textarea class="form-control mb-2" id="cdr-return-remark" rows="2" placeholder="Comment (required if returning for revision)"></textarea>' +
                      '<div class="d-flex justify-content-end gap-2">' +
                      '<button class="btn btn-warning" onclick="cdrDecide(' + r.id + ', \'return\')"><i class="ri-arrow-go-back-line"></i> Return for Revision</button>' +
                      '<button class="btn btn-success" onclick="cdrDecide(' + r.id + ', \'accept\')"><i class="ri-checkbox-circle-line"></i> Accept</button>' +
                      '</div></div>';
              } else {
                  footer.innerHTML = '<button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>';
              }

              bootstrap.Modal.getOrCreateInstance(document.getElementById('cdr-detail-modal')).show();
          })
          .catch(function () { showToast('Unable to load this request.', '#f44336'); });
    }

    function cdrAddReference(id) {
      var fileInput = document.getElementById('cdr-ref-file');
      if (!fileInput.files.length) { showToast('Choose a file first.', '#ff9800'); return; }
      var fd = new FormData();
      fd.append('document', fileInput.files[0]);
      fetch('/api/college-requests/' + id + '/reference-documents', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'ciprms' } })
          .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
          .then(function (res) {
              if (!res.ok) { showToast(res.body.error || 'Upload failed.', '#f44336'); return; }
              showToast('Reference document attached.', '#4caf50');
              cdrOpenDetail(id);
              cdrLoadList();
          })
          .catch(function () { showToast('Network error during upload.', '#f44336'); });
    }

    function cdrDecide(id, action) {
      var remark = (document.getElementById('cdr-return-remark') || {}).value || '';
      if (action === 'return' && !remark.trim()) { showToast('A comment is required when returning for revision.', '#ff9800'); return; }
      fetch('/api/college-requests/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'ciprms' },
          body: JSON.stringify({ action: action, remark: remark })
      })
      .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
      .then(function (res) {
          if (!res.ok) { showToast(res.body.error || 'Unable to update this request.', '#f44336'); return; }
          showToast(action === 'accept' ? 'Request accepted.' : 'Returned for revision.', '#4caf50');
          bootstrap.Modal.getInstance(document.getElementById('cdr-detail-modal')).hide();
          cdrLoadList();
      })
      .catch(function () { showToast('Network error.', '#f44336'); });
    }

    /* ─── INIT ─── */
    // Deep-link support so a notification ("New request submitted",
    // "Additional documents requested", etc.) can jump straight to the
    // relevant request's detail modal: /partnership-requests?open=pr&id=5
    function openFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const open = params.get('open');
      const id = params.get('id');
      if (!open || !id) return;
      if (open === 'pr') {
        switchSection('pr');
        openPRDetail(id);
      } else if (open === 'dr') {
        switchSection('dr');
        openDRDetail(parseInt(id));
      } else if (open === 'cdr') {
        switchSection('cdr');
        cdrOpenDetail(parseInt(id));
      }
    }

    // Status pre-filter from the URL, e.g. the dashboard's Expansion Opportunity
    // card links to /partnership-requests?status=Pending. Only known statuses apply.
    function applyStatusFromQuery() {
      const status = new URLSearchParams(window.location.search).get('status');
      if (!status) return;
      const btn = Array.from(document.querySelectorAll('#pr-filter-tabs .btn')).find(b => b.textContent.trim() === status);
      if (!btn) return;
      switchSection('pr');
      setPRStatusFilter(status, btn);
    }

    /* ─── LIVE UPDATES ───
       Another reviewer, or the requester, changed a request: re-read both lists from the server (the source of truth), redraw
       the tables and counters, flash the rows that actually changed, and refresh a detail modal that is open on one of them.
       Filters and search text stay as they are. A failed background read leaves what is on screen untouched. */
    var refreshing = false, refreshQueued = false;
    function changedIds(before, after, idOf) {
      const old = new Map(before.map(r => [idOf(r), JSON.stringify(r)]));
      return new Set(after.filter(r => old.get(idOf(r)) !== JSON.stringify(r)).map(idOf));
    }
    function refreshOpenModals() {
      const shown = id => document.getElementById(id) && document.getElementById(id).classList.contains('show');
      if (shown('pr-modal') && currentPRId && prData.some(x => String(x.id) === currentPRId)) openPRDetail(currentPRId);
      if (shown('pr-draft-modal') && currentPRId) { const r = prData.find(x => String(x.id) === currentPRId); if (r) renderDraftTimeline(r); }
      if (shown('dr-modal') && currentDRId) {
        const keep = document.getElementById('dr-received-by').value;
        if (drData.some(x => x.id === currentDRId)) { openDRDetail(currentDRId); document.getElementById('dr-received-by').value = keep; }
      }
      if (shown('dr-draft-modal') && currentDRId) { const r = drData.find(x => x.id === currentDRId); if (r) renderDRDraftTimeline(r); }
    }
    async function refreshLive() {
      if (refreshing) { refreshQueued = true; return true; }
      refreshing = true;
      try {
        const [p, d] = await Promise.all([
          CIPRMS.api('/api/requests', { quiet: true }),
          IS_LAU ? Promise.resolve({ ok: true, data: [] }) : CIPRMS.api('/api/document-requests', { quiet: true })
        ]);
        if (p.ok && Array.isArray(p.data)) {
          const next = p.data.filter(notDraft);
          flashPR = changedIds(prData, next, r => String(r.id));
          prData = next; renderPR(); flashPR = new Set();
        }
        if (d.ok && Array.isArray(d.data)) {
          flashDR = changedIds(drData, d.data, r => r.id);
          drData = d.data; renderDR(); flashDR = new Set();
        }
        updateStats();
        refreshOpenModals();
        return !!(p.ok && d.ok);   // false makes CIPRMS.live retry
      } finally {
        refreshing = false;
        if (refreshQueued) { refreshQueued = false; refreshLive(); }
      }
    }

    async function init() {
      bindDrStatusSelects();
      await Promise.all([loadPR(), loadDR(), cdrLoadList(), cdrLoadDeans()]);
      updateStats();
      openFromQuery();
      applyStatusFromQuery();
      if (window.CIPRMS && CIPRMS.initDropzone) {
        window.prDraftDropzone = CIPRMS.initDropzone({
          container: '#pr-draft-dropzone-wrap',
          input: '#pr-draft-file',
          compact: true,
          title: 'Upload Document',
          desc: 'PDF, JPG, JPEG, or PNG · Max 10MB'
        });
        window.drDraftDropzone = CIPRMS.initDropzone({
          container: '#dr-draft-dropzone-wrap',
          input: '#dr-draft-file',
          compact: true,
          title: 'Upload Document',
          desc: 'PDF, JPG, JPEG, or PNG · Max 10MB'
        });
      }
      if (window.CIPRMS && CIPRMS.live) {
        const events = IS_LAU
          ? ['request.updated', 'request.statusChanged']
          : ['request.updated', 'request.statusChanged', 'documentRequest.updated', 'documentRequest.statusChanged'];
        CIPRMS.live(events, refreshLive, { debounce: 250 });
      }
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>

