<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg"
  data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">

<head>
  <meta charset="utf-8" />
  <%- include('../partials/ui-state-init') %>
  <title>Requests | CIPRMS-CSPC-CIRL</title>
  <meta name="description" content="Manage Partnership Requests and Document Requests for CIPRMS CSPC-CIRL">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/cirl-logo.jpg">
  <script src="/velzon/assets/js/layout.js"></script>
  <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/app.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/ciprms-bridge.css?v=20260925d" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    /* ── Hero Banner ── */
    .pr-hero {
      background: var(--vz-card-bg, #fff);
      border: 1px solid var(--vz-border-color, #e9ecef);
      border-radius: 12px;
      padding: 1.4rem 1.75rem;
      color: var(--vz-body-color, #212529);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .05);
    }

    .pr-hero-icon {
      width: 54px;
      height: 54px;
      background: #eef1fb;
      color: #405189;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      flex-shrink: 0;
    }

    .pr-hero h4 {
      margin: 0;
      font-weight: 700;
      font-size: 1.2rem;
    }

    .pr-hero p {
      margin: .15rem 0 0;
      font-size: .82rem;
      color: var(--vz-secondary-color, #6c757d);
    }

    /* ── Stat cards ── */
    .stat-card {
      border-radius: 12px;
      transition: transform .18s, box-shadow .18s;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .1);
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      flex-shrink: 0;
    }

    /* ── Section Switcher Cards ── */
    .section-tabs {
      display: flex;
      gap: .75rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .section-tab {
      flex: 1 1 200px;
      min-width: 180px;
      max-width: 300px;
      padding: 1rem 1.2rem;
      border-radius: 12px;
      font-size: .84rem;
      font-weight: 600;
      cursor: pointer;
      border: 2px solid #e9ecef;
      transition: all .2s ease;
      display: flex;
      align-items: center;
      gap: .75rem;
      text-decoration: none;
      color: #495057;
      background: #fff;
      box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .section-tab:hover {
      border-color: #405189;
      background: #f0f3ff;
      color: #405189;
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(64,81,137,.12);
    }

    .section-tab.active {
      border-color: #405189;
      background: var(--vz-card-bg, #fff);
      color: #405189;
      box-shadow: 0 4px 14px rgba(64,81,137,.18);
    }

    .section-tab.active .tab-count {
      background: #405189;
      color: #fff;
    }

    .section-tab-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: rgba(255,255,255,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
      transition: background .2s;
    }

    .section-tab:not(.active) .section-tab-icon {
      background: #eef1fb;
      color: #405189;
    }

    .section-tab.active .section-tab-icon {
      background: #405189;
      color: #fff;
    }

    /* DR variant accent */
    .section-tab[id="tab-dr"]:not(.active):hover {
      border-color: #0ab39c;
      background: #f0fdf4;
      color: #0ab39c;
    }
    .section-tab[id="tab-dr"]:not(.active):hover .section-tab-icon {
      background: #d1fae5;
      color: #0ab39c;
    }
    .section-tab[id="tab-dr"].active {
      background: var(--vz-card-bg, #fff);
      color: #0ab39c;
      border-color: #0ab39c;
      box-shadow: 0 4px 14px rgba(10,179,156,.18);
    }
    .section-tab[id="tab-dr"].active .section-tab-icon,
    .section-tab[id="tab-dr"].active .tab-count {
      background: #0ab39c;
      color: #fff;
    }

    .section-tab-body {
      display: flex;
      flex-direction: column;
    }
    .section-tab-title {
      font-size: .88rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .section-tab-desc {
      font-size: .72rem;
      font-weight: 400;
      opacity: .75;
      margin-top: 1px;
    }
    .section-tab .tab-count {
      margin-left: auto;
      background: rgba(255,255,255,.25);
      border-radius: 20px;
      padding: 2px 9px;
      font-size: .75rem;
      font-weight: 700;
      flex-shrink: 0;
    }
    .section-tab:not(.active) .tab-count {
      background: #e2e7f8;
      color: #405189;
    }
    .section-tab[id="tab-dr"]:not(.active) .tab-count {
      background: #d1fae5;
      color: #0ab39c;
    }

    /* CDR (College Requests) variant accent */
    .section-tab[id="tab-cdr"]:not(.active):hover {
      border-color: #6f42c1;
      background: #f5f0fc;
      color: #6f42c1;
    }
    .section-tab[id="tab-cdr"]:not(.active):hover .section-tab-icon {
      background: #e8d9f7;
      color: #6f42c1;
    }
    .section-tab[id="tab-cdr"].active {
      background: var(--vz-card-bg, #fff);
      color: #6f42c1;
      border-color: #6f42c1;
      box-shadow: 0 4px 14px rgba(111,66,193,.18);
    }
    .section-tab[id="tab-cdr"].active .section-tab-icon,
    .section-tab[id="tab-cdr"].active .tab-count {
      background: #6f42c1;
      color: #fff;
    }
    .section-tab[id="tab-cdr"]:not(.active) .tab-count {
      background: #e8d9f7;
      color: #6f42c1;
    }

    /* ── Filter row ── */
    .filter-row {
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .filter-row .form-control,
    .filter-row .form-select {
      border-radius: 8px;
      font-size: .82rem;
    }

    /* ── Table ── */
    .table th {
      font-size: .73rem;
      letter-spacing: .04em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .table td {
      font-size: .84rem;
      vertical-align: middle;
    }

    .badge-type {
      font-size: .73rem;
      border-radius: 6px;
      padding: 3px 9px;
      font-weight: 600;
    }

    /* ── Empty state ── */
    .empty-state {
      padding: 3rem 1rem;
      text-align: center;
      color: #adb5bd;
    }

    .empty-state i {
      font-size: 3rem;
      display: block;
      margin-bottom: .75rem;
    }

    /* ── Modal detail labels ── */
    .detail-label {
      font-size: .72rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: .05em;
      color: #8496af;
      margin-bottom: 3px;
    }

    .detail-value {
      font-weight: 600;
      font-size: .9rem;
      color: #212529;
      overflow-wrap: anywhere; /* a long unbroken institution/document name wraps instead of overflowing the modal */
    }

    .detail-box {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 1rem;
    }

    /* ── Status ribbon ── */
    .status-ribbon {
      display: flex;
      align-items: center;
      gap: .8rem;
      padding: .85rem 1rem;
      border-radius: 10px;
      margin-top: 1rem;
    }

    .status-ribbon i {
      font-size: 1.6rem;
    }

    /* Ribbon colors are per theme: pastel fill + deep text in light mode,
       translucent fill + brighter text in dark mode. */
    .status-ribbon { --rb-bg: #fef3c7; --rb-fg: #d97706; background: var(--rb-bg); border: 1.5px solid color-mix(in srgb, var(--rb-fg) 20%, transparent); }
    .status-ribbon i, .status-ribbon .ribbon-title { color: var(--rb-fg); }
    .ribbon-pending  { --rb-bg: #fef3c7; --rb-fg: #d97706; }
    .ribbon-review   { --rb-bg: #dbeafe; --rb-fg: #1e40af; }
    .ribbon-approved { --rb-bg: #dcfce7; --rb-fg: #15803d; }
    .ribbon-rejected { --rb-bg: #fee2e2; --rb-fg: #b91c1c; }
    [data-bs-theme="dark"] .ribbon-pending  { --rb-bg: rgba(245, 158, 11, .14); --rb-fg: #fbbf24; }
    [data-bs-theme="dark"] .ribbon-review   { --rb-bg: rgba(59, 130, 246, .16); --rb-fg: #7aa7ff; }
    [data-bs-theme="dark"] .ribbon-approved { --rb-bg: rgba(34, 197, 94, .14);  --rb-fg: #4ade80; }
    [data-bs-theme="dark"] .ribbon-rejected { --rb-bg: rgba(239, 68, 68, .15);  --rb-fg: #f87171; }

    /* ── Dark mode overrides ──────────────────────────────────────────────
       This page's own light-only inline colors above (section tabs, detail
       box/value) had no [data-bs-theme="dark"] counterpart, so they stayed
       hardcoded light/white even with Dark Mode on. Values mirror the same
       Velzon dark surface/text tones already used by ciprms-bridge.css's
       dark-mode block (see assets/css/ciprms-bridge.css) for consistency. */
    [data-bs-theme="dark"] .section-tab {
      background: #1e2533;
      color: #ced4da;
      border-color: rgba(255, 255, 255, .12);
    }
    [data-bs-theme="dark"] .section-tab.active {
      background: #1e2533;
      color: #7094f5;
      border-color: #405189;
    }
    [data-bs-theme="dark"] .section-tab[id="tab-dr"].active {
      color: #3bc2b0;
      border-color: #0ab39c;
    }
    [data-bs-theme="dark"] .section-tab:hover {
      background: #262d3d;
      color: #7094f5;
    }
    [data-bs-theme="dark"] .section-tab:not(.active) .section-tab-icon {
      background: rgba(112, 148, 245, .15);
      color: #7094f5;
    }
    [data-bs-theme="dark"] .section-tab[id="tab-dr"]:not(.active):hover {
      background: rgba(10, 179, 156, .12);
      color: #3bc2b0;
    }
    [data-bs-theme="dark"] .section-tab[id="tab-dr"]:not(.active):hover .section-tab-icon {
      background: rgba(10, 179, 156, .18);
      color: #3bc2b0;
    }
    [data-bs-theme="dark"] .section-tab:not(.active) .tab-count {
      background: rgba(112, 148, 245, .18);
      color: #7094f5;
    }
    [data-bs-theme="dark"] .section-tab[id="tab-dr"]:not(.active) .tab-count {
      background: rgba(10, 179, 156, .18);
      color: #3bc2b0;
    }
    [data-bs-theme="dark"] .pr-hero {
      background: #1e2533;
      border-color: rgba(255, 255, 255, .12);
      box-shadow: 0 1px 4px rgba(0, 0, 0, .3);
    }
    /* Text legibility in dark mode: Bootstrap's .text-dark resolves to a
       near-black (unreadable on the dark "Release" badge), and the default
       muted grey (#878a99) is too dim on the dark card surfaces. */
    [data-bs-theme="dark"] .text-dark {
      color: #e9ecef !important;
    }
    [data-bs-theme="dark"] .text-muted {
      color: #b4bccb !important;
    }
    [data-bs-theme="dark"] .pr-hero h4 {
      color: #f1f3f5;
    }
    [data-bs-theme="dark"] .pr-hero p {
      color: #b4bccb;
    }
    [data-bs-theme="dark"] .section-tab-desc {
      opacity: .9;
    }
    [data-bs-theme="dark"] .table td,
    [data-bs-theme="dark"] .table th {
      color: #dee2e6;
    }
    [data-bs-theme="dark"] .badge.bg-light {
      background-color: rgba(255, 255, 255, .1) !important;
      color: #dee2e6 !important;
      border-color: rgba(255, 255, 255, .2) !important;
    }
    [data-bs-theme="dark"] .pr-hero-icon {
      background: rgba(112, 148, 245, .15);
      color: #7094f5;
    }
    [data-bs-theme="dark"] .section-tab.active .tab-count,
    [data-bs-theme="dark"] .section-tab.active .section-tab-icon {
      background: #405189;
      color: #fff;
    }
    [data-bs-theme="dark"] .section-tab[id="tab-dr"].active .tab-count,
    [data-bs-theme="dark"] .section-tab[id="tab-dr"].active .section-tab-icon {
      background: #0ab39c;
      color: #fff;
    }
    [data-bs-theme="dark"] .empty-state {
      color: #6c7a91;
    }
    [data-bs-theme="dark"] .stat-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, .45);
    }
    [data-bs-theme="dark"] .detail-box {
      background: #262d3d;
    }
    [data-bs-theme="dark"] .detail-value {
      color: #e9ecef;
    }
    [data-bs-theme="dark"] .detail-label {
      color: #adb5bd;
    }

    /* ── Toast ── */
    #pr-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      color: #fff;
      padding: .65rem 1.1rem;
      border-radius: .6rem;
      font-size: .82rem;
      font-weight: 600;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .2);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      display: flex;
      align-items: center;
      gap: .4rem;
    }
  
    /* ── View Draft timeline ──
       Each version is a flex row (avatar + card). A flex child will not shrink below its
       content's min-content width unless told it may, so one long UNBROKEN filename or note
       ("Article_4_Duration_and_Termination_…") pushed the card — and its border — far past the
       modal's edge, over the Requests page behind it. min-width:0 lets the card shrink to the
       modal, and overflow-wrap:anywhere wraps the long token inside it. */
    .draft-item { min-width: 0; }
    .draft-card { min-width: 0; overflow-wrap: anywhere; }
    .draft-item .draft-card .btn { overflow-wrap: normal; }
    #draft-preview-modal .modal-body,
    #pr-draft-modal .modal-body,
    #dr-draft-modal .modal-body { overflow-wrap: anywhere; }
    #draft-preview-modal .modal-body img { max-width: 100%; height: auto; }

    /* ── Document Requests: inline Status dropdown (Status column) ──
       Coloured with the same classes as the status badges (statusClasses), so it reads as the same status, with a
       visible caret and a hover ring so it is obvious it can be changed. Compact: a long name such as "Awaiting for
       Approval" is cut with an ellipsis inside the control instead of stretching the table. */
    .dr-status-select {
      width: 100%; min-width: 150px; max-width: 200px; padding: .2rem 1.6rem .2rem .6rem;
      font-size: .75rem; font-weight: 600; line-height: 1.4; cursor: pointer;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      border: 1px solid rgba(0, 0, 0, .14); background-position: right .5rem center; background-size: 12px 10px;
    }
    .dr-status-select:not(:disabled):hover { box-shadow: 0 0 0 .18rem rgba(64, 81, 137, .18); }
    .dr-status-select:disabled { cursor: default; opacity: .8; }
    .dr-status-select.is-busy { cursor: progress; opacity: .6; }
    .dr-status-select option { color: #212529; background: #fff; font-weight: 500; }
    .dr-status-select option:disabled { color: #98a2b3; }
    [data-bs-theme="dark"] .dr-status-select { border-color: rgba(255, 255, 255, .18); }
    [data-bs-theme="dark"] .dr-status-select option { color: #e9ecef; background: #212529; }
    [data-bs-theme="dark"] .dr-status-select option:disabled { color: #6c757d; }

    /* ── Requests modals: a little more room ──
       Partnership Request details + View Draft, and Document Request details + Drafts. All four were a plain
       Bootstrap modal-lg (800px) — wide enough for the fields but tight for tables, filenames, notes and the footer
       buttons. Widened on desktop only (never full-screen; below 992px Bootstrap's own responsive width applies),
       with a little more padding, and the body scrolls INSIDE the modal (capped to the viewport height) instead of
       the whole page scrolling behind it. Sizing/spacing only — the markup, classes and behaviour are unchanged. */
    @media (min-width: 992px) {
      #pr-modal .modal-dialog, #pr-draft-modal .modal-dialog, #dr-modal .modal-dialog, #dr-draft-modal .modal-dialog, #cdr-create-modal .modal-dialog, #cdr-detail-modal .modal-dialog { --vz-modal-width: 960px; }
    }
    @media (min-width: 1400px) {
      #pr-modal .modal-dialog, #pr-draft-modal .modal-dialog, #dr-modal .modal-dialog, #dr-draft-modal .modal-dialog, #cdr-create-modal .modal-dialog, #cdr-detail-modal .modal-dialog { --vz-modal-width: 1040px; }
    }
    #pr-modal .modal-content, #pr-draft-modal .modal-content, #dr-modal .modal-content, #dr-draft-modal .modal-content, #cdr-create-modal .modal-content, #cdr-detail-modal .modal-content { max-height: calc(100vh - 2rem); }
    #pr-modal .modal-body, #pr-draft-modal .modal-body, #dr-modal .modal-body, #dr-draft-modal .modal-body, #cdr-create-modal .modal-body, #cdr-detail-modal .modal-body {
      padding: 1.5rem 1.75rem; overflow-y: auto; overflow-wrap: anywhere; min-width: 0;
    }
    #pr-modal .modal-footer, #pr-draft-modal .modal-footer, #dr-modal .modal-footer, #dr-draft-modal .modal-footer, #cdr-create-modal .modal-footer, #cdr-detail-modal .modal-footer {
      flex-wrap: wrap; gap: .5rem; padding: 1rem 1.75rem;
    }
    /* The header title can carry a long, unbroken institution name. As a flex child it would not shrink below that
       name's width, stretching the header past the screen and pushing the close (X) button out of view. */
    #pr-modal .modal-title, #pr-draft-modal .modal-title, #dr-modal .modal-title, #dr-draft-modal .modal-title, #cdr-create-modal .modal-title, #cdr-detail-modal .modal-title { min-width: 0; overflow-wrap: anywhere; }
    #pr-modal .btn-close, #pr-draft-modal .btn-close, #dr-modal .btn-close, #dr-draft-modal .btn-close, #cdr-create-modal .btn-close, #cdr-detail-modal .btn-close { flex-shrink: 0; }
    @media (max-width: 575.98px) {
      #pr-modal .modal-body, #pr-draft-modal .modal-body, #dr-modal .modal-body, #dr-draft-modal .modal-body, #cdr-create-modal .modal-body, #cdr-detail-modal .modal-body { padding: 1rem; }
      #pr-modal .modal-footer, #pr-draft-modal .modal-footer, #dr-modal .modal-footer, #dr-draft-modal .modal-footer, #cdr-create-modal .modal-footer, #cdr-detail-modal .modal-footer { padding: .75rem 1rem; }
      /* Document Request details laid its fields out as fixed half-width columns even on a phone: one per row there. */
      #dr-modal .modal-body .row > .col-6 { flex: 0 0 100%; max-width: 100%; }
    }

    /* ── College Requests (CDR) tab — required-document chips and status-history timeline ── */
    .cdr-doc-chip {
      display: inline-flex; align-items: center; gap: .4rem; background: #f3f4fa; color: #495057;
      border-radius: 16px; padding: .3rem .8rem; font-size: .8rem; margin: .15rem;
    }
    .cdr-history-item { border-left: 2px solid #e9ebec; padding: .25rem 0 .25rem 1rem; margin-left: .4rem; position: relative; }
    .cdr-history-item::before {
      content: ''; position: absolute; left: -5px; top: .5rem; width: 8px; height: 8px;
      border-radius: 50%; background: #6f42c1;
    }

    /* ── Target College Dean — searchable multi-select with removable chips (2026-11) ── */
    .dean-combo-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .dean-combo-chips:empty { display: none; }
    .dean-chip {
      display: inline-flex; align-items: center; gap: 6px; background: #eef1fb; color: #405189;
      border-radius: 14px; padding: .25rem .5rem .25rem .7rem; font-size: .8rem; font-weight: 500;
    }
    .dean-chip button {
      border: none; background: none; color: #405189; opacity: .65; line-height: 1; font-size: 1rem;
      cursor: pointer; padding: 0 2px;
    }
    .dean-chip button:hover { opacity: 1; }
    .dean-combo-input-wrap { position: relative; }
    .dean-combo-dropdown {
      position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 1065;
      background: #fff; border: 1px solid #e9ebec; border-radius: 8px; box-shadow: 0 10px 28px rgba(0,0,0,.12);
      max-height: 220px; overflow-y: auto;
    }
    .dean-combo-option { padding: .5rem .75rem; font-size: .85rem; cursor: pointer; }
    .dean-combo-option:hover, .dean-combo-option.active { background: #f0f2fb; color: #405189; }
    .dean-combo-option small { display: block; color: #878a99; font-size: .72rem; }
    .dean-combo-empty { padding: 10px; font-size: .8rem; color: #878a99; text-align: center; }
    [data-bs-theme="dark"] .dean-chip { background: rgba(96,126,224,.18); color: #a9bcf5; }
    [data-bs-theme="dark"] .dean-chip button { color: #a9bcf5; }
    [data-bs-theme="dark"] .dean-combo-dropdown { background: #2a2f3c; border-color: #3a4053; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
    [data-bs-theme="dark"] .dean-combo-option { color: #d3d5db; }
    [data-bs-theme="dark"] .dean-combo-option:hover, [data-bs-theme="dark"] .dean-combo-option.active { background: #363c4c; color: #a9bcf5; }
    [data-bs-theme="dark"] .dean-combo-option small { color: #9699a3; }
</style>
</head>

<body>
  <div id="layout-wrapper">
    <%- include('../partials/header') %>
