<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Calendar | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <script src="/velzon/assets/js/layout.js"></script>
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/ciprms-bridge.css?v=20260925d" rel="stylesheet"/>
    <link href="/velzon/assets/libs/dragula/dragula.min.css" rel="stylesheet"/>
    <%- include('../partials/calendar_layout') %>
    <style>
        /* Add Event is a two-step flow (details, then recipients): a slightly wider dialog on desktop so both fit
           comfortably; on small screens Bootstrap's own full-width behaviour applies and the body scrolls inside the
           modal (modal-dialog-scrollable), never outside it. */
        @media (min-width: 992px) { #event-modal .modal-dialog { --vz-modal-width: 920px; } }
        .cal-steps { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
        .cal-step { flex: 1 1 200px; display: flex; align-items: center; gap: .5rem; padding: .5rem .75rem; min-width: 0;
                    border: 1px solid var(--vz-border-color); border-radius: .5rem; font-size: .8125rem; font-weight: 600;
                    color: var(--vz-secondary-color, #878a99); }
        .cal-step-num { flex: none; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center;
                        justify-content: center; font-size: .75rem; background: var(--vz-tertiary-bg, #f3f6f9); }
        .cal-step.active { border-color: var(--vz-primary); color: var(--vz-primary); background: var(--vz-primary-bg-subtle, #e7ebfa); }
        .cal-step.active .cal-step-num { background: var(--vz-primary); color: #fff; }
        .cal-step.done .cal-step-num { background: var(--vz-success, #0ab39c); color: #fff; }
        #rcp-results { max-height: 240px; overflow-y: auto; border: 1px solid var(--vz-border-color); border-radius: .5rem; }
        .rcp-row { display: flex; align-items: center; gap: .75rem; padding: .5rem .75rem; min-width: 0; cursor: pointer;
                   border-bottom: 1px solid var(--vz-border-color); }
        .rcp-row:last-child { border-bottom: 0; }
        .rcp-row:hover, .rcp-row:focus-visible { background: var(--vz-tertiary-bg, #f3f6f9); outline: none; }
        .rcp-row.selected { background: var(--vz-primary-bg-subtle, #e7ebfa); }
        .rcp-text { flex: 1 1 auto; min-width: 0; }
        .rcp-name, .rcp-email { overflow-wrap: anywhere; }
        .rcp-email { font-size: .75rem; color: var(--vz-secondary-color, #878a99); }
        #rcp-selected { display: flex; flex-wrap: wrap; gap: .4rem; max-height: 160px; overflow-y: auto; }
        .rcp-chip { display: inline-flex; align-items: center; gap: .4rem; max-width: 100%; padding: .25rem .3rem .25rem .65rem;
                    border-radius: 2rem; font-size: .8rem; background: var(--vz-primary-bg-subtle, #e7ebfa); color: var(--vz-primary); }
        .rcp-chip > span { min-width: 0; overflow-wrap: anywhere; }
        .rcp-chip button { flex: none; width: 20px; height: 20px; border: 0; border-radius: 50%; line-height: 1; padding: 0;
                           background: rgba(64, 81, 137, .18); color: inherit; cursor: pointer; }

        /* Attendance / Live Check-in modal: a plain 800px modal-lg was too narrow for six columns (name, role, e-mail,
           invitation, status, time joined), so the e-mail wrapped letter by letter. Wider on desktop only (below 992px
           Bootstrap's own responsive width applies), capped to the viewport height, with the attendee list scrolling
           inside its own box (header row stays put) instead of the modal or the page overflowing. Sizing/layout only. */
        @media (min-width: 992px) { #attendance-modal .modal-dialog { --vz-modal-width: 1040px; } }
        @media (min-width: 1400px) { #attendance-modal .modal-dialog { --vz-modal-width: 1160px; } }
        #attendance-modal .modal-content { max-height: calc(100vh - 2rem); }
        #attendance-modal .modal-body { min-width: 0; overflow-y: auto; }
        #attendance-modal .table-responsive { max-height: calc(100vh - 21rem); min-height: 6rem; overflow: auto; }
        #attendance-modal thead th { position: sticky; top: 0; z-index: 1; white-space: nowrap; background: var(--vz-tertiary-bg, #f3f6f9); }
        #attendance-modal td { overflow-wrap: anywhere; }
        #attendance-modal td:nth-child(3) { min-width: 14rem; }          /* e-mail: long addresses stay on few lines */
        #attendance-modal td:nth-child(6), #attendance-modal td:nth-child(5) { white-space: nowrap; overflow-wrap: normal; }
        @media (max-width: 575.98px) {
          #attendance-modal .modal-body { padding: 1rem !important; }
          #attendance-modal .table-responsive { max-height: calc(100vh - 17rem); }
        }
    </style>
</head>
<body>
<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                            <h4 class="mb-sm-0">Calendar</h4>
                            <div class="page-title-right">
                                <ol class="breadcrumb m-0" id="page-breadcrumb">
                                    <li class="breadcrumb-item"><a href="<%= typeof homeHref !== 'undefined' ? homeHref : '/dashboard' %>">CIPRMS</a></li>
                                    <li class="breadcrumb-item active">Calendar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="row">

                            <!-- col-xl-3 sidebar — exact from apps-calendar.html -->
                            <% var canManageCalendar = typeof user !== 'undefined' && user && (user.role === 'Administrator' || user.role === 'Staff'); %>
                            <div class="col-xl-3 cal-side">
                                <% if (canManageCalendar) { %>
                                <div class="card">
                                    <div class="card-body">
                                        <button class="btn btn-primary w-100" id="btn-new-event">
                                            <i class="mdi mdi-plus"></i> Create New Event
                                        </button>
                                        <div id="external-events">
                                            <br>
                                            <p class="text-muted">Drag and drop your event or click in the calendar</p>
                                            <div class="external-event fc-event bg-success-subtle text-success" data-class="bg-success-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Renewal</div>
                                            <div class="external-event fc-event bg-danger-subtle text-danger" data-class="bg-danger-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Expiry / Deadline</div>
                                            <div class="external-event fc-event bg-primary-subtle text-primary" data-class="bg-primary-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Meeting</div>
                                            <div class="external-event fc-event bg-warning-subtle text-warning" data-class="bg-warning-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Mobility / Exchange</div>
                                            <div class="external-event fc-event bg-info-subtle text-info" data-class="bg-info-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Partnership Review</div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                <div class="cal-upcoming">
                                    <h5 class="mb-1">Upcoming Events</h5>
                                    <p class="text-muted">Don't miss scheduled events</p>
                                    <div class="cal-upcoming-scroll pe-2 me-n1">
                                        <div id="upcoming-event-list"></div>
                                    </div>
                                </div>

                                <% /* Approval Progress — College Dean only (2026-11), moved here from the College Dean's
                                     own Monitoring page, directly under Upcoming Events. Same data source and calculation
                                     (GET /api/document-requests/mine, "Approved" = that status or anything past it in the
                                     6-stage workflow) as before — see loadApprovalProgress() below — this template is
                                     shared by every role's Calendar, so the card itself is gated the same way the
                                     Administrator/Staff-only "Create New Event" controls above already are. */ %>
                                <% if (typeof user !== 'undefined' && user && user.role === 'Auth. Personnel') { %>
                                <div class="card">
                                    <div class="card-header"><h5 class="card-title mb-0 fs-14"><i class="ri-progress-4-line me-2"></i>Approval Progress</h5></div>
                                    <div class="card-body" id="approval-progress-body">
                                        <div class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></div>
                                    </div>
                                </div>
                                <% } %>

                                <div class="card">
                                    <div class="card-body bg-info-subtle">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0">
                                                <i data-feather="calendar" class="text-info icon-dual-info"></i>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="fs-15">Partnership Calendar</h6>
                                                <% if (canManageCalendar) { %>
                                                <p class="text-muted mb-0">Click a date or drag an event type onto the calendar. Click events to view, edit, or delete.</p>
                                                <% } else { %>
                                                <p class="text-muted mb-0">Click an event to view its details.</p>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- end col-xl-3 -->

                            <!-- col-xl-9 main calendar — exact from apps-calendar.html -->
                            <div class="col-xl-9">
                                <div id="cal-notice"></div>
                                <div class="card cal-card">
                                    <div class="card-body">
                                        <div id="calendar"></div>
                                    </div>
                                </div>
                            </div><!-- end col-xl-9 -->
                        </div><!-- end row -->

                        <div style="clear:both"></div>

                        <!-- Event Modal — same structure as apps-calendar.html -->
                        <div class="modal fade" id="event-modal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                                <div class="modal-content border-0">
                                    <div class="modal-header p-3 bg-info-subtle">
                                        <h5 class="modal-title" id="modal-title">Event</h5>
                                        <span class="badge bg-success-subtle text-success ms-2 d-none" id="v-gcal-badge" title="Recipients were invited via Google Calendar"><i class="ri-google-fill me-1"></i>Synced to Google Calendar</span>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <!-- View mode -->
                                        <!-- Add Event only: where the person is in the two-step flow -->
                                        <div class="cal-steps d-none" id="cal-steps" aria-label="Add event steps">
                                            <div class="cal-step active" id="cal-step-1"><span class="cal-step-num">1</span><span>Step 1: Event Details</span></div>
                                            <div class="cal-step" id="cal-step-2"><span class="cal-step-num">2</span><span>Step 2: Recipients</span></div>
                                        </div>
                                        <div id="view-mode">
                                            <div class="d-flex mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-calendar-event-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-date"></h6></div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-time-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-time"></h6></div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2 d-none" id="v-eventtype-row">
                                                <div class="flex-shrink-0 me-3"><i class="ri-price-tag-3-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><span class="badge bg-secondary-subtle text-secondary" id="v-eventtype-badge"></span></div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-map-pin-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-location"></h6></div>
                                            </div>
                                            <div class="d-flex mb-3">
                                                <div class="flex-shrink-0 me-3"><i class="ri-discuss-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><p class="text-muted mb-0" id="v-desc"></p></div>
                                            </div>
                                            <%- include('../partials/meeting_join') %>
                                            <div class="d-none mb-3" id="v-invites">
                                                <div class="d-flex align-items-start">
                                                    <div class="flex-shrink-0 me-3"><i class="ri-team-line text-muted fs-16"></i></div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="fw-semibold mb-1" id="v-invite-summary"></h6>
                                                        <div class="alert alert-warning py-2 px-3 fs-12 mb-2 d-none" id="v-invite-warning"></div>
                                                        <button type="button" class="btn btn-sm btn-soft-primary" id="btn-attendance"><i class="ri-list-check-2 align-bottom me-1"></i>View attendance</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Edit/Add form -->
                                        <div id="edit-mode" class="d-none">
                                            <!-- Shown when Save is clicked on a new event with required fields left empty -->
                                            <div class="alert alert-danger py-2 px-3 fs-13 d-none" id="f-missing-alert" role="alert"></div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-7">
                                                    <label class="form-label">Calendar Color <span class="text-danger">*</span></label>
                                                    <select class="form-select" id="f-type">
                                                        <option value="">Select a color</option>
                                                        <option value="bg-primary-subtle">Meeting</option>
                                                        <option value="bg-danger-subtle">Expiry / Deadline</option>
                                                        <option value="bg-success-subtle">Renewal</option>
                                                        <option value="bg-warning-subtle">Mobility / Exchange</option>
                                                        <option value="bg-info-subtle">Partnership Review</option>
                                                    </select>
                                                    <div class="invalid-feedback">Please select a calendar color.</div>
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label">Date <span class="text-danger">*</span></label>
                                                    <input type="date" class="form-control" id="f-date">
                                                    <div class="invalid-feedback" id="f-date-error">Please choose the date.</div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Event Name <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="f-title">
                                                <div class="invalid-feedback">Please provide an event name.</div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Event Type <span class="text-danger">*</span></label>
                                                <select class="form-select" id="f-event-type">
                                                    <option value="">Select event type</option>
                                                    <option value="Meeting">Meeting</option>
                                                    <option value="Physical Meeting">Physical Meeting</option>
                                                    <option value="Online Meeting">Online Meeting</option>
                                                    <option value="Conference">Conference</option>
                                                    <option value="Seminar">Seminar</option>
                                                    <option value="Workshop">Workshop</option>
                                                    <option value="Institutional Activity">Institutional Activity</option>
                                                    <option value="Partnership Activity">Partnership Activity</option>
                                                    <option value="Consultation">Consultation</option>
                                                    <option value="__custom__">Other / Custom&hellip;</option>
                                                </select>
                                                <div class="invalid-feedback">Please select or enter an event type.</div>
                                                <input type="text" class="form-control mt-2 d-none" id="f-event-type-custom" maxlength="80" placeholder="Enter a custom event type">
                                            </div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-sm-6">
                                                    <label class="form-label">Start Time <span class="text-danger">*</span></label>
                                                    <input type="time" class="form-control" id="f-start">
                                                    <div class="invalid-feedback">Please set the start time.</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label">End Time <span class="text-danger">*</span></label>
                                                    <input type="time" class="form-control" id="f-end">
                                                    <div class="invalid-feedback" id="f-end-feedback">Please set the end time.</div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" id="f-location-label" for="f-location">Institution / Location <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="f-location">
                                                <div class="invalid-feedback">Please enter the institution or location.</div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Notes</label>
                                                <textarea class="form-control" id="f-desc" rows="3"></textarea>
                                            </div>
                                            <div class="mb-2" id="f-recipients-wrap">
                                                <label class="form-label" id="f-recipients-label">Notify Recipients <span class="text-muted fw-normal">(Optional)</span></label>
                                                <select class="form-select" id="f-recipients" multiple size="8">
                                                    <optgroup label="Roles">
                                                        <option value="all">All Users</option>
                                                        <option value="Administrator">Administrators</option>
                                                        <option value="Auth. Personnel">College Dean</option>
                                                        <option value="potential_partner">Partner</option>
                                                        <option value="Staff">CIRL Staff</option>
                                                    </optgroup>
                                                    <optgroup label="Individual Users" id="f-recipients-individuals"></optgroup>
                                                </select>
                                                <div class="form-text" id="f-recipients-help">Ctrl/Cmd-click to select multiple. Only the users selected here will be notified and e-mailed a Google Calendar invitation. Leave blank to create the event without notifying anyone.</div>
                                            </div>
                                        </div>
                                        <!-- Add Event, step 2: who to notify. Search runs on the user list already loaded from /api/users. -->
                                        <div id="step-recipients" class="d-none">
                                            <label class="form-label" for="rcp-search">Search recipients by email address <span class="text-muted fw-normal">(Optional)</span></label>
                                            <div class="position-relative search-box mb-2">
                                                <input type="text" class="form-control" id="rcp-search" autocomplete="off" aria-controls="rcp-results">
                                                <i class="ri-search-line search-icon"></i>
                                            </div>
                                            <div id="rcp-results" role="listbox" aria-label="Matching users" aria-multiselectable="true"></div>
                                            <div class="form-text mb-3" id="rcp-hint">Click a person to add or remove them. Only the people selected here are notified and e-mailed a Google Calendar invitation.</div>
                                            <div class="mb-3">
                                                <div class="fs-13 fw-semibold mb-1">Or notify a whole group</div>
                                                <div class="d-flex flex-wrap gap-2" id="rcp-groups"></div>
                                            </div>
                                            <div>
                                                <div class="fs-13 fw-semibold mb-1">Selected recipients <span class="badge bg-primary-subtle text-primary ms-1" id="rcp-count">0</span></div>
                                                <div id="rcp-selected" aria-live="polite"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-soft-danger d-none" id="btn-delete"><i class="ri-close-line"></i> Delete</button>
                                        <button type="button" class="btn btn-soft-primary d-none" id="btn-edit-toggle"><i class="ri-edit-line"></i> Edit</button>
                                        <button type="button" class="btn btn-light d-none" id="btn-back"><i class="ri-arrow-left-line align-bottom me-1"></i>Back</button>
                                        <button type="button" class="btn btn-primary d-none" id="btn-next">Next<i class="ri-arrow-right-line align-bottom ms-1"></i></button>
                                        <button type="button" class="btn btn-success d-none" id="btn-save"><i class="ri-save-line"></i> Save</button>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end modal -->

                        <!-- Attendance modal: who was invited and who actually joined (server-recorded time) -->
                        <div class="modal fade" id="attendance-modal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content border-0">
                                    <div class="modal-header p-3 bg-info-subtle">
                                        <h5 class="modal-title" id="attendance-title">Attendance</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <p class="text-muted fs-13 mb-3" id="attendance-meta"></p>
                                        <div class="alert alert-warning py-2 px-3 fs-12 d-none" id="attendance-warning"></div>
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light"><tr><th>Name</th><th>Role</th><th>Email</th><th>Invitation</th><th>Status</th><th>Time Joined</th></tr></thead>
                                                <tbody id="attendance-body"></tbody>
                                            </table>
                                        </div>
                                        <%- /* 2026-10-08: Google Meet access-tracking investigation — the only join event CIPRMS can ever see is a
                                             click on its own Join button (the one thing that reaches this server); someone who opens the Google
                                             Calendar invitation e-mail's own Meet button, or opens the meeting link directly, joins without CIPRMS
                                             knowing. Said plainly here instead of letting "Joined" read as a verified Google Meet attendance count. */ %>
                                        <p class="text-muted fs-12 mt-3 mb-0">Invited means the user was added to the meeting; Joined means they clicked this app's Join button once the meeting started — the time shown is recorded by the server. CIPRMS can only see joins through that button: someone who opened the Google Meet link directly (e.g. from the Google Calendar invitation e-mail) without clicking it here will not appear as Joined.</p>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end attendance modal -->

                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script src="/velzon/assets/libs/fullcalendar/index.global.min.js"></script>
<script src="/velzon/assets/libs/dragula/dragula.min.js"></script>

<script>
(function(){

// Auth. Personnel lost calendar create/edit/delete 2026-07-23 — view-only
// unless another existing permission explicitly grants editing (currently
// none does). Administrator keeps full management, unchanged. Staff gained
// the same full management as Administrator 2026-09-14 (requireStaffAccess
// now gates the create/edit/delete API routes too — see cirl.js).
var CAN_MANAGE = <%- JSON.stringify(canManageCalendar) %>;

var cal, bsModal, attendanceModal, currentEv = null, isAdding = false, saving = false, pendingRequestId = null;

// â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function str_dt(dt){
  if(!dt) return '';
  return dt.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
}
function str_tm(dt){
  if(!dt) return '';
  return dt.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
}
function str_tm_input(dt){
  if(!dt) return '';
  return String(dt.getHours()).padStart(2,'0')+':'+String(dt.getMinutes()).padStart(2,'0');
}
// Local calendar date for a date <input>. (toISOString().slice(0,10) gave the
// UTC date, which is the PREVIOUS day for any event before 08:00 Manila time —
// editing such an event silently moved it a day earlier.)
function str_date_input(dt){
  if(!dt) return '';
  return dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+'-'+String(dt.getDate()).padStart(2,'0');
}
// Wall-clock string in the SAME shape the Add/Edit form saves ("2026-09-29T21:44"
// or "2026-09-29" for all-day). Drag-and-drop used to save toISOString() (a UTC
// instant) instead, so one event could end up stored in two different formats.
function fc_wall(dt, allDay){
  var date = str_date_input(dt);
  return allDay ? date : date + 'T' + str_tm_input(dt);
}
function esc(str){ return String(str==null?'':str).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
// Today's calendar date (YYYY-MM-DD) on the browser's clock — the earliest date a NEW event may be given.
function todayDateStr(){ return str_date_input(new Date()); }
// New events only: the date picker greys out every day before today (the native `min`), and a past date typed in by
// hand is flagged inline. Editing an existing event removes the limit again — a historical event stays editable.
function setDateMin(limitToToday){
  var el = document.getElementById('f-date');
  if(limitToToday) el.min = todayDateStr(); else el.removeAttribute('min');
  el.classList.remove('is-invalid');
}
function validateNewEventDate(){
  var el = document.getElementById('f-date');
  var bad = isAdding && !!el.value && el.value < todayDateStr();
  if(bad) document.getElementById('f-date-error').textContent = 'Past dates cannot be selected. Please choose today or a future date.';
  el.classList.toggle('is-invalid', bad);
  return !bad;
}
// ── Add Event is two steps: 1) event details, 2) recipients ─────────────────────────────────────────────────────
// Next validates the details and only switches panels — nothing is sent. Save (step 2) is the one and only create
// request, with the same clientRequestId de-duplication and in-flight guard as before. Editing an existing event is
// NOT part of this flow: it keeps its single form and Save.
var addStep = 1, allUsers = [], selectedRecipients = [];
var RECIPIENT_GROUPS = [['all', 'All Users'], ['Administrator', 'Administrators'], ['Auth. Personnel', 'College Dean'], ['potential_partner', 'Partner'], ['Staff', 'CIRL Staff']];
var ROLE_LABELS = { 'Administrator': 'Administrator', 'Auth. Personnel': 'College Dean', 'potential_partner': 'Partner', 'Staff': 'CIRL Staff' };

function toggleRecipient(value, label){
  var i = selectedRecipients.findIndex(function(r){ return r.value === value; });
  if(i >= 0) selectedRecipients.splice(i, 1); else selectedRecipients.push({ value: value, label: label });
  renderRecipients();
}
function renderRecipients(){
  var q = document.getElementById('rcp-search').value.trim().toLowerCase();
  var chosen = {}; selectedRecipients.forEach(function(r){ chosen[r.value] = true; });
  var matches = allUsers.filter(function(u){
    return u.email && (!q || u.email.toLowerCase().indexOf(q) >= 0 || String(u.name || '').toLowerCase().indexOf(q) >= 0);
  });
  var shown = matches.slice(0, 50);
  var html = shown.map(function(u){
    var on = !!chosen[u.email], role = ROLE_LABELS[u.role] || u.role || '';
    return '<div class="rcp-row' + (on ? ' selected' : '') + '" role="option" tabindex="0" aria-selected="' + on + '" data-email="' + esc(u.email) + '">' +
      '<div class="rcp-text"><div class="rcp-name fw-medium fs-13">' + esc(u.name || u.email) + '</div><div class="rcp-email">' + esc(u.email) + '</div></div>' +
      (role ? '<span class="badge bg-light text-body flex-shrink-0">' + esc(role) + '</span>' : '') +
      '<i class="ri-' + (on ? 'checkbox-circle-fill text-primary' : 'add-circle-line text-muted') + ' fs-18 flex-shrink-0"></i></div>';
  }).join('');
  if(!shown.length) html = '<div class="text-muted fs-13 p-3">' + (allUsers.length ? 'No users match “' + esc(q) + '”.' : 'No users are available to select.') + '</div>';
  else if(matches.length > shown.length) html += '<div class="text-muted fs-12 p-2 text-center">Showing the first ' + shown.length + ' of ' + matches.length + ' — keep typing to narrow the list.</div>';
  document.getElementById('rcp-results').innerHTML = html;

  document.getElementById('rcp-groups').innerHTML = RECIPIENT_GROUPS.map(function(g){
    var on = !!chosen[g[0]];
    return '<button type="button" class="btn btn-sm ' + (on ? 'btn-primary' : 'btn-outline-primary') + '" aria-pressed="' + on + '" data-group="' + esc(g[0]) + '">' + esc(g[1]) + '</button>';
  }).join('');

  document.getElementById('rcp-count').textContent = selectedRecipients.length;
  document.getElementById('rcp-selected').innerHTML = selectedRecipients.length
    ? selectedRecipients.map(function(r){
        return '<span class="rcp-chip"><span>' + esc(r.label) + '</span><button type="button" data-remove="' + esc(r.value) + '" aria-label="Remove ' + esc(r.label) + '">&times;</button></span>';
      }).join('')
    : '<span class="text-muted fs-13">No recipients selected — the event will be created without notifying anyone.</span>';
}
function showStep(n){
  addStep = n;
  var two = n === 2;
  document.getElementById('edit-mode').classList.toggle('d-none', two);
  document.getElementById('step-recipients').classList.toggle('d-none', !two);
  document.getElementById('btn-next').classList.toggle('d-none', two);
  document.getElementById('btn-back').classList.toggle('d-none', !two);
  document.getElementById('btn-save').classList.toggle('d-none', !two);
  var s1 = document.getElementById('cal-step-1'), s2 = document.getElementById('cal-step-2');
  s1.classList.toggle('active', !two); s1.classList.toggle('done', two);
  s2.classList.toggle('active', two);
  setBreadcrumb(two ? ['Calendar', 'New Event', 'Recipients'] : ['Calendar', 'New Event']);
  if(two){ renderRecipients(); document.getElementById('rcp-search').focus(); }
}
// Leaves the Add wizard chrome behind (view / edit use the modal as before).
function leaveWizard(){
  ['cal-steps', 'step-recipients', 'btn-next', 'btn-back'].forEach(function(id){ document.getElementById(id).classList.add('d-none'); });
}
// Reads and checks the event details (step 1's fields). Returns them, or null after telling the person what is wrong.
// Used by Next (add) and by Save (edit, and the final Save of add) — the same checks in one place.
function readEventDetails(){
  var title  = document.getElementById('f-title').value.trim();
  var date   = document.getElementById('f-date').value;
  var tinput = document.getElementById('f-title');
  // A new event needs every field except Notes and Recipients (highlighted + listed in the warning); editing an
  // existing event keeps the lighter name + date check, since older events may lack some fields.
  if(isAdding){
    if(!checkRequiredNewEventFields()){ showToast('<i class="ri-error-warning-line me-1"></i>Please fill in all required fields to create the event.', '#f06548'); return null; }
  } else {
    if(!title || !date){ tinput.classList.add('is-invalid'); if(!title) tinput.focus(); else document.getElementById('f-date').focus(); return null; }
    tinput.classList.remove('is-invalid');
  }
  // A brand-new event's date must be today or later — flagged inline on the date field (a date typed by hand is
  // not stopped by the picker's `min`), and nothing is sent.
  if(isAdding && !validateNewEventDate()){ document.getElementById('f-date').focus(); showToast('Past dates cannot be selected. Please choose today or a future date.', '#f06548'); return null; }
  var st = document.getElementById('f-start').value, et = document.getElementById('f-end').value;
  if(st && et && et <= st){
    var endEl = document.getElementById('f-end');
    document.getElementById('f-end-feedback').textContent = 'The end time must be after the start time.';
    endEl.classList.add('is-invalid'); endEl.focus();
    showToast('The end time must be after the start time.', '#f06548');
    return null;
  }
  // Only a brand-new event is checked — editing/dragging an existing (possibly now-historical) event is unaffected.
  if(isAdding && isPastNewEvent(date, st)){ showToast('This date/time has already passed. Please choose a future date and time.', '#f06548'); return null; }
  return {
    title: title, st: st, allDay: !st,
    start: st ? date + 'T' + st : date, end: et ? date + 'T' + et : null,
    cls: document.getElementById('f-type').value,
    eventType: resolvedEventType(),
    loc: document.getElementById('f-location').value.trim(),
    desc: document.getElementById('f-desc').value.trim()
  };
}

// The Event Type field is a native <select> (predefined types, searchable by typing in every
// browser) plus an "Other / Custom…" option that reveals a free-text input — resolvedEventType()
// is the one place that turns either into the single string actually saved.
function resolvedEventType(){
  var sel = document.getElementById('f-event-type').value;
  if(sel === '__custom__') return document.getElementById('f-event-type-custom').value.trim();
  return sel;
}

// Physical Meeting has no virtual link, so its "location" is really a venue — relabel the existing
// Institution/Location field rather than adding a second, overlapping field for the same purpose.
function updateLocationLabelForEventType(){
  var label = document.getElementById('f-location-label');
  if(!label) return;
  label.innerHTML = resolvedEventType() === 'Physical Meeting'
    ? 'Venue <span class="text-muted fw-normal">(Building / Room / Office)</span> <span class="text-danger">*</span>'
    : 'Institution / Location <span class="text-danger">*</span>';
}

function onEventTypeChange(){
  var sel = document.getElementById('f-event-type').value;
  var customInput = document.getElementById('f-event-type-custom');
  if(sel === '__custom__'){
    customInput.classList.remove('d-none');
    customInput.focus();
  } else {
    customInput.classList.add('d-none');
    customInput.value = '';
  }
  updateLocationLabelForEventType();
}
// Client-side approximation only (compares against the BROWSER's local clock, not APP_TIMEZONE) — a quick, friendly
// "that's already passed" before ever hitting the network. The server (isNewEventInThePast in cirl.js, Asia/Manila /
// APP_TIMEZONE) is the authoritative check and cannot be bypassed by skipping this one. An all-day event compares by
// CALENDAR DATE only, so "today" is never rejected just because today's midnight has already gone by.
function isPastNewEvent(dateStr, startStr){
  if(!dateStr) return false;
  var now = new Date();
  if(!startStr){
    var todayStr = now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');
    return dateStr < todayStr;
  }
  var d = dateStr.split('-'), t = startStr.split(':');
  var candidate = new Date(+d[0], +d[1]-1, +d[2], +t[0], +t[1]);
  return candidate < now;
}

// â”€â”€ Breadcrumb â”€â”€ reflects whichever event is currently open, e.g. CIPRMS > Calendar >
// <event title> [> Attendance]. swappingToAttendance guards event-modal's existing
// hidden.bs.modal handler (below) so hiding it to make way for Attendance doesn't
// stomp the breadcrumb Attendance just set.
var HOME_HREF = '<%= typeof homeHref !== "undefined" ? homeHref : "/dashboard" %>';
var swappingToAttendance = false;
function setBreadcrumb(labels) {
  var ol = document.getElementById('page-breadcrumb');
  if (!ol) return;
  var html = '<li class="breadcrumb-item"><a href="' + HOME_HREF + '">CIPRMS</a></li>';
  labels.forEach(function (label, i) {
    var isLast = i === labels.length - 1;
    html += isLast
      ? '<li class="breadcrumb-item active">' + esc(label) + '</li>'
      : '<li class="breadcrumb-item"><a href="' + window.location.pathname + '">' + esc(label) + '</a></li>';
  });
  ol.innerHTML = html;
}
function resetBreadcrumb() { setBreadcrumb(['Calendar']); }

// Show a just-saved event. It is attached to the calendar's own event source (the /api/calendarevents
// feed): FullCalendar wipes and reloads a source's events on every fetch — which happens whenever
// you page to another month — so the saved event is then replaced by the feed's copy of itself. A
// source-less cal.addEvent() copy was never replaced, so paging away and back showed the same event
// twice (one of them a phantom that Delete could not remove until a refresh).
function addSavedEvent(doc){
  if(cal.getEventById(String(doc.id))) return null;
  return cal.addEvent(docToFcEvent(doc), cal.getEventSources()[0]);
}
// One token per Save / palette drop, so a repeated request for the same action
// is recognised by the server and cannot create a second event.
function newRequestId(){
  if(window.crypto && crypto.randomUUID) return crypto.randomUUID();
  return 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
}

// Result of a create/update: what Google Calendar did, and anyone who could not be e-mailed.
function reportInvitations(inv, doneText){
  var toast = doneText;
  var lines = [];
  if(inv && inv.invited){
    if(inv.google === 'sent') toast += ' Google Calendar is e-mailing the invitation to ' + inv.googleAttendees + ' attendee' + (inv.googleAttendees === 1 ? '' : 's') + '.';
    else if(inv.google === 'not_connected') lines.push('Google Calendar is not connected, so no invitation e-mails were sent. Connect it under Settings \u2192 Integrations.');
    else if(inv.google === 'failed') lines.push('Google Calendar did not send the invitation: ' + esc(inv.error || 'unknown error'));
    else if(inv.google === 'no_valid_attendees') lines.push('None of the invited users has a valid e-mail address, so no Google Calendar invitation was sent.');
  }
  ((inv && inv.skipped) || []).forEach(function(s){
    lines.push('Not e-mailed: <strong>' + esc(s.name || s.email || 'Unknown user') + '</strong>' + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason));
  });
  showToast('<i class="ri-checkbox-circle-line me-1"></i>' + esc(toast));
  var box = document.getElementById('cal-notice');
  if(!box) return;
  box.innerHTML = lines.length
    ? '<div class="alert alert-warning alert-dismissible fade show" role="alert"><strong>' + esc(doneText.replace(/\.$/, '')) + ', but:</strong><br>' + lines.join('<br>') + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>'
    : '';
}

function renderInvitationPanel(ev){
  var ep = ev.extendedProps, box = document.getElementById('v-invites');
  var count = CAN_MANAGE ? (ep.participantCount || 0) : 0;
  box.classList.toggle('d-none', !count);
  if(!count) return;
  document.getElementById('v-invite-summary').textContent = count + ' invited' + (ep.joinedCount ? ' \u00b7 ' + ep.joinedCount + ' joined' : '');
  var warn = [];
  if(!ep.googleEventId){
    var st = ep.googleSyncStatus;
    warn.push(st === 'not_connected' ? 'Google Calendar is not connected \u2014 no invitation e-mails were sent.'
      : st === 'failed' ? 'Google Calendar did not send the invitation: ' + esc(ep.googleSyncError || 'unknown error')
      : st === 'no_valid_attendees' ? 'No invited user has a valid e-mail address \u2014 no Google Calendar invitation was sent.'
      : 'No Google Calendar invitation was sent for this event.');
  }
  (ep.inviteSkipped || []).forEach(function(s){
    warn.push('Not e-mailed: ' + esc(s.name || s.email || 'Unknown user') + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason));
  });
  var w = document.getElementById('v-invite-warning');
  w.innerHTML = warn.join('<br>');
  w.classList.toggle('d-none', !warn.length);
}

function saveMove(dbId, updates, info){
  apiPatch(dbId, updates).then(function(data){
    if(!data.success){ info.revert(); showToast(data.error || 'Could not move the event.', '#f06548'); return; }
    syncFromServer(info.event, data.event);
    reportInvitations(data.invitations, 'Event updated.');
    upcomingEvent();
  }).catch(function(){ info.revert(); showToast('Error saving event.', '#f06548'); });
}

function openAttendance(){
  if(!currentEv) return;
  var id = currentEv.extendedProps.dbId || currentEv.id;
  fetch('/api/calendarevents/' + id + '/attendance').then(function(r){ return r.json(); }).then(function(d){
    if(d.error){ showToast(d.error, '#f06548'); return; }
    document.getElementById('attendance-title').textContent = d.event.title + ' \u2014 Attendance';
    document.getElementById('attendance-meta').textContent = (d.event.startsAtDisplay ? 'Starts ' + d.event.startsAtDisplay + ' (' + d.timeZone + '). ' : '') + d.summary.joined + ' of ' + d.summary.invited + ' invited participant' + (d.summary.invited === 1 ? '' : 's') + ' joined via CIPRMS.';
    var warn = [];
    if(d.google.status !== 'sent') warn.push(d.google.status === 'not_connected' ? 'Google Calendar is not connected \u2014 no invitation e-mails were sent.' : d.google.status === 'failed' ? 'Google Calendar did not send the invitation: ' + esc(d.google.error || 'unknown error') : 'No Google Calendar invitation was sent for this event.');
    (d.skipped || []).forEach(function(s){ warn.push('Not e-mailed: ' + esc(s.name || s.email || 'Unknown user') + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason)); });
    var w = document.getElementById('attendance-warning'); w.innerHTML = warn.join('<br>'); w.classList.toggle('d-none', !warn.length);
    document.getElementById('attendance-body').innerHTML = d.participants.length ? d.participants.map(function(p){
      var joined = p.status === 'Joined';
      // A re-open (clicked Join again later, e.g. after dropping off and coming back) shows a small note next
      // to the first join time instead of a whole extra column \u2014 nothing to say when it never happened.
      var reaccess = joined && p.lastAccessDisplay ? ' <span class="text-muted fs-11">(reopened ' + esc(p.lastAccessDisplay) + ')</span>' : '';
      return '<tr><td>' + esc(p.name) + '</td><td>' + esc(p.role) + '</td><td class="text-break">' + esc(p.email) + '</td><td>' + esc(p.invitation) + '</td>'
        + '<td><span class="badge ' + (joined ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary') + '" title="' + (joined ? 'Joined via CIPRMS\u2019 own Join button \u2014 not a Google Meet participation record' : 'No CIPRMS Join click was recorded for this person') + '">' + esc(p.status) + '</span></td>'
        + '<td' + (joined ? ' title="' + esc(p.joinedDateDisplay) + ' (' + esc(d.timeZone) + ')"' : '') + '>' + (joined ? esc(p.joinedAtDisplay) : '\u2014') + reaccess + '</td></tr>';
    }).join('') : '<tr><td colspan="6" class="text-muted text-center">Nobody was invited to this event.</td></tr>';
    setBreadcrumb(['Calendar', d.event.title, 'Attendance']);
    swappingToAttendance = true;
    bsModal.hide();
    attendanceModal.show();
  }).catch(function(){ showToast('Could not load the attendance list.', '#f06548'); });
}

// After the server answers a move/edit, keep the calendar's copy of the event in step.
function syncFromServer(fcEvent, doc){
  if(!doc) return;
  fcEvent.setExtendedProp('googleEventId', doc.googleEventId || null);
  fcEvent.setExtendedProp('googleSyncStatus', doc.googleSyncStatus || null);
  fcEvent.setExtendedProp('googleSyncError', doc.googleSyncError || null);
  fcEvent.setExtendedProp('inviteSkipped', doc.inviteSkipped || []);
  fcEvent.setExtendedProp('participantCount', (doc.participantEmails || []).length || fcEvent.extendedProps.participantCount || 0);
}

// â”€â”€ Upcoming events sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function upcomingEvent(){
  if(!cal) return;
  var now = new Date();
  var evs = cal.getEvents().filter(function(e){ return e.start && e.start >= now; })
              .sort(function(a,b){ return a.start - b.start; }).slice(0,10);
  var html = '';
  evs.forEach(function(e){
    var cls = e.classNames[0] || 'bg-primary-subtle';
    var tc  = cls.replace('-subtle','').replace('bg-','text-');
    html += '<div class="card mb-2"><div class="card-body p-3">'
      + '<div class="d-flex mb-1"><div class="flex-grow-1"><i class="mdi mdi-checkbox-blank-circle me-2 '+tc+'"></i>'
      + '<span class="fw-medium">'+str_dt(e.start)+'</span></div>'
      + '<div class="flex-shrink-0"><small class="badge bg-primary-subtle text-primary ms-auto">'+str_tm(e.start)+'</small></div></div>'
      + '<h6 class="card-title fs-14 mb-1">'+e.title+'</h6>'
      + '<p class="text-muted text-truncate mb-0 fs-12">'+(e.extendedProps.description||'')+'</p>'
      + '</div></div>';
  });
  document.getElementById('upcoming-event-list').innerHTML = html || '<p class="text-muted fs-12">No upcoming events.</p>';
}

// ── Approval Progress (College Dean only) ─────────────────────────────────────
// Moved here from the College Dean's own Monitoring page (2026-11), under Upcoming Events — #approval-
// progress-body only exists in the DOM when this template rendered it (the EJS role guard above), so this
// is a no-op on every other role's Calendar. Same endpoint and exact same 6-stage-workflow calculation
// personnel_monitoring.ejs used before this move: "Approved" and everything after it (Release, Completed)
// counts toward Approved, since the request was approved and just continues through fulfillment.
function loadApprovalProgress() {
  var box = document.getElementById('approval-progress-body');
  if (!box) return;
  var DR_WORKFLOW_STATUSES = ['Received', 'Preparing', 'Awaiting for Approval', 'Approved', 'Release', 'Completed'];
  var DR_APPROVED_IDX = DR_WORKFLOW_STATUSES.indexOf('Approved');
  function drWorkflowIdx(r) { return DR_WORKFLOW_STATUSES.indexOf(r.canonicalStatus || r.status); }
  function drIsApproved(r) { return drWorkflowIdx(r) >= DR_APPROVED_IDX; }
  function drIsInProgress(r) { var idx = drWorkflowIdx(r); return idx > -1 && idx < DR_APPROVED_IDX; }

  CIPRMS.api('/api/document-requests/mine', { quiet: true }).then(function (res) {
    if (!res.ok || !Array.isArray(res.data)) {
      box.innerHTML = '<p class="text-muted fs-12 mb-0">Could not load approval progress.</p>';
      return;
    }
    var all = res.data;
    var total = all.length;
    var approved = all.filter(drIsApproved).length;
    var inProgress = all.filter(drIsInProgress).length;
    var pct = total ? Math.round((approved / total) * 100) : 0;
    box.innerHTML =
      '<div class="d-flex justify-content-between mb-1"><span>Approved</span><span>' + approved + ' / ' + total + '</span></div>' +
      '<div class="progress mb-3" style="height:10px"><div class="progress-bar bg-success" style="width:' + pct + '%"></div></div>' +
      '<div class="row g-2 text-center">' +
        '<div class="col-6"><div class="border rounded p-2"><h5 class="mb-0">' + inProgress + '</h5><small class="text-muted">In Progress</small></div></div>' +
        '<div class="col-6"><div class="border rounded p-2"><h5 class="mb-0 text-success">' + approved + '</h5><small class="text-muted">Approved</small></div></div>' +
      '</div>';
  }).catch(function () {
    box.innerHTML = '<p class="text-muted fs-12 mb-0">Could not load approval progress.</p>';
  });
}

// â”€â”€ API helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Every write goes through CIPRMS.api: a timeout, a dropped connection, an expired session or a server error comes back as
// { success:false, error:<plain-language message> } - the shape the callers below already handle (a failed drag reverts,
// a failed delete restores the event). Google Calendar sync happens inside these requests, so allow it more time.
var calWrites = 0;   // writes in flight - a live refresh waits for them (see calendarLive)
function calApi(url, method, payload){
  calWrites++;
  return CIPRMS.api(url, { method: method, json: payload, quiet: true, timeout: 45000 }).then(function(res){
    calWrites--;
    return res.ok ? res.data : { success: false, error: res.error, status: res.status };
  });
}
function apiPost(payload){ return calApi('/api/calendarevents', 'POST', payload); }
function apiPatch(id,payload){ return calApi('/api/calendarevents/'+id, 'PATCH', payload); }
function apiDelete(id){ return calApi('/api/calendarevents/'+id, 'DELETE'); }

// Somebody else changed the event that is open in the dialog: one that was removed closes it; one that only changed is
// redrawn if it is being viewed (an event being edited keeps what was typed, and Save still targets the same event).
function reconcileOpenEvent(){
  var modalEl = document.getElementById('event-modal');
  if(!modalEl || !modalEl.classList.contains('show') || isAdding || !currentEv || saving) return;
  var fresh = cal.getEventById(String(currentEv.id));
  if(!fresh){ bsModal.hide(); currentEv = null; showToast('This event was removed.', '#f06548'); return; }
  if(fresh === currentEv) return;
  if(!document.getElementById('view-mode').classList.contains('d-none')) showView(fresh); else currentEv = fresh;
}

// â”€â”€ Modal helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function showView(ev){
  currentEv = ev; isAdding = false;
  leaveWizard();
  document.getElementById('modal-title').textContent = ev.title;
  document.getElementById('view-mode').classList.remove('d-none');
  document.getElementById('edit-mode').classList.add('d-none');
  document.getElementById('v-date').textContent = str_dt(ev.start);
  document.getElementById('v-time').textContent = ev.allDay ? 'All day' : (str_tm(ev.start)+(ev.end?' – '+str_tm(ev.end):''));
  document.getElementById('v-location').textContent = ev.extendedProps.location || '—';
  document.getElementById('v-desc').textContent     = ev.extendedProps.description || '—';
  document.getElementById('v-gcal-badge').classList.toggle('d-none', !ev.extendedProps.googleEventId);
  var _vEvType = ev.extendedProps.eventType || '';
  document.getElementById('v-eventtype-row').classList.toggle('d-none', !_vEvType);
  document.getElementById('v-eventtype-badge').textContent = _vEvType;
  // Physical Meeting has no Google Meet link to join — never show the Join control for one, regardless
  // of the calendar color/className it happens to carry.
  if (_vEvType === 'Physical Meeting') MeetingJoin.hide();
  else MeetingJoin.render(ev.extendedProps.dbId || ev.id, ev.extendedProps.myInvite);
  renderInvitationPanel(ev);
  document.getElementById('btn-delete').classList.toggle('d-none', !CAN_MANAGE);
  document.getElementById('btn-edit-toggle').classList.toggle('d-none', !CAN_MANAGE);
  document.getElementById('btn-save').classList.add('d-none');
  setBreadcrumb(['Calendar', ev.title]);
  bsModal.show();
}

// ── Required fields when CREATING an event ──────────────────────────────────
// Every field except Notes and Notify Recipients must be filled in before a new event can be saved. Each empty one
// is highlighted and listed in the warning at the top of the form; the highlight clears as soon as it is filled in.
// (Editing an existing event keeps the older, lighter check — events created before this rule may lack some fields.)
var REQUIRED_NEW_EVENT_FIELDS = [
  ['f-type', 'Calendar Color'],
  ['f-date', 'Date'],
  ['f-title', 'Event Name'],
  ['f-start', 'Start Time'],
  ['f-end', 'End Time'],
  ['f-location', 'Institution / Location']
];

function clearFormErrors(){
  REQUIRED_NEW_EVENT_FIELDS.forEach(function(f){ document.getElementById(f[0]).classList.remove('is-invalid'); });
  document.getElementById('f-end-feedback').textContent = 'Please set the end time.';
  document.getElementById('f-missing-alert').classList.add('d-none');
}

function showMissingAlert(labels){
  var box = document.getElementById('f-missing-alert');
  if(!labels.length){ box.classList.add('d-none'); return; }
  box.innerHTML = '<i class="ri-error-warning-line me-1"></i><strong>Please complete the following to create the event:</strong> ';
  box.appendChild(document.createTextNode(labels.join(', ') + '.'));
  box.classList.remove('d-none');
}

// Returns true when every required field is filled in; otherwise highlights the empty ones and shows the warning.
function checkRequiredNewEventFields(){
  var missing = [];
  REQUIRED_NEW_EVENT_FIELDS.forEach(function(f){
    var el = document.getElementById(f[0]);
    var empty = !String(el.value || '').trim();
    el.classList.toggle('is-invalid', empty);
    if(empty && f[0] === 'f-date') document.getElementById('f-date-error').textContent = 'Please choose the date.';
    if(empty) missing.push(f[1]);
  });
  // Event Type needs its own check: the <select>'s own value can be non-empty ("__custom__") while the
  // custom text input it reveals is still blank, which the generic loop above can't see.
  var typeSel = document.getElementById('f-event-type');
  var customInput = document.getElementById('f-event-type-custom');
  var typeEmpty = !typeSel.value || (typeSel.value === '__custom__' && !customInput.value.trim());
  typeSel.classList.toggle('is-invalid', typeEmpty);
  customInput.classList.toggle('is-invalid', typeSel.value === '__custom__' && !customInput.value.trim());
  if(typeEmpty) missing.push('Event Type');
  showMissingAlert(missing);
  if(missing.length){
    var firstField = REQUIRED_NEW_EVENT_FIELDS.filter(function(f){ return missing.indexOf(f[1]) !== -1; })[0];
    if(firstField) document.getElementById(firstField[0]).focus();
    else if(typeEmpty) typeSel.focus();
  }
  return !missing.length;
}

// Filling in a highlighted field clears its highlight and drops it from the warning straight away.
REQUIRED_NEW_EVENT_FIELDS.forEach(function(f){
  var el = document.getElementById(f[0]);
  ['input', 'change'].forEach(function(evt){
    el.addEventListener(evt, function(){
      if(!el.classList.contains('is-invalid') || !String(el.value || '').trim()) return;
      el.classList.remove('is-invalid');
      if(f[0] === 'f-date') validateNewEventDate();
      var stillMissing = REQUIRED_NEW_EVENT_FIELDS.filter(function(r){ return document.getElementById(r[0]).classList.contains('is-invalid'); }).map(function(r){ return r[1]; });
      showMissingAlert(stillMissing);
    });
  });
});

// Same live-clear behavior as above, for the Event Type select + its custom-text companion.
function reEvaluateEventTypeMissing(){
  var typeSel = document.getElementById('f-event-type');
  var customInput = document.getElementById('f-event-type-custom');
  var typeEmpty = !typeSel.value || (typeSel.value === '__custom__' && !customInput.value.trim());
  if(typeEmpty) return;
  typeSel.classList.remove('is-invalid');
  customInput.classList.remove('is-invalid');
  var stillMissing = REQUIRED_NEW_EVENT_FIELDS.filter(function(r){ return document.getElementById(r[0]).classList.contains('is-invalid'); }).map(function(r){ return r[1]; });
  showMissingAlert(stillMissing);
}
document.getElementById('f-event-type').addEventListener('change', function(){ onEventTypeChange(); reEvaluateEventTypeMissing(); });
document.getElementById('f-event-type-custom').addEventListener('input', reEvaluateEventTypeMissing);

function showAdd(dateStr, prefill){
