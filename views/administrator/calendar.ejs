function showEdit(){
  if(!currentEv) return;
  clearFormErrors();
  leaveWizard();
  document.getElementById('modal-title').textContent = 'Edit Event';
  document.getElementById('view-mode').classList.add('d-none');
  document.getElementById('edit-mode').classList.remove('d-none');
  document.getElementById('f-title').value    = currentEv.title;
  document.getElementById('f-date').value     = str_date_input(currentEv.start);
  setDateMin(false);   // editing an existing (possibly historical) event is never limited to today-or-later
  document.getElementById('f-start').value    = currentEv.allDay ? '' : str_tm_input(currentEv.start);
  document.getElementById('f-end').value      = currentEv.end && !currentEv.allDay ? str_tm_input(currentEv.end) : '';
  document.getElementById('f-location').value = currentEv.extendedProps.location    || '';
  document.getElementById('f-desc').value     = currentEv.extendedProps.description || '';
  document.getElementById('f-type').value     = currentEv.classNames[0] || 'bg-primary-subtle';
  var _evType = currentEv.extendedProps.eventType || '';
  var _predefinedTypes = ['Meeting','Physical Meeting','Online Meeting','Conference','Seminar','Workshop','Institutional Activity','Partnership Activity','Consultation'];
  if(_evType && _predefinedTypes.indexOf(_evType) === -1){
    document.getElementById('f-event-type').value = '__custom__';
    document.getElementById('f-event-type-custom').value = _evType;
    document.getElementById('f-event-type-custom').classList.remove('d-none');
  } else {
    document.getElementById('f-event-type').value = _evType;
    document.getElementById('f-event-type-custom').value = '';
    document.getElementById('f-event-type-custom').classList.add('d-none');
  }
  updateLocationLabelForEventType();
  // Editing never re-notifies the people already invited; anyone selected here is ADDED
  // (notified, added to the Google event, and e-mailed the invitation).
  document.getElementById('f-recipients-wrap').classList.remove('d-none');
  Array.from(document.getElementById('f-recipients').options).forEach(function(o){ o.selected = false; });
  document.getElementById('f-recipients-label').innerHTML = 'Add attendees <span class="text-muted fw-normal">(Optional)</span>';
  document.getElementById('f-recipients-help').textContent = 'Already-invited people are kept. Anyone selected here is added and sent a Google Calendar invitation. Leave blank to change nothing.';
  document.getElementById('btn-delete').classList.remove('d-none');
  document.getElementById('btn-edit-toggle').classList.add('d-none');
  document.getElementById('btn-save').classList.remove('d-none');
  setBreadcrumb(['Calendar', currentEv.title, 'Edit']);
}

// â”€â”€ Build FullCalendar event object from DB doc â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function docToFcEvent(doc){
  return {
    id:        doc.id,
    title:     doc.title,
    start:     doc.start,
    end:       doc.end || undefined,
    allDay:    doc.allDay || false,
    className: doc.className || 'bg-primary-subtle',
    extendedProps: {
      location:    doc.location    || '',
      description: doc.description || '',
      eventType:   doc.eventType   || '',
      dbId:        doc.id,
      googleEventId: doc.googleEventId || null,
      googleSyncStatus: doc.googleSyncStatus || null,
      googleSyncError:  doc.googleSyncError || null,
      inviteSkipped:    doc.inviteSkipped || [],
      participantCount: doc.participantCount || 0,
      joinedCount:      doc.joinedCount || 0,
      myInvite:         doc.myInvite || null
    }
  };
}

// â”€â”€ DOMContentLoaded â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
document.addEventListener('DOMContentLoaded', function(){
  bsModal = new bootstrap.Modal(document.getElementById('event-modal'));
  attendanceModal = new bootstrap.Modal(document.getElementById('attendance-modal'));
  document.getElementById('event-modal').addEventListener('hidden.bs.modal', MeetingJoin.stop);
  document.getElementById('event-modal').addEventListener('hidden.bs.modal', function () {
    if (swappingToAttendance) { swappingToAttendance = false; return; }   // hidden only to make way for Attendance
    resetBreadcrumb();
  });
  document.getElementById('attendance-modal').addEventListener('hidden.bs.modal', function () {
    resetBreadcrumb();   // nothing brings event-modal back when Attendance closes — same as today's UX
  });
  document.getElementById('btn-attendance').addEventListener('click', openAttendance);

  // Add Event wizard. Next only validates and switches panels (no request); Back only switches back, and every
  // entered value stays in the step-1 fields because that panel is hidden, not rebuilt.
  document.getElementById('btn-next').addEventListener('click', function(){ if(readEventDetails()) showStep(2); });
  document.getElementById('btn-back').addEventListener('click', function(){ if(!saving) showStep(1); });
  document.getElementById('rcp-search').addEventListener('input', renderRecipients);
  document.getElementById('rcp-search').addEventListener('keydown', function(e){ if(e.key === 'Enter') e.preventDefault(); });
  function pickRow(row){
    var email = row.getAttribute('data-email');
    var u = allUsers.find(function(x){ return x.email === email; });
    if(u) toggleRecipient(u.email, u.email);
  }
  document.getElementById('rcp-results').addEventListener('click', function(e){ var row = e.target.closest('.rcp-row'); if(row) pickRow(row); });
  document.getElementById('rcp-results').addEventListener('keydown', function(e){
    var row = e.target.closest('.rcp-row');
    if(row && (e.key === 'Enter' || e.key === ' ')){ e.preventDefault(); pickRow(row); }
  });
  document.getElementById('rcp-groups').addEventListener('click', function(e){
    var b = e.target.closest('[data-group]'); if(!b) return;
    var g = RECIPIENT_GROUPS.find(function(x){ return x[0] === b.getAttribute('data-group'); });
    if(g) toggleRecipient(g[0], 'Group: ' + g[1]);
  });
  document.getElementById('rcp-selected').addEventListener('click', function(e){
    var b = e.target.closest('[data-remove]'); if(!b) return;
    var v = b.getAttribute('data-remove');
    selectedRecipients = selectedRecipients.filter(function(r){ return r.value !== v; });
    renderRecipients();
  });
  // If this user joins from the modal, keep the calendar's copy of the event current.
  MeetingJoin.onJoined(function(invite){ if(currentEv) currentEv.setExtendedProp('myInvite', invite); });
  var calEl = document.getElementById('calendar');

  // Deep-link support so a "New event" notification can jump straight to that
  // event's detail modal: /calendar?id=5. FullCalendar loads its events feed
  // asynchronously, so this only runs once the feed finishes loading.
  var deepLinkOpened = false;
  function openFromQuery(){
    if (deepLinkOpened) return;
    var id = new URLSearchParams(window.location.search).get('id');
    if (!id) { deepLinkOpened = true; return; }
    var ev = cal.getEventById(id);
    if (ev) { deepLinkOpened = true; showView(ev); }
  }

  // Individual-user recipient options — /api/users is Administrator/Staff-only
  // (requireStaffAccess), so Auth. Personnel (who can also reach this page)
  // simply won't see this group populated; the role-based options above
  // still work for them.
  function escapeHtml(str){ return String(str==null?'':str).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  fetch('/api/users').then(function(r){ return r.ok ? r.json() : []; }).then(function(users){
    allUsers = Array.isArray(users) ? users : [];   // also feeds the Add Event step-2 search
    var group = document.getElementById('f-recipients-individuals');
    group.innerHTML =users.map(function(u){ return '<option value="'+escapeHtml(u.email)+'">'+escapeHtml(u.name)+' ('+escapeHtml(u.email)+')</option>'; }).join('');
  }).catch(function(){ /* Auth. Personnel: no individual-user list, role options still work */ });

  cal = new FullCalendar.Calendar(calEl, {
    timeZone:    'local',
    headerToolbar: { left:'prev,next today', center:'title', right:'dayGridMonth,timeGridWeek,listMonth' },
    initialView: 'dayGridMonth',
    aspectRatio: calendarAspect(window.innerWidth),
    editable:    CAN_MANAGE,
    droppable:   CAN_MANAGE,
    selectable:  CAN_MANAGE,
    navLinks:    true,
    events:      '/api/calendarevents',   // FullCalendar fetches & maps automatically
    dayMaxEvents: 3,

    // FullCalendar JSON feed: map raw docs to FC event objects
    eventDataTransform: function(doc){ return docToFcEvent(doc); },

    windowResize: function(){
      var w = window.innerWidth;
      cal.setOption('aspectRatio', calendarAspect(w));
      cal.changeView(w < 768 ? 'listMonth' : w < 1200 ? 'timeGridWeek' : 'dayGridMonth');
    },
    // Creating from a calendar cell: days before today are not selectable (the cell just tells the person why).
    // Viewing or navigating to earlier months, and clicking an existing event there, are untouched.
    selectAllow: function(span){ return str_date_input(span.start) >= todayDateStr(); },
    dateClick:   function(info){ if(CAN_MANAGE && info.dateStr.slice(0,10) < todayDateStr()) showToast('Past dates are not available for new events.', '#f06548'); },
    select:      function(info){ showAdd(info.startStr.slice(0,10)); },
    eventClick:  function(info){ showView(info.event); },

    // Drag-drop moves the event: exactly one PATCH per gesture, in the same
    // wall-clock format the Add/Edit form saves. The server patches the SAME
    // Google Calendar event (never inserts a new one) and Google e-mails the
    // attendees the change.
    eventDrop: function(info){
      var ev = info.event, dbId = ev.extendedProps.dbId || ev.id;
      saveMove(dbId, { start: fc_wall(ev.start, ev.allDay), end: ev.end ? fc_wall(ev.end, ev.allDay) : null, allDay: ev.allDay }, info);
    },

    // Resize updates end time in DB
    eventResize: function(info){
      var ev = info.event, dbId = ev.extendedProps.dbId || ev.id;
      saveMove(dbId, { end: ev.end ? fc_wall(ev.end, ev.allDay) : null }, info);
    },

    // Drag an external event tile onto the calendar. The tile's Draggable is
    // configured with create:false (below), so FullCalendar does NOT add its own
    // event on drop. The drop no longer saves straight away: it opens the Add
    // Event form with the tile's type, name and the dropped-on date filled in,
    // so the same required fields (times, location) must be completed first.
    drop: function(info){
      if(info.dateStr.slice(0,10) < todayDateStr()){ showToast('Past dates are not available for new events.', '#f06548'); return; }
      var cls   = info.draggedEl.dataset.class || '';
      var title = info.draggedEl.innerText.trim();
      showAdd(String(info.dateStr).slice(0, 10), { title: title, className: cls });
    },

    // List view is much shorter than the sidebar next to it: let its card fill the row.
    datesSet: function(info){ calendarCardFill(info); },
    eventDidMount: function(){ upcomingEvent(); },
    loading: function(isLoading){ if (!isLoading) openFromQuery(); },
    // loading(false) can fire before the fetched events are in the calendar's store, in which case the
    // deep link (?id=N from a notification) found nothing and never tried again. eventsSet fires once they are
    // there; openFromQuery() is a no-op after it has opened the event once.
    eventsSet: function(){ openFromQuery(); reconcileOpenEvent(); }
  });

  cal.render();
  calendarLive(cal, function(){ return calWrites; });

  // Draggable external events (Administrator/Staff only — the palette isn't rendered otherwise)
  if(CAN_MANAGE && typeof FullCalendar.Draggable !== 'undefined'){
    new FullCalendar.Draggable(document.getElementById('external-events'),{
      itemSelector: '.external-event',
      eventData: function(el){ return { title: el.innerText.trim(), className: el.dataset.class, create: false }; }
    });
  }

  // Re-check a date as it is typed/picked (new events only): shows the inline message straight away.
  ['input', 'change'].forEach(function(t){ document.getElementById('f-date').addEventListener(t, validateNewEventDate); });

  var btnNewEvent = document.getElementById('btn-new-event');
  if (btnNewEvent) btnNewEvent.addEventListener('click', function(){ showAdd(''); });
  document.getElementById('btn-edit-toggle').addEventListener('click', showEdit);

  // â”€â”€ Save (add or edit) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('btn-save').addEventListener('click', function(){
    if(saving) return; // a second click while the first request is in flight would be a second Save
    // Same checks as Next. If something is wrong at the final Save of a new event (e.g. the time has passed while
    // the recipients were being chosen), go back to the details so the problem is visible.
    var d = readEventDetails();
    if(!d){ if(isAdding) showStep(1); return; }
    var title = d.title, st = d.st, start = d.start, end = d.end, cls = d.cls, loc = d.loc, desc = d.desc, evType = d.eventType;
    // Add: the recipients picked on step 2. Edit: the attendee list on the edit form, as before.
    var recipients = isAdding
      ? selectedRecipients.map(function(r){ return r.value; })
      : Array.from(document.getElementById('f-recipients').selectedOptions).map(function(o){ return o.value; });
    var saveBtn = document.getElementById('btn-save');
    function finish(){ saving = false; saveBtn.disabled = false; }
    saving = true; saveBtn.disabled = true;

    if(currentEv && !isAdding){
      // EDIT — persist to MongoDB then update FC event (the same event; never a new one)
      var dbId   = currentEv.extendedProps.dbId || currentEv.id;
      var updates = { title:title, start:start, end:end, allDay:!st, className:cls, location:loc, description:desc, eventType:evType };
      if(recipients.length) updates.recipients = recipients;
      apiPatch(dbId, updates).then(function(data){
        if(data.success){
          currentEv.setProp('title', title);
          currentEv.setProp('classNames', [cls]);
          currentEv.setStart(start);
          currentEv.setEnd(end);
          currentEv.setExtendedProp('location', loc);
          currentEv.setExtendedProp('description', desc);
          currentEv.setExtendedProp('eventType', evType);
          syncFromServer(currentEv, data.event);
          bsModal.hide(); upcomingEvent();
          reportInvitations(data.invitations, 'Event updated.');
        } else { showToast(data.error || 'Could not save the event.', '#f06548'); }
      }).catch(function(e){ console.error(e); showToast('Error saving event.', '#f06548'); }).then(finish);
    } else {
      // ADD — persist to MongoDB then add to FC
      var payload = { title:title, start:start, end:end, allDay:!st, className:cls, location:loc, description:desc, eventType:evType, recipients:recipients, clientRequestId: pendingRequestId };
      apiPost(payload).then(function(data){
        if(data.success){
          addSavedEvent(data.event);
          pendingRequestId = newRequestId();
          bsModal.hide(); upcomingEvent();
          reportInvitations(data.invitations, data.duplicate ? 'Event already created.' : 'Event created.');
        } else { showToast(data.error || 'Could not create the event.', '#f06548'); }
      }).catch(function(e){ console.error(e); showToast('Error saving event.', '#f06548'); }).then(finish);
    }
  });

  // â”€â”€ Delete â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('btn-delete').addEventListener('click', function(){
    if(!currentEv) return;
    if(!confirm('Delete "' + currentEv.title + '"?')) return;
    var dbId = currentEv.extendedProps.dbId || currentEv.id;
    // The event leaves the calendar the moment the user confirms — it does not wait for the server (and, behind
    // it, the Google Calendar cancellation) to answer. If the server then refuses, it is put back and the user
    // is told. Every instance with that id is removed, so no stray copy can be left standing.
    var gone = String(currentEv.id);
    var snapshot = currentEv.toPlainObject();
    cal.getEvents().filter(function(e){ return String(e.id) === gone; }).forEach(function(e){ e.remove(); });
    bsModal.hide(); upcomingEvent();
    function restore(message){
      if(!cal.getEventById(gone)) cal.addEvent(snapshot, cal.getEventSources()[0]);
      upcomingEvent();
      showToast(message, '#f06548');
    }
    apiDelete(dbId).then(function(data){
      if(data.success){ showToast('<i class="ri-checkbox-circle-line me-1"></i>Event deleted.'); }
      else { restore(data.error || 'Could not delete the event.'); }
    }).catch(function(e){ console.error(e); restore('Error deleting event.'); });
  });

  loadApprovalProgress();
});

function showToast(msg, bg) {
  const t = document.getElementById('cal-toast');
  if (!t) return;
  t.innerHTML = msg; t.style.background = bg || '#405189';
  t.style.opacity = '1'; t.style.pointerEvents = 'auto';
  setTimeout(() => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; }, 3500);
}

})();
</script>

<!-- Toast -->
<div id="cal-toast" style="
    position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;
    color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;
    font-size:.8125rem;font-weight:600;
    box-shadow:0 4px 16px rgba(0,0,0,.18);
    opacity:0;pointer-events:none;transition:opacity .3s;
    display:flex;align-items:center;gap:.4rem;
"></div>

</body>
</html>
